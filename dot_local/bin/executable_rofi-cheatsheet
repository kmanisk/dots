#!/usr/bin/env bash
# ==============================================================================
# rofi-cheatsheet: Interactive Keybinding & Shortcut Cheatsheet
# Searchable quick-reference modal for Sway, xremap, clipboard, and screenshots.
# ==============================================================================
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

THEME="$HOME/.config/rofi/clipboard-floating.rasi"

entries=(
    "Win + V              Open centered clipboard manager (prompt preview & search):~/.local/bin/clipboard-menu"
    "Caps + c             Open centered clipboard manager (Katana 60% keyboard):~/.local/bin/clipboard-menu"
    "Caps + .             Paste clipboard into the focused window (Ctrl+V / Ctrl+Shift+V in terminals):~/.local/bin/paste-smart"
    "Caps + Shift + Space Screenshot buffer picker (Space multi-select, paste into prompt):~/.local/bin/screenshot-buffer menu"
    "Caps + Space         Capture screenshot to buffer queue:~/.local/bin/screenshot-fullscreen"
    "Caps + v             View latest screenshot in imv:~/.local/bin/clipboard-view"
    "Win + Alt + L        Screen black / sleep mode (audio and agent stay active):~/.local/bin/screen-black"
    "Win + Alt + D        Toggle Desktop Commander scratchpad (live agent monitor):~/.local/bin/toggle-dc"
    "Win + Ctrl + I       Toggle Keep-Awake (prevent screen sleep & lock):~/.local/bin/keep-awake toggle"
    "Win + Alt + S        Snip region directly to screenshot buffer:~/.local/bin/screenshot-buffer snip"
    "Win + Alt + V        Screenshot buffer picker (Space multi-select, paste into prompt):~/.local/bin/screenshot-buffer menu"
    "Win + Alt + Shift + V Batch paste merged stitched image:~/.local/bin/screenshot-buffer stitch"
    "Win + Alt + X        Clear screenshot buffer queue:~/.local/bin/screenshot-buffer clear"
    "Win + Alt + A        Toggle auto-buffering mode:~/.local/bin/screenshot-buffer toggle"
    "L (Shift + L)        MPV: Loop current video infinitely (File loop toggle):true"
    "Ctrl + L             MPV: Loop entire playlist infinitely:true"
    "Win + Shift + S      OCR text snip from screen region:~/.local/bin/ocr-snip"
    "Win + S              Normal region screenshot to clipboard:~/.local/bin/screenshot-region"
    "Win + ?              Open this cheatsheet:~/.local/bin/rofi-cheatsheet"
)

display_lines=""
for item in "${entries[@]}"; do
    line="${item%%:*}"
    display_lines+="${line}"$'\n'
done

chosen=$(printf "%s" "$display_lines" | rofi -dmenu -i \
    -sort \
    -sorting-method "fzf" \
    -matching "fuzzy" \
    -p "Cheatsheet" \
    -mesg "Enter: Execute action  │  Esc: Close" \
    -theme "$THEME" || true)

[ -z "$chosen" ] && exit 0

for item in "${entries[@]}"; do
    line="${item%%:*}"
    action="${item#*:}"
    if [ "$line" = "$chosen" ]; then
        eval "$action" &
        break
    fi
done
