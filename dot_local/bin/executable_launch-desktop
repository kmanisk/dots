#!/usr/bin/env bash
# ==============================================================================
# Desktop Session Launcher (ASUS TUF F16 - Optimus Hybrid)
# ==============================================================================

SESSION_FILE="$HOME/.session_choice"
SESSION="plasma"

if [ -f "$SESSION_FILE" ]; then
    CHOICE=$(tr -d '[:space:]' < "$SESSION_FILE")
    [ -n "$CHOICE" ] && SESSION="$CHOICE"
fi

# Apply Intel hardware CTM vibrance before any compositor claims DRM master
if [ -x "$HOME/.local/bin/ctm-test" ]; then
    VIB_VAL="1.3"
    if [ -f "$HOME/.config/vibrance" ]; then
        VIB_VAL="$(cat "$HOME/.config/vibrance" 2>/dev/null | tr -d '[:space:]')"
    fi
    "$HOME/.local/bin/ctm-test" --set "${VIB_VAL:-1.3}" >/dev/null 2>&1 || true
fi

if [ "$SESSION" = "sway" ]; then
    exec "$HOME/.local/bin/sway-run"
elif [ "$SESSION" = "plasma" ] && [ -x /usr/bin/startplasma-wayland ]; then
    echo "==> Starting KDE Plasma (Wayland)..."
    export XDG_SESSION_TYPE=wayland
    export XDG_CURRENT_DESKTOP=KDE
    export XDG_SESSION_DESKTOP=KDE
    export DESKTOP_SESSION=plasma
    export MOZ_ENABLE_WAYLAND=1
    export QT_QPA_PLATFORM="wayland;xcb"
    export SDL_VIDEODRIVER="wayland,x11"
    export CLUTTER_BACKEND=wayland

    # Optimus Hybrid GPU Strategy:
    # Render compositor on Intel iGPU (card1), keep NVIDIA RTX 5050 (card0) suspended
    # Games offload explicitly via prime-run / gamemoderun
    if [ -e /dev/dri/card1 ] && [ -e /dev/dri/card0 ]; then
        export KWIN_DRM_DEVICES=/dev/dri/card1:/dev/dri/card0
    fi

    exec /usr/lib/plasma-dbus-run-session-if-needed /usr/bin/startplasma-wayland
else
    echo "==> Starting i3 (X11)..."
    export XDG_SESSION_TYPE=x11
    export XDG_CURRENT_DESKTOP=i3
    export DESKTOP_SESSION=i3
    exec startx
fi
