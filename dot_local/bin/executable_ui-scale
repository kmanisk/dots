#!/usr/bin/env bash
# ==============================================================================
# ui-scale - central UI scaling for every window managed by Sway
# ==============================================================================
# Sway can only scale outputs, not individual windows. This helper changes the
# scale of every active output, applies it immediately, and writes the value
# into ~/.config/sway/config.d/99-ui-scale.conf so Sway itself restores it on
# reload and on the next login.
# ==============================================================================
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/99-ui-scale.conf"
OUTPUT="${UI_SCALE_OUTPUT:-*}"
STEP="${UI_SCALE_STEP:-0.05}"
MIN="${UI_SCALE_MIN:-0.75}"
MAX="${UI_SCALE_MAX:-2.00}"

read_scale() {
    local value="1.00"
    if [ -r "$CONF" ]; then
        value=$(grep -oE 'scale[[:space:]]+[0-9]+(\.[0-9]+)?' "$CONF" | awk '{print $2}' | head -n1)
    fi
    if ! [[ "${value:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        value="1.00"
    fi
    printf '%s' "$value"
}

adjust() {
    awk -v v="$1" -v d="$2" -v lo="$MIN" -v hi="$MAX" 'BEGIN {
        n = v + d
        if (n < lo) n = lo
        if (n > hi) n = hi
        printf "%.2f", n
    }'
}

write_conf() {
    local value="$1" dir tmp
    dir="$(dirname "$CONF")"
    mkdir -p "$dir"
    tmp="$(mktemp "$dir/.99-ui-scale.conf.tmp.XXXXXX")"
    {
        echo "# Generated by ui-scale. Do not edit by hand."
        echo "# Change with \$mod+Alt+equal / \$mod+Alt+minus, or run: ui-scale in|out|reset"
        echo "output \"$OUTPUT\" scale $value"
    } > "$tmp"

    # Same-directory rename is atomic. Avoid replacing the file at all when the
    # generated content is unchanged, so `ui-scale apply` causes no write churn.
    if [ -f "$CONF" ] && cmp -s "$tmp" "$CONF"; then
        rm -f "$tmp"
    else
        mv -f "$tmp" "$CONF"
    fi
}

apply() {
    local value="$1"
    write_conf "$value"
    swaymsg output "$OUTPUT" scale "$value" >/dev/null
    # Keep system chrome (OSD, notifications, bar, lock) proportional.
    sync_cmd="$(command -v ui-sync 2>/dev/null || true)"
    [ -n "$sync_cmd" ] && { "$sync_cmd" --quiet 2>/dev/null || true; }
}

current=$(read_scale)
action="${1:-status}"
dry_run=0
[ "${2:-}" = "--dry-run" ] && dry_run=1

case "$action" in
    in)     next=$(adjust "$current" "$STEP") ;;
    out)    next=$(adjust "$current" "-$STEP") ;;
    reset)  next="1.00" ;;
    apply)  next="$current" ;;
    status)
        printf 'UI scale %s on output "%s" (step %s, range %s-%s)\n' \
            "$current" "$OUTPUT" "$STEP" "$MIN" "$MAX"
        exit 0
        ;;
    *)
        printf 'usage: ui-scale in|out|reset|apply|status [--dry-run]\n' >&2
        exit 2
        ;;
esac

if [ "$dry_run" -eq 1 ]; then
    printf '%s -> %s\n' "$current" "$next"
    exit 0
fi

apply "$next"
printf 'UI scale %s on output "%s"\n' "$next" "$OUTPUT"
notify-send -a ui-scale -t 1200 "UI scale" "${next}x" 2>/dev/null || true
