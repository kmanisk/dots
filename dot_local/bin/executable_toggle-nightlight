#!/usr/bin/env bash
# ==============================================================================
# Night Light Toggle (Persistent, Flicker-Free)
# Unified with wl-gammarelay-rs (handles both Night Light and Sub-Zero Brightness)
# Persistent State: ~/.config/nightlight_state
# Supports: toggle-nightlight [on|off|toggle] [--silent] [--auto]
# ==============================================================================
export PATH="$HOME/.local/bin:$PATH"

STATE_FILE="$HOME/.config/nightlight_state"
TEMP_FILE="$HOME/.config/nightlight_temp"

CURRENT_TEMP=4200
if [[ -f "$TEMP_FILE" ]]; then
    val=$(cat "$TEMP_FILE" 2>/dev/null)
    if [[ -n "$val" && "$val" -ge 2000 && "$val" -le 6500 ]]; then
        CURRENT_TEMP="$val"
    fi
fi

ACTION="toggle"
SILENT=0
IS_AUTO=0

for arg in "$@"; do
    if [[ "$arg" == "--silent" ]]; then
        SILENT=1
    elif [[ "$arg" == "--auto" ]]; then
        IS_AUTO=1
    elif [[ "$arg" == "on" || "$arg" == "off" || "$arg" == "toggle" ]]; then
        ACTION="$arg"
    fi
done

# If triggered by automated schedule/timer, respect user disabled preference
CURRENT_STATE="$(cat "$STATE_FILE" 2>/dev/null || echo "on")"
if (( IS_AUTO == 1 )); then
    if [[ "$CURRENT_STATE" == "off" || "$CURRENT_STATE" == "disabled" || "$CURRENT_STATE" == "0" ]]; then
        exit 0
    fi
fi

notify_osd() {
    local text="$1"
    local pct="$2"
    if (( SILENT == 0 )); then
        notify-send -a "Night Light" -u low -i preferences-desktop-display \
            -h string:x-canonical-private-synchronous:nightlight \
            -h string:x-dunst-stack-tag:nightlight \
            -h int:value:"$pct" \
            "$text" 2>/dev/null || \
        dunstify -a "Night Light" -u low -i preferences-desktop-display \
            -h string:x-dunst-stack-tag:nightlight \
            -h int:value:"$pct" \
            "$text" 2>/dev/null
    fi
}

turn_on() {
    if (( CURRENT_TEMP >= 6500 )); then
        CURRENT_TEMP=4200
    fi
    echo "$CURRENT_TEMP" > "$TEMP_FILE"

    if [ -n "$WAYLAND_DISPLAY" ] || [ -n "$SWAYSOCK" ]; then
        if ! systemctl --user is-active --quiet wl-gammarelay.service 2>/dev/null; then
            systemctl --user start wl-gammarelay.service 2>/dev/null || true
        fi
        busctl --user set-property rs.wl-gammarelay / rs.wl.gammarelay Temperature q "$CURRENT_TEMP" 2>/dev/null || true
    else
        pkill -9 -x gammastep >/dev/null 2>&1 || true
        redshift -r -P -m randr -O "$CURRENT_TEMP" >/dev/null 2>&1
    fi
    echo "on" > "$STATE_FILE"
    PERCENT=$(( (CURRENT_TEMP - 2000) * 100 / 4500 ))
    notify_osd "Night Light: ON (${CURRENT_TEMP}K)" "$PERCENT"
}

turn_off() {
    if [ -n "$WAYLAND_DISPLAY" ] || [ -n "$SWAYSOCK" ]; then
        if ! systemctl --user is-active --quiet wl-gammarelay.service 2>/dev/null; then
            systemctl --user start wl-gammarelay.service 2>/dev/null || true
        fi
        busctl --user set-property rs.wl-gammarelay / rs.wl.gammarelay Temperature q 6500 2>/dev/null || true
    else
        pkill -9 -x redshift >/dev/null 2>&1 || true
        pkill -9 -x gammastep >/dev/null 2>&1 || true
        redshift -x -m randr >/dev/null 2>&1 || true
        PRIMARY_MON="$(xrandr --query 2>/dev/null | grep " connected primary" | cut -d' ' -f1)"
        [ -z "$PRIMARY_MON" ] && PRIMARY_MON="$(xrandr --query 2>/dev/null | grep " connected" | cut -d' ' -f1 | head -n1)"
        if [ -n "$PRIMARY_MON" ]; then
            xrandr --output "$PRIMARY_MON" --gamma 1.0:1.0:1.0 --brightness 1.0 >/dev/null 2>&1 || true
        fi
    fi
    echo "off" > "$STATE_FILE"
    notify_osd "Night Light: OFF (6500K)" 100
}

case "$ACTION" in
    on)
        turn_on
        ;;
    off)
        turn_off
        ;;
    toggle|*)
        if [[ "$CURRENT_STATE" == "on" || "$CURRENT_STATE" == "1" ]]; then
            turn_off
        else
            turn_on
        fi
        ;;
esac
