#!/usr/bin/env bash
# ==============================================================================
# Toggle Bottom Bar (Polybar) - Alt+0. The ONLY writer of bar_state besides
# initial setup. Flips the persisted state, then bar-apply enforces it.
# --force: explicit user action, so the in-game guard is bypassed.
# ==============================================================================
export DISPLAY="${DISPLAY:-:0}"
export PATH="$HOME/.local/bin:$PATH"

SWAY_STATE_FILE="$HOME/.local/state/sway/bar_state"
POLY_STATE_FILE="$HOME/.config/polybar/bar_state"
mkdir -p "$HOME/.local/state/sway" "$HOME/.config/polybar"

if [ -n "$SWAYSOCK" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    CURRENT_STATE=$(cat "$SWAY_STATE_FILE" 2>/dev/null || cat "$POLY_STATE_FILE" 2>/dev/null || echo "false")
else
    CURRENT_STATE=$(cat "$POLY_STATE_FILE" 2>/dev/null || echo "false")
fi

case "$CURRENT_STATE" in
    false|hidden|0|off)
        echo "true" > "$SWAY_STATE_FILE"
        echo "true" > "$POLY_STATE_FILE"
        if [ -n "$SWAYSOCK" ] || [ -n "$WAYLAND_DISPLAY" ]; then
            swaymsg "bar bar-0 mode dock" >/dev/null 2>&1
        else
            "$HOME/.config/polybar/launch.sh" >/dev/null 2>&1 &
        fi
        ;;
    *)
        echo "false" > "$SWAY_STATE_FILE"
        echo "false" > "$POLY_STATE_FILE"
        if [ -n "$SWAYSOCK" ] || [ -n "$WAYLAND_DISPLAY" ]; then
            swaymsg "bar bar-0 mode invisible" >/dev/null 2>&1
        else
            polybar-msg cmd quit 2>/dev/null || true
            pkill -x polybar 2>/dev/null || true
            rm -f /run/user/$(id -u)/polybar/ipc.*.sock 2>/dev/null
        fi
        ;;
esac
