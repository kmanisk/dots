#!/usr/bin/env bash
# Brave Browser Launcher (discrete NVIDIA RTX 5050 via PRIME render offload)
# NOTE: Chromium cannot PRIME-offload on native Wayland (upstream bug), so on
# Wayland sessions force XWayland (ozone x11) where classic GLX offload works.
# Do NOT add --enable-features=Vulkan/--use-angle=vulkan here: they conflict
# with brave-origin-flags.conf (which disables Vulkan) and break GPU init.
BRAVE_BIN=$(command -v /usr/bin/brave-origin || command -v /usr/sbin/brave-origin || command -v /usr/bin/brave)
if [ -z "$BRAVE_BIN" ]; then
    echo "brave-nvidia launcher: real binary not found" >&2
    exit 1
fi

if [ -n "$SWAYSOCK" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    # VA-API -> NVIDIA bridge (libva-nvidia-driver) for NVDEC video decode
    export LIBVA_DRIVER_NAME=nvidia
    # Classic DRI3 GLX offload: render on NVIDIA, present via Intel/XWayland
    export DRI_PRIME=1
    # Sway output scaling owns the desktop scale; do not stack a Chromium
    # device-scale override on top of it.
    exec prime-run "$BRAVE_BIN" \
        --ozone-platform=x11 \
        "$@"
fi

exec prime-run "$BRAVE_BIN" "$@"
