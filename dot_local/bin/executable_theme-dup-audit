#!/usr/bin/env python3
"""Audit generated theme uniqueness and show suppressed duplicates."""
import json
import os
import sys

sys.path.insert(0, os.path.expanduser("~/.local/lib"))
from theme_engine.dedupe import family_key, palette_distance

CACHE_DIR = os.path.expanduser("~/.cache/theme/themes")
DEDUP_MANIFEST = os.path.expanduser("~/.cache/theme/dedup.json")


def load_themes():
    themes = {}
    for filename in sorted(os.listdir(CACHE_DIR)):
        if not filename.endswith(".json"):
            continue
        path = os.path.join(CACHE_DIR, filename)
        try:
            with open(path, "r", encoding="utf-8") as f:
                themes[filename[:-5]] = json.load(f)
        except Exception:
            pass
    return themes


def main():
    themes = load_themes()
    print(f"exposed unique themes: {len(themes)}")

    if os.path.exists(DEDUP_MANIFEST):
        with open(DEDUP_MANIFEST, "r", encoding="utf-8") as f:
            report = json.load(f)
        duplicates = report.get("duplicates", {})
        print(f"suppressed duplicates: {len(duplicates)}")
        for name, info in sorted(duplicates.items()):
            print(
                f"  {name} -> {info.get('survivor')} "
                f"[{info.get('reason')}, distance={info.get('distance')}]"
            )
    else:
        print("suppressed duplicates: unknown (run theme-sync --force)")

    pairs = []
    names = sorted(themes)
    for i, a in enumerate(names):
        for b in names[i + 1 :]:
            if themes[a].get("type", "dark") != themes[b].get("type", "dark"):
                continue
            if family_key(a) != family_key(b):
                continue
            dist = palette_distance(themes[a], themes[b])
            pairs.append((dist, a, b))
    pairs.sort()

    print("\nclosest remaining same-family pairs:")
    if not pairs:
        print("  none")
    else:
        for dist, a, b in pairs[:20]:
            print(f"  {dist:5.1f}  {a} <-> {b}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
