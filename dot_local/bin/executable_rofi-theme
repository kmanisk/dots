#!/usr/bin/env python3
"""
rofi-theme: Pure NvChad Base46 Theme Selector for the whole system.
Displays exact NvChad bordered theme list with colored palette chips (󱓻).
Fast (<10ms generation), 0 resident daemons, atomic switching.
"""
import os
import sys
import glob
import json
import subprocess
import shutil

sys.path.insert(0, os.path.expanduser("~/.local/lib"))
from theme_engine import is_cache_stale

THEME_SET = os.path.expanduser("~/.local/bin/theme-set")
CACHE_DIR = os.path.expanduser("~/.cache/theme/themes")
THEME_RASI = os.path.expanduser("~/.config/rofi/theme-picker-nvchad.rasi")
BASE46_DIR = os.path.expanduser("~/.config/theme/base46/lua/base46/themes")
CUSTOM_DIR = os.path.expanduser("~/.config/theme/custom")
IMPORTED_DIR = os.path.expanduser("~/.config/theme/imported")
MANIFEST_PATH = os.path.expanduser("~/.cache/theme/manifest.json")

ORDER = ["base08", "base09", "base0A", "base0B", "base0C", "base0D", "base0E", "base0F"]

def get_current_theme():
    name_file = os.path.expanduser("~/.local/state/theme/name")
    if os.path.exists(name_file):
        try:
            with open(name_file, "r") as f:
                return f.read().strip()
        except Exception:
            pass
    return "gruvchad"

def main():
    if not os.path.isfile(THEME_SET) or not os.access(THEME_SET, os.X_OK):
        print(f"Error: {THEME_SET} not found or not executable", file=sys.stderr)
        return 1

    current = get_current_theme()
    theme_files = sorted(glob.glob(os.path.join(CACHE_DIR, "*.json")))

    # Fast O(N) manifest staleness check
    stale, _ = is_cache_stale([BASE46_DIR, IMPORTED_DIR, CUSTOM_DIR], MANIFEST_PATH)
    if stale or not theme_files:
        subprocess.run([os.path.expanduser("~/.local/bin/theme-sync")], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        theme_files = sorted(glob.glob(os.path.join(CACHE_DIR, "*.json")))

    # Place current active theme at the very top (row 0) so it is visible and selected on launch,
    # and whenever the user filters with a query, focus stays locked on the #1 top match (row 0).
    theme_files.sort(key=lambda tf: (0 if os.path.splitext(os.path.basename(tf))[0] == current else 1, os.path.basename(tf)))

    lines = []
    names = []

    for tf in theme_files:
        theme_name = os.path.splitext(os.path.basename(tf))[0]
        names.append(theme_name)

        try:
            with open(tf, "r", encoding="utf-8") as jf:
                d = json.load(jf)
            b16 = d.get("base_16", {})
        except Exception:
            b16 = {}

        swatches = ""
        for k in ORDER:
            c = b16.get(k.upper(), "#777777")
            swatches += f"<span foreground=\"{c}\" size=\"large\">● </span>"

        is_current = (theme_name == current)
        active_col = b16.get("BASE0B", "#a7c080")
        badge = f" <span foreground=\"{active_col}\" weight=\"bold\" size=\"small\">[ACTIVE]</span>" if is_current else "         "
        lines.append(f"{theme_name:<26}{badge}  {swatches}")

    input_text = "\n".join(lines) + "\n"

    rofi_cmd = [
        "rofi",
        "-dmenu",
        "-i",
        "-markup-rows",
        "-p", " ",
        "-no-custom",
        "-sort",
        "-sorting-method", "fzf",
        "-matching", "fuzzy",
        "-format", "s",
        "-theme", THEME_RASI,
    ]

    try:
        proc = subprocess.run(
            rofi_cmd,
            input=input_text,
            text=True,
            capture_output=True
        )
        if proc.returncode != 0 or not proc.stdout.strip():
            return 0

        selected_line = proc.stdout.strip()
        chosen_theme = selected_line.split()[0]
        if chosen_theme in names:
            subprocess.run([THEME_SET, chosen_theme])
    except Exception as e:
        print(f"Error launching theme picker: {e}", file=sys.stderr)
        return 1

    return 0

if __name__ == "__main__":
    sys.exit(main())
