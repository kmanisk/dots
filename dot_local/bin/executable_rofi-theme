#!/usr/bin/env python3
"""
rofi-theme: Pure NvChad Base46 Theme Selector for the whole system.
Operates in native Rofi Script Mode (man rofi-script) for dynamic in-place mutations:
  • Enter:         Queue selected theme, close immediately, apply in a detached one-shot worker
  • Ctrl+D:        Permanently delete selected theme (with active theme immunity)
  • Ctrl+R:        Rescan sources and recompile theme cache (theme-sync)
  • Ctrl+I:        Display rich theme metadata & palette specs in header
  • 0 resident daemons, <10ms generation, instant Wayland repaint without window reload.
"""
import html
import json
import os
import signal
import subprocess
import sys
import time

# Cleanly handle broken pipes (e.g. head, grep, rofi quit)
try:
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
except (AttributeError, ValueError):
    pass

sys.path.insert(0, os.path.expanduser("~/.local/lib"))

THEME_SET = os.path.expanduser("~/.local/bin/theme-set")
THEME_SYNC = os.path.expanduser("~/.local/bin/theme-sync")
CACHE_DIR = os.path.expanduser("~/.cache/theme/themes")
PREVIEWS_DIR = os.path.expanduser("~/.cache/theme/previews")
THEME_RASI = os.path.expanduser("~/.config/rofi/theme-picker-nvchad.rasi")
BASE46_DIR = os.path.expanduser("~/.config/theme/base46/lua/base46/themes")
CUSTOM_DIR = os.path.expanduser("~/.config/theme/custom")
IMPORTED_DIR = os.path.expanduser("~/.config/theme/imported")
APPLY_LOG = os.path.expanduser("~/.local/state/theme/last-picker-apply.log")
PICKER_REQUEST = os.path.expanduser("~/.local/state/theme/picker-request")
PICKER_INDEX = os.path.expanduser("~/.cache/theme/picker-index.json")

ORDER = ["base08", "base09", "base0A", "base0B", "base0C", "base0D", "base0E", "base0F"]

NULL = "\x00"
US = "\x1f"

DEFAULT_HINT = (
    "<span weight='bold'>Enter:</span> Apply  │  "
    "<span weight='bold'>Ctrl+D:</span> Delete  │  "
    "<span weight='bold'>Ctrl+R:</span> Sync  │  "
    "<span weight='bold'>Ctrl+I:</span> Preview HUD"
)


def get_current_theme():
    name_file = os.path.expanduser("~/.local/state/theme/name")
    if os.path.exists(name_file):
        try:
            with open(name_file, "r") as f:
                return f.read().strip()
        except Exception:
            pass
    return "gruvchad"


def find_theme_source(theme_name):
    clean = theme_name[8:] if theme_name.startswith("omarchy-") else theme_name

    # 1. Check imported
    if os.path.isdir(IMPORTED_DIR):
        for root, _, files in os.walk(IMPORTED_DIR):
            for f in files:
                stem, ext = os.path.splitext(f)
                if ext == ".json" and stem in (theme_name, clean, f"omarchy-{clean}"):
                    return os.path.join(root, f), "Imported Omarchy"

    # 2. Check custom
    if os.path.isdir(CUSTOM_DIR):
        for root, _, files in os.walk(CUSTOM_DIR):
            for f in files:
                stem, ext = os.path.splitext(f)
                if ext in (".json", ".yaml", ".toml") and stem in (theme_name, clean):
                    return os.path.join(root, f), "Custom"

    # 3. Check base46
    base46_candidates = [
        os.path.join(BASE46_DIR, f"{theme_name}.lua"),
        os.path.join(BASE46_DIR, f"{clean}.lua"),
    ]
    for b in base46_candidates:
        if os.path.exists(b):
            return b, "Base46"

    return None, None


def purge_cache(theme_name):
    clean = theme_name[8:] if theme_name.startswith("omarchy-") else theme_name
    targets = [
        os.path.join(CACHE_DIR, f"{theme_name}.json"),
        os.path.join(CACHE_DIR, f"{clean}.json"),
        os.path.join(CACHE_DIR, f"omarchy-{clean}.json"),
        os.path.join(PREVIEWS_DIR, f"{theme_name}.png"),
        os.path.join(PREVIEWS_DIR, f"{clean}.png"),
        os.path.join(PREVIEWS_DIR, f"omarchy-{clean}.png"),
    ]
    for t in targets:
        if os.path.exists(t):
            try:
                os.remove(t)
            except Exception:
                pass


def get_theme_cache_path(theme_name):
    clean = theme_name[8:] if theme_name.startswith("omarchy-") else theme_name
    candidates = [
        os.path.join(CACHE_DIR, f"{theme_name}.json"),
        os.path.join(CACHE_DIR, f"{clean}.json"),
        os.path.join(CACHE_DIR, f"omarchy-{clean}.json"),
    ]
    return next((c for c in candidates if os.path.exists(c)), None)


def _rel_luma(hex_color):
    h = (hex_color.lstrip("#"))[:6]
    if len(h) == 3:
        h = "".join(c * 2 for c in h)
    try:
        r, g, b = (int(h[i * 2:i * 2 + 2], 16) / 255 for i in range(3))
    except ValueError:
        return 0.0
    f = lambda c: c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b)


def _contrast(a, b):
    la, lb = _rel_luma(a), _rel_luma(b)
    hi, lo = max(la, lb), min(la, lb)
    return (hi + 0.05) / (lo + 0.05)


def load_active_palette(current):
    """Read the compiled JSON of the ACTIVE theme. Its chrome (inputbar/hint
    rows in the message bar) is drawn in this palette, so status text must
    contrast against the same background-alt the rofi chrome uses (base30
    one_bg). Palette values below a contrast floor fall back to the theme's
    readable foreground instead of hard-coded hexes."""
    d = None
    path = get_theme_cache_path(current)
    if path:
        try:
            with open(path, "r", encoding="utf-8") as jf:
                d = json.load(jf)
        except Exception:
            d = None
    if not isinstance(d, dict):
        return {}

    sem = d.get("semantic") or d.get("derived", {}).get("semantic") or {}
    b16 = d.get("base_16") or d.get("palette", {}).get("base_16") or {}
    b30 = d.get("base_30") or d.get("derived", {}).get("base_30") or {}
    bar = b30.get("one_bg") or b16.get("BASE01") or "#20242c"
    fg = sem.get("foreground") or b16.get("BASE05") or "#d8dce3"

    def pick(key16, default):
        c = sem.get(key16) or default
        if c and _contrast(c, bar) >= 3.0:
            return c
        return fg

    return {
        "ok": pick("success", b16.get("BASE0B")),
        "err": pick("error", b16.get("BASE08")),
        "info": pick("info", b16.get("BASE0D")),
        "accent": pick("accent", d.get("accent") or b16.get("BASE0D")),
        "muted": sem.get("muted") if (sem.get("muted") and _contrast(sem.get("muted"), bar) >= 2.0) else fg,
        "fg": fg,
        "bg": sem.get("background") or b16.get("BASE00") or "#16181e",
    }


def status_span(pal, key, extra="weight='bold'"):
    """Pango span opener; color only when the palette can serve it, so the
    fallback inherits the chrome text color (always readable)."""
    c = (pal or {}).get(key)
    if c and str(c).startswith("#"):
        return f"<span foreground='{c}' {extra}>"
    return f"<span {extra}>"


def generate_preview_hud(theme_name, active_pal):
    clean = theme_name[8:] if theme_name.startswith("omarchy-") else theme_name
    target_path = get_theme_cache_path(clean)
    if not target_path:
        return f"{status_span(active_pal,'err')}No compiled metadata found for '{html.escape(clean)}'</span>"

    try:
        with open(target_path, "r", encoding="utf-8") as jf:
            d = json.load(jf)
    except Exception as e:
        return f"{status_span(active_pal,'err')}Error parsing metadata: {html.escape(str(e))}</span>"

    # Chrome colors come from the ACTIVE palette (the bar the HUD sits on);
    # selected-theme colors are kept only inside self-backgrounded blocks.
    bk = (active_pal or {}).get("bg") or "#20242c"

    b16 = d.get("palette", {}).get("base_16", {}) or d.get("base_16", {})
    sem = d.get("derived", {}).get("semantic", {}) or d.get("semantic", {})

    bg = sem.get("background") or b16.get("BASE00", "#181a1f")
    fg = sem.get("foreground") or b16.get("BASE05", "#b9bec6")
    accent = d.get("accent") or sem.get("accent") or b16.get("BASE0D", "#ad2222")
    sel_bg = sem.get("selection") or b16.get("BASE02", "#2b2f37")
    sel_fg = sem.get("selection_fg") or fg
    border = sem.get("border") or accent
    muted = sem.get("muted") or b16.get("BASE03", "#4b515b")

    b00 = b16.get("BASE00", "#181a1f")
    b01 = b16.get("BASE01", "#101216")
    b02 = b16.get("BASE02", "#2b2f37")
    b03 = b16.get("BASE03", "#4b515b")
    b04 = b16.get("BASE04", "#6a707a")
    b05 = b16.get("BASE05", "#b9bec6")
    b06 = b16.get("BASE06", "#d3d7dd")
    b07 = b16.get("BASE07", "#eceff2")
    b08 = b16.get("BASE08", "#e53939")
    b09 = b16.get("BASE09", "#cc1f1f")
    b0A = b16.get("BASE0A", "#9e1a1a")
    b0B = b16.get("BASE0B", "#dce0e6")
    b0C = b16.get("BASE0C", "#8f949c")
    b0D = b16.get("BASE0D", "#ad2222")
    b0E = b16.get("BASE0E", "#c3c8d0")
    b0F = b16.get("BASE0F", "#6a3030")

    row1 = " ".join([f"<span background='{bk}' foreground='{c}'>██</span>" for c in [b00, b01, b02, b03, b04, b05, b06, b07]])
    row2 = " ".join([f"<span background='{bk}' foreground='{c}'>██</span>" for c in [b08, b09, b0A, b0B, b0C, b0D, b0E, b0F]])

    display_name = d.get("display_name") or d.get("name") or clean
    author = d.get("source", {}).get("author") or "Unknown"
    provider = d.get("source", {}).get("provider") or "custom"
    theme_type = d.get("type") or "dark"

    safe_name = html.escape(str(display_name))
    safe_author = html.escape(str(author))
    safe_provider = html.escape(str(provider))
    safe_type = html.escape(str(theme_type))
    safe_id = html.escape(str(clean))

    span_title = status_span(active_pal, "accent", "weight='bold' size='large'")
    span_muted = status_span(active_pal, "muted")
    span_small = status_span(active_pal, "muted", "weight='normal' size='small'")
    lines = [
        f"{span_title}{safe_name.upper()}</span>  {span_muted}{safe_author} ({safe_provider} • {safe_type})</span>  │  {span_small}[Ctrl+I: Hide HUD]</span>",
        f"  <span background='{bk}' foreground='{bg}'>██</span> Bg: {bg}   <span background='{bk}' foreground='{fg}'>██</span> Fg: {fg}   <span background='{bk}' foreground='{accent}'>██</span> Accent: {accent}   <span background='{bk}' foreground='{sel_bg}'>██</span> Sel: {sel_bg}",
        f"  {status_span(active_pal,'muted')}Base16:</span> {row1}  {status_span(active_pal,'muted')}00-07</span>   {row2}  {status_span(active_pal,'muted')}08-0F</span>",
        f"  <span background='{bg}' foreground='{fg}'> <span foreground='{b0E}' weight='bold'>fn</span> <span foreground='{b0D}'>main</span>() {{ <span foreground='{b08}'>println!</span>(<span foreground='{b0B}'>&quot;Hello, {safe_name}!&quot;</span>); }} </span>  <span background='{accent}' foreground='{bg}' weight='bold'> NORMAL </span><span background='{sel_bg}' foreground='{sel_fg}'> {safe_id}.rs </span>",
    ]

    return "&#10;".join(lines)


def output_mode_header(message_str, data_str=None):
    sys.stdout.write(f"{NULL}prompt{US}Theme:\n")
    sys.stdout.write(f"{NULL}markup-rows{US}true\n")
    sys.stdout.write(f"{NULL}use-hot-keys{US}true\n")
    sys.stdout.write(f"{NULL}no-custom{US}true\n")
    sys.stdout.write(f"{NULL}message{US}{message_str}\n")
    if data_str is not None:
        sys.stdout.write(f"{NULL}data{US}{data_str}\n")
    sys.stdout.write(f"{NULL}new-selection{US}0\n")


def load_picker_entries():
    try:
        with open(PICKER_INDEX, "r", encoding="utf-8") as handle:
            payload = json.load(handle)
        if payload.get("version") == 1 and isinstance(payload.get("themes"), list):
            return payload["themes"]
    except (OSError, json.JSONDecodeError, TypeError):
        pass

    # Exceptional fallback for a missing/corrupt index. This keeps the picker
    # usable without forcing a full theme-sync before Rofi can become visible.
    entries = []
    try:
        cache_paths = sorted(
            entry.path for entry in os.scandir(CACHE_DIR)
            if entry.is_file() and entry.name.endswith(".json")
        )
    except OSError:
        cache_paths = []
    for tf in cache_paths:
        theme_name = os.path.splitext(os.path.basename(tf))[0]
        try:
            with open(tf, "r", encoding="utf-8") as jf:
                d = json.load(jf)
            b16 = (d.get("palette") or {}).get("base_16") or d.get("base_16") or {}
            source = d.get("source") or {}
            entries.append({
                "name": theme_name,
                "swatches": [str(b16.get(key.upper()) or "#777777") for key in ORDER],
                "meta": " ".join(
                    part for part in [
                        str(source.get("provider") or ""),
                        str(d.get("type") or ""),
                        " ".join(str(tag) for tag in (source.get("tags") or [])),
                    ] if part
                ).strip(),
            })
        except Exception:
            continue
    return entries


def remove_picker_index_entry(theme_name):
    """Drop a deleted theme from the visible snapshot before background sync finishes."""
    try:
        with open(PICKER_INDEX, "r", encoding="utf-8") as handle:
            payload = json.load(handle)
        themes = payload.get("themes") or []
        kept = [item for item in themes if item.get("name") != theme_name]
        if len(kept) == len(themes):
            return
        payload["themes"] = kept
        temp = PICKER_INDEX + f".{os.getpid()}.tmp"
        with open(temp, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, separators=(",", ":"), sort_keys=True)
        os.replace(temp, PICKER_INDEX)
    except (OSError, json.JSONDecodeError, TypeError):
        pass


def output_theme_rows(current):
    entries = load_picker_entries()
    if not entries:
        subprocess.run([THEME_SYNC], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        entries = load_picker_entries()

    entries.sort(key=lambda item: (0 if item.get("name") == current else 1, item.get("name") or ""))

    for item in entries:
        theme_name = str(item.get("name") or "")
        if not theme_name:
            continue
        swatches = "".join(
            f"<span foreground=\"{color}\" size=\"large\">● </span>"
            for color in (item.get("swatches") or ["#777777"] * 8)[:8]
        )
        is_current = theme_name == current
        badge = (
            " <span weight=\"bold\" size=\"small\">[ACTIVE]</span>"
            if is_current else "         "
        )
        # Strip the provider prefix from the visible label only. Rofi's row
        # value and info metadata must retain the canonical theme ID so
        # activation, deletion, and previews still resolve the same theme.
        visible_name = theme_name.removeprefix("omarchy-")
        display_str = f"{visible_name:<26}{badge}  {swatches}"
        meta = str(item.get("meta") or "")
        sys.stdout.write(f"{theme_name}{NULL}display{US}{display_str}{US}info{US}{theme_name}{US}meta{US}{meta}\n")

    sys.stdout.flush()


def _write_apply_log(theme_name, result=None, error=None):
    """Keep the last picker apply diagnostic without holding the Rofi UI open."""
    os.makedirs(os.path.dirname(APPLY_LOG), exist_ok=True)
    if error is not None:
        text = f"theme={theme_name}\nerror={error}\n"
    else:
        text = (
            f"theme={theme_name}\nreturncode={result.returncode}\n"
            f"stdout={result.stdout.strip()}\nstderr={result.stderr.strip()}\n"
        )
    temp = APPLY_LOG + f".{os.getpid()}.tmp"
    with open(temp, "w", encoding="utf-8") as handle:
        handle.write(text)
    os.replace(temp, APPLY_LOG)


def apply_worker(theme_name, request_token):
    """Run only the newest queued picker transaction after Rofi has closed."""
    try:
        try:
            with open(PICKER_REQUEST, "r", encoding="utf-8") as handle:
                latest = handle.read().strip()
        except OSError:
            latest = ""
        if latest != request_token:
            return 0

        result = subprocess.run(
            [THEME_SET, theme_name],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=15,
            check=False,
        )
        _write_apply_log(theme_name, result=result)
        if result.returncode != 0:
            detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
            subprocess.run(
                ["notify-send", "-u", "critical", "Theme apply failed", f"{theme_name}: {detail[:700]}"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            return result.returncode or 1
        return 0
    except Exception as exc:
        _write_apply_log(theme_name, error=str(exc))
        subprocess.run(
            ["notify-send", "-u", "critical", "Theme apply failed", f"{theme_name}: {str(exc)[:700]}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        return 1


def spawn_theme_apply(theme_name):
    """Publish a latest-selection token, then detach the validated apply worker."""
    os.makedirs(os.path.dirname(PICKER_REQUEST), exist_ok=True)
    request_token = f"{time.time_ns()}-{os.getpid()}"
    temp = PICKER_REQUEST + f".{os.getpid()}.tmp"
    with open(temp, "w", encoding="utf-8") as handle:
        handle.write(request_token + "\n")
    os.replace(temp, PICKER_REQUEST)

    script_path = os.path.abspath(__file__)
    subprocess.Popen(
        [sys.executable, script_path, "--apply-worker", theme_name, request_token],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        stdin=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
    )


def main():
    if len(sys.argv) >= 4 and sys.argv[1] == "--apply-worker":
        return apply_worker(sys.argv[2], sys.argv[3])

    # 1. If executed outside Rofi (from Sway keybind, terminal, or script), launch Rofi in script mode
    if "ROFI_RETV" not in os.environ:
        if not os.path.isfile(THEME_SET) or not os.access(THEME_SET, os.X_OK):
            print(f"Error: {THEME_SET} not found or not executable", file=sys.stderr)
            return 1

        script_path = os.path.abspath(__file__)
        rofi_cmd = [
            "rofi",
            "-show", "theme",
            "-modes", f"theme:{script_path}",
            "-theme", THEME_RASI,
            "-selected-row", "0",
            "-kb-remove-char-forward", "Delete",
            "-kb-custom-1", "Control+d,Control+Shift+D",
            "-kb-custom-2", "Control+r",
            "-kb-custom-3", "Control+i",
            "-sort",
            "-sorting-method", "fzf",
            "-matching", "fuzzy",
        ]
        os.execvp("rofi", rofi_cmd)

    # 2. Inside Rofi script mode: dispatch based on ROFI_RETV
    retv = os.environ.get("ROFI_RETV", "0")
    current = get_current_theme()
    pal = load_active_palette(current)

    # Initial invocation is cache-first. Existing compiled themes are a complete
    # immutable picker snapshot for this Rofi session, so source-tree freshness
    # checks and theme-sync never block menu visibility. Explicit imports/deletes
    # already synchronize their cache; Ctrl+R remains the deliberate manual refresh.
    if retv == "0":
        message = DEFAULT_HINT
        try:
            cache_exists = any(
                entry.is_file() and entry.name.endswith(".json")
                for entry in os.scandir(CACHE_DIR)
            )
        except OSError:
            cache_exists = False
        if not cache_exists:
            try:
                result = subprocess.run(
                    [THEME_SYNC],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    timeout=15,
                    check=False,
                )
                if result.returncode != 0:
                    detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
                    message = f"{status_span(pal, 'err')}Theme cache sync failed: {html.escape(detail)}</span>"
            except Exception as exc:
                message = f"{status_span(pal, 'err')}Theme cache sync failed: {html.escape(str(exc))}</span>"

        current = get_current_theme()
        pal = load_active_palette(current)
        output_mode_header(message, "")
        output_theme_rows(current)
        return 0

    # User pressed Enter: validate the selected cache ID, launch the existing
    # ordered theme-set transaction in a detached one-shot worker, then emit no
    # rows. Rofi therefore closes immediately instead of staying on-screen while
    # application IPC or first-use wallpaper work completes.
    if retv == "1":
        chosen_theme = os.environ.get("ROFI_INFO") or (sys.argv[1].split()[0] if len(sys.argv) > 1 else "")
        if not chosen_theme or not get_theme_cache_path(chosen_theme):
            msg = f"{status_span(pal, 'err')}Unknown theme '{html.escape(chosen_theme)}'</span>"
            output_mode_header(msg, "")
            output_theme_rows(current)
            return 0

        try:
            spawn_theme_apply(chosen_theme)
        except Exception as exc:
            msg = f"{status_span(pal, 'err')}Could not queue '{html.escape(chosen_theme)}': {html.escape(str(exc))}</span>"
            output_mode_header(msg, "")
            output_theme_rows(current)
            return 0

        return 0

    # User pressed Ctrl+D / Ctrl+Shift+D: Delete theme
    if retv == "10":
        target = os.environ.get("ROFI_INFO") or (sys.argv[1].split()[0] if len(sys.argv) > 1 else "")
        clean = target[8:] if target.startswith("omarchy-") else target

        # Active theme safety rule
        if clean == current or target == current:
            msg = f"{status_span(pal, 'err')}Cannot delete active theme '{clean}'! Switch themes first.</span>"
            output_mode_header(msg, "")
            output_theme_rows(current)
            return 0

        source_path, source_type = find_theme_source(clean)
        if source_path:
            try:
                os.remove(source_path)
                purge_cache(clean)
                remove_picker_index_entry(clean)
                remove_picker_index_entry(target)
                # Fire notification and background sync asynchronously so GUI repaints in <20ms
                subprocess.Popen(
                    ["notify-send", "Theme Engine", f"Deleted theme '{clean}' ({source_type})", "-i", "dialog-information"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    stdin=subprocess.DEVNULL,
                    start_new_session=True,
                    close_fds=True,
                )
                subprocess.Popen(
                    [THEME_SYNC],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    stdin=subprocess.DEVNULL,
                    start_new_session=True,
                    close_fds=True,
                )
                msg = f"{status_span(pal, 'ok')}Deleted '{clean}' ({source_type})</span>"
            except Exception as e:
                msg = f"{status_span(pal, 'err')}Error deleting '{clean}': {e}</span>"
        else:
            msg = f"{status_span(pal, 'err')}Theme '{clean}' not found in any source directory.</span>"

        output_mode_header(msg, "")
        output_theme_rows(current)
        return 0

    # User pressed Ctrl+R: Re-sync theme cache and report the real result.
    if retv == "11":
        try:
            result = subprocess.run(
                [THEME_SYNC],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=15,
                check=False,
            )
            current = get_current_theme()
            pal = load_active_palette(current)
            if result.returncode == 0:
                msg = f"{status_span(pal, 'info')}Themes synchronized and cache recompiled</span>"
            else:
                detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
                msg = f"{status_span(pal, 'err')}Theme sync failed: {html.escape(detail)}</span>"
        except Exception as exc:
            current = get_current_theme()
            pal = load_active_palette(current)
            msg = f"{status_span(pal, 'err')}Theme sync failed: {html.escape(str(exc))}</span>"
        output_mode_header(msg, "")
        output_theme_rows(current)
        return 0

    # User pressed Ctrl+I: Toggle preview HUD
    if retv == "12":
        target = os.environ.get("ROFI_INFO") or (sys.argv[1].split()[0] if len(sys.argv) > 1 else "")
        clean = target[8:] if target.startswith("omarchy-") else target
        if not clean:
            output_mode_header(DEFAULT_HINT, "")
            output_theme_rows(current)
            return 0

        prev_preview = os.environ.get("ROFI_DATA", "")
        if prev_preview == clean:
            # Toggled OFF for same theme
            msg = DEFAULT_HINT
            new_data = ""
        else:
            # Toggled ON or switched to newly selected theme
            msg = generate_preview_hud(clean, pal)
            new_data = clean

        output_mode_header(msg, new_data)
        output_theme_rows(current)
        return 0

    # Any other action: close rofi
    return 0


if __name__ == "__main__":
    sys.exit(main())
