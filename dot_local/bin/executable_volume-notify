#!/usr/bin/env bash
# ==============================================================================
# volume-notify: Ultra-fast volume adjustment with native Dunst OSD notification
# Optimized for zero-latency response on Bluetooth and internal speakers
# ==============================================================================
set -euo pipefail

# 1. Fast heal if default sink was captured by an isolated gaming or filter sink
DEF_SINK=$(pactl get-default-sink 2>/dev/null || echo "")
if [[ "$DEF_SINK" == "sink.peace_gaming" || "$DEF_SINK" =~ effect_input || -z "$DEF_SINK" ]]; then
    BT_SINK=$(pactl list short sinks 2>/dev/null | awk '$2 ~ /^bluez_output/ {print $2; exit}' || true)
    TARGET="${BT_SINK:-alsa_output.pci-0000_00_1f.3.analog-stereo}"
    pactl set-default-sink "$TARGET" 2>/dev/null || true
fi

# 2. Native PipeWire instant volume adjustment (capped at 100%)
case "${1:-status}" in
    up)
        wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
        ;;
    down)
        wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
        ;;
    mute)
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
        ;;
esac

# 3. Suppress OSD notification completely on Workspace 4 (Gaming workspace)
CURRENT_WS=""
if [[ -n "${SWAYSOCK:-}" ]] && command -v swaymsg >/dev/null 2>&1; then
    CURRENT_WS=$(swaymsg -t get_workspaces --raw 2>/dev/null | jq -r '.[] | select(.focused).name' 2>/dev/null || echo "")
fi

if [[ "$CURRENT_WS" == "4" ]]; then
    exit 0
fi

# 4. Instant volume & mute query in a single atomic call
VOL_INFO=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || echo "Volume: 0.00")
VOL=$(echo "$VOL_INFO" | awk '{print int($2 * 100)}')
VOL="${VOL:-0}"

MUTE="false"
[[ "$VOL_INFO" =~ \[MUTED\] ]] && MUTE="true"

# 5. Fast OSD notification with stack-tag to prevent queuing
TIMEOUT=600

if [[ "$MUTE" == "true" ]]; then
    dunstify -a "Volume" -t "$TIMEOUT" -u low -i audio-volume-muted \
        -h string:x-dunst-stack-tag:volume "Volume: Muted" 2>/dev/null || \
    notify-send -a "Volume" -t "$TIMEOUT" -u low -i audio-volume-muted \
        -h string:x-canonical-private-synchronous:volume \
        -h string:x-dunst-stack-tag:volume "Volume: Muted" 2>/dev/null || true
else
    dunstify -a "Volume" -t "$TIMEOUT" -u low -i audio-volume-high \
        -h string:x-dunst-stack-tag:volume \
        -h int:value:"$VOL" "Volume: ${VOL}%" 2>/dev/null || \
    notify-send -a "Volume" -t "$TIMEOUT" -u low -i audio-volume-high \
        -h string:x-canonical-private-synchronous:volume \
        -h string:x-dunst-stack-tag:volume \
        -h int:value:"$VOL" "Volume: ${VOL}%" 2>/dev/null || true
fi
