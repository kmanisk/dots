#!/usr/bin/env bash
# ==============================================================================
# rofi-websearch: Instant bang-based web search with live horizontal suggestions
# ==============================================================================
export PATH="$HOME/.local/bin:$PATH"

HINTS=$(cat <<'HINT_EOF'
!yt  YouTube
!aw  ArchWiki
!gh  GitHub
!w   Wikipedia
!rd  Reddit
!so  StackOverflow
!a   Amazon
!pdb ProtonDB
!ddg DuckDuckGo
!sdb SteamDB
!fg  FitGirl Repacks
!sr  SteamRIP
Google (Default)
HINT_EOF
)

# Fast suggestion fetcher via native public autocomplete endpoints (~30ms)
fetch_suggestions() {
    local eng="$1"
    local raw="$2"
    local enc
    enc=$(echo -n "$raw" | jq -sRr @uri)

    case "$eng" in
        youtube)
            curl -s --max-time 1.5 "https://suggestqueries.google.com/complete/search?client=firefox&ds=yt&q=${enc}" | jq -r '.[1][]?' 2>/dev/null | head -n 12
            ;;
        archwiki)
            curl -s --max-time 1.5 "https://wiki.archlinux.org/api.php?action=opensearch&format=json&search=${enc}" | jq -r '.[1][]?' 2>/dev/null | head -n 12
            ;;
        wikipedia)
            curl -s --max-time 1.5 "https://en.wikipedia.org/w/api.php?action=opensearch&format=json&search=${enc}" | jq -r '.[1][]?' 2>/dev/null | head -n 12
            ;;
        duckduckgo)
            curl -s --max-time 1.5 "https://duckduckgo.com/ac/?q=${enc}&type=list" | jq -r '.[1][]?' 2>/dev/null | head -n 12
            ;;
        *)
            curl -s --max-time 1.5 "https://suggestqueries.google.com/complete/search?client=chrome&q=${enc}" | jq -r '.[1][]?' 2>/dev/null | head -n 12
            ;;
    esac
}

THEME="$HOME/.config/rofi/tsoding.rasi"
for arg in "$@"; do
    case "$arg" in
        --floating|-f)
            THEME="$HOME/.config/rofi/websearch-floating.rasi"
            ;;
    esac
done

# 1. First prompt: user types query or selects an engine
QUERY=$(echo "$HINTS" | rofi -dmenu -i -p "Search" \
    -sort \
    -sorting-method "fzf" \
    -matching "fuzzy" \
    -kb-accept-entry "Control+m" \
    -kb-accept-custom "Return" \
    -kb-accept-alt "" \
    -kb-custom-1 "Control+Return" \
    -kb-custom-2 "Shift+Return" \
    -theme "$THEME")
EXIT_CODE=$?

# User hit Escape
[ $EXIT_CODE -eq 1 ] && exit 0
[ -z "$QUERY" ] && exit 0

WANT_SUGGESTIONS=0
if [ $EXIT_CODE -eq 10 ] || [ $EXIT_CODE -eq 11 ]; then
    WANT_SUGGESTIONS=1
fi

QUERY="$(echo "$QUERY" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

# Check for trailing '?' -> triggers suggestions
if [[ "$QUERY" =~ \?$ ]]; then
    WANT_SUGGESTIONS=1
    QUERY="${QUERY%\?}"
    QUERY="$(echo "$QUERY" | sed -e 's/[[:space:]]*$//')"
fi

[ -z "$QUERY" ] && exit 0

# Check for Direct URL
if [[ "$QUERY" =~ ^https?:// ]] || [[ "$QUERY" =~ ^www\. ]]; then
    [[ "$QUERY" =~ ^www\. ]] && QUERY="https://$QUERY"
    xdg-open "$QUERY" >/dev/null 2>&1 &
    swaymsg "workspace number 2" >/dev/null 2>&1 || i3-msg "workspace number 2" >/dev/null 2>&1 || true
    exit 0
fi

ENGINE=""
RAW_QUERY=""
NEED_PROMPT=0

# 1. Standalone engine selection (user selected chip or typed engine without query)
case "$QUERY" in
    *"YouTube"*|\!yt|yt:|yt|youtube|\!youtube)
        ENGINE="youtube"
        NEED_PROMPT=1
        ;;
    *"ArchWiki"*|\!aw|aw:|aw|arch|\!arch|archwiki|\!archwiki)
        ENGINE="archwiki"
        NEED_PROMPT=1
        ;;
    *"GitHub"*|\!gh|gh:|gh|git|\!git|github|\!github)
        ENGINE="github"
        NEED_PROMPT=1
        ;;
    *"Wikipedia"*|\!w|w:|w|wiki|\!wiki|wikipedia|\!wikipedia)
        ENGINE="wikipedia"
        NEED_PROMPT=1
        ;;
    *"Amazon"*|\!a|a:|a|amz:|amz|\!amz|amazon|\!amazon)
        ENGINE="amazon"
        NEED_PROMPT=1
        ;;
    *"Reddit"*|\!rd|rd:|rd|r/|\!r|r:|reddit|\!reddit)
        ENGINE="reddit"
        NEED_PROMPT=1
        ;;
    *"StackOverflow"*|\!so|so:|so|stackoverflow|\!stackoverflow)
        ENGINE="stackoverflow"
        NEED_PROMPT=1
        ;;
    *"ProtonDB"*|\!pdb|pdb:|pdb|proton|\!proton|protondb|\!protondb)
        ENGINE="protondb"
        NEED_PROMPT=1
        ;;
    *"DuckDuckGo"*|\!ddg|ddg:|ddg|duck|\!duck|duckduckgo|\!duckduckgo)
        ENGINE="duckduckgo"
        NEED_PROMPT=1
        ;;
    *"SteamDB"*|\!sdb|sdb:|sdb|steamdb|\!steamdb)
        ENGINE="steamdb"
        NEED_PROMPT=1
        ;;
    *"FitGirl"*|\!fg|fg:|fg|fitgirl|\!fitgirl|fitgirlrepacks|\!fitgirlrepacks)
        ENGINE="fitgirl"
        NEED_PROMPT=1
        ;;
    *"SteamRIP"*|\!sr|sr:|sr|steamrip|\!steamrip)
        ENGINE="steamrip"
        NEED_PROMPT=1
        ;;
    *"Google"*|\!g|g:|g|google|\!google)
        ENGINE="google"
        NEED_PROMPT=1
        ;;
esac

# 2. Engine prefix with query (user typed bang/prefix and search terms together in Prompt 1)
if [ -z "$ENGINE" ]; then
    case "$QUERY" in
        \!yt\ *|yt:\ *|yt\ *|youtube\ *|\!youtube\ *)
            ENGINE="youtube"
            RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!yt|yt:|yt|youtube|!youtube)[[:space:]]+//')"
            ;;
        \!aw\ *|aw:\ *|aw\ *|\!arch\ *|arch\ *|archwiki\ *|\!archwiki\ *)
            ENGINE="archwiki"
            RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!aw|aw:|aw|!arch|arch|archwiki|!archwiki)[[:space:]]+//')"
            ;;
        \!gh\ *|gh:\ *|gh\ *|git\ *|\!git\ *|github\ *|\!github\ *)
            ENGINE="github"
            RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!gh|gh:|gh|git|!git|github|!github)[[:space:]]+//')"
            ;;
        \!w\ *|w:\ *|w\ *|wiki\ *|\!wiki\ *|wikipedia\ *|\!wikipedia\ *)
            ENGINE="wikipedia"
            RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!w|w:|w|!wiki|wiki|wikipedia|!wikipedia)[[:space:]]+//')"
            ;;
        \!a\ *|a:\ *|a\ *|amz:\ *|amz\ *|\!amz\ *|amazon\ *|\!amazon\ *)
            ENGINE="amazon"
            RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!a|a:|a|amz:|amz|!amz|amazon|!amazon)[[:space:]]+//')"
            ;;
        \!rd\ *|rd:\ *|rd\ *|r/\ *|\!r\ *|r:\ *|reddit\ *|\!reddit\ *)
            ENGINE="reddit"
            RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!rd|rd:|rd|r\/|!r|r:|reddit|!reddit)[[:space:]]+//')"
            ;;
        \!ddg\ *|ddg:\ *|ddg\ *|duck\ *|\!duck\ *|duckduckgo\ *|\!duckduckgo\ *)
            ENGINE="duckduckgo"
            RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!ddg|ddg:|ddg|duck|!duck|duckduckgo|!duckduckgo)[[:space:]]+//')"
            ;;
        \!sdb\ *|sdb:\ *|sdb\ *|steamdb\ *|\!steamdb\ *)
            ENGINE="steamdb"
            RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!sdb|sdb:|sdb|steamdb|!steamdb)[[:space:]]+//')"
            ;;
        \!fg\ *|fg:\ *|fg\ *|fitgirl\ *|\!fitgirl\ *|fitgirlrepacks\ *|\!fitgirlrepacks\ *)
            ENGINE="fitgirl"
            RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!fg|fg:|fg|fitgirl|!fitgirl|fitgirlrepacks|!fitgirlrepacks)[[:space:]]+//')"
            ;;
        \!sr\ *|sr:\ *|sr\ *|steamrip\ *|\!steamrip\ *)
            ENGINE="steamrip"
            RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!sr|sr:|sr|steamrip|!steamrip)[[:space:]]+//')"
            ;;
        \!so\ *|so:\ *|so\ *|stackoverflow\ *|\!stackoverflow\ *)
            ENGINE="stackoverflow"
            RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!so|so:|so|stackoverflow|!stackoverflow)[[:space:]]+//')"
            ;;
        \!pdb\ *|pdb:\ *|pdb\ *|proton\ *|\!proton\ *|protondb\ *|\!protondb\ *)
            ENGINE="protondb"
            RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!pdb|pdb:|pdb|proton|!proton|protondb|!protondb)[[:space:]]+//')"
            ;;
        \!g\ *|g:\ *|g\ *|google\ *|\!google\ *)
            ENGINE="google"
            RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!g|g:|g|google|!google)[[:space:]]+//')"
            ;;
        *)
            ENGINE="google"
            RAW_QUERY="$QUERY"
            ;;
    esac
fi

# 3. If only engine was selected, prompt for the query
if [ "$NEED_PROMPT" -eq 1 ]; then
    PROMPT_TITLE="Search"
    case "$ENGINE" in
        youtube)       PROMPT_TITLE="YouTube" ;;
        archwiki)      PROMPT_TITLE="ArchWiki" ;;
        github)        PROMPT_TITLE="GitHub" ;;
        wikipedia)     PROMPT_TITLE="Wikipedia" ;;
        amazon)        PROMPT_TITLE="Amazon" ;;
        reddit)        PROMPT_TITLE="Reddit" ;;
        stackoverflow) PROMPT_TITLE="StackOverflow" ;;
        protondb)      PROMPT_TITLE="ProtonDB" ;;
        duckduckgo)    PROMPT_TITLE="DuckDuckGo" ;;
        steamdb)       PROMPT_TITLE="SteamDB" ;;
        fitgirl)       PROMPT_TITLE="FitGirl" ;;
        steamrip)      PROMPT_TITLE="SteamRIP" ;;
        google)        PROMPT_TITLE="Google" ;;
    esac

    QUERY=$(rofi -dmenu -i -p "$PROMPT_TITLE" \
        -kb-accept-entry "" \
        -kb-accept-custom "Return" \
        -kb-accept-alt "" \
        -kb-custom-1 "Control+Return" \
        -kb-custom-2 "Shift+Return" \
        -theme "$THEME" < /dev/null)
    PROMPT2_EXIT=$?
    [ $PROMPT2_EXIT -eq 1 ] && exit 0
    [ -z "$QUERY" ] && exit 0

    if [ $PROMPT2_EXIT -eq 10 ] || [ $PROMPT2_EXIT -eq 11 ]; then
        WANT_SUGGESTIONS=1
    fi

    RAW_QUERY="$(echo "$QUERY" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

    if [[ "$RAW_QUERY" =~ \?$ ]]; then
        WANT_SUGGESTIONS=1
        RAW_QUERY="${RAW_QUERY%\?}"
        RAW_QUERY="$(echo "$RAW_QUERY" | sed -e 's/[[:space:]]*$//')"
    fi

    [ -z "$RAW_QUERY" ] && exit 0
fi

# If user requested suggestions (via '?' or Ctrl+Return):
if [ "$WANT_SUGGESTIONS" -eq 1 ]; then
    SUGGESTIONS=$(fetch_suggestions "$ENGINE" "$RAW_QUERY")
    if [ -n "$SUGGESTIONS" ]; then
        CHOICE=$(printf "%s\n%s" "$RAW_QUERY" "$SUGGESTIONS" | rofi -dmenu -i \
            -sort \
            -sorting-method "fzf" \
            -matching "fuzzy" \
            -p "$ENGINE" \
            -theme "$THEME")
        if [ -n "$CHOICE" ]; then
            RAW_QUERY="$CHOICE"
        else
            exit 0
        fi
    fi
fi

# URL encode query via jq
ENCODED_QUERY=$(echo -n "$RAW_QUERY" | jq -sRr @uri)

# Build target URL
case "$ENGINE" in
    youtube)
        URL="https://www.youtube.com/results?search_query=${ENCODED_QUERY}"
        ;;
    archwiki)
        URL="https://wiki.archlinux.org/index.php?search=${ENCODED_QUERY}"
        ;;
    github)
        URL="https://github.com/search?q=${ENCODED_QUERY}"
        ;;
    wikipedia)
        URL="https://en.wikipedia.org/wiki/Special:Search?search=${ENCODED_QUERY}"
        ;;
    amazon)
        URL="https://www.amazon.com/s?k=${ENCODED_QUERY}"
        ;;
    reddit)
        URL="https://www.reddit.com/search/?q=${ENCODED_QUERY}"
        ;;
    duckduckgo)
        URL="https://duckduckgo.com/?q=${ENCODED_QUERY}"
        ;;
    steamdb)
        URL="https://steamdb.info/search/?a=all&q=${ENCODED_QUERY}"
        ;;
    fitgirl)
        URL="https://fitgirl-repacks.site/?s=${ENCODED_QUERY}"
        ;;
    steamrip)
        URL="https://steamrip.com/?s=${ENCODED_QUERY}"
        ;;
    stackoverflow)
        URL="https://stackoverflow.com/search?q=${ENCODED_QUERY}"
        ;;
    protondb)
        URL="https://www.protondb.com/search?q=${ENCODED_QUERY}"
        ;;
    google|*)
        URL="https://www.google.com/search?q=${ENCODED_QUERY}"
        ;;
esac

# Launch in browser and jump to workspace 2
xdg-open "$URL" >/dev/null 2>&1 &
swaymsg "workspace number 2" >/dev/null 2>&1 || i3-msg "workspace number 2" >/dev/null 2>&1 || true
