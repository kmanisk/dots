#!/usr/bin/env bash
# ==============================================================================
# rofi-websearch: Instant bang-based web search with live horizontal suggestions
# ==============================================================================
export PATH="$HOME/.local/bin:$PATH"

HINTS=$(cat <<'HINT_EOF'
!yt  YouTube
!aw  ArchWiki
!gh  GitHub
!w   Wikipedia
!rd  Reddit
!so  StackOverflow
!a   Amazon
!pdb ProtonDB
!ddg DuckDuckGo
!sdb SteamDB
Google (Default)
HINT_EOF
)

# Fast suggestion fetcher via native public autocomplete endpoints (~30ms)
fetch_suggestions() {
    local eng="$1"
    local raw="$2"
    local enc
    enc=$(echo -n "$raw" | jq -sRr @uri)

    case "$eng" in
        youtube)
            curl -s --max-time 1.5 "https://suggestqueries.google.com/complete/search?client=firefox&ds=yt&q=${enc}" | jq -r '.[1][]?' 2>/dev/null | head -n 12
            ;;
        archwiki)
            curl -s --max-time 1.5 "https://wiki.archlinux.org/api.php?action=opensearch&format=json&search=${enc}" | jq -r '.[1][]?' 2>/dev/null | head -n 12
            ;;
        wikipedia)
            curl -s --max-time 1.5 "https://en.wikipedia.org/w/api.php?action=opensearch&format=json&search=${enc}" | jq -r '.[1][]?' 2>/dev/null | head -n 12
            ;;
        duckduckgo)
            curl -s --max-time 1.5 "https://duckduckgo.com/ac/?q=${enc}&type=list" | jq -r '.[1][]?' 2>/dev/null | head -n 12
            ;;
        *)
            curl -s --max-time 1.5 "https://suggestqueries.google.com/complete/search?client=chrome&q=${enc}" | jq -r '.[1][]?' 2>/dev/null | head -n 12
            ;;
    esac
}

THEME="$HOME/.config/rofi/tsoding.rasi"
for arg in "$@"; do
    case "$arg" in
        --floating|-f)
            THEME="$HOME/.config/rofi/websearch-floating.rasi"
            ;;
    esac
done

# 1. First prompt: user types query
# Control+Return (custom-1) triggers suggestions; Enter triggers instant search
QUERY=$(echo "$HINTS" | rofi -dmenu -i -p "Search" \
    -sort \
    -sorting-method "fzf" \
    -matching "fuzzy" \
    -kb-accept-custom "" \
    -kb-accept-alt "" \
    -kb-custom-1 "Control+Return" \
    -kb-custom-2 "Shift+Return" \
    -theme "$THEME")
EXIT_CODE=$?

# User hit Escape
[ $EXIT_CODE -eq 1 ] && exit 0
[ -z "$QUERY" ] && exit 0

WANT_SUGGESTIONS=0
if [ $EXIT_CODE -eq 10 ] || [ $EXIT_CODE -eq 11 ]; then
    WANT_SUGGESTIONS=1
fi

# If user clicked/selected a hint line without typing a query, prompt with that engine prefix
case "$QUERY" in
    *"YouTube"*|*"!yt"*)        PREFIX="!yt " ;;
    *"ArchWiki"*|*"!aw"*)       PREFIX="!aw " ;;
    *"GitHub"*|*"!gh"*)         PREFIX="!gh " ;;
    *"Wikipedia"*|*"!w "*)      PREFIX="!w " ;;
    *"Amazon"*|*"!a "*)         PREFIX="!a " ;;
    *"Reddit"*|*"!rd"*)         PREFIX="!rd " ;;
    *"StackOverflow"*|*"!so"*)  PREFIX="!so " ;;
    *"ProtonDB"*|*"!pdb"*)      PREFIX="!pdb " ;;
    *"DuckDuckGo"*|*"!ddg"*)    PREFIX="!ddg " ;;
    *"SteamDB"*|*"!sdb"*)       PREFIX="!sdb " ;;
    *"Google"*)                 PREFIX="" ;;
    *)                          PREFIX="" ;;
esac

if [ -n "$PREFIX" ]; then
    QUERY=$(rofi -dmenu -i -p "Enter query" -filter "$PREFIX" \
        -sort \
        -sorting-method "fzf" \
        -matching "fuzzy" \
        -kb-accept-custom "" \
        -kb-accept-alt "" \
        -kb-custom-1 "Control+Return" \
        -kb-custom-2 "Shift+Return" \
        -theme "$THEME")
    PREFIX_EXIT_CODE=$?
    [ $PREFIX_EXIT_CODE -eq 1 ] && exit 0
    [ -z "$QUERY" ] && exit 0
    if [ $PREFIX_EXIT_CODE -eq 10 ] || [ $PREFIX_EXIT_CODE -eq 11 ]; then
        WANT_SUGGESTIONS=1
    fi
fi

# Trim whitespace
QUERY="$(echo "$QUERY" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

# Check for trailing '?' -> triggers suggestions
if [[ "$QUERY" =~ \?$ ]]; then
    WANT_SUGGESTIONS=1
    QUERY="${QUERY%\?}"
    QUERY="$(echo "$QUERY" | sed -e 's/[[:space:]]*$//')"
fi

# Check for Direct URL
if [[ "$QUERY" =~ ^https?:// ]] || [[ "$QUERY" =~ ^www\. ]]; then
    [[ "$QUERY" =~ ^www\. ]] && QUERY="https://$QUERY"
    xdg-open "$QUERY" >/dev/null 2>&1 &
    i3-msg "workspace number 2" >/dev/null 2>&1 || true
    exit 0
fi

# Parse engine and strip bang/prefix
ENGINE="google"
RAW_QUERY=""

case "$QUERY" in
    \!yt\ *|yt:\ *|yt\ *|youtube\ *)
        ENGINE="youtube"
        RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!yt|yt:|yt|youtube)[[:space:]]+//')"
        ;;
    \!aw\ *|aw:\ *|aw\ *|arch\ *|\!arch\ *)
        ENGINE="archwiki"
        RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!aw|aw:|aw|!arch|arch)[[:space:]]+//')"
        ;;
    \!gh\ *|gh:\ *|gh\ *|git\ *|github\ *)
        ENGINE="github"
        RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!gh|gh:|gh|git|github)[[:space:]]+//')"
        ;;
    \!w\ *|w:\ *|w\ *|wiki\ *|\!wiki\ *)
        ENGINE="wikipedia"
        RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!w|w:|w|!wiki|wiki)[[:space:]]+//')"
        ;;
    \!a\ *|a:\ *|a\ *|amz:\ *|amz\ *|amazon\ *|\!amz\ *)
        ENGINE="amazon"
        RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!a|a:|a|amz:|amz|!amz|amazon)[[:space:]]+//')"
        ;;
    \!rd\ *|rd:\ *|rd\ *|r/\ *|\!r\ *|r:\ *|reddit\ *)
        ENGINE="reddit"
        RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!rd|rd:|rd|r\/|!r|r:|reddit)[[:space:]]+//')"
        ;;
    \!ddg\ *|ddg:\ *|ddg\ *|duck\ *)
        ENGINE="duckduckgo"
        RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!ddg|ddg:|ddg|duck)[[:space:]]+//')"
        ;;
    \!sdb\ *|sdb:\ *|sdb\ *|steamdb\ *)
        ENGINE="steamdb"
        RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!sdb|sdb:|sdb|steamdb)[[:space:]]+//')"
        ;;
    \!so\ *|so:\ *|so\ *|stackoverflow\ *)
        ENGINE="stackoverflow"
        RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!so|so:|so|stackoverflow)[[:space:]]+//')"
        ;;
    \!pdb\ *|pdb:\ *|pdb\ *|proton\ *|protondb\ *)
        ENGINE="protondb"
        RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!pdb|pdb:|pdb|proton|protondb)[[:space:]]+//')"
        ;;
    \!g\ *|g:\ *|g\ *|google\ *)
        ENGINE="google"
        RAW_QUERY="$(echo "$QUERY" | sed -E 's/^(!g|g:|g|google)[[:space:]]+//')"
        ;;
    *)
        ENGINE="google"
        RAW_QUERY="$QUERY"
        ;;
esac

[ -z "$RAW_QUERY" ] && exit 0

# If user requested suggestions (via '?' or Ctrl+Return):
if [ "$WANT_SUGGESTIONS" -eq 1 ]; then
    SUGGESTIONS=$(fetch_suggestions "$ENGINE" "$RAW_QUERY")
    if [ -n "$SUGGESTIONS" ]; then
        # Present suggestions as horizontal chips right next to prompt
        CHOICE=$(printf "%s\n%s" "$RAW_QUERY" "$SUGGESTIONS" | rofi -dmenu -i \
            -sort \
            -sorting-method "fzf" \
            -matching "fuzzy" \
            -p "💡 $ENGINE" \
            -theme "$THEME")
        if [ -n "$CHOICE" ]; then
            RAW_QUERY="$CHOICE"
        else
            exit 0
        fi
    fi
fi

# URL encode query via jq
ENCODED_QUERY=$(echo -n "$RAW_QUERY" | jq -sRr @uri)

# Build target URL
case "$ENGINE" in
    youtube)
        URL="https://www.youtube.com/results?search_query=${ENCODED_QUERY}"
        ;;
    archwiki)
        URL="https://wiki.archlinux.org/index.php?search=${ENCODED_QUERY}"
        ;;
    github)
        URL="https://github.com/search?q=${ENCODED_QUERY}"
        ;;
    wikipedia)
        URL="https://en.wikipedia.org/wiki/Special:Search?search=${ENCODED_QUERY}"
        ;;
    amazon)
        URL="https://www.amazon.com/s?k=${ENCODED_QUERY}"
        ;;
    reddit)
        URL="https://www.reddit.com/search/?q=${ENCODED_QUERY}"
        ;;
    duckduckgo)
        URL="https://duckduckgo.com/?q=${ENCODED_QUERY}"
        ;;
    steamdb)
        URL="https://steamdb.info/search/?a=all&q=${ENCODED_QUERY}"
        ;;
    stackoverflow)
        URL="https://stackoverflow.com/search?q=${ENCODED_QUERY}"
        ;;
    protondb)
        URL="https://www.protondb.com/search?q=${ENCODED_QUERY}"
        ;;
    google|*)
        URL="https://www.google.com/search?q=${ENCODED_QUERY}"
        ;;
esac

# Launch in browser and jump to workspace 2
xdg-open "$URL" >/dev/null 2>&1 &
i3-msg "workspace number 2" >/dev/null 2>&1 || true
