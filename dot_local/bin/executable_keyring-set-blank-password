#!/usr/bin/env python3
import sys
import os
import getpass
import dbus

def main():
    print("=" * 60)
    print("GNOME Keyring: Convert to Permanent Blank Password")
    print("=" * 60)
    print("This utility changes your login keyring password to empty/blank.")
    print("Under passwordless autologin, this allows the keyring to")
    print("automatically decrypt and unlock at boot without prompting.\n")

    if not sys.stdin.isatty():
        print("ERROR: This command must be run in an interactive terminal.")
        sys.exit(1)

    try:
        bus = dbus.SessionBus()
        service = bus.get_object("org.freedesktop.secrets", "/org/freedesktop/secrets")
        login_col = bus.get_object("org.freedesktop.secrets", "/org/freedesktop/secrets/collection/login")
        session_path = service.OpenSession("plain", "", dbus_interface="org.freedesktop.Secret.Service")[1]
    except Exception as e:
        print(f"Error connecting to Secret Service D-Bus: {e}")
        input("\nPress Enter to exit...")
        sys.exit(1)

    max_attempts = 3
    for attempt in range(1, max_attempts + 1):
        try:
            current_pw = getpass.getpass(f"Enter current login keyring password [{attempt}/{max_attempts}]: ")
            if not current_pw:
                print("Password cannot be blank. Enter your current user/keyring password.")
                continue

            orig_secret = dbus.Struct(
                (session_path, dbus.ByteArray(b""), dbus.ByteArray(current_pw.encode("utf-8")), "text/plain"),
                signature="oayays"
            )
            new_secret = dbus.Struct(
                (session_path, dbus.ByteArray(b""), dbus.ByteArray(b""), "text/plain"),
                signature="oayays"
            )

            service.ChangeWithMasterPassword(
                login_col,
                orig_secret,
                new_secret,
                dbus_interface="org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface"
            )

            # Ensure collection is unlocked
            locked = login_col.Get("org.freedesktop.Secret.Collection", "Locked", dbus_interface="org.freedesktop.DBus.Properties")
            if locked != 0:
                service.UnlockWithMasterPassword(
                    login_col,
                    new_secret,
                    dbus_interface="org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface"
                )

            print("\n" + "=" * 60)
            print("SUCCESS: Login keyring password changed to blank!")
            print("The keyring is now UNLOCKED and will auto-unlock at boot forever.")
            print("=" * 60)
            input("\nPress Enter to finish and close...")
            sys.exit(0)

        except dbus.exceptions.DBusException as de:
            if "Denied" in str(de) or "invalid" in str(de).lower():
                print("Incorrect password. Please try again.")
            else:
                print(f"D-Bus Error: {de}")
        except (KeyboardInterrupt, EOFError):
            print("\nAborted.")
            sys.exit(130)

    print("\nExceeded maximum attempts. Keyring remains locked.")
    input("Press Enter to exit...")
    sys.exit(1)

if __name__ == "__main__":
    main()
