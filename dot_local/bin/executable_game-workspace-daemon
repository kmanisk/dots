#!/usr/bin/env python3
"""
game-workspace-daemon:
Event-driven Sway IPC daemon to guarantee:
- Workspace 2: Browsers (Brave, Firefox, etc.) and Video players (mpv, vlc)
- Workspace 4: Games & Game Launchers (Steam games, CS2, Elden Ring, GTA IV, Rockstar)
- Picture-in-Picture: Floats freely on the active workspace without eviction
Pure Python, zero external dependencies, direct UNIX socket IPC over $SWAYSOCK.
"""
import os
import sys
import socket
import struct
import json
import re
import fcntl
import time

LOCK_FILE = "/tmp/game-workspace-daemon.lock"
LOG_FILE = "/tmp/game-workspace-daemon.log"

def log(msg):
    try:
        t = time.strftime("%H:%M:%S")
        with open(LOG_FILE, "a") as f:
            f.write(f"{t} {msg}\n")
    except Exception:
        pass

def create_ipc_socket():
    sock_path = os.environ.get("SWAYSOCK")
    if not sock_path:
        # Fallback to sway socket if environment missing
        uid = os.getuid()
        for candidate in [f"/run/user/{uid}/sway-ipc.{uid}.sock"]:
            if os.path.exists(candidate):
                sock_path = candidate
                break
    if not sock_path or not os.path.exists(sock_path):
        raise RuntimeError(f"Sway IPC socket not found: {sock_path}")
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(sock_path)
    return s

def send_ipc(sock, msg_type, payload_str):
    payload = payload_str.encode("utf-8")
    header = b"i3-ipc" + struct.pack("<II", len(payload), msg_type)
    sock.sendall(header + payload)

def recv_ipc(sock):
    magic = sock.recv(6)
    if not magic or magic != b"i3-ipc":
        return None, None
    raw_header = sock.recv(8)
    if len(raw_header) < 8:
        return None, None
    length, msg_type = struct.unpack("<II", raw_header)
    data = b""
    while len(data) < length:
        chunk = sock.recv(min(length - len(data), 65536))
        if not chunk:
            break
        data += chunk
    return msg_type, json.loads(data.decode("utf-8"))

def ipc_cmd(sock, cmd):
    send_ipc(sock, 0, cmd)
    return recv_ipc(sock)

def get_tree(sock):
    send_ipc(sock, 4, "")
    _, tree = recv_ipc(sock)
    return tree

def find_window_workspace(tree, con_id):
    def search(node, current_ws):
        if node.get("type") == "workspace":
            current_ws = node.get("name")
        if node.get("id") == con_id:
            return current_ws
        for child in node.get("nodes", []) + node.get("floating_nodes", []):
            res = search(child, current_ws)
            if res is not None:
                return res
        return None
    return search(tree, None)

BROWSER_RE = re.compile(r"\b(brave|brave-browser|brave-origin|firefox|librewolf|zen-alpha|qutebrowser)\b", re.I)
VIDEO_RE = re.compile(r"\b(mpv|vlc)\b", re.I)
PIP_RE = re.compile(r"picture[- ]in[- ]picture", re.I)
GAME_RE = re.compile(r"steam_app_|gamescope|cs2|eldenring|dyinglight|farcry|gtaiv|hll|hellletloose|launcher\.exe|socialclubhelper\.exe|playgtaiv", re.I)
GAME_TITLE_RE = re.compile(r"^(rockstar games.*|grand theft auto iv|gtaiv)$", re.I)

def route_container(cmd_sock, con, tree=None):
    cid = con.get("id")
    if not cid:
        return
    app_id = con.get("app_id") or ""
    props = con.get("window_properties") or {}
    class_name = props.get("class") or ""
    instance = props.get("instance") or ""
    title = con.get("name") or ""

    ident = f"{app_id} {class_name} {instance}"

    # Bypass: Picture-in-Picture video popups float on current workspace
    if PIP_RE.search(title):
        return

    # Backstop 1: Browsers to Workspace 2
    if BROWSER_RE.search(ident):
        if tree is None:
            tree = get_tree(cmd_sock)
        cur_ws = find_window_workspace(tree, cid)
        if cur_ws and cur_ws != "2":
            log(f"ROUTE BROWSER con_id={cid} ({ident}) from ws {cur_ws} -> ws2")
            ipc_cmd(cmd_sock, f"[con_id={cid}] move to workspace number 2")
        return

    # Backstop 2: Video players to Workspace 2
    if VIDEO_RE.search(ident):
        if tree is None:
            tree = get_tree(cmd_sock)
        cur_ws = find_window_workspace(tree, cid)
        if cur_ws and cur_ws != "2":
            log(f"ROUTE VIDEO con_id={cid} ({ident}) from ws {cur_ws} -> ws2")
            ipc_cmd(cmd_sock, f"[con_id={cid}] move to workspace number 2, focus")
        return

    # Backstop 3: Games to Workspace 4
    if not BROWSER_RE.search(ident) and not VIDEO_RE.search(ident):
        if GAME_RE.search(ident) or GAME_TITLE_RE.search(title):
            if tree is None:
                tree = get_tree(cmd_sock)
            cur_ws = find_window_workspace(tree, cid)
            if cur_ws and cur_ws != "4":
                log(f"ROUTE GAME con_id={cid} ({ident}) from ws {cur_ws} -> ws4")
                ipc_cmd(cmd_sock, f"[con_id={cid}] move to workspace number 4")
            return

def scan_tree_and_route(cmd_sock):
    tree = get_tree(cmd_sock)
    def traverse(node):
        if node.get("type") in ("con", "floating_con") and node.get("pid"):
            route_container(cmd_sock, node, tree)
        for child in node.get("nodes", []) + node.get("floating_nodes", []):
            traverse(child)
    traverse(tree)

def main():
    lock_fd = open(LOCK_FILE, "w")
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except IOError:
        sys.exit(0)

    log(f"daemon started pid={os.getpid()}")

    cmd_sock = create_ipc_socket()
    sub_sock = create_ipc_socket()

    # Initial sweep of all current windows
    try:
        scan_tree_and_route(cmd_sock)
    except Exception as e:
        log(f"Initial sweep error: {e}")

    # Subscribe to window events
    send_ipc(sub_sock, 2, json.dumps(["window"]))
    _, sub_res = recv_ipc(sub_sock)
    if not sub_res or not sub_res.get("success"):
        log("Failed to subscribe to window events")
        sys.exit(1)

    while True:
        try:
            msg_type, event = recv_ipc(sub_sock)
            if event is None:
                break
            change = event.get("change")
            if change in ("new", "title", "focus"):
                con = event.get("container")
                if con:
                    route_container(cmd_sock, con)
        except Exception as e:
            log(f"Event loop exception: {e}")
            time.sleep(1)

if __name__ == "__main__":
    main()
