#!/usr/bin/env bash
# ==============================================================================
# screenshot-preview: Live preview renderer for screenshot-picker
# Renders high-res image previews in terminal via chafa with dimensions & size.
# ==============================================================================
set -euo pipefail

FILE="${1:-}"
[ -z "$FILE" ] && exit 0
[ -f "$FILE" ] || exit 0
[ -s "$FILE" ] || exit 0

export PATH="$HOME/.local/bin:/usr/bin:/bin:$PATH"

dim=$(identify -format "%wx%h, %m, %b" "$FILE" 2>/dev/null || echo "Image")
fname=$(basename "$FILE")

printf "\033[1;36m[Screenshot Preview]\033[0m \033[1;32m%s\033[0m \033[1;30m│\033[0m \033[1;33m%s\033[0m\n\n" \
    "$dim" "$fname"

cols="${FZF_PREVIEW_COLUMNS:-80}"
lines="${FZF_PREVIEW_LINES:-30}"
max_h=$((lines > 4 ? lines - 4 : 15))

chafa --size="${cols}x${max_h}" "$FILE" 2>/dev/null || true
