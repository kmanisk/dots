#!/usr/bin/env python3
"""
theme-ls: Fast command-line theme lister for the unified Theme Engine.
Lists all compiled Schema 1 canonical themes. Ideal for shell piping and fzf.

Usage:
  theme-ls [--long | -l] [--active] [--provider <provider>]
"""
import argparse
import glob
import json
import os
import sys

CACHE_DIR = os.path.expanduser("~/.cache/theme/themes")


def get_current_theme():
    name_file = os.path.expanduser("~/.local/state/theme/name")
    if os.path.exists(name_file):
        try:
            with open(name_file, "r") as f:
                return f.read().strip()
        except Exception:
            pass
    return "gruvchad"


def main():
    parser = argparse.ArgumentParser(description="List available themes in the Theme Engine.")
    parser.add_argument("-l", "--long", action="store_true", help="Display detailed table format")
    parser.add_argument("-a", "--active", action="store_true", help="Print only the currently active theme")
    parser.add_argument("-p", "--provider", type=str, help="Filter by provider (base46, omarchy, custom)")
    args = parser.parse_args()

    current = get_current_theme()

    if args.active:
        print(current)
        return 0

    theme_files = sorted(glob.glob(os.path.join(CACHE_DIR, "*.json")))
    if not theme_files:
        # Fallback to sync if cache empty
        subprocess.run([os.path.expanduser("~/.local/bin/theme-sync")], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        theme_files = sorted(glob.glob(os.path.join(CACHE_DIR, "*.json")))

    if not args.long:
        # Standard unix output: one theme name per line
        for tf in theme_files:
            t_name = os.path.splitext(os.path.basename(tf))[0]
            if args.provider:
                try:
                    with open(tf, "r", encoding="utf-8") as jf:
                        d = json.load(jf)
                    prov = d.get("source", {}).get("provider", "unknown")
                    if prov.lower() != args.provider.lower():
                        continue
                except Exception:
                    continue
            print(t_name)
        return 0

    # Long format (-l)
    print(f"{'THEME':<28} {'PROVIDER':<14} {'TYPE':<8} {'STATUS'}")
    print(f"{'-'*28} {'-'*14} {'-'*8} {'-'*8}")

    for tf in theme_files:
        t_name = os.path.splitext(os.path.basename(tf))[0]
        prov = "unknown"
        t_type = "dark"
        try:
            with open(tf, "r", encoding="utf-8") as jf:
                d = json.load(jf)
            prov = d.get("source", {}).get("provider", "unknown")
            t_type = d.get("type", "dark")
        except Exception:
            pass

        if args.provider and prov.lower() != args.provider.lower():
            continue

        status = "\033[1;32m[ACTIVE]\033[0m" if t_name == current else ""
        print(f"{t_name:<28} {prov:<14} {t_type:<8} {status}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
