#!/usr/bin/env python3
"""
theme-doctor: Single comprehensive health audit for CachyOS theming system & display CTM.
Audits:
  - Theme Engine, Schema 1 & Source Breakdown
  - Validation (WCAG AA & completeness across all 288 themes)
  - Subsystems (Cache, Manifest, Templates, App configs, Hooks)
  - Hardware CTM (Intel CRTC 151, eDP-1, saturation, vkBasalt status)
"""
import os
import sys
import json
import glob
import subprocess
import re

sys.path.insert(0, os.path.expanduser("~/.local/lib"))
from theme_engine.schema import contrast_ratio, BASE16_KEYS, HEX_RE, clean_hex

def colored(text, color):
    codes = {
        "green": "\033[1;32m",
        "yellow": "\033[1;33m",
        "red": "\033[1;31m",
        "cyan": "\033[1;36m",
        "bold": "\033[1m",
        "dim": "\033[2m",
        "reset": "\033[0m",
    }
    return f"{codes.get(color, '')}{text}{codes['reset']}"

def run_cmd(cmd):
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=3)
        return res.stdout.strip()
    except Exception:
        return ""

def main():
    print(colored("\nTheme Engine & Display Doctor", "bold"))
    print(colored("═" * 40, "dim"))

    # 1. Themes & Catalog Breakdown
    custom_dir = os.path.expanduser("~/.config/theme/custom")
    imported_dir = os.path.expanduser("~/.config/theme/imported/omarchy")
    base46_dir = os.path.expanduser("~/.config/theme/base46/lua/base46/themes")
    cache_dir = os.path.expanduser("~/.cache/theme/themes")

    custom_count = len(glob.glob(os.path.join(custom_dir, "*.json")))
    imported_count = len(glob.glob(os.path.join(imported_dir, "*.json")))
    base46_count = len(glob.glob(os.path.join(base46_dir, "*.lua")))
    cached_files = glob.glob(os.path.join(cache_dir, "*.json"))
    total_count = len(cached_files)

    print(colored("Theme Sources", "cyan"))
    print(f"  Schema:                 {colored('1', 'green')}")
    print(f"  Omarchy imported:       {colored(str(imported_count), 'bold')} (official catalog)")
    print(f"  Base46 (NvChad):        {colored(str(base46_count), 'bold')} (core lua)")
    print(f"  Custom themes:          {colored(str(custom_count), 'bold')}")
    print(colored("  ──────────────────────────────", "dim"))
    print(f"  Total compiled:         {colored(str(total_count), 'bold')}")

    # 2. Validation Audit across all themes
    passed = 0
    warned = 0
    failed = 0
    warnings_list = []

    for f in cached_files:
        fname = os.path.basename(f)
        try:
            with open(f, "r", encoding="utf-8") as jf:
                data = json.load(jf)
        except Exception as e:
            failed += 1
            continue

        b16 = data.get("base_16") or data.get("palette", {}).get("base_16", {})
        err = False
        for k in BASE16_KEYS:
            if k not in b16 or not HEX_RE.match(str(b16[k])):
                err = True
                break

        if err:
            failed += 1
            continue

        bg = b16.get("BASE00")
        fg = b16.get("BASE05")
        if bg and fg and HEX_RE.match(str(bg)) and HEX_RE.match(str(fg)):
            cr = contrast_ratio(clean_hex(bg), clean_hex(fg))
            if cr < 4.5:
                warned += 1
                warnings_list.append(f"{fname} ({cr:.2f}:1)")
                continue

        passed += 1

    print(colored("\nTheme Validation (Schema 1 & WCAG AA)", "cyan"))
    print(f"  Valid:                  {colored(str(passed), 'green')}")
    print(f"  Warnings:               {colored(str(warned), 'yellow' if warned else 'green')}" + (f" ({', '.join(warnings_list)})" if warnings_list else ""))
    print(f"  Failed:                 {colored(str(failed), 'red' if failed else 'green')}")

    # 3. Subsystems & Applications
    print(colored("\nSubsystems & Applications", "cyan"))
    manifest_path = os.path.expanduser("~/.cache/theme/manifest.json")
    manifest_ok = os.path.exists(manifest_path) and os.path.getsize(manifest_path) > 100
    cache_ok = total_count >= 200

    def status_label(ok, note=""):
        if ok:
            return colored("OK", "green") + (f" {note}" if note else "")
        return colored("MISSING", "red") + (f" {note}" if note else "")

    print(f"  Cache:                  {status_label(cache_ok, f'({total_count} JSONs)')}")
    print(f"  Manifest:               {status_label(manifest_ok, '(mtime_ns tracking)')}")

    # Templates
    templates = ["sway.conf", "swaybar.conf", "dunst.conf", "alacritty.toml", "colors.sh", "btop.theme", "rofi.rasi", "yazi.toml", "zed-theme.json"]
    missing_tpl = [t for t in templates if not os.path.exists(os.path.expanduser(f"~/.config/theme/templates/{t}"))]
    print(f"  Templates:              {status_label(len(missing_tpl) == 0, f'({len(templates)-len(missing_tpl)}/{len(templates)})')}")

    # Target App configs
    sway_ok = os.path.exists(os.path.expanduser("~/.config/sway/definitions.d/theme.conf")) or os.path.exists(os.path.expanduser("~/.config/sway/config"))
    gtk_ok = os.path.exists(os.path.expanduser("~/.config/gtk-3.0/settings.ini"))
    alacritty_ok = os.path.exists(os.path.expanduser("~/.config/alacritty/alacritty.toml"))
    nvim_dir = os.path.expanduser("~/.config/nvim/lua/themes")
    nvim_ok = os.path.isdir(nvim_dir)
    nvim_count = len(os.listdir(nvim_dir)) if nvim_ok else 0
    yazi_ok = os.path.exists(os.path.expanduser("~/.config/yazi/theme.toml")) or os.path.exists(os.path.expanduser("~/.config/yazi/yazi.toml"))
    btop_ok = os.path.isdir(os.path.expanduser("~/.config/btop/themes"))
    rofi_ok = os.path.exists(os.path.expanduser("~/.local/bin/rofi-theme"))
    hooks_dir = os.path.expanduser("~/.config/theme/hooks.d")
    hooks_ok = os.path.isdir(hooks_dir)

    print(f"  Sway:                   {status_label(sway_ok)}")
    print(f"  GTK:                    {status_label(gtk_ok)}")
    print(f"  Alacritty:              {status_label(alacritty_ok)}")
    print(f"  Neovim:                 {status_label(nvim_ok, f'({nvim_count} ports)')}")
    print(f"  Yazi:                   {status_label(yazi_ok)}")
    print(f"  btop:                   {status_label(btop_ok)}")
    print(f"  Rofi:                   {status_label(rofi_ok)}")
    print(f"  Hooks:                  {status_label(hooks_ok, f'({len(os.listdir(hooks_dir))} scripts)')}")

    # 4. Hardware CTM & Vibrance
    print(colored("\nHardware Display CTM & Vibrance", "cyan"))
    inspect_out = run_cmd([os.path.expanduser("~/.local/bin/ctm-test"), "--inspect"])
    
    crtc = "Unknown"
    conn = "Unknown"
    ctm_blob = "Unknown"
    driver = "Unknown"
    for line in inspect_out.splitlines():
        if "crtc   :" in line:
            crtc = line.split(":", 1)[1].strip()
        elif "conn   :" in line:
            conn = line.split(":", 1)[1].strip().split()[0]
        elif "ctm_blob:" in line:
            ctm_blob = line.split(":", 1)[1].strip()
        elif "driver :" in line:
            driver = line.split(":", 1)[1].strip()

    cfg_val = "1.0"
    vibrance_file = os.path.expanduser("~/.config/vibrance")
    if os.path.exists(vibrance_file):
        with open(vibrance_file, "r") as f:
            cfg_val = f.read().strip()

    # Check vkBasalt in cs2-launch
    cs2_launch = os.path.expanduser("~/.local/bin/cs2-launch")
    vkbasalt_status = "disabled (system default)"
    if os.path.exists(cs2_launch):
        with open(cs2_launch, "r") as f:
            c = f.read()
            if "ENABLE_VKBASALT=0" in c:
                vkbasalt_status = colored("disabled (ENABLE_VKBASALT=0 in cs2-launch)", "green")
            elif "ENABLE_VKBASALT=1" in c:
                vkbasalt_status = colored("ENABLED", "red")

    print(f"  Driver:                 {colored(driver, 'bold')}")
    print(f"  CRTC:                   {colored(crtc, 'bold')}")
    print(f"  Connector:              {colored(conn, 'bold')}")
    print(f"  Configured Saturation:  {colored(cfg_val, 'bold')} (~/.config/vibrance)")
    is_active = ctm_blob != "0" and ctm_blob != "Unknown"
    blob_status = colored(f"active (blob {ctm_blob})", "green") if is_active else colored("identity (blob 0)", "yellow")
    print(f"  Live CTM Hardware:      {blob_status}")
    print(f"  vkBasalt (CS2):         {vkbasalt_status}")

    print(colored("═" * 40, "dim"))
    all_ok = (failed == 0) and cache_ok and manifest_ok and sway_ok
    if all_ok:
        print(colored("✓ All systems healthy and operational.", "green"))
    else:
        print(colored("✗ Doctor detected issues needing attention.", "red"))

if __name__ == "__main__":
    main()
