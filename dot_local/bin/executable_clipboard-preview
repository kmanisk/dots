#!/usr/bin/env bash
# ==============================================================================
# clipboard-preview: Live preview renderer for clipboard-picker
# Renders terminal image previews via chafa or syntax-highlighted, wrapped text
# with prompt statistics (lines, words, size) via bat.
# ==============================================================================
set -euo pipefail

LINE="${1:-}"
[ -z "$LINE" ] && exit 0

export PATH="$HOME/.local/bin:/usr/bin:/bin:$PATH"

if [[ "$LINE" == *"[[ binary data"* ]]; then
    tmp="${XDG_RUNTIME_DIR:-/tmp}/clip-prev-$$.png"
    trap 'rm -f "$tmp"' EXIT
    cliphist decode <<< "$LINE" > "$tmp" 2>/dev/null || exit 0
    [ -s "$tmp" ] || exit 0

    dim=$(identify -format "%wx%h, %m, %b" "$tmp" 2>/dev/null || echo "Image")
    printf "\033[1;36m[Image Preview]\033[0m \033[1;32m%s\033[0m\n\n" "$dim"

    cols="${FZF_PREVIEW_COLUMNS:-80}"
    lines="${FZF_PREVIEW_LINES:-30}"
    max_h=$((lines > 4 ? lines - 4 : 15))
    chafa --size="${cols}x${max_h}" "$tmp" 2>/dev/null || true
else
    # Extract text cleanly
    RAW=$(cliphist decode <<< "$LINE" 2>/dev/null) || exit 0
    [ -z "$RAW" ] && exit 0

    total_lines=$(printf '%s\n' "$RAW" | wc -l)
    total_words=$(printf '%s\n' "$RAW" | wc -w)
    total_bytes=$(printf '%s\n' "$RAW" | wc -c)

    if [ "$total_bytes" -ge 1048576 ]; then
        size_str="$(awk "BEGIN {printf \"%.2f MB\", $total_bytes/1048576}")"
    elif [ "$total_bytes" -ge 1024 ]; then
        size_str="$(awk "BEGIN {printf \"%.1f KB\", $total_bytes/1024}")"
    else
        size_str="${total_bytes} B"
    fi

    printf "\033[1;36m[Text / Prompt]\033[0m \033[1;32m%s lines\033[0m \033[1;30m│\033[0m \033[1;33m%s words\033[0m \033[1;30m│\033[0m \033[1;35m%s\033[0m\n\n" \
        "$total_lines" "$total_words" "$size_str"

    if command -v bat >/dev/null 2>&1; then
        printf '%s' "$RAW" | bat --style=numbers,changes --color=always --wrap=character \
            --terminal-width="${FZF_PREVIEW_COLUMNS:-90}"
    else
        printf '%s\n' "$RAW"
    fi
fi
