#!/usr/bin/env python3
import json, subprocess, sys
from pathlib import Path

base = Path.home() / ".local/share/agent"
projects = json.loads((base / "projects.json").read_text())
name = sys.argv[1] if len(sys.argv) > 1 else ""
if not name:
    print("Usage: agent-check <project>", file=sys.stderr)
    sys.exit(2)

info = projects.get(name)
root = None
checks = None
if info:
    root = Path(info["path"])
    checks = info.get("check", [])
else:
    tele = Path("/home/onyx/Projects/tele") / name
    if tele.is_dir():
        root = tele
        checks = projects["tele"]["check"]
if root is None:
    p = Path(name).expanduser()
    if p.is_dir():
        root = p.resolve()
        checks = ["git diff --check"]
if root is None:
    print(f"Unknown project: {name}", file=sys.stderr)
    sys.exit(2)

print(f"PROJECT {name} @ {root}")
for i, command in enumerate(checks, 1):
    print(f"\n[{i}/{len(checks)}] $ {command}", flush=True)
    rc = subprocess.run(command, cwd=root, shell=True).returncode
    if rc != 0:
        print(f"\nFAIL ({rc}): {command}")
        sys.exit(rc)
print("\nALL CHECKS PASSED")
