#!/usr/bin/env bash
# ==============================================================================
# paste-smart: clipboard paste handler for Caps + . (Caps-DOT)
#
# Sends the paste shortcut the focused window actually understands:
#   - terminals (foot, alacritty, kitty, wezterm) -> Ctrl+Shift+V
#   - everything else                             -> Ctrl+V
#
# This key is paste-only. The screenshot buffer picker lives on
# Caps+Shift+Space, so Caps+. never opens a window.
# ==============================================================================
set -euo pipefail

export PATH="$HOME/.local/bin:/usr/bin:/bin:$PATH"

# Resolve Sway / Wayland environment (launched from xremap, not a login shell)
if [ -z "${SWAYSOCK:-}" ] || [ -z "${WAYLAND_DISPLAY:-}" ]; then
    while IFS='=' read -r k v; do
        case "$k" in
            SWAYSOCK|WAYLAND_DISPLAY|DISPLAY|XDG_CURRENT_DESKTOP)
                [ -n "$v" ] && export "$k"="$v"
                ;;
        esac
    done < <(systemctl --user show-environment 2>/dev/null || true)
fi

# Give xremap a moment to settle the CapsLock virtual modifier
sleep 0.05
exec "$HOME/.local/bin/wtype-paste"
