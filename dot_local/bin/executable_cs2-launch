#!/usr/bin/env bash
# CS2 launcher (Sway, dynamic GPU mode: Hybrid PRIME offload / AsusMuxDgpu direct)
# CS2_MODE=wayland   native Wayland, 4:3 stretch works, FPS paced to ~165 (default)
# CS2_MODE=x11       XWayland, FPS uncapped, no stretch (black bar)
# CS2_MODE=gamescope stretch + nearest filter, FPS depends on host pacing, may freeze
set -eo pipefail

CS2_MODE="${CS2_MODE:-wayland}"

# --- GPU mode-aware graphics environment ---
if [ -z "$GPU_MODE" ]; then
    if [ -r "${XDG_RUNTIME_DIR:-/run/user/$UID}/gpu_mode" ]; then
        read -r GPU_MODE < "${XDG_RUNTIME_DIR:-/run/user/$UID}/gpu_mode"
    else
        GPU_MODE="$(supergfxctl -g 2>/dev/null || true)"
    fi
fi

case "$GPU_MODE" in
    Hybrid)
        export __NV_PRIME_RENDER_OFFLOAD=1
        export __GLX_VENDOR_LIBRARY_NAME=nvidia
        export __VK_LAYER_NV_optimus=NVIDIA_only
        export LIBVA_DRIVER_NAME=iHD
        ;;
    AsusMuxDgpu)
        unset __NV_PRIME_RENDER_OFFLOAD
        unset __GLX_VENDOR_LIBRARY_NAME
        unset __VK_LAYER_NV_optimus
        unset __VK_LAYER_NV_OPTIMUS
        export LIBVA_DRIVER_NAME=nvidia
        ;;
    Integrated)
        unset __NV_PRIME_RENDER_OFFLOAD
        unset __GLX_VENDOR_LIBRARY_NAME
        unset __VK_LAYER_NV_optimus
        unset __VK_LAYER_NV_OPTIMUS
        export LIBVA_DRIVER_NAME=iHD
        ;;
    *)
        unset __NV_PRIME_RENDER_OFFLOAD
        unset __GLX_VENDOR_LIBRARY_NAME
        unset __VK_LAYER_NV_optimus
        unset __VK_LAYER_NV_OPTIMUS
        unset LIBVA_DRIVER_NAME
        ;;
esac

# Audio routing to tactical gaming sink
export PIPEWIRE_NODE="sink.peace_gaming"
export PULSE_SINK="sink.peace_gaming"

# Native explicit sync (linux-drm-syncobj-v1) enabled by default on NVIDIA 555+ / wlroots 0.18.
# In AsusMuxDgpu + wayland mode, SDL2 inside the Sniper container sends a wp_linux_drm_syncobj
# acquire point before attaching a buffer — Sway treats this as a protocol violation (error 3)
# and kills the Wayland connection, crashing CS2. Disabling explicit sync at the NVIDIA KMS level
# prevents the protocol from being advertised to SDL, avoiding the race.
# VK_TIMEOUT / NV_ERR_NO_MEMORY risks apply only when toggling explicit sync mid-session;
# disabling it from process start (clean launch) is safe for CS2's Vulkan/Sniper pipeline.
if [ "${CS2_DISABLE_EXPLICIT_SYNC:-0}" = "1" ] || \
   { [ "${GPU_MODE}" = "AsusMuxDgpu" ] && [ "${CS2_MODE:-wayland}" = "wayland" ]; }; then
    export __NV_DISABLE_EXPLICIT_SYNC=1
fi
export ENABLE_VKBASALT=0

if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for wayland_socket in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/wayland-[0-9]*; do
        if [ -S "$wayland_socket" ]; then
            WAYLAND_DISPLAY="${wayland_socket##*/}"
            break
        fi
    done
    export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
fi

# --- resolution ---
TARGET_RES="${CS2_RES:-1600x1200}"
case "$TARGET_RES" in
    1600|1600x1200) TARGET_W=1600; TARGET_H=1200 ;;
    1440|1440x1080) TARGET_W=1440; TARGET_H=1080 ;;
    1344|1344x1008) TARGET_W=1344; TARGET_H=1008 ;;
    1280|1280x960)  TARGET_W=1280; TARGET_H=960 ;;
    1024|1024x768)  TARGET_W=1024; TARGET_H=768 ;;
    native|1920|1920x1200) TARGET_W=1920; TARGET_H=1200 ;;
    *) TARGET_W=1600; TARGET_H=1200 ;;
esac

# Enforce exclusive fullscreen at target resolution in cs2_video.txt
# (prevents borderless windowed fallback which disables SDL Wayland stretch and causes 320px black bar)
for vcfg in "$HOME/.local/share/Steam"/userdata/*/730/local/cfg/cs2_video.txt; do
    if [ -f "$vcfg" ]; then
        sed -i \
            -e 's/"setting.fullscreen"[[:space:]]*"[0-9]*"/"setting.fullscreen"\t\t"1"/' \
            -e 's/"setting.coop_fullscreen"[[:space:]]*"[0-9]*"/"setting.coop_fullscreen"\t\t"0"/' \
            -e 's/"setting.nowindowborder"[[:space:]]*"[0-9]*"/"setting.nowindowborder"\t\t"0"/' \
            -e "s/\"setting.defaultres\"[[:space:]]*\"[0-9]*\"/\"setting.defaultres\"\t\t\"$TARGET_W\"/" \
            -e "s/\"setting.defaultresheight\"[[:space:]]*\"[0-9]*\"/\"setting.defaultresheight\"\t\t\"$TARGET_H\"/" \
            "$vcfg" 2>/dev/null || true
    fi
done

# --- per-mode SDL setup ---
case "$CS2_MODE" in
    wayland)
        export XDG_SESSION_TYPE=wayland
        export SDL_VIDEO_DRIVER=wayland SDL_VIDEODRIVER=wayland
        export SDL_VIDEO_WAYLAND_SCALE_TO_DISPLAY=1
        export SDL_VIDEO_WAYLAND_MODE_SCALING=stretch
        export SDL_VIDEO_WAYLAND_ALLOW_TEARING=1
        # Strip gameoverlayrenderer.so to prevent Steam CEF overlay crash loop on Wayland/NVIDIA
        if [ -n "${LD_PRELOAD:-}" ]; then
            LD_PRELOAD="$(echo "$LD_PRELOAD" | tr ':' '\n' | { grep -v 'gameoverlayrenderer' || true; } | paste -sd ':' -)"
            export LD_PRELOAD
        fi
        ;;
    x11|gamescope)
        export SDL_VIDEO_DRIVER=x11 SDL_VIDEODRIVER=x11
        unset SDL_VIDEO_WAYLAND_SCALE_TO_DISPLAY SDL_VIDEO_WAYLAND_MODE_SCALING SDL_VIDEO_WAYLAND_ALLOW_TEARING
        ;;
    *) echo "Unknown CS2_MODE=$CS2_MODE" >&2; exit 1 ;;
esac

# --- locate cs2.sh when run without Steam's %command% ---
if [ $# -eq 0 ] || [[ "$1" == -* ]]; then
    for d in "/mnt/Games/SteamLibrary" "$HOME/.local/share/Steam"; do
        f="$d/steamapps/common/Counter-Strike Global Offensive/game/cs2.sh"
        [ -f "$f" ] && { set -- "$f" "$@"; break; }
    done
fi
[ $# -eq 0 ] && { echo "ERROR: Could not locate CS2 executable." >&2; exit 1; }

# Pin to 6 physical P-cores; remove -mainthreadpriority 2 to prevent thread starvation/watchdog stalls
CS2_FLAGS=(-vulkan -fullscreen -w "$TARGET_W" -h "$TARGET_H" -threads 6 -nojoy -novid +fps_max 0 +fps_max_ui 0 +clientport "${CS2_CLIENTPORT:-27006}")

# --- asusctl performance profile switching ---
previous_profile="$(cat /sys/firmware/acpi/platform_profile 2>/dev/null || true)"
if command -v asusctl >/dev/null 2>&1; then
    asusctl profile set Performance >/dev/null 2>&1 || true
fi

# --- ananicy-cpp conflict resolution (AGENTS.md Rule 2) ---
ananicy_was_active=0
gamemode_command=()
if systemctl is-active --quiet ananicy-cpp.service 2>/dev/null; then
    if sudo -n systemctl stop ananicy-cpp.service 2>/dev/null && \
       ! systemctl is-active --quiet ananicy-cpp.service 2>/dev/null; then
        ananicy_was_active=1
    else
        echo "WARNING: ananicy-cpp remains active; launching without GameMode." >&2
    fi
fi
if ! systemctl is-active --quiet ananicy-cpp.service 2>/dev/null; then
    gamemode_command=(gamemoderun)
fi

# --- sway gaming mode ---
if [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null 2>&1; then
    swaymsg 'mode "gaming"' >/dev/null 2>&1 || true
fi
cleanup() {
    if command -v asusctl >/dev/null 2>&1 && [ -n "$previous_profile" ]; then
        case "$previous_profile" in
            quiet|low-power) asusctl profile set Quiet >/dev/null 2>&1 || true ;;
            balanced) asusctl profile set Balanced >/dev/null 2>&1 || true ;;
            performance) asusctl profile set Performance >/dev/null 2>&1 || true ;;
        esac
    fi
    if [ "$ananicy_was_active" = "1" ]; then
        sudo -n systemctl start ananicy-cpp.service 2>/dev/null || true
    fi
    for vcfg in "$HOME/.local/share/Steam"/userdata/*/730/local/cfg/cs2_video.txt; do
        if [ -f "$vcfg" ]; then
            sed -i \
                -e 's/"setting.fullscreen"[[:space:]]*"[0-9]*"/"setting.fullscreen"\t\t"1"/' \
                -e 's/"setting.coop_fullscreen"[[:space:]]*"[0-9]*"/"setting.coop_fullscreen"\t\t"0"/' \
                -e 's/"setting.nowindowborder"[[:space:]]*"[0-9]*"/"setting.nowindowborder"\t\t"0"/' \
                -e "s/\"setting.defaultres\"[[:space:]]*\"[0-9]*\"/\"setting.defaultres\"\t\t\"$TARGET_W\"/" \
                -e "s/\"setting.defaultresheight\"[[:space:]]*\"[0-9]*\"/\"setting.defaultresheight\"\t\t\"$TARGET_H\"/" \
                "$vcfg" 2>/dev/null || true
        fi
    done
    if [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null 2>&1; then
        swaymsg 'mode "default"' >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT INT TERM

echo "==> CS2 mode: $CS2_MODE (${TARGET_W}x${TARGET_H})"
if [ "$CS2_MODE" = "gamescope" ]; then
    command -v gamescope >/dev/null 2>&1 || { echo "gamescope not installed" >&2; exit 1; }
    # no -r/-o so gamescope adds no refresh cap of its own
    taskset -c 0-11 gamescope \
        -w "$TARGET_W" -h "$TARGET_H" -W 1920 -H 1200 \
        -f -S stretch -F nearest --force-grab-cursor \
        -- "${gamemode_command[@]}" "$@" "${CS2_FLAGS[@]}"
else
    taskset -c 0-11 "${gamemode_command[@]}" "$@" "${CS2_FLAGS[@]}"
fi
