#!/usr/bin/env bash
# ==============================================================================
# CS2 Wayland Native Launcher (Sway / Wayland + RTX 5050 Mobile Laptop)
# ==============================================================================
# - Hardware: ASUS TUF F16 (i5-13450HX + RTX 5050 Mobile Blackwell)
# - Session: Sway / Wayland (wlroots compositor on Intel iGPU)
# - Rendering: Direct Native Wayland Vulkan offload to NVIDIA RTX 5050
# - Scaling: SDL_VIDEO_WAYLAND_SCALE_TO_DISPLAY=1
# - CPU Pinning: Physical P-cores 0-11 (Bypasses E-cores to eliminate micro-stutters)
# - Gamescope DISABLED by default to prevent DRM/kernel freezes on NVIDIA hybrid
# ==============================================================================

set -eo pipefail

# 1. Wayland & NVIDIA PRIME Offload Environment
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    export WAYLAND_DISPLAY="$(ls -1 /run/user/$(id -u)/wayland-[0-9]* 2>/dev/null | head -n 1 | xargs -r basename || echo "wayland-1")"
fi
export XDG_SESSION_TYPE=wayland
export SDL_VIDEO_DRIVER=wayland
export SDL_VIDEODRIVER=wayland
export SDL_VIDEO_WAYLAND_SCALE_TO_DISPLAY=1
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only
export LIBVA_DRIVER_NAME=iHD

# Vibrance via vkBasalt (in-process shader: no extra present hop, scanout
# stays eligible). Config: ~/.config/vkBasalt/vkBasalt.conf
export ENABLE_VKBASALT=1

# 2. Resolution Configuration
TARGET_RES="${CS2_RES:-1440x1080}"
TARGET_W=1440
TARGET_H=1080
case "$TARGET_RES" in
    1600|1600x1200) TARGET_W=1600; TARGET_H=1200 ;;
    1440|1440x1080) TARGET_W=1440; TARGET_H=1080 ;;
    1344|1344x1008) TARGET_W=1344; TARGET_H=1008 ;;
    1280|1280x960)  TARGET_W=1280; TARGET_H=960 ;;
    1024|1024x768)  TARGET_W=1024; TARGET_H=768 ;;
    native|1920|1920x1200) TARGET_W=1920; TARGET_H=1200 ;;
esac

# 3. Resolve CS2 launcher executable if invoked without Steam %command% arguments
if [ $# -eq 0 ] || [[ "$1" == -* ]]; then
    if [ -f "/mnt/Games/SteamLibrary/steamapps/common/Counter-Strike Global Offensive/game/cs2.sh" ]; then
        set -- "/mnt/Games/SteamLibrary/steamapps/common/Counter-Strike Global Offensive/game/cs2.sh" "$@"
    elif [ -f "$HOME/.local/share/Steam/steamapps/common/Counter-Strike Global Offensive/game/cs2.sh" ]; then
        set -- "$HOME/.local/share/Steam/steamapps/common/Counter-Strike Global Offensive/game/cs2.sh" "$@"
    fi
fi
if [ $# -eq 0 ]; then
    echo "ERROR: Could not locate CS2 executable." >&2
    exit 1
fi

CS2_FLAGS=(-vulkan -threads 7 -mainthreadpriority 2 -nojoy -novid +fps_max 0 +fps_max_ui 0)

# 4. Mode Selection: Native Wayland (Default, Rock-solid)
# Gamescope in nested Wayland mode on NVIDIA Optimus causes DRM kernel panics / freezes.
# Only enabled if explicitly forced via USE_GAMESCOPE=1.
USE_GAMESCOPE="${USE_GAMESCOPE:-0}"

if [ "$USE_GAMESCOPE" = "1" ] && command -v gamescope >/dev/null 2>&1; then
    echo "==> Launching CS2 via Gamescope (Caution: May freeze on NVIDIA hybrid)..."
    exec taskset -c 0-11 gamescope \
        -w "$TARGET_W" -h "$TARGET_H" \
        -W 1920 -H 1200 \
        -r 165 -o 165 \
        -f -S stretch \
        --force-grab-cursor \
        -- \
        gamemoderun "$@" "${CS2_FLAGS[@]}"
else
    echo "==> Launching CS2 natively via Direct SDL Wayland on RTX 5050 (P-cores 0-11)..."
    exec taskset -c 0-11 gamemoderun "$@" "${CS2_FLAGS[@]}"
fi
