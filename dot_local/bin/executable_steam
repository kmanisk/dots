#!/usr/bin/env bash
# Steam Launcher
# Prevent PRIME offload variables from breaking Chromium Embedded Framework (CEF) / steamwebhelper.
# Bypass: STEAM_DGPU=1 keeps PRIME env (full client on NVIDIA). Allowed because
# Win+Shift+G (prime-run steam-workspace) and rofi entries opt in explicitly.
if [ "${STEAM_DGPU:-0}" != "1" ]; then
    unset __NV_PRIME_RENDER_OFFLOAD
    unset __NV_PRIME_RENDER_OFFLOAD_PROVIDER
    unset __VK_LAYER_NV_optimus
    unset VK_DRIVER_FILES
    unset VK_ICD_FILENAMES
    unset __GLX_VENDOR_LIBRARY_NAME
    unset LIBVA_DRIVER_NAME
    unset NVD_BACKEND
fi

# Desktop UI scaling for 16" 1920x1200 Display (scale 1.0 prevents CEF coordinate desync on XWayland)
export GDK_SCALE=1
if [ "${STEAM_FORCE_DESKTOPUI_SCALING:-}" = "1.35" ]; then
    export STEAM_FORCE_DESKTOPUI_SCALING=1.0
else
    export STEAM_FORCE_DESKTOPUI_SCALING="${STEAM_FORCE_DESKTOPUI_SCALING:-1.0}"
fi

# Disable GPU acceleration for CEF web views under Xwayland to fix
# unresponsive mouse clicks, invisible cursor, and hit-box coordinate misalignment.
CEF_FLAGS=()
if ! [[ "$*" =~ "-cef-disable-gpu" ]]; then
    CEF_FLAGS+=("-cef-disable-gpu" "-cef-disable-gpu-compositing")
fi

exec /usr/bin/steam "${CEF_FLAGS[@]}" "$@"
