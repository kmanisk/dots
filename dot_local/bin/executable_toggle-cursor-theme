#!/usr/bin/env bash
# ==============================================================================
# toggle-cursor-theme: Switch the cursor between Gruvbox Material Dark and Light.
#
# Usage:
#   toggle-cursor-theme          # toggle polarity
#   toggle-cursor-theme dark     # force dark
#   toggle-cursor-theme light    # force light
#   toggle-cursor-theme status   # report theme, size, and every consumer
#
# The size is preserved; only the theme polarity changes. This mirrors
# adjust-cursor-size: the same six consumers are written, including the
# chezmoi sources, so the live session and the repository cannot drift apart.
#
# Sources kept in sync:
#   1. Sway live seat        seat * xcursor_theme <theme> <size>
#   2. Sway config           ~/.config/sway/config.d/10-display.conf (+ chezmoi)
#   3. GTK 2 / 3 / 4         gtk-cursor-theme-name
#   4. GSettings             org.gnome.desktop.interface cursor-theme
#   5. Xresources            Xcursor.theme (feeds the ~/.icons/default fallback)
#   6. Session environment   environment.d/30-cursor.conf (+ chezmoi),
#                            systemd user env, dbus activation env
# ==============================================================================
set -euo pipefail

DARK_THEME="phinger-cursors-gruvbox-material"
LIGHT_THEME="phinger-cursors-gruvbox-material-light"

SWAY_CONF="$HOME/.config/sway/config.d/10-display.conf"
SWAY_SRC="$HOME/.local/share/chezmoi/dot_config/sway/config.d/10-display.conf"
ENV_CONF="$HOME/.config/environment.d/30-cursor.conf"
ENV_SRC="$HOME/.local/share/chezmoi/dot_config/environment.d/30-cursor.conf"

die() {
    printf 'toggle-cursor-theme: %s\n' "$*" >&2
    exit 1
}

theme_installed() {
    local t=$1 d
    for d in "$HOME/.local/share/icons/$t" "$HOME/.icons/$t" "/usr/share/icons/$t"; do
        [ -d "$d/cursors" ] && return 0
    done
    return 1
}

# Sway config is authoritative; the other stores are fallbacks only.
detect_theme() {
    local t
    t=$(grep -oE 'seat (\*|seat0) xcursor_theme [^ ]+' "$SWAY_CONF" 2>/dev/null \
        | awk '{print $4}' | head -n1)
    [ -n "$t" ] || t=$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | tr -d "'\"")
    [ -n "$t" ] || t=$(grep -E '^Xcursor\.theme:' "$HOME/.Xresources" 2>/dev/null | awk '{print $2}')
    printf '%s' "$t"
}

detect_size() {
    local s
    s=$(grep -oE 'seat (\*|seat0) xcursor_theme [^ ]+ [0-9]+' "$SWAY_CONF" 2>/dev/null \
        | awk '{print $5}' | head -n1)
    [ -n "$s" ] || s=$(gsettings get org.gnome.desktop.interface cursor-size 2>/dev/null | tr -d "'\"")
    [ -n "$s" ] || s=$(grep -E '^Xcursor\.size:' "$HOME/.Xresources" 2>/dev/null | awk '{print $2}')
    printf '%s' "$s"
}

CURRENT_THEME=$(detect_theme)
CURRENT_THEME="${CURRENT_THEME:-$LIGHT_THEME}"
SIZE=$(detect_size)
[ -n "$SIZE" ] || die "cannot determine the current cursor size"

case "${1:-toggle}" in
    status)
        printf 'Cursor theme : %s\n' "$CURRENT_THEME"
        printf 'Cursor size  : %spx\n' "$SIZE"
        printf 'sway config  : %s\n' "$(grep -oE 'xcursor_theme [^ ]+ [0-9]+' "$SWAY_CONF" 2>/dev/null || echo missing)"
        printf 'chezmoi      : %s\n' "$(grep -oE 'xcursor_theme [^ ]+ [0-9]+' "$SWAY_SRC" 2>/dev/null || echo missing)"
        printf 'gsettings    : %s\n' "$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | tr -d "'\"" || echo unavailable)"
        printf 'gtk-3.0/4.0  : %s / %s\n' \
            "$(grep -hoE 'gtk-cursor-theme-name=.*' "$HOME/.config/gtk-3.0/settings.ini" 2>/dev/null | cut -d= -f2)" \
            "$(grep -hoE 'gtk-cursor-theme-name=.*' "$HOME/.config/gtk-4.0/settings.ini" 2>/dev/null | cut -d= -f2)"
        printf 'Xresources   : %s\n' "$(grep -E '^Xcursor\.theme:' "$HOME/.Xresources" 2>/dev/null | awk '{print $2}')"
        printf 'session env  : %s\n' "$(grep -E '^XCURSOR_THEME=' "$ENV_CONF" 2>/dev/null | cut -d= -f2)"
        printf 'icons default: %s\n' "$(grep -E '^Inherits=' "$HOME/.local/share/icons/default/index.theme" 2>/dev/null | cut -d= -f2)"
        exit 0
        ;;
    dark|Dark)
        NEW_THEME="$DARK_THEME"
        MODE="Dark"
        ;;
    light|Light)
        NEW_THEME="$LIGHT_THEME"
        MODE="Light"
        ;;
    toggle|"")
        if [ "$CURRENT_THEME" = "$DARK_THEME" ]; then
            NEW_THEME="$LIGHT_THEME"
            MODE="Light"
        else
            NEW_THEME="$DARK_THEME"
            MODE="Dark"
        fi
        ;;
    *)
        die "invalid argument '$1' (use dark, light, status, or no argument to toggle)"
        ;;
esac

theme_installed "$NEW_THEME" || die "theme '$NEW_THEME' is not installed"

if [ "$NEW_THEME" = "$CURRENT_THEME" ]; then
    printf 'Cursor theme already %s (%spx); nothing to do.\n' "$NEW_THEME" "$SIZE"
    exit 0
fi

# --- 1. GSettings -------------------------------------------------------------
gsettings set org.gnome.desktop.interface cursor-theme "$NEW_THEME" 2>/dev/null || true
gsettings set org.gnome.desktop.interface cursor-size "$SIZE" 2>/dev/null || true

# --- 2. GTK 2 / 3 / 4 ---------------------------------------------------------
if [ -f "$HOME/.gtkrc-2.0" ]; then
    sed -i -E "s/gtk-cursor-theme-name=.*/gtk-cursor-theme-name=\"$NEW_THEME\"/" "$HOME/.gtkrc-2.0"
fi
for cfg in "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"; do
    [ -f "$cfg" ] || continue
    sed -i -E "s/gtk-cursor-theme-name=.*/gtk-cursor-theme-name=$NEW_THEME/" "$cfg"
done

# --- 3. Xresources (must happen before the fallback refresh) ------------------
if [ -f "$HOME/.Xresources" ]; then
    sed -i -E "s/^Xcursor\.theme:.*/Xcursor.theme: $NEW_THEME/" "$HOME/.Xresources"
    command -v xrdb >/dev/null 2>&1 && xrdb -merge "$HOME/.Xresources" 2>/dev/null || true
fi

# --- 4. Sway config, live and chezmoi source ----------------------------------
saw_sway_src=0
for scfg in "$SWAY_CONF" "$SWAY_SRC"; do
    [ -f "$scfg" ] || continue
    sed -i -E "s/^(seat (\*|seat0) xcursor_theme )[^ ]+( [0-9]+)?/\1$NEW_THEME $SIZE/" "$scfg"
    [ "$scfg" = "$SWAY_SRC" ] && saw_sway_src=1
done

# --- 5. Session environment ---------------------------------------------------
for ecfg in "$ENV_CONF" "$ENV_SRC"; do
    [ -f "$ecfg" ] || continue
    if grep -qE '^XCURSOR_THEME=' "$ecfg"; then
        sed -i -E "s/^XCURSOR_THEME=.*/XCURSOR_THEME=$NEW_THEME/" "$ecfg"
    else
        printf 'XCURSOR_THEME=%s\n' "$NEW_THEME" >> "$ecfg"
    fi
done

export XCURSOR_THEME="$NEW_THEME"
export XCURSOR_SIZE="$SIZE"
systemctl --user import-environment XCURSOR_THEME XCURSOR_SIZE 2>/dev/null || true
command -v dbus-update-activation-environment >/dev/null 2>&1 && \
    dbus-update-activation-environment --systemd XCURSOR_THEME XCURSOR_SIZE 2>/dev/null || true

# --- 6. X11 / Xwayland / CEF fallbacks ----------------------------------------
"$HOME/.local/bin/ensure-xcursor-fallbacks" >/dev/null 2>&1 || true
if [ -n "${DISPLAY:-}" ] && command -v xsetroot >/dev/null 2>&1; then
    xsetroot -cursor_name left_ptr 2>/dev/null || true
fi

# --- 7. Live compositor -------------------------------------------------------
live_ok=0
if [ -n "${SWAYSOCK:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
    if swaymsg "seat * xcursor_theme $NEW_THEME $SIZE" >/dev/null 2>&1; then
        live_ok=1
    fi
fi

# --- 8. Report ----------------------------------------------------------------
printf 'Cursor theme: %s -> %s (%s, %spx)\n' "$CURRENT_THEME" "$NEW_THEME" "$MODE" "$SIZE"
[ "$live_ok" -eq 1 ] && printf 'Applied live to the Sway seat.\n'
[ "$saw_sway_src" -eq 0 ] && printf 'Warning: chezmoi sway source not found, only live config updated.\n'
if [ "$live_ok" -eq 0 ]; then
    printf 'Note: Sway IPC unavailable; theme applies after the next reload or login.\n'
fi
printf 'Running GTK/Qt apps may keep the old cursor until restarted.\n'

if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Theme" -u low -i preferences-desktop-theme -r 9945 \
        "Cursor Theme" "Gruvbox $MODE (${SIZE}px)"
fi
