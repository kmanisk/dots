#!/usr/bin/env bash
# ==============================================================================
# toggle-cursor-theme: Toggle between Gruvbox Material Dark & Light cursor
# Compatible with Sway (Wayland) and i3 (X11)
# ==============================================================================
set -euo pipefail

DARK_THEME="phinger-cursors-gruvbox-material"
LIGHT_THEME="phinger-cursors-gruvbox-material-light"

# 1. Determine current cursor theme
CURRENT=$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | tr -d "'\"" || true)
if [[ -z "$CURRENT" ]]; then
    CURRENT=$(grep -oE 'seat seat0 xcursor_theme [^ ]+' "$HOME/.config/sway/config.d/10-display.conf" "$HOME/.config/sway/config" 2>/dev/null | awk '{print $4}' | head -n1 || true)
fi
if [[ -z "$CURRENT" ]]; then
    CURRENT=$(grep -E '^Xcursor\.theme:' "$HOME/.Xresources" 2>/dev/null | awk '{print $2}' || true)
fi

TARGET_MODE="${1:-toggle}"

case "$TARGET_MODE" in
    dark|Dark)
        NEW_THEME="$DARK_THEME"
        MODE="Dark"
        ;;
    light|Light)
        NEW_THEME="$LIGHT_THEME"
        MODE="Light"
        ;;
    status)
        echo "Current cursor: $CURRENT"
        exit 0
        ;;
    toggle|*)
        if [ "$CURRENT" = "$DARK_THEME" ]; then
            NEW_THEME="$LIGHT_THEME"
            MODE="Light"
        else
            NEW_THEME="$DARK_THEME"
            MODE="Dark"
        fi
        ;;
esac

# 2. Determine current cursor size (preserve user's size setting)
SIZE=$(gsettings get org.gnome.desktop.interface cursor-size 2>/dev/null | tr -d "'\"" || true)
if [[ -z "$SIZE" || "$SIZE" -le 0 ]]; then
    SIZE=$(grep -oE 'seat seat0 xcursor_theme [^ ]+ [0-9]+' "$HOME/.config/sway/config.d/10-display.conf" "$HOME/.config/sway/config" 2>/dev/null | awk '{print $4}' | head -n1 || true)
fi
if [[ -z "$SIZE" || "$SIZE" -le 0 ]]; then
    SIZE=$(grep -E '^Xcursor\.size:' "$HOME/.Xresources" 2>/dev/null | awk '{print $2}' || true)
fi
SIZE="${SIZE:-32}"

# 3. Apply to GNOME / GTK settings (GSettings)
gsettings set org.gnome.desktop.interface cursor-theme "$NEW_THEME" 2>/dev/null || true
gsettings set org.gnome.desktop.interface cursor-size "$SIZE" 2>/dev/null || true

# 4. Update .Xresources and xrdb merge
if [ -f "$HOME/.Xresources" ]; then
    sed -i -E "s/Xcursor\.theme:.*/Xcursor.theme: $NEW_THEME/" "$HOME/.Xresources"
    sed -i -E "s/Xcursor\.size:.*/Xcursor.size: $SIZE/" "$HOME/.Xresources"
    command -v xrdb >/dev/null 2>&1 && xrdb -merge "$HOME/.Xresources" 2>/dev/null || true
fi

# 5. Update GTK 2
if [ -f "$HOME/.gtkrc-2.0" ]; then
    sed -i -E "s/gtk-cursor-theme-name=.*/gtk-cursor-theme-name=\"$NEW_THEME\"/" "$HOME/.gtkrc-2.0"
    sed -i -E "s/gtk-cursor-theme-size=.*/gtk-cursor-theme-size=$SIZE/" "$HOME/.gtkrc-2.0"
fi

# 6. Update GTK 3 & 4
for cfg in "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"; do
    if [ -f "$cfg" ]; then
        sed -i -E "s/gtk-cursor-theme-name=.*/gtk-cursor-theme-name=$NEW_THEME/" "$cfg"
        sed -i -E "s/gtk-cursor-theme-size=.*/gtk-cursor-theme-size=$SIZE/" "$cfg"
    fi
done

# 7. Update fallback index.theme
for idx in "$HOME/.icons/default/index.theme" "$HOME/.local/share/icons/default/index.theme"; do
    mkdir -p "$(dirname "$idx")"
    cat <<EOF > "$idx"
[Icon Theme]
Inherits=$NEW_THEME
EOF
done

# 8. Sync i3 config and X11 root window
if [ -f "$HOME/.config/i3/config" ]; then
    sed -i -E "s/cursor-theme '[^']+'/cursor-theme '$NEW_THEME'/" "$HOME/.config/i3/config" 2>/dev/null || true
fi
if [ -n "${DISPLAY:-}" ] && command -v xsetroot >/dev/null 2>&1; then
    xsetroot -cursor_name left_ptr 2>/dev/null || true
fi

# 9. Sync Sway (Wayland) compositor & session
for scfg in "$HOME/.config/sway/config.d/10-display.conf" "$HOME/.config/sway/config"; do
    if [ -f "$scfg" ]; then
        sed -i -E "s/^(seat seat0 xcursor_theme )[^ ]+( [0-9]+)?/\1$NEW_THEME $SIZE/" "$scfg" 2>/dev/null || true
    fi
done

export XCURSOR_THEME="$NEW_THEME"
export XCURSOR_SIZE="$SIZE"
systemctl --user import-environment XCURSOR_THEME XCURSOR_SIZE 2>/dev/null || true
command -v dbus-update-activation-environment >/dev/null 2>&1 && \
    dbus-update-activation-environment --systemd XCURSOR_THEME XCURSOR_SIZE 2>/dev/null || true

if [ -n "${SWAYSOCK:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
    swaymsg "seat seat0 xcursor_theme $NEW_THEME $SIZE" >/dev/null 2>&1 || true
fi

# 10. Notification (works on Mako, Dunst, SwayNC)
if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Theme" -u low -i preferences-desktop-theme -r 9945 "Cursor Theme" "Switched to Gruvbox $MODE (${SIZE}px)"
elif command -v dunstify >/dev/null 2>&1; then
    dunstify -a "Theme" -u low -i preferences-desktop-theme -r 9945 "Cursor Theme" "Switched to Gruvbox $MODE (${SIZE}px)"
fi
