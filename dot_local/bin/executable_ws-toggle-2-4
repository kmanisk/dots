#!/usr/bin/env sh
# ws-toggle-2-4 — instantly toggle between workspaces 2 and 4 only.
# On ws2 -> ws4, anywhere else -> ws2.
IPC="i3-msg"
[ -n "$SWAYSOCK" ] && IPC="swaymsg"
CUR=$($IPC -t get_workspaces | python3 -c 'import json,sys; print([w["name"] for w in json.load(sys.stdin) if w["focused"]][0])' 2>/dev/null)
if [ "$CUR" = "2" ]; then
    $IPC "workspace number 4; mode \"gaming\"" >/dev/null 2>&1
else
    $IPC "workspace number 2; mode \"default\"" >/dev/null 2>&1
fi
