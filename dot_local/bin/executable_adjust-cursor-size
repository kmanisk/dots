#!/usr/bin/env bash
# ==============================================================================
# adjust-cursor-size: Adjust cursor size up or down (+4 / -4)
# Range: 16px to 64px
# Compatible with Sway (Wayland) and i3 (X11)
# ==============================================================================
set -euo pipefail

DELTA="${1:-4}"

# 1. Get current size from gsettings or fallback to sway config / Xresources
CURRENT_SIZE=$(gsettings get org.gnome.desktop.interface cursor-size 2>/dev/null | tr -d "'\"" || true)
if [[ -z "$CURRENT_SIZE" || "$CURRENT_SIZE" -le 0 ]]; then
    CURRENT_SIZE=$(grep -oE 'seat (\*|seat0) xcursor_theme [^ ]+ [0-9]+' "$HOME/.config/sway/config.d/10-display.conf" "$HOME/.config/sway/config" 2>/dev/null | awk '{print $5}' | head -n1 || true)
fi
if [[ -z "$CURRENT_SIZE" || "$CURRENT_SIZE" -le 0 ]]; then
    CURRENT_SIZE=$(grep -E '^Xcursor\.size:' "$HOME/.Xresources" 2>/dev/null | awk '{print $2}' || true)
fi
CURRENT_SIZE="${CURRENT_SIZE:-32}"

NEW_SIZE=$(( CURRENT_SIZE + DELTA ))

# Clamp between 16 and 64
if (( NEW_SIZE > 64 )); then
    NEW_SIZE=64
fi
if (( NEW_SIZE < 16 )); then
    NEW_SIZE=16
fi

# 2. Get current cursor theme
CURRENT_THEME=$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | tr -d "'\"" || true)
if [[ -z "$CURRENT_THEME" ]]; then
    CURRENT_THEME=$(grep -oE 'seat (\*|seat0) xcursor_theme [^ ]+' "$HOME/.config/sway/config.d/10-display.conf" "$HOME/.config/sway/config" 2>/dev/null | awk '{print $4}' | head -n1 || true)
fi
CURRENT_THEME="${CURRENT_THEME:-phinger-cursors-gruvbox-material}"

# 3. Update GSettings (GNOME / GTK live)
gsettings set org.gnome.desktop.interface cursor-size "$NEW_SIZE" 2>/dev/null || true

# 4. Update .Xresources & merge
if [ -f "$HOME/.Xresources" ]; then
    sed -i -E "s/Xcursor\.size:.*/Xcursor.size: $NEW_SIZE/" "$HOME/.Xresources"
    command -v xrdb >/dev/null 2>&1 && xrdb -merge "$HOME/.Xresources" 2>/dev/null || true
fi

# 5. Update GTK 2
if [ -f "$HOME/.gtkrc-2.0" ]; then
    sed -i -E "s/gtk-cursor-theme-size=.*/gtk-cursor-theme-size=$NEW_SIZE/" "$HOME/.gtkrc-2.0"
fi

# 6. Update GTK 3 & 4
for cfg in "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"; do
    if [ -f "$cfg" ]; then
        sed -i -E "s/gtk-cursor-theme-size=.*/gtk-cursor-theme-size=$NEW_SIZE/" "$cfg"
    fi
done

# 7. Update i3 config & root window
if [ -f "$HOME/.config/i3/config" ]; then
    sed -i -E "s/cursor-size [0-9]+/cursor-size $NEW_SIZE/" "$HOME/.config/i3/config" 2>/dev/null || true
fi
if [ -n "${DISPLAY:-}" ] && command -v xsetroot >/dev/null 2>&1; then
    xsetroot -cursor_name left_ptr 2>/dev/null || true
fi

# 8. Update Sway config & live compositor
for scfg in "$HOME/.config/sway/config.d/10-display.conf" "$HOME/.config/sway/config"; do
    if [ -f "$scfg" ]; then
        sed -i -E "s/^(seat (\*|seat0) xcursor_theme [^ ]+ )[0-9]+/\1$NEW_SIZE/" "$scfg" 2>/dev/null || true
    fi
done

export XCURSOR_THEME="$CURRENT_THEME"
export XCURSOR_SIZE="$NEW_SIZE"
systemctl --user import-environment XCURSOR_THEME XCURSOR_SIZE 2>/dev/null || true
command -v dbus-update-activation-environment >/dev/null 2>&1 && \
    dbus-update-activation-environment --systemd XCURSOR_THEME XCURSOR_SIZE 2>/dev/null || true

if [ -n "${SWAYSOCK:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
    swaymsg "seat * xcursor_theme $CURRENT_THEME $NEW_SIZE" >/dev/null 2>&1 || true
fi

# 9. Notify user
if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Cursor" -u low -i preferences-desktop-theme -r 9944 "Cursor Size" "Set to ${NEW_SIZE}px"
elif command -v dunstify >/dev/null 2>&1; then
    dunstify -a "Cursor" -u low -i preferences-desktop-theme -r 9944 "Cursor Size" "Set to ${NEW_SIZE}px"
fi
