#!/usr/bin/env bash
# ==============================================================================
# toggle-audio-sink — Smart Audio Output Switcher
# Seamlessly cycles across available physical audio targets:
#   - Laptop Speakers (ALC256 + Dolby DAX3 DSP)
#   - Wired Headphones (ALC256 3.5mm Jack) — ONLY IF ACTUALLY CONNECTED
#   - Bluetooth Devices (e.g. Boult BassBox, headsets)
#   - USB DAC / HDMI Outputs
# ==============================================================================
set -euo pipefail
export DISPLAY="${DISPLAY:-:0}"
export PATH="$HOME/.gemini/antigravity-cli/bin:$HOME/.local/bin:$PATH"

ALSA_SINK="alsa_output.pci-0000_00_1f.3.analog-stereo"

is_headphones_connected() {
    if amixer -c 0 cget iface=CARD,name="Headphone Jack" 2>/dev/null | grep -q "values=on"; then
        return 0
    fi
    local port_info
    port_info=$(pactl list sinks 2>/dev/null | awk -v s="$ALSA_SINK" '$0 ~ "Name: " s {f=1} f && /analog-output-headphones:/ {print; exit}')
    if [[ -n "$port_info" && "$port_info" != *"not available"* ]]; then
        return 0
    fi
    return 1
}

# 1. Enumerate available physical audio targets
declare -a TARGET_IDS=()
declare -a TARGET_SINKS=()
declare -a TARGET_PORTS=()
declare -a TARGET_DESCS=()
declare -a TARGET_ICONS=()
declare -a TARGET_PREFIXES=()

add_target() {
    TARGET_IDS+=("$1")
    TARGET_SINKS+=("$2")
    TARGET_PORTS+=("$3")
    TARGET_DESCS+=("$4")
    TARGET_ICONS+=("$5")
    TARGET_PREFIXES+=("$6")
}

# Internal speakers (always available on the laptop)
if pactl list short sinks 2>/dev/null | grep -q "$ALSA_SINK"; then
    add_target "alsa:speaker" "$ALSA_SINK" "analog-output-speaker" "Laptop Speakers (Dolby DSP)" "audio-speakers" "🔊 "
    # Smart check: only include 3.5mm headphones IF physically plugged in
    if is_headphones_connected; then
        add_target "alsa:headphones" "$ALSA_SINK" "analog-output-headphones" "Wired Headphones (3.5mm)" "audio-headphones" "🎧 "
    fi
fi

# External devices (Bluetooth, USB, HDMI)
while read -r sink_name; do
    [[ -z "$sink_name" || "$sink_name" == "$ALSA_SINK" ]] && continue
    desc=$(pactl list sinks 2>/dev/null | grep -A 25 "Name: $sink_name" | grep -m 1 "Description:" | sed 's/^[ \t]*Description:[ \t]*//' || echo "$sink_name")
    if [[ "$sink_name" == bluez_output* ]]; then
        if [[ "$desc" =~ [Ss]peaker|[Bb]ox|[Bb]ar ]]; then
            add_target "$sink_name" "$sink_name" "" "$desc" "audio-speakers" "🔊 "
        else
            add_target "$sink_name" "$sink_name" "" "$desc" "audio-headphones" "🎧 "
        fi
    elif [[ "$sink_name" == *hdmi* || "$sink_name" == *displayport* ]]; then
        add_target "$sink_name" "$sink_name" "" "$desc" "video-display" "🖥️ "
    elif [[ "$sink_name" == *usb* ]]; then
        add_target "$sink_name" "$sink_name" "" "$desc" "audio-card" "🔌 "
    fi
done < <(pactl list short sinks 2>/dev/null | awk '{print $2}' | grep -v -E "ghelper|dusky|dolby|rnnoise|null|dummy|peace|effect_")

TOTAL_TARGETS=${#TARGET_IDS[@]}
if [[ $TOTAL_TARGETS -le 1 ]]; then
    desc="${TARGET_DESCS[0]:-Internal Audio}"
    notify-send -u low -t 2000 -i dialog-information "Audio Switcher" "Only 1 audio target available: $desc"
    exit 0
fi

# 2. Determine currently active target
DEFAULT_SINK=$(pactl get-default-sink 2>/dev/null || echo "")
CURRENT_ID=""

if [[ "$DEFAULT_SINK" == "$ALSA_SINK" ]]; then
    active_port=$(pactl list sinks 2>/dev/null | awk -v s="$ALSA_SINK" '$0 ~ "Name: " s {f=1} f && /Active Port:/ {print $3; exit}')
    if [[ "$active_port" == "analog-output-headphones" ]] && is_headphones_connected; then
        CURRENT_ID="alsa:headphones"
    else
        CURRENT_ID="alsa:speaker"
    fi
else
    for id in "${TARGET_IDS[@]}"; do
        if [[ "$id" == "$DEFAULT_SINK" ]]; then
            CURRENT_ID="$id"
            break
        fi
    done
fi

CURRENT_INDEX=-1
for i in "${!TARGET_IDS[@]}"; do
    if [[ "${TARGET_IDS[$i]}" == "$CURRENT_ID" ]]; then
        CURRENT_INDEX=$i
        break
    fi
done

# 3. Cycle to next target
NEXT_INDEX=$(( (CURRENT_INDEX + 1) % TOTAL_TARGETS ))
NEXT_ID="${TARGET_IDS[$NEXT_INDEX]}"
NEXT_SINK="${TARGET_SINKS[$NEXT_INDEX]}"
NEXT_PORT="${TARGET_PORTS[$NEXT_INDEX]}"
NEXT_DESC="${TARGET_DESCS[$NEXT_INDEX]}"
NEXT_ICON="${TARGET_ICONS[$NEXT_INDEX]}"
NEXT_PREFIX="${TARGET_PREFIXES[$NEXT_INDEX]}"

# 4. Apply target switch
if [[ "$NEXT_ID" == "alsa:speaker" ]]; then
    amixer -c 0 sset Speaker 100% unmute >/dev/null 2>&1 || true
    pactl set-sink-port "$ALSA_SINK" "analog-output-speaker" 2>/dev/null || true
    pactl set-default-sink "$ALSA_SINK" 2>/dev/null || true
    pw-metadata -n default 0 default.audio.sink "{\"name\":\"$ALSA_SINK\"}" 2>/dev/null || true
    # Clear user_disabled quietly; dax-speaker-route.lua auto-enables DSP
    dax_id=$(pw-dump Node 2>/dev/null | jq -r '.[] | select(.info.props["node.name"] == "effect_input.Dolby_Speaker") | .id' 2>/dev/null | head -n 1 || true)
    [[ -n "$dax_id" && "$dax_id" != "null" ]] && pw-metadata -n filters "$dax_id" filter.smart.user_disabled false 2>/dev/null || true
elif [[ "$NEXT_ID" == "alsa:headphones" ]]; then
    amixer -c 0 sset Headphone 100% unmute >/dev/null 2>&1 || true
    pactl set-sink-port "$ALSA_SINK" "analog-output-headphones" 2>/dev/null || true
    pactl set-default-sink "$ALSA_SINK" 2>/dev/null || true
    pw-metadata -n default 0 default.audio.sink "{\"name\":\"$ALSA_SINK\"}" 2>/dev/null || true
else
    pactl set-default-sink "$NEXT_SINK" 2>/dev/null || true
    pw-metadata -n default 0 default.audio.sink "{\"name\":\"$NEXT_SINK\"}" 2>/dev/null || true
fi

# Move all active application playback streams to the selected destination sink
python3 -c "
import subprocess, sys
target_sink = sys.argv[1]

try:
    pactl_inputs = subprocess.check_output(['pactl', 'list', 'sink-inputs'], text=True)
    current_id = None
    node_name = ''
    media_name = ''
    app_name = ''
    
    lines = pactl_inputs.split('\n') + ['']
    for line in lines:
        line_s = line.strip()
        if line_s.startswith('Sink Input #'):
            current_id = line_s.split('#')[1].strip()
            node_name = ''
            media_name = ''
            app_name = ''
        elif 'node.name =' in line_s:
            node_name = line_s.split('=')[1].strip(' \"')
        elif 'media.name =' in line_s:
            media_name = line_s.split('=')[1].strip(' \"')
        elif 'application.name =' in line_s:
            app_name = line_s.split('=')[1].strip(' \"')
        elif not line_s and current_id:
            skip = any(x in (node_name + media_name) for x in ['ghelper', 'dusky', 'dolby', 'Dolby', 'rnnoise', 'effect_', 'peace'])
            if not skip and 'cs2' not in app_name:
                subprocess.run(['pactl', 'move-sink-input', current_id, target_sink], stderr=subprocess.DEVNULL)
            current_id = None
except Exception:
    pass
" "$NEXT_SINK" 2>/dev/null || true

notify-send -t 2000 -i "$NEXT_ICON" "Audio Output Switched" "${NEXT_PREFIX}${NEXT_DESC}"
