#!/usr/bin/env bash
# ==============================================================================
# screen-black: Instant DPMS toggle for overnight sleep audio & background tasks
# - Win+Alt+L toggles screen OFF / ON instantly.
# - Inhibits idle, sleep, and lid-close suspension (HandleLidSwitch blocked).
# - Pauses swayidle so no auto-lock or timeout can turn display back on.
# - Audio and background agents continue running indefinitely with lid closed.
# ==============================================================================
set -euo pipefail

export PATH="$HOME/.local/bin:/usr/bin:/bin:$PATH"

# Resolve Wayland / Sway environment
if [ -z "${SWAYSOCK:-}" ] || [ -z "${WAYLAND_DISPLAY:-}" ]; then
    while IFS='=' read -r k v; do
        case "$k" in
            SWAYSOCK|WAYLAND_DISPLAY|DISPLAY|XDG_CURRENT_DESKTOP)
                [ -n "$v" ] && export "$k"="$v"
                ;;
        esac
    done < <(systemctl --user show-environment 2>/dev/null || true)
fi

STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/screen-black.state"

# Check if eDP-1 is currently on
IS_ON="true"
if command -v jq >/dev/null 2>&1; then
    IS_ON=$(swaymsg -t get_outputs 2>/dev/null | jq -r '.[] | select(.name=="eDP-1") | .dpms' 2>/dev/null || echo "true")
fi

if [ -f "$STATE_FILE" ] || [ "$IS_ON" = "false" ]; then
    # --- SCREEN IS CURRENTLY OFF: REGAIN SCREEN IMMEDIATELY ---
    rm -f "$STATE_FILE"
    systemctl --user stop screen-black-inhibitor.service 2>/dev/null || true

    # Resume swayidle timer
    pkill -CONT -x swayidle 2>/dev/null || true

    # Turn display panel on
    swaymsg "output * dpms on" 2>/dev/null || true
    notify-send -a "Display" -t 1500 -i display "Display Restored" "Screen active"
else
    # --- SCREEN IS CURRENTLY ON: TURN OFF FOR OVERNIGHT SLEEP ---
    touch "$STATE_FILE"

    # Turn display panel off immediately
    swaymsg "output * dpms off" 2>/dev/null || true

    # Pause swayidle so timeouts or switch events cannot wake screen or lock session
    pkill -STOP -x swayidle 2>/dev/null || true

    # Start sleep, idle, and lid-close inhibitor as transient systemd user service
    systemctl --user stop screen-black-inhibitor.service 2>/dev/null || true
    systemd-run --user --unit=screen-black-inhibitor \
        systemd-inhibit --what=idle:sleep:handle-lid-switch \
        --who="screen-black" \
        --why="Overnight sleep audio and background tasks" \
        --mode=block \
        sleep infinity >/dev/null 2>&1
fi
