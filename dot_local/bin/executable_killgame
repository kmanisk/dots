#!/usr/bin/env bash
# ==============================================================================
# Emergency Game / Compositor Termination Script (killgame / kg)
# ==============================================================================
echo "==> Terminating hung game processes and compositors..."

# 1. Kill Games, Launchers, Wine/Proton processes, and Steam
killall -9 -v cs2 gamescope gamescopereaper steam steamwebhelper eldenring.exe GTAIV.exe PlayGTAIV.exe LaunchGTAIV.exe wineserver 2>/dev/null || true
pkill -9 -e -f "gamescope|cs2|steam|eldenring|gtaiv|wineserver|pressure-vessel" 2>/dev/null || true

# Session sidecars: ensure restore will never resurrect killed Steam
mkdir -p "$HOME/.config/sway/session" 2>/dev/null || true
touch "$HOME/.config/sway/session/steam_was_killed" 2>/dev/null || true
touch /tmp/steam_killed_by_user 2>/dev/null || true

# Desktop notification if GUI is alive
notify-send -t 2000 -i application-exit "Steam & Games Terminated" "All Steam and game processes force killed" 2>/dev/null || true

# 2. Restore display / bar (X11 only bits are gated; Wayland needs none)
if [ -n "$SWAYSOCK" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    swaymsg reload 2>/dev/null || true
else
    export DISPLAY="${DISPLAY:-:0}"
    xrandr --output eDP-1 --set "scaling mode" "Full aspect" 2>/dev/null || true
    xrandr --output eDP-1 --mode 1920x1200 --rate 165.00 2>/dev/null || xrandr --output eDP-1 --auto 2>/dev/null || true
    sh "$HOME/.fehbg" 2>/dev/null || true
    i3-msg restart 2>/dev/null || true
    "$HOME/.local/bin/bar-apply" 2>/dev/null || true
fi

# 3. Guidance message
echo ""
echo "==> Done! Return to your desktop by pressing: Ctrl + Alt + F2 (or Ctrl + Alt + Fn + F2)"
echo "==> If the screen is still black, run: sudo systemctl restart ly@tty2"
