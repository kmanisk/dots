#!/bin/sh
# ==============================================================================
# steam-workspace - Smart Steam Launcher & Focuser (Workspace 3)
# ==============================================================================
# - Cold boot: launches steam, lands on ws3, locks focus when window maps.
# - Background/tray: re-opens main window via steam://open/main, focuses on ws3.
# - Already visible: immediately switches to ws3 and focuses the window.
# ==============================================================================
set -u

WS=3

# Compositor IPC: swaymsg on Wayland, i3-msg on X11
IPC_CMD="i3-msg"
if [ -n "$SWAYSOCK" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    IPC_CMD="swaymsg"
fi

has_window() {
    $IPC_CMD -t get_tree 2>/dev/null | grep -qE '"instance": ?"steamwebhelper"'
}

if [ -n "${SWAYSOCK:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
    export STEAM_FORCE_DESKTOPUI_SCALING="${STEAM_FORCE_DESKTOPUI_SCALING:-1}"
fi

# Parse arguments
SILENT=0
for arg in "$@"; do
    case "$arg" in
        --silent|-s) SILENT=1 ;;
    esac
done

if [ "$SILENT" -eq 0 ]; then
    # Switch to workspace 3 when not launched in background
    $IPC_CMD "workspace number $WS" >/dev/null 2>&1
fi

if ! pgrep -x steam >/dev/null 2>&1; then
    # 1. Cold boot: Steam process is not running at all
    # If launched under prime-run (Win+Shift+G), keep the offload env
    # instead of letting the steam wrapper strip it.
    if [ -n "${__NV_PRIME_RENDER_OFFLOAD:-}" ]; then
        export STEAM_DGPU=1
    fi
    # STEAM_DGPU=1 without prime-run (rofi NVIDIA entry): apply the
    # offload env here, same values as prime-run.
    if [ "${STEAM_DGPU:-0}" = "1" ]; then
        export __NV_PRIME_RENDER_OFFLOAD=1 __VK_LAYER_NV_optimus=NVIDIA_only __GLX_VENDOR_LIBRARY_NAME=nvidia
    fi
    nohup steam -silent >/dev/null 2>&1 &
    if [ "$SILENT" -eq 0 ]; then
        (
            for _ in $(seq 1 30); do
                sleep 0.5
                if has_window; then
                    $IPC_CMD "[instance=\"steamwebhelper\"] focus; workspace number $WS" >/dev/null 2>&1
                    break
                fi
            done
        ) &
    fi
elif ! has_window; then
    # 2. Process is running in background/tray, but window is closed/hidden
    nohup steam steam://open/main >/dev/null 2>&1 &
    if [ "$SILENT" -eq 0 ]; then
        (
            for _ in $(seq 1 15); do
                sleep 0.2
                if has_window; then
                    $IPC_CMD "[instance=\"steamwebhelper\"] focus; workspace number $WS" >/dev/null 2>&1
                    break
                fi
            done
        ) &
    fi
else
    # 3. Window already exists
    if [ "$SILENT" -eq 0 ]; then
        $IPC_CMD "[instance=\"steamwebhelper\"] focus; workspace number $WS" >/dev/null 2>&1
    fi
fi
