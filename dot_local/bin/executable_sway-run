#!/usr/bin/env bash
# ==============================================================================
# Sway (Wayland) Launcher — ASUS TUF Gaming F16 (Dynamic GPU Architecture)
# ==============================================================================
# Supports:
# - Integrated : Intel UHD Graphics drives eDP-1; Intel VA-API; Intel CTM
# - Hybrid     : Intel UHD Graphics drives eDP-1; Intel VA-API; Intel CTM; dGPU sleeps
# - AsusMuxDgpu: NVIDIA RTX 5050 drives eDP-1; NVIDIA VA-API; nvibrant; direct scanout
# ==============================================================================

export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway
export XDG_SESSION_TYPE=wayland

# Mode detection via supergfxctl (queried once at login; cached in env & tmpfs RAM)
GPU_MODE="Hybrid"
if command -v supergfxctl >/dev/null 2>&1; then
    GPU_MODE="$(supergfxctl -g 2>/dev/null || echo 'Hybrid')"
fi
export GPU_MODE
echo "$GPU_MODE" > "${XDG_RUNTIME_DIR:-/run/user/$UID}/gpu_mode" 2>/dev/null || true

# Mode-aware VA-API driver selection
case "$GPU_MODE" in
    Integrated|Hybrid)
        export LIBVA_DRIVER_NAME=iHD
        ;;
    AsusMuxDgpu)
        export LIBVA_DRIVER_NAME=nvidia
        ;;
    *)
        unset LIBVA_DRIVER_NAME
        ;;
esac

# Wayland native toolkits
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export SDL_VIDEODRIVER="wayland,x11"
export CLUTTER_BACKEND=wayland
export _JAVA_AWT_WM_NONREPARENTING=1

# WLR cursor fallback for hybrid GPU configurations
export WLR_NO_HARDWARE_CURSORS=1

# Pin Sway compositor directly to Intel iGPU in Hybrid/Integrated modes to ensure RTX 5050 suspends
if [ "$GPU_MODE" = "Hybrid" ] || [ "$GPU_MODE" = "Integrated" ]; then
    if [ -e /dev/dri/by-path/pci-0000:00:02.0-card ]; then
        export WLR_DRM_DEVICES=/dev/dri/by-path/pci-0000:00:02.0-card
    elif [ -e /dev/dri/card1 ] && [ -e /dev/dri/card0 ]; then
        export WLR_DRM_DEVICES=/dev/dri/card1
    fi
fi

# Mode-specific hardware environment & display vibrance
case "$GPU_MODE" in
    AsusMuxDgpu)
        # Allow proprietary NVIDIA scanout on direct dGPU mode
        export SWAY_UNSUPPORTED_GPU=true
        ;;
esac

# Canonical mode-aware display vibrance application
if [ -x "$HOME/.local/bin/apply-vibrance" ]; then
    "$HOME/.local/bin/apply-vibrance" >/dev/null 2>&1 || true
fi

exec sway "$@"
