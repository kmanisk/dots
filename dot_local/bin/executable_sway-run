#!/usr/bin/env bash
# ==============================================================================
# Sway (Wayland) Launcher — ASUS TUF Gaming F16 (Dynamic GPU Architecture)
# ==============================================================================
# Supports:
# - Integrated : Intel UHD Graphics drives eDP-1; Intel VA-API; Intel CTM
# - Hybrid     : Intel UHD Graphics drives eDP-1; Intel VA-API; Intel CTM; dGPU sleeps
# - AsusMuxDgpu: NVIDIA RTX 5050 drives eDP-1; NVIDIA VA-API; nvibrant; direct scanout
# ==============================================================================

export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway
export XDG_SESSION_TYPE=wayland

# Mode detection via supergfxctl with hardware sysfs reconciliation
GPU_MODE="Hybrid"
if command -v supergfxctl >/dev/null 2>&1; then
    GPU_MODE="$(supergfxctl -g 2>/dev/null || echo 'Hybrid')"
fi

# Reconcile with live ASUS hardware sysfs (handles pending reboot states cleanly)
if [ -r /sys/class/firmware-attributes/asus-armoury/attributes/dgpu_disable/current_value ]; then
    dgpu_off="$(cat /sys/class/firmware-attributes/asus-armoury/attributes/dgpu_disable/current_value 2>/dev/null || echo 0)"
    if [ "$dgpu_off" = "1" ]; then
        GPU_MODE="Integrated"
    fi
fi
if [ "$GPU_MODE" != "Integrated" ] && [ -r /sys/class/firmware-attributes/asus-armoury/attributes/gpu_mux_mode/current_value ]; then
    hw_mux="$(cat /sys/class/firmware-attributes/asus-armoury/attributes/gpu_mux_mode/current_value 2>/dev/null || echo "")"
    if [ "$hw_mux" = "1" ] && [ "$GPU_MODE" = "AsusMuxDgpu" ]; then
        GPU_MODE="Hybrid"
    elif [ "$hw_mux" = "0" ]; then
        GPU_MODE="AsusMuxDgpu"
    fi
fi

export GPU_MODE
echo "$GPU_MODE" > "${XDG_RUNTIME_DIR:-/run/user/$UID}/gpu_mode" 2>/dev/null || true

# Mode-aware VA-API driver selection
case "$GPU_MODE" in
    Integrated|Hybrid)
        export LIBVA_DRIVER_NAME=iHD
        ;;
    AsusMuxDgpu)
        export LIBVA_DRIVER_NAME=nvidia
        ;;
    *)
        unset LIBVA_DRIVER_NAME
        ;;
esac

# Wayland native toolkits
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export SDL_VIDEODRIVER="wayland,x11"
export CLUTTER_BACKEND=wayland
export _JAVA_AWT_WM_NONREPARENTING=1
# ArtCraft Suite Wayland integration
export GRIDCRAFT_WAYLAND=1
export WORDCRAFT_WAYLAND=1
export FILMCRAFT_WAYLAND=1
export PHOTOCRAFT_NATIVE_WAYLAND=1
# WLR cursor fallback for NVIDIA and hybrid GPU configurations (fixes invisible cursor in Xwayland/Steam)
export WLR_NO_HARDWARE_CURSORS=1
export XCURSOR_PATH="$HOME/.local/share/icons:$HOME/.icons:/usr/share/icons:/usr/share/pixmaps"

# Pin Sway compositor directly to Intel iGPU in Hybrid/Integrated modes to ensure RTX 5050 suspends.
# Note: wlroots splits WLR_DRM_DEVICES on ':'. Never pass '/dev/dri/by-path/...' directly
# because PCI identifiers contain colons (e.g. pci-0000:00:02.0-card), breaking wlroots path parsing.
# Resolve the real device path without colons (e.g. /dev/dri/card1).
if [ "$GPU_MODE" = "Hybrid" ] || [ "$GPU_MODE" = "Integrated" ]; then
    INTEL_CARD=""
    if [ -e /dev/dri/by-path/pci-0000:00:02.0-card ]; then
        INTEL_CARD="$(readlink -f /dev/dri/by-path/pci-0000:00:02.0-card 2>/dev/null || true)"
    elif [ -e /dev/dri/card1 ] && [ -e /dev/dri/card0 ]; then
        INTEL_CARD="/dev/dri/card1"
    fi
    if [ -n "$INTEL_CARD" ] && [ -e "$INTEL_CARD" ]; then
        export WLR_DRM_DEVICES="$INTEL_CARD"
    fi
fi

# Mode-specific hardware environment & display vibrance
case "$GPU_MODE" in
    AsusMuxDgpu)
        # Allow proprietary NVIDIA scanout on direct dGPU mode
        export SWAY_UNSUPPORTED_GPU=true
        # Use Vulkan renderer: wlroots Vulkan path handles linux-drm-syncobj-v1 explicit sync
        # with NVIDIA correctly; the default OpenGL renderer can produce protocol violation
        # (error 3: Acquire point set but no buffer attached) crashing Wayland clients like CS2.
        export WLR_RENDERER=vulkan
        ;;
esac

# Canonical mode-aware display vibrance application
if [ -x "$HOME/.local/bin/apply-vibrance" ]; then
    "$HOME/.local/bin/apply-vibrance" >/dev/null 2>&1 || true
fi

exec sway "$@"
