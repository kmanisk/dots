#!/usr/bin/env bash
# ==============================================================================
# hudtest: Toggle MangoHud telemetry preview on a spinning Vulkan cube
# ==============================================================================
if pgrep -x vkcube >/dev/null; then
    pkill -x vkcube
    exit 0
fi

TARGET_CONFIG="$1"
if [[ -n "$TARGET_CONFIG" && -f "$TARGET_CONFIG" ]]; then
    export MANGOHUD_CONFIGFILE="$TARGET_CONFIG"
    shift
fi

# Previews must always show the HUD even though the default preset hides it
# for games. read_cfg keeps the config file in the chain (a bare MANGOHUD_CONFIG
# would replace it entirely); no_display=0 is then applied last and wins.
export MANGOHUD_CONFIG="read_cfg,no_display=0"

exec prime-run mangohud vkcube "$@"
