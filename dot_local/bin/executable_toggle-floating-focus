#!/usr/bin/env bash
# toggle-floating-focus — flip focus between the floating layer and the
# tiled/tabbed layer of the current workspace.
#
# If a floating window is focused, focus moves to the last focused
# tiled/tabbed container underneath (swaymsg focus tiling).
# Otherwise focus returns to the most recent floating window
# (swaymsg focus floating). This never changes window floating STATE,
# only which layer receives input.

set -euo pipefail

floating_focused=$(swaymsg -t get_tree --raw 2>/dev/null \
    | jq -r '[.. | objects | select(.type? == "floating_con" and .focused? == true)] | length')

if [ "${floating_focused:-0}" -gt 0 ]; then
    swaymsg focus tiling >/dev/null 2>&1
else
    swaymsg focus floating >/dev/null 2>&1
fi
