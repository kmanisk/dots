#!/usr/bin/env bash
# ==============================================================================
# Fullscreen Screenshot -> ~/Pictures/Screenshots + Clipboard (X11 & Wayland)
# Keybind: Win+Shift+S (Sway & i3)
# Features:
#   - Atomic flock (FD 200): prevents multi-keybind spamming
#   - Zero memory footprint: runs ephemerally, exits immediately
# ==============================================================================
set -euo pipefail

LOCK_FILE="/tmp/screenshot-fullscreen.lock"
exec 200>"$LOCK_FILE"
if ! flock -n 200; then
    exit 0
fi

# Ensure Wayland / Sway / X11 environment is present (e.g. when spawned from xremap)
if [ -z "${SWAYSOCK:-}" ] || [ -z "${WAYLAND_DISPLAY:-}" ]; then
    if command -v systemctl >/dev/null 2>&1; then
        while IFS='=' read -r k v; do
            case "$k" in
                SWAYSOCK|WAYLAND_DISPLAY|DISPLAY|XDG_CURRENT_DESKTOP)
                    [ -n "$v" ] && export "$k"="$v"
                    ;;
            esac
        done < <(systemctl --user show-environment 2>/dev/null || true)
    fi
fi
if [ -z "${SWAYSOCK:-}" ]; then
    for s in /run/user/"$UID"/sway-ipc.*.sock /tmp/sway-ipc.*.sock; do
        if [ -S "$s" ]; then
            export SWAYSOCK="$s"
            break
        fi
    done
fi
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for w in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/wayland-*; do
        if [ -S "$w" ]; then
            export WAYLAND_DISPLAY="$(basename "$w")"
            break
        fi
    done
fi

export LD_LIBRARY_PATH="$HOME/.local/lib:${LD_LIBRARY_PATH:-}"
export PATH="$HOME/.gemini/antigravity-cli/bin:$HOME/.local/bin:$PATH"
export DISPLAY="${DISPLAY:-:0}"

SAVE=1
[ "${1:-}" = "--clipboard-only" ] && SAVE=0

# Detect workspace: Workspace 3 (Steam/Games) and Workspace 4 (Active Game) or active game window
IS_GAMING=0
CURRENT_WS=""
FOCUSED_APP=""
if [ -n "${SWAYSOCK:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
    CURRENT_WS="$(swaymsg -t get_workspaces 2>/dev/null | jq -r '.[] | select(.focused) | .name' 2>/dev/null || true)"
    FOCUSED_APP="$(swaymsg -t get_tree 2>/dev/null | jq -r '.. | select(.focused? == true) | (.app_id // .window_properties.class // "")' 2>/dev/null || true)"
else
    CURRENT_WS="$(i3-msg -t get_workspaces 2>/dev/null | jq -r '.[] | select(.focused) | .name' 2>/dev/null || true)"
    FOCUSED_APP="$(i3-msg -t get_tree 2>/dev/null | jq -r '.. | select(.focused? == true) | (.window_properties.class // "")' 2>/dev/null || true)"
fi

if [ "$CURRENT_WS" = "4" ] || [ "$CURRENT_WS" = "3" ] || [[ "$FOCUSED_APP" =~ (steam_app|eldenring|cs2|gamescope|darksouls|GTAIV) ]]; then
    IS_GAMING=1
    SAVE=1
fi

if [ "$SAVE" = 1 ]; then
    if [ "$IS_GAMING" = 1 ]; then
        DIR="$HOME/Pictures/Screenshots/Gaming"
    else
        DIR="$HOME/Pictures/Screenshots"
    fi
    mkdir -p "$DIR"
    FILE="$DIR/screenshot-$(date +%Y-%m-%d_%H-%M-%S)_$$.png"
else
    FILE="/tmp/screenshot_fullscreen_$(date +%s).png"
fi

if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${SWAYSOCK:-}" ]; then
    if grim "$FILE" 2>/dev/null && [ -s "$FILE" ]; then
        flock -u 200 2>/dev/null || true
        exec 200>&-
        wl-copy -t image/png < "$FILE"
        if [ "$SAVE" = 1 ]; then
            if [ "$IS_GAMING" = 1 ]; then
                notify-send -a "Gaming Screenshot" -t 1500 -i camera-photo "Gaming Screenshot" "Saved to Screenshots/Gaming + clipboard"
            else
                BUF_DIR="${XDG_RUNTIME_DIR:-/tmp}/screenshot-buffer-$UID"
                mkdir -p "$BUF_DIR"
                cp "$FILE" "$BUF_DIR/shot_$(date +%s%N).png"
                count=$(find "$BUF_DIR" -maxdepth 1 -name "shot_*.png" 2>/dev/null | wc -l)
                notify-send -a "Screenshot Buffer" -t 1500 -i camera-photo "Screenshot Buffered" "#$count in queue. Caps+Shift+Space to pick."
            fi
        else
            rm -f "$FILE"
            notify-send -a "Screenshot" -t 1500 -i camera-photo "Screenshot" "Fullscreen copied to clipboard"
        fi
    else
        flock -u 200 2>/dev/null || true
        exec 200>&-
        notify-send -a "Screenshot" -t 1500 -i dialog-error "Screenshot Failed"
        rm -f "$FILE"
    fi
else
    if maim "$FILE" 2>/dev/null && [ -s "$FILE" ]; then
        flock -u 200 2>/dev/null || true
        exec 200>&-
        timeout 2s xclip -selection clipboard -t image/png -i "$FILE" 2>/dev/null || true
        if [ "$SAVE" = 1 ]; then
            if [ "$IS_GAMING" = 1 ]; then
                notify-send -a "Gaming Screenshot" -t 1500 -i camera-photo "Gaming Screenshot" "Saved to Screenshots/Gaming + clipboard"
            else
                BUF_DIR="${XDG_RUNTIME_DIR:-/tmp}/screenshot-buffer-$UID"
                mkdir -p "$BUF_DIR"
                cp "$FILE" "$BUF_DIR/shot_$(date +%s%N).png"
                count=$(find "$BUF_DIR" -maxdepth 1 -name "shot_*.png" 2>/dev/null | wc -l)
                notify-send -a "Screenshot Buffer" -t 1500 -i camera-photo "Screenshot Buffered" "#$count in queue. Caps+Shift+Space to pick."
            fi
        else
            notify-send -a "Screenshot" -t 1500 -i camera-photo "Screenshot" "Fullscreen copied to clipboard"
            rm -f "$FILE"
        fi
    else
        flock -u 200 2>/dev/null || true
        exec 200>&-
        notify-send -a "Screenshot" -t 1500 -i dialog-error "Screenshot Failed"
        rm -f "$FILE"
    fi
fi
