#!/bin/sh
# ==============================================================================
# artcraft - one manager for every ArtCraft app shipped as an Arch package
# ==============================================================================
# All thirteen ArtCraft tools publish `*-linux-x86_64.pkg.tar.zst` on GitHub
# releases and are not in the Arch repos or a working AUR entry, so `pacman -Syu`
# never updates them. This wrapper tracks every app, verifies the release
# checksum, installs with `pacman -U`, and reports what is behind.
#
#   artcraft list                 installed vs latest for every app
#   artcraft list --refresh       bypass the 6 hour release cache
#   artcraft check                machine-readable check (exit 10 = update available)
#   artcraft install <app|all>    install or upgrade one or more apps
#   artcraft update [app|all]     upgrade installed apps (default: all installed)
#   artcraft remove <app|all>     uninstall
#   artcraft launch <app>         start an installed app
#   artcraft scale <percent>      set the interface size for installed apps
#
# Apps: photocraft vectorcraft filmcraft lightcraft pdfcraft effectcraft
#       designcraft wordcraft figcraft soundcraft deckcraft cadcraft gridcraft
#
# Releases are cached in ~/.cache/artcraft for 6 hours to stay well inside the
# unauthenticated GitHub API limit. Snapper's pacman hook snapshots every
# install, so no manual snapshot step is needed here.
#
# Interface size lives in the app's own config: `ui_scale` (a multiplier) in
# ~/.config/<app>/app.ron for the egui apps, `uiScale` (a percentage) in
# ~/.config/<app>/ui.json for WordCraft. `artcraft scale` writes whichever one
# the app actually uses and keeps a .artcraft-bak copy of the file.
# ==============================================================================
set -eu

APPS="photocraft vectorcraft filmcraft lightcraft pdfcraft effectcraft designcraft wordcraft figcraft soundcraft deckcraft cadcraft gridcraft"
ARCH="x86_64"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/artcraft"
RELEASE_CACHE="$CACHE_DIR/releases.tsv"
NOTIFIED="$CACHE_DIR/notified.tsv"
CACHE_TTL=21600

mkdir -p "$CACHE_DIR"

say() { [ "${QUIET:-0}" -eq 1 ] || printf '%s\n' "$*"; }
die() { printf 'artcraft: %s\n' "$*" >&2; exit 1; }

have_notify=0
command -v notify-send >/dev/null 2>&1 && have_notify=1
notify() {
    [ "$have_notify" -eq 1 ] || return 0
    notify-send -a "ArtCraft" -i application-x-executable "$1" "$2" 2>/dev/null || true
}

pkg_name() { printf 'ai.storyteller.%s' "$1"; }

is_app() {
    for a in $APPS; do [ "$a" = "$1" ] && return 0; done
    return 1
}

installed_version() {
    pacman -Q "$(pkg_name "$1")" 2>/dev/null | awk '{print $2}' | sed 's/-[0-9]*$//'
}

# ---- release metadata --------------------------------------------------------
# Emits one line per app: name <TAB> version <TAB> prerelease <TAB> asset
fetch_releases() {
    python3 - "$@" <<'PY'
import json, sys, urllib.request
for name in sys.argv[1:]:
    url = f"https://api.github.com/repos/storytold/{name}/releases/latest"
    req = urllib.request.Request(url, headers={"User-Agent": "artcraft-wrapper"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            d = json.load(r)
        tag = str(d.get("tag_name", "")).lstrip("v")
        pre = "1" if d.get("prerelease") else "0"
        asset = ""
        for a in d.get("assets", []):
            n = a.get("name", "")
            if n.endswith("-linux-x86_64.pkg.tar.zst"):
                asset = n
                break
        print(f"{name}\t{tag}\t{pre}\t{asset}")
    except Exception:
        print(f"{name}\t\t\t")
PY
}

load_releases() {
    local refresh="${1:-0}" now age
    now=$(date +%s)
    if [ "$refresh" -eq 1 ] || [ ! -s "$RELEASE_CACHE" ]; then
        fetch_releases $APPS > "$RELEASE_CACHE.tmp"
        mv "$RELEASE_CACHE.tmp" "$RELEASE_CACHE"
        return 0
    fi
    age=$(( now - $(stat -c %Y "$RELEASE_CACHE" 2>/dev/null || echo 0) ))
    if [ "$age" -gt "$CACHE_TTL" ]; then
        fetch_releases $APPS > "$RELEASE_CACHE.tmp"
        mv "$RELEASE_CACHE.tmp" "$RELEASE_CACHE"
    fi
}

latest_version() { awk -F'\t' -v a="$1" '$1 == a {print $2}' "$RELEASE_CACHE"; }
latest_asset()   { awk -F'\t' -v a="$1" '$1 == a {print $4}' "$RELEASE_CACHE"; }

# ---- commands ----------------------------------------------------------------
cmd_list() {
    local refresh=0 status installed latest
    for arg in "$@"; do
        [ "$arg" = "--refresh" ] && refresh=1
    done
    load_releases "$refresh"
    printf '%-12s %-11s %-11s %s\n' APP INSTALLED LATEST STATUS
    for app in $APPS; do
        installed=$(installed_version "$app")
        latest=$(latest_version "$app")
        if [ -z "$latest" ]; then
            status="release lookup failed"
        elif [ -z "$installed" ]; then
            status="not installed"
        elif [ "$(vercmp "$latest" "$installed")" -gt 0 ]; then
            status="update available"
        else
            status="up to date"
        fi
        printf '%-12s %-11s %-11s %s\n' "$app" "${installed:--}" "${latest:-?}" "$status"
    done
}

cmd_check() {
    local updates="" new_notifications="" installed latest
    load_releases 0
    for app in $APPS; do
        installed=$(installed_version "$app")
        [ -n "$installed" ] || continue
        latest=$(latest_version "$app")
        [ -n "$latest" ] || continue
        if [ "$(vercmp "$latest" "$installed")" -gt 0 ]; then
            updates="${updates}${app} ${installed} -> ${latest}; "
            if ! grep -qx "${app}	${latest}" "$NOTIFIED" 2>/dev/null; then
                new_notifications="${new_notifications}${app} ${installed}->${latest}, "
                printf '%s\t%s\n' "$app" "$latest" >> "$NOTIFIED"
            fi
        fi
    done
    if [ -z "$updates" ]; then
        say "All installed ArtCraft apps are up to date."
        exit 0
    fi
    say "Updates available: ${updates%; }"
    if [ -n "$new_notifications" ]; then
        notify "ArtCraft updates" "${new_notifications%, }. Run: artcraft update"
    fi
    exit 10
}

install_one() {
    local app="$1" version="$2" asset="$3" tmp base expected actual
    local pkg; pkg=$(pkg_name "$app")

    if [ -z "$version" ] || [ -z "$asset" ]; then
        printf 'artcraft: no Arch package found for %s\n' "$app" >&2
        return 1
    fi

    tmp=$(mktemp -d "${TMPDIR:-/tmp}/artcraft.XXXXXX") || return 1
    trap 'rm -rf "$tmp"' EXIT INT TERM
    base="https://github.com/storytold/$app/releases/download/v$version"

    say "Fetching $app $version..."
    curl -fsSL --max-time 60 -o "$tmp/SHA256SUMS.txt" "$base/SHA256SUMS.txt" || {
        trap - EXIT INT TERM; rm -rf "$tmp"; printf 'artcraft: %s checksum list download failed\n' "$app" >&2; return 1; }
    curl -fsSL --max-time 600 -o "$tmp/$asset" "$base/$asset" || {
        trap - EXIT INT TERM; rm -rf "$tmp"; printf 'artcraft: %s package download failed\n' "$app" >&2; return 1; }

    expected=$(awk -v a="$asset" '$2 == a {print $1}' "$tmp/SHA256SUMS.txt")
    actual=$(sha256sum "$tmp/$asset" | awk '{print $1}')
    if [ -z "$expected" ] || [ "$expected" != "$actual" ]; then
        trap - EXIT INT TERM; rm -rf "$tmp"
        printf 'artcraft: %s checksum mismatch, refusing to install\n' "$app" >&2
        return 1
    fi

    sudo pacman -U --noconfirm "$tmp/$asset" >/dev/null || {
        trap - EXIT INT TERM; rm -rf "$tmp"
        printf 'artcraft: pacman failed for %s\n' "$app" >&2
        return 1; }

    trap - EXIT INT TERM
    rm -rf "$tmp"
    say "Installed $app $(installed_version "$app")"
}

cmd_install() {
    local apps="$*" app installed latest asset rc=0
    [ -n "$apps" ] || die "install needs an app name or 'all'"
    case "$apps" in *all*) apps="$APPS" ;; esac
    for app in $apps; do
        is_app "$app" || die "unknown app: $app"
    done
    load_releases 0
    for app in $apps; do
        installed=$(installed_version "$app")
        latest=$(latest_version "$app")
        asset=$(latest_asset "$app")
        if [ -n "$installed" ] && [ -n "$latest" ] && [ "$(vercmp "$latest" "$installed")" -le 0 ]; then
            say "$app $installed is already current"
            continue
        fi
        install_one "$app" "$latest" "$asset" || rc=1
    done
    return "$rc"
}

cmd_update() {
    local apps="$*" app installed latest asset rc=0
    if [ -z "$apps" ]; then
        apps=""
        for app in $APPS; do
            [ -n "$(installed_version "$app")" ] && apps="$apps $app"
        done
        [ -n "$apps" ] || die "no ArtCraft apps installed"
    fi
    case "$apps" in *all*) apps="$APPS" ;; esac
    load_releases 1
    for app in $apps; do
        is_app "$app" || die "unknown app: $app"
        installed=$(installed_version "$app")
        latest=$(latest_version "$app")
        asset=$(latest_asset "$app")
        if [ -z "$installed" ]; then
            say "$app is not installed; use 'artcraft install $app'"
            continue
        fi
        if [ -z "$latest" ] || [ -z "$asset" ]; then
            say "$app: no release metadata available"
            continue
        fi
        if [ "$(vercmp "$latest" "$installed")" -le 0 ]; then
            say "$app $installed is already current"
            continue
        fi
        install_one "$app" "$latest" "$asset" || rc=1
    done
    return "$rc"
}

cmd_remove() {
    local app
    [ -n "${1:-}" ] || die "remove needs an app name or 'all'"
    case "$1" in all) set -- $APPS ;; esac
    for app in "$@"; do
        is_app "$app" || die "unknown app: $app"
        if [ -z "$(installed_version "$app")" ]; then
            say "$app is not installed"
            continue
        fi
        sudo pacman -Rns --noconfirm "$(pkg_name "$app")" >/dev/null || die "pacman failed for $app"
        say "Removed $app"
    done
}

cmd_launch() {
    local app="${1:-}"
    [ -n "$app" ] || die "launch needs an app name"
    is_app "$app" || die "unknown app: $app"
    [ -n "$(installed_version "$app")" ] || die "$app is not installed"
    command -v "$app" >/dev/null 2>&1 || die "$app has no launcher in PATH"
    exec "$app" >/dev/null 2>&1 &
}

cmd_scale() {
    local pct="${1:-}"
    case "$pct" in
        ''|*[!0-9]*) die "scale needs a percentage, e.g. 'artcraft scale 125'" ;;
    esac
    [ "$pct" -ge 50 ] && [ "$pct" -le 300 ] || die "scale must be between 50 and 300"
    shift
    if [ $# -gt 0 ]; then
        case "$1" in all) set -- $APPS ;; esac
        for app in "$@"; do is_app "$app" || die "unknown app: $app"; done
    else
        set -- $APPS
    fi
    python3 - "$pct" "$@" <<'PY'
import json, os, re, shutil, sys

pct = int(sys.argv[1])
apps = sys.argv[2:]
mult = round(pct / 100, 4)


def loads_lenient(text):
    return json.loads(re.sub(r',(\s*[}\]])', r'\1', text))


def backup(path):
    shutil.copy2(path, path + '.artcraft-bak')


changed = []
missing = []

for app in apps:
    base = os.path.expanduser(f'~/.config/{app}')
    if not os.path.isdir(base):
        continue

    ui_json = os.path.join(base, 'ui.json')
    app_ron = os.path.join(base, 'app.ron')
    done = False

    if os.path.exists(ui_json):
        try:
            data = loads_lenient(open(ui_json).read())
        except Exception:
            data = None
        if isinstance(data, dict) and 'uiScale' in data:
            data['uiScale'] = pct
            backup(ui_json)
            with open(ui_json, 'w') as f:
                f.write(json.dumps(data, indent=2) + '\n')
            changed.append((app, 'ui.json', f'uiScale={pct}'))
            done = True

    if not done and os.path.exists(app_ron):
        try:
            outer = loads_lenient(open(app_ron).read())
        except Exception:
            outer = None
        if isinstance(outer, dict):
            for key, value in list(outer.items()):
                if not isinstance(value, str) or not value.lstrip().startswith('{'):
                    continue
                try:
                    inner = loads_lenient(value)
                except Exception:
                    continue
                if not isinstance(inner, dict):
                    continue
                inner['ui_scale'] = mult
                outer[key] = json.dumps(inner, separators=(',', ':'))
                backup(app_ron)
                with open(app_ron, 'w') as f:
                    f.write(json.dumps(outer, indent=4) + '\n')
                changed.append((app, 'app.ron', f'ui_scale={mult}'))
                done = True
                break

    if not done:
        missing.append(app)

for app, path, value in changed:
    print(f'{app}: {path} -> {value}')
for app in missing:
    print(f'{app}: no scaling setting found (open Preferences once and set Interface size)')
if changed:
    print('Restart any running ArtCraft app to apply.')
if not changed:
    sys.exit(1)
PY
}

usage() {
    sed -n '3,25p' "$0" | sed 's/^# \{0,1\}//'
    printf '\nUsage: artcraft <list|check|install|update|remove|launch|scale> [app|all]\n'
}

[ $# -gt 0 ] || { usage; exit 2; }

CMD="$1"; shift
case "$CMD" in
    list|status)  cmd_list "$@" ;;
    check)        QUIET=0; cmd_check "$@" ;;
    install)      cmd_install "$@" ;;
    update)       cmd_update "$@" ;;
    remove)       cmd_remove "$@" ;;
    launch)       cmd_launch "$@" ;;
    scale)        cmd_scale "$@" ;;
    -h|--help|help) usage ;;
    *)            usage; exit 2 ;;
esac
