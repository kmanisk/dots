#!/usr/bin/env bash
# ==============================================================================
# Interactive Region Screenshot -> Clipboard (X11 & Wayland)
# Keybind: Win+S (clipboard only) / Win+Ctrl+S --save (file + clipboard)
# ==============================================================================
# Ensure Wayland / Sway / X11 environment is present (e.g. when spawned from xremap)
if [ -z "${SWAYSOCK:-}" ] || [ -z "${WAYLAND_DISPLAY:-}" ]; then
    if command -v systemctl >/dev/null 2>&1; then
        while IFS='=' read -r k v; do
            case "$k" in
                SWAYSOCK|WAYLAND_DISPLAY|DISPLAY|XDG_CURRENT_DESKTOP)
                    [ -n "$v" ] && export "$k"="$v"
                    ;;
            esac
        done < <(systemctl --user show-environment 2>/dev/null || true)
    fi
fi
if [ -z "${SWAYSOCK:-}" ]; then
    for s in /run/user/"$UID"/sway-ipc.*.sock /tmp/sway-ipc.*.sock; do
        if [ -S "$s" ]; then
            export SWAYSOCK="$s"
            break
        fi
    done
fi
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for w in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/wayland-*; do
        if [ -S "$w" ]; then
            export WAYLAND_DISPLAY="$(basename "$w")"
            break
        fi
    done
fi

export LD_LIBRARY_PATH="$HOME/.local/lib:${LD_LIBRARY_PATH:-}"
export PATH="$HOME/.gemini/antigravity-cli/bin:$HOME/.local/bin:$PATH"
export DISPLAY="${DISPLAY:-:0}"

[ -f "$HOME/.local/state/theme/colors.sh" ] && source "$HOME/.local/state/theme/colors.sh"

SAVE=0
[ "${1:-}" = "--save" ] && SAVE=1

if [ "$SAVE" = 1 ]; then
    mkdir -p "$HOME/Pictures/Screenshots"
    FILE="$HOME/Pictures/Screenshots/snip-$(date +%Y-%m-%d_%H-%M-%S)_$$.png"
else
    FILE="/tmp/screenshot_$(date +%s).png"
fi

# Select region and capture
if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${SWAYSOCK:-}" ]; then
    BORDER_COL="${THEME_ACCENT:-#58a6ff}ff"
    BG_COL="${THEME_BG:-#000000}80"
    SEL_COL="${THEME_ACCENT:-#58a6ff}33"
    GEOM=$(slurp -b "$BG_COL" -c "$BORDER_COL" -s "$SEL_COL" 2>/dev/null)
    [ -z "$GEOM" ] && exit 0
    if grim -g "$GEOM" "$FILE" 2>/dev/null && [ -s "$FILE" ]; then
        wl-copy -t image/png < "$FILE"
        BUF_DIR="${XDG_RUNTIME_DIR:-/tmp}/screenshot-buffer-$UID"
        if [ -f "$BUF_DIR/.auto_mode" ]; then
            mkdir -p "$BUF_DIR"
            cp "$FILE" "$BUF_DIR/shot_$(date +%s%N).png"
            count=$(find "$BUF_DIR" -maxdepth 1 -name "shot_*.png" 2>/dev/null | wc -l)
            notify-send -a "Screenshot" -t 1500 -i camera-photo "Screenshot Buffered" "#$count in queue. Caps+Shift+Space to pick."
            [ "$SAVE" = 0 ] && rm -f "$FILE"
        elif [ "$SAVE" = 1 ]; then
            notify-send -a "Screenshot" -t 1500 -i camera-photo "Screenshot" "Region saved to Screenshots + clipboard"
        else
            rm -f "$FILE"
            notify-send -a "Screenshot" -t 1500 -i camera-photo "Screenshot" "Region copied to clipboard"
        fi
    fi
else
    if maim -s "$FILE" 2>/dev/null; then
        if [ -s "$FILE" ]; then
            xclip -selection clipboard -t image/png -i "$FILE"
            if [ "$SAVE" = 1 ]; then
                notify-send -t 1500 -i camera-photo "Screenshot" "Region saved to Screenshots + clipboard"
            else
                notify-send -t 1500 -i camera-photo "Screenshot" "Region copied to clipboard"
                rm -f "$FILE"
            fi
        fi
    fi
fi
