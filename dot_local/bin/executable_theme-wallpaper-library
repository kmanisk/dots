#!/usr/bin/env python3
"""Build and maintain the centralized theme wallpaper library.

The normal theme switch path never calls the network. This helper is an explicit,
one-shot maintenance command that selects SFW, high-resolution Wallhaven images,
rejects known AI-generation metadata, stores each local asset once, and maps every
compiled system theme to three palette-matched assets.
"""
from __future__ import annotations

import json
import math
import colorsys
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path

THEME_CACHE = Path(os.path.expanduser("~/.cache/theme/themes"))
ROOT = Path(os.path.expanduser("~/.local/share/theme/wallpapers"))
ASSETS = ROOT / "assets"
UPSTREAM = ROOT / "upstream"
MANIFEST = ROOT / "manifest.json"
OLD_CACHE = Path(os.path.expanduser("~/.cache/theme/wallpapers"))

WALLHAVEN_API = "https://wallhaven.cc/api/v1"
USER_AGENT = "theme-wallpaper-library/1.0"
API_INTERVAL = 1.50  # official unauthenticated limit is 45 requests/minute
SEARCH_PAGES = 3
ACCEPTED_POOL = 6
ASSETS_PER_BUCKET = 4
THEME_CHOICES = 3
MAX_SOURCE_BYTES = 50 * 1024 * 1024
DOWNLOAD_WORKERS = 2
TARGET_BOX = "2560x1600>"
WEBP_QUALITY = "92"
SCHEMA = 1
HUMAN_PROVENANCE_CUTOFF = "2022-01-01"

# Wallhaven's documented discrete color search palette.
WALLHAVEN_COLORS = (
    "660000", "990000", "cc0000", "cc3333", "ea4c88", "993399", "663399",
    "333399", "0066cc", "0099cc", "66cccc", "77cc33", "669900", "336600",
    "666600", "999900", "cccc33", "ffff00", "ffcc33", "ff9900", "ff6600",
    "cc6633", "996633", "663300", "000000", "424153", "999999", "cccccc",
    "ffffff",
)

AI_TAG_TERMS = (
    "ai art", "ai-generated", "ai generated", "generated by ai", "generative ai",
    "artificial intelligence", "midjourney", "stable diffusion", "stable-diffusion",
    "dall-e", "dalle", "novelai", "novel ai", "comfyui", "automatic1111",
    "leonardo ai", "flux ai", "flux.1", "firefly ai",
)
AI_SOURCE_TERMS = (
    "civitai.com", "openart.ai", "lexica.art", "midjourney.com", "nightcafe",
    "tensor.art", "seaart.ai", "leonardo.ai", "mage.space", "playgroundai.com",
    "prompthero.com", "dream.ai", "wombo.art",
)
IMAGE_SUFFIXES = {".jpg", ".jpeg", ".png", ".webp"}

_api_lock = threading.Lock()
_last_api_at = 0.0


def log(message: str) -> None:
    print(f"wallpaper-library: {message}", flush=True)


def die(message: str, code: int = 1) -> None:
    print(f"wallpaper-library: {message}", file=sys.stderr)
    raise SystemExit(code)


def which(command: str) -> str | None:
    return shutil.which(command)


def atomic_write(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp_name, path)
    finally:
        try:
            os.unlink(tmp_name)
        except FileNotFoundError:
            pass


def write_json(path: Path, payload: dict) -> None:
    atomic_write(path, (json.dumps(payload, indent=2, sort_keys=True) + "\n").encode())


def sync_manifest_to_chezmoi() -> None:
    """Keep the small provenance/mapping manifest in the chezmoi source."""
    chezmoi = which("chezmoi")
    if not chezmoi:
        return
    result = subprocess.run(
        [chezmoi, "add", str(MANIFEST)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        log(f"warning: chezmoi did not record manifest: {result.stderr.strip()}")


def clean_hex(value: object, default: str = "#808080") -> str:
    text = str(value or "").strip().lower()
    if not text.startswith("#"):
        text = "#" + text
    return text if re.fullmatch(r"#[0-9a-f]{6}", text) else default


def rgb(value: str) -> tuple[int, int, int]:
    h = clean_hex(value).lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def srgb_linear(channel: int) -> float:
    c = channel / 255.0
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def luminance(value: str) -> float:
    r, g, b = rgb(value)
    return 0.2126 * srgb_linear(r) + 0.7152 * srgb_linear(g) + 0.0722 * srgb_linear(b)


def color_distance(a: str, b: str) -> float:
    ar, ag, ab = rgb(a)
    br, bg, bb = rgb(b)
    # Weighted RGB distance favors perceptually important green differences.
    return math.sqrt(2 * (ar - br) ** 2 + 4 * (ag - bg) ** 2 + 3 * (ab - bb) ** 2)


def nearest_bucket(color: str) -> str:
    return min(WALLHAVEN_COLORS, key=lambda item: color_distance(color, "#" + item))


def average_palette_luminance(colors: list[str]) -> float:
    vals = [luminance(c) for c in colors if re.fullmatch(r"#[0-9a-fA-F]{6}", str(c))]
    return sum(vals) / len(vals) if vals else 0.5


def color_saturation(value: str) -> float:
    r, g, b = rgb(value)
    return colorsys.rgb_to_hsv(r / 255.0, g / 255.0, b / 255.0)[1]


def analyze_local_image(path: Path) -> dict:
    """Extract a small deterministic visual profile from the actual local image."""
    magick = which("magick")
    if not magick:
        raise RuntimeError("ImageMagick 'magick' is required for visual wallpaper analysis")
    result = subprocess.run(
        [
            magick, str(path),
            "-auto-orient", "-resize", "96x60>",
            "+dither", "-colors", "12",
            "-format", "%c", "histogram:info:-",
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=20,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or f"magick exited {result.returncode}")

    entries: list[tuple[int, str]] = []
    for line in result.stdout.splitlines():
        match = re.match(r"\s*(\d+):.*#([0-9A-Fa-f]{6})(?:[0-9A-Fa-f]{2})?\b", line)
        if not match:
            continue
        entries.append((int(match.group(1)), "#" + match.group(2).lower()))
    if not entries:
        raise RuntimeError("ImageMagick returned no histogram colors")

    total = sum(count for count, _color in entries)
    mean_luminance = sum(count * luminance(color) for count, color in entries) / total
    mean_saturation = sum(count * color_saturation(color) for count, color in entries) / total

    # For theme matching, rank chromatic mid-tones above black/white canvas areas
    # while still keeping the full dominant list as a fallback for monochrome themes.
    ranked = sorted(
        entries,
        key=lambda item: item[0] * (0.35 + color_saturation(item[1])),
        reverse=True,
    )
    chromatic = [
        color for _count, color in ranked
        if color_saturation(color) >= 0.16 and 0.025 <= luminance(color) <= 0.92
    ]
    dominant = [color for _count, color in sorted(entries, reverse=True)]
    visual_colors: list[str] = []
    for color in chromatic + dominant:
        if color not in visual_colors:
            visual_colors.append(color)
        if len(visual_colors) >= 8:
            break

    return {
        "version": 1,
        "colors": visual_colors,
        "mean_luminance": round(mean_luminance, 6),
        "mean_saturation": round(mean_saturation, 6),
    }


def enrich_visual_profiles(assets: dict[str, dict]) -> None:
    failures = []
    for asset_id, asset in sorted(assets.items()):
        path = ROOT / str(asset.get("file") or "")
        try:
            asset["visual"] = analyze_local_image(path)
        except Exception as exc:
            failures.append(f"{asset_id}: {exc}")
    if failures:
        for failure in failures[:20]:
            log(f"warning: visual analysis {failure}")
        die(f"visual analysis failed for {len(failures)} asset(s)")


def theme_signature(data: dict) -> tuple[str, str]:
    derived = data.get("derived") or {}
    semantic = derived.get("semantic") or data.get("semantic") or {}
    palette = data.get("palette") or {}
    b16 = palette.get("base_16") or data.get("base_16") or {}
    b30 = derived.get("base_30") or data.get("base_30") or {}
    accent = clean_hex(
        semantic.get("accent")
        or data.get("accent")
        or palette.get("accent")
        or b30.get("folder_bg")
        or b30.get("blue")
        or b16.get("BASE0D")
    )
    background = clean_hex(
        semantic.get("background")
        or b30.get("black")
        or b16.get("BASE00")
        or "#101010",
        "#101010",
    )
    return accent, background


def load_themes() -> dict[str, dict]:
    result: dict[str, dict] = {}
    for path in sorted(THEME_CACHE.glob("*.json")):
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        result[path.stem] = data
    if not result:
        die(f"no compiled themes found under {THEME_CACHE}; run theme-sync first")
    return result


def required_buckets(themes: dict[str, dict]) -> dict[str, list[str]]:
    result: dict[str, list[str]] = {}
    for name, data in themes.items():
        accent, _background = theme_signature(data)
        result.setdefault(nearest_bucket(accent), []).append(name)
    return result


def api_get(path: str, params: dict | None = None) -> dict:
    global _last_api_at
    query = "?" + urllib.parse.urlencode(params) if params else ""
    url = WALLHAVEN_API + path + query
    for attempt in range(4):
        with _api_lock:
            delay = API_INTERVAL - (time.monotonic() - _last_api_at)
            if delay > 0:
                time.sleep(delay)
            _last_api_at = time.monotonic()
        request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
        try:
            with urllib.request.urlopen(request, timeout=25) as response:
                return json.load(response)
        except urllib.error.HTTPError as exc:
            if exc.code == 429 and attempt < 3:
                retry = int(exc.headers.get("Retry-After") or 10)
                time.sleep(max(retry, 5))
                continue
            raise
        except (urllib.error.URLError, TimeoutError):
            if attempt < 3:
                time.sleep(2 + attempt * 2)
                continue
            raise
    raise RuntimeError("API retry loop exhausted")


def search_bucket(bucket: str, page: int) -> list[dict]:
    payload = api_get(
        "/search",
        {
            "q": '-"AI art"',
            "categories": "100",  # General only
            "purity": "100",      # SFW only
            "sorting": "favorites",
            "order": "desc",
            "atleast": "1920x1200",
            "ratios": "16x9,16x10",
            "colors": bucket,
            "page": str(page),
        },
    )
    return payload.get("data") or []


def wallpaper_detail(wallpaper_id: str) -> dict:
    payload = api_get(f"/w/{urllib.parse.quote(wallpaper_id, safe='')}")
    return payload.get("data") or {}


def reject_ai(detail: dict) -> str | None:
    tags = [str(t.get("name") or "").strip().lower() for t in (detail.get("tags") or []) if isinstance(t, dict)]
    blob = " | ".join(tags)
    for term in AI_TAG_TERMS:
        if term in blob:
            return f"AI tag: {term}"
    source = str(detail.get("source") or "").lower()
    for term in AI_SOURCE_TERMS:
        if term in source:
            return f"AI source: {term}"
    return None


def reject_provenance(detail: dict) -> str | None:
    """Conservative automated human-authorship boundary.

    Metadata cannot prove authorship, so automated curation deliberately limits
    itself to Wallhaven uploads from before the modern generative-AI wave and
    then applies the explicit AI-tag/source denylist as a second independent
    check. Newer images can still be added manually after human review, but are
    never selected by this automated sync.
    """
    created = str(detail.get("created_at") or "")
    if not created:
        return "missing upload timestamp"
    if created >= HUMAN_PROVENANCE_CUTOFF:
        return f"upload is newer than conservative cutoff {HUMAN_PROVENANCE_CUTOFF}"
    return reject_ai(detail)


def trust_score(detail: dict) -> float:
    """Prefer popular and attributable candidates inside the trusted period."""
    score = float(detail.get("favorites") or 0)
    if detail.get("source"):
        score += 500
    if detail.get("uploader"):
        score += 50
    return score


def asset_from_detail(detail: dict, bucket: str) -> dict:
    wallpaper_id = str(detail.get("id") or "")
    colors = [clean_hex(c) for c in (detail.get("colors") or [])]
    uploader = detail.get("uploader") or {}
    return {
        "id": f"wallhaven-{wallpaper_id}",
        "provider": "wallhaven",
        "wallhaven_id": wallpaper_id,
        "page_url": detail.get("url"),
        "download_url": detail.get("path"),
        "source_url": detail.get("source") or "",
        "uploader": uploader.get("username") if isinstance(uploader, dict) else "",
        "created_at": detail.get("created_at"),
        "favorites": detail.get("favorites") or 0,
        "resolution": detail.get("resolution"),
        "file_type": detail.get("file_type"),
        "source_file_size": detail.get("file_size") or 0,
        "colors": colors,
        "palette_luminance": round(average_palette_luminance(colors), 6),
        "tags": [str(t.get("name") or "") for t in (detail.get("tags") or []) if isinstance(t, dict)],
        "bucket": bucket,
        "file": f"assets/wallhaven-{wallpaper_id}.webp",
        "ai_checked": True,
    }


def select_bucket_assets(bucket: str, reserved_ids: set[str] | None = None) -> list[dict]:
    reserved_ids = reserved_ids or set()
    accepted: list[dict] = []
    shared_fallback: list[dict] = []
    seen: set[str] = set()
    rejected_recent = 0
    rejected_metadata = 0
    for page in range(1, SEARCH_PAGES + 1):
        for item in search_bucket(bucket, page):
            wallpaper_id = str(item.get("id") or "")
            if not wallpaper_id or wallpaper_id in seen:
                continue
            seen.add(wallpaper_id)
            if int(item.get("file_size") or 0) > MAX_SOURCE_BYTES:
                continue

            # Search results already include created_at, so reject modern uploads
            # before spending an additional API request on their full metadata.
            created = str(item.get("created_at") or "")
            if not created or created >= HUMAN_PROVENANCE_CUTOFF:
                rejected_recent += 1
                continue
            try:
                detail = wallpaper_detail(wallpaper_id)
            except Exception as exc:
                log(f"warning: metadata {wallpaper_id}: {exc}")
                continue
            reason = reject_provenance(detail)
            if reason:
                rejected_metadata += 1
                continue
            asset = asset_from_detail(detail, bucket)
            if asset["id"] in reserved_ids:
                shared_fallback.append(asset)
            else:
                accepted.append(asset)
            if len(accepted) >= ACCEPTED_POOL:
                break
        if len(accepted) >= ACCEPTED_POOL:
            break

    # Prefer unique assets across buckets, but never fail a color bucket solely
    # because Wallhaven's color searches overlap heavily. Reuse a vetted shared
    # candidate only when there are not enough unique conservative choices.
    if len(accepted) < ASSETS_PER_BUCKET:
        for asset in sorted(shared_fallback, key=trust_score, reverse=True):
            if asset["id"] not in {item["id"] for item in accepted}:
                accepted.append(asset)
            if len(accepted) >= ASSETS_PER_BUCKET:
                break
    if len(accepted) < ASSETS_PER_BUCKET:
        die(
            f"color {bucket}: only {len(accepted)} conservative candidate(s); "
            f"rejected {rejected_recent} modern and {rejected_metadata} metadata candidate(s)"
        )

    # Keep both dark and light choices while preferring old/popular/attributed work.
    ordered = sorted(accepted, key=lambda a: (a["palette_luminance"], -trust_score(a)))
    half = max(len(ordered) // 2, 1)
    dark = sorted(ordered[:half], key=trust_score, reverse=True)
    light = sorted(ordered[half:], key=trust_score, reverse=True)
    chosen: list[dict] = []
    for group in (dark[:2], light[:2]):
        for asset in group:
            if asset["id"] not in {x["id"] for x in chosen}:
                chosen.append(asset)
    for asset in sorted(accepted, key=trust_score, reverse=True):
        if len(chosen) >= ASSETS_PER_BUCKET:
            break
        if asset["id"] not in {x["id"] for x in chosen}:
            chosen.append(asset)
    log(
        f"color {bucket}: selected {len(chosen)} vetted assets; "
        f"rejected {rejected_recent} modern and {rejected_metadata} metadata candidate(s)"
    )
    return chosen[:ASSETS_PER_BUCKET]


def valid_local_image(path: Path) -> bool:
    try:
        if path.stat().st_size < 4096:
            return False
        with path.open("rb") as handle:
            head = handle.read(16)
        return (
            head.startswith(b"\x89PNG\r\n\x1a\n")
            or head.startswith(b"\xff\xd8\xff")
            or (head[:4] == b"RIFF" and head[8:12] == b"WEBP")
        )
    except OSError:
        return False


def download_source(url: str, destination: Path) -> None:
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    total = 0
    with urllib.request.urlopen(request, timeout=60) as response, open(destination, "wb") as handle:
        length = response.headers.get("Content-Length")
        if length and int(length) > MAX_SOURCE_BYTES:
            raise RuntimeError("source exceeds 50 MiB safety limit")
        while True:
            chunk = response.read(1024 * 1024)
            if not chunk:
                break
            total += len(chunk)
            if total > MAX_SOURCE_BYTES:
                raise RuntimeError("source exceeds 50 MiB safety limit")
            handle.write(chunk)


def convert_asset(asset: dict, force: bool = False) -> tuple[str, bool, str]:
    asset_id = asset["id"]
    destination = ROOT / asset["file"]
    if not force and valid_local_image(destination):
        return asset_id, True, "existing"
    magick = which("magick")
    if not magick:
        return asset_id, False, "ImageMagick 'magick' is required"
    destination.parent.mkdir(parents=True, exist_ok=True)
    source_fd, source_name = tempfile.mkstemp(prefix=f".{asset_id}-source-", dir=destination.parent)
    os.close(source_fd)
    out_fd, out_name = tempfile.mkstemp(prefix=f".{asset_id}-out-", suffix=".webp", dir=destination.parent)
    os.close(out_fd)
    try:
        download_source(str(asset.get("download_url") or ""), Path(source_name))
        result = subprocess.run(
            [magick, source_name, "-auto-orient", "-strip", "-resize", TARGET_BOX, "-quality", WEBP_QUALITY, out_name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            timeout=120,
            check=False,
        )
        if result.returncode != 0 or not valid_local_image(Path(out_name)):
            return asset_id, False, result.stderr.strip() or "conversion failed"
        os.replace(out_name, destination)
        return asset_id, True, "downloaded"
    except Exception as exc:
        return asset_id, False, str(exc)
    finally:
        for temp in (source_name, out_name):
            try:
                os.unlink(temp)
            except FileNotFoundError:
                pass


def theme_palette_colors(data: dict, accent: str) -> list[str]:
    palette = data.get("palette") or {}
    b16 = palette.get("base_16") or data.get("base_16") or {}
    values = [
        accent,
        b16.get("BASE0D"), b16.get("BASE0E"), b16.get("BASE0B"),
        b16.get("BASE0C"), b16.get("BASE0A"), b16.get("BASE08"),
    ]
    result: list[str] = []
    for value in values:
        color = clean_hex(value)
        if color not in result:
            result.append(color)
    return result


def theme_asset_score(accent: str, background: str, theme_colors: list[str], asset: dict) -> float:
    visual = asset.get("visual") or {}
    colors = visual.get("colors") or asset.get("colors") or ["#808080"]
    image_luminance = float(visual.get("mean_luminance", asset.get("palette_luminance", 0.5)))
    image_saturation = float(
        visual.get(
            "mean_saturation",
            sum(color_saturation(c) for c in colors) / max(len(colors), 1),
        )
    )

    # The signature accent matters most, but matching several authored syntax
    # hues prevents a single coincidental swatch from dominating the result.
    accent_distance = min(color_distance(accent, c) for c in colors)
    palette_distances = [min(color_distance(theme_color, c) for c in colors) for theme_color in theme_colors[:6]]
    palette_distance = sum(palette_distances) / max(len(palette_distances), 1)

    background_luminance = luminance(background)
    luminance_penalty = abs(background_luminance - image_luminance) * 145.0
    saturation_penalty = abs(color_saturation(accent) - image_saturation) * 42.0

    # Keep the source color bucket as a mild prior, not a hard constraint. The
    # actual pixels are authoritative when they disagree with Wallhaven metadata.
    bucket_color = "#" + str(asset.get("bucket") or "808080")
    bucket_penalty = color_distance(accent, bucket_color) * 0.06

    return (
        accent_distance * 0.58
        + palette_distance * 0.42
        + luminance_penalty
        + saturation_penalty
        + bucket_penalty
    )


def build_theme_map(themes: dict[str, dict], buckets: dict[str, list[str]], assets: dict[str, dict]) -> dict[str, dict]:
    all_assets = list(assets.values())
    if not all_assets:
        die("no wallpaper assets available")

    scored_by_theme: dict[str, tuple[str, str, str, list[tuple[float, dict]]]] = {}
    first_usage: Counter[str] = Counter()

    # Pass 1: the primary wallpaper is always the absolute best visual match.
    for name, data in themes.items():
        accent, background = theme_signature(data)
        bucket = nearest_bucket(accent)
        theme_colors = theme_palette_colors(data, accent)
        scored = sorted(
            ((theme_asset_score(accent, background, theme_colors, asset), asset) for asset in all_assets),
            key=lambda item: (item[0], item[1]["id"]),
        )
        scored_by_theme[name] = (accent, background, bucket, scored)
        first_usage[scored[0][1]["id"]] += 1

    # Pass 2: alternatives stay inside the best visual shortlist, but a modest
    # global reuse penalty prevents one generally compatible image from filling
    # the second/third slot for a large fraction of the catalog.
    usage = Counter(first_usage)
    result: dict[str, dict] = {}
    shortlist_size = min(18, len(all_assets))
    for name in sorted(themes):
        accent, background, bucket, scored = scored_by_theme[name]
        chosen_pairs = [scored[0]]
        chosen_ids = {scored[0][1]["id"]}
        for _slot in range(1, THEME_CHOICES):
            candidates = [item for item in scored[:shortlist_size] if item[1]["id"] not in chosen_ids]
            if not candidates:
                candidates = [item for item in scored if item[1]["id"] not in chosen_ids]
            selected = min(
                candidates,
                key=lambda item: (item[0] + usage[item[1]["id"]] * 3.0, item[1]["id"]),
            )
            chosen_pairs.append(selected)
            chosen_ids.add(selected[1]["id"])
            usage[selected[1]["id"]] += 1

        chosen = [asset["id"] for _score, asset in chosen_pairs]
        result[name] = {
            "accent": accent,
            "background": background,
            "bucket": bucket,
            "assets": chosen,
            "match_scores": {asset["id"]: round(score, 3) for score, asset in chosen_pairs},
        }
    return result


def migrate_old_cache() -> None:
    ROOT.mkdir(parents=True, exist_ok=True)
    if OLD_CACHE.is_symlink():
        return
    if OLD_CACHE.is_dir() and not UPSTREAM.exists():
        UPSTREAM.parent.mkdir(parents=True, exist_ok=True)
        os.replace(OLD_CACHE, UPSTREAM)
        log(f"migrated old upstream cache to {UPSTREAM}")
    elif OLD_CACHE.is_dir() and UPSTREAM.exists():
        log(f"warning: both {OLD_CACHE} and {UPSTREAM} exist; leaving old cache untouched")


def build_manifest(themes: dict[str, dict], bucket_assets: dict[str, list[dict]]) -> dict:
    assets: dict[str, dict] = {}
    buckets: dict[str, list[str]] = {}
    for bucket, selected in bucket_assets.items():
        ids: list[str] = []
        for asset in selected:
            assets[asset["id"]] = asset
            ids.append(asset["id"])
        buckets[bucket] = ids
    theme_map = build_theme_map(themes, buckets, assets)
    return {
        "schema": SCHEMA,
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "policy": {
            "provider": "wallhaven",
            "category": "general",
            "purity": "sfw",
            "minimum_resolution": "1920x1200",
            "ratios": ["16x9", "16x10"],
            "sorting": "favorites",
            "search_exclusion": 'AI art',
            "human_provenance_cutoff": HUMAN_PROVENANCE_CUTOFF,
            "provenance_policy": "automated selection accepts only uploads before cutoff, then rejects explicit AI tags and known AI source domains",
            "ai_validation": "full metadata tags and known AI source domains rejected",
            "local_format": "WebP quality 92, max 2560x1600 without upscaling",
            "assets_per_color_bucket": ASSETS_PER_BUCKET,
            "assets_per_theme": THEME_CHOICES,
            "mapping": "actual-pixel dominant colors + luminance + saturation; Wallhaven bucket is only a mild prior",
        },
        "buckets": buckets,
        "assets": assets,
        "themes": theme_map,
    }


def load_manifest() -> dict:
    try:
        return json.loads(MANIFEST.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}


def hydrate(manifest: dict, theme: str | None = None, force: bool = False) -> None:
    assets = manifest.get("assets") or {}
    if theme:
        entry = (manifest.get("themes") or {}).get(theme)
        if not entry:
            die(f"theme is not mapped in library: {theme}")
        wanted = [aid for aid in entry.get("assets", []) if aid in assets]
    else:
        wanted = sorted(assets)
    jobs = [assets[aid] for aid in wanted]
    failures: list[tuple[str, str]] = []
    downloaded = existing = 0
    with ThreadPoolExecutor(max_workers=DOWNLOAD_WORKERS, thread_name_prefix="wallpaper-library") as pool:
        futures = {pool.submit(convert_asset, asset, force): asset["id"] for asset in jobs}
        for future in as_completed(futures):
            asset_id, ok, status = future.result()
            if ok:
                if status == "existing":
                    existing += 1
                else:
                    downloaded += 1
                    log(f"asset {asset_id}: downloaded")
            else:
                failures.append((asset_id, status))
                log(f"warning: asset {asset_id}: {status}")
    log(f"assets: {downloaded} downloaded, {existing} already present, {len(failures)} failed")
    if failures:
        die("one or more wallpaper assets failed to hydrate")


def prune_unreferenced_assets(manifest: dict) -> int:
    """Remove obsolete curated assets after a complete replacement manifest exists.

    Preserve the currently displayed wallpaper even if a refreshed catalog no
    longer references it; the next wallpaper/theme action will move the pointer
    to a mapped asset without risking a broken login-time wallpaper path.
    """
    keep = {
        (ROOT / str(asset.get("file") or "")).resolve()
        for asset in (manifest.get("assets") or {}).values()
        if asset.get("file")
    }
    try:
        current = Path(
            Path(os.path.expanduser("~/.config/current_wallpaper")).read_text(encoding="utf-8").strip()
        ).resolve()
        if current.is_file():
            keep.add(current)
    except (OSError, ValueError):
        pass

    removed = 0
    ASSETS.mkdir(parents=True, exist_ok=True)
    for path in ASSETS.iterdir():
        if path.is_file() and path.resolve() not in keep:
            path.unlink()
            removed += 1
    return removed


def sync(refresh: bool = False) -> None:
    if not which("magick"):
        die("ImageMagick is required for normalized local wallpaper assets")
    themes = load_themes()
    needed = required_buckets(themes)
    current = load_manifest()
    bucket_assets: dict[str, list[dict]] = {}

    if not refresh and current.get("schema") == SCHEMA:
        current_assets = current.get("assets") or {}
        for bucket in needed:
            ids = (current.get("buckets") or {}).get(bucket) or []
            selected = [current_assets[aid] for aid in ids if aid in current_assets]
            if len(selected) >= ASSETS_PER_BUCKET and all(
                not reject_provenance(
                    {
                        "created_at": a.get("created_at"),
                        "tags": [{"name": t} for t in a.get("tags", [])],
                        "source": a.get("source_url", ""),
                    }
                )
                for a in selected
            ):
                bucket_assets[bucket] = selected[:ASSETS_PER_BUCKET]

    missing = [bucket for bucket in sorted(needed) if bucket not in bucket_assets]
    reserved_ids = {asset["id"] for selected in bucket_assets.values() for asset in selected}
    log(f"catalog: {len(themes)} themes across {len(needed)} color bucket(s); {len(missing)} bucket(s) need source selection")
    for index, bucket in enumerate(missing, 1):
        log(f"selecting color {bucket} ({index}/{len(missing)}) for {len(needed[bucket])} theme(s)")
        bucket_assets[bucket] = select_bucket_assets(bucket, reserved_ids=reserved_ids)
        reserved_ids.update(asset["id"] for asset in bucket_assets[bucket])

    manifest = build_manifest(themes, bucket_assets)
    hydrate(manifest, force=False)
    enrich_visual_profiles(manifest["assets"])
    manifest["themes"] = build_theme_map(themes, manifest["buckets"], manifest["assets"])
    write_json(MANIFEST, manifest)
    removed = prune_unreferenced_assets(manifest)
    sync_manifest_to_chezmoi()
    migrate_old_cache()
    log(
        f"manifest: {len(manifest['themes'])} themes, {len(manifest['assets'])} unique vetted assets; "
        f"pruned {removed} obsolete asset(s)"
    )
    status()


def status() -> None:
    manifest = load_manifest()
    themes = load_themes()
    mapped = manifest.get("themes") or {}
    assets = manifest.get("assets") or {}
    local = 0
    total_bytes = 0
    for asset in assets.values():
        path = ROOT / str(asset.get("file") or "")
        if valid_local_image(path):
            local += 1
            total_bytes += path.stat().st_size
    missing_themes = sorted(set(themes) - set(mapped))
    print(f"Themes: {len(mapped)}/{len(themes)} mapped")
    print(f"Assets: {local}/{len(assets)} local")
    print(f"Library size: {total_bytes / (1024 * 1024):.1f} MiB")
    print(f"Root: {ROOT}")
    if missing_themes:
        print("Missing themes: " + ", ".join(missing_themes[:20]))


def audit() -> int:
    manifest = load_manifest()
    themes = load_themes()
    mapped = manifest.get("themes") or {}
    assets = manifest.get("assets") or {}
    failures: list[str] = []
    for name in sorted(themes):
        entry = mapped.get(name)
        choices = entry.get("assets") if isinstance(entry, dict) else None
        if not isinstance(choices, list) or len(choices) != THEME_CHOICES:
            failures.append(f"theme {name}: expected {THEME_CHOICES} mapped assets, got {len(choices or [])}")
            continue
        for aid in choices:
            if aid not in assets:
                failures.append(f"theme {name}: unknown asset {aid}")
    for aid, asset in sorted(assets.items()):
        detail_for_check = {
            "created_at": asset.get("created_at"),
            "tags": [{"name": tag} for tag in asset.get("tags", [])],
            "source": asset.get("source_url", ""),
        }
        reason = reject_provenance(detail_for_check)
        if reason:
            failures.append(f"asset {aid}: {reason}")
        resolution = str(asset.get("resolution") or "")
        match = re.fullmatch(r"(\d+)x(\d+)", resolution)
        if not match or int(match.group(1)) < 1920 or int(match.group(2)) < 1200:
            failures.append(f"asset {aid}: source resolution below 1920x1200 ({resolution or 'unknown'})")
        path = ROOT / str(asset.get("file") or "")
        if not valid_local_image(path):
            failures.append(f"asset {aid}: missing/invalid local image")
        visual = asset.get("visual") or {}
        if visual.get("version") != 1 or not visual.get("colors"):
            failures.append(f"asset {aid}: missing actual-pixel visual profile")
    if failures:
        for item in failures[:100]:
            print("FAIL " + item)
        print(f"Summary: {len(failures)} failure(s)")
        return 1
    print(
        f"PASS {len(themes)} themes mapped; {len(assets)} vetted local assets; "
        f"all uploads pre-{HUMAN_PROVENANCE_CUTOFF} and explicit AI metadata clean"
    )
    return 0


def usage() -> None:
    print("""Usage: theme-wallpaper-library <command> [options]

Commands:
  plan                 Show catalog/color-bucket coverage without network access
  sync [--refresh]     Select vetted sources, download assets, map every theme
  fetch [theme|--all]  Hydrate assets already recorded in the manifest
  status               Show coverage, asset count and local disk use
  audit                Verify complete mappings, local files and AI metadata policy

Normal theme switching remains network-free. The centralized library lives at:
  ~/.local/share/theme/wallpapers/
""")


def plan() -> None:
    themes = load_themes()
    buckets = required_buckets(themes)
    print(f"Themes: {len(themes)}")
    print(f"Color buckets used: {len(buckets)}/{len(WALLHAVEN_COLORS)}")
    for bucket, names in sorted(buckets.items(), key=lambda item: (-len(item[1]), item[0])):
        print(f"  {bucket}: {len(names):3d} theme(s)")


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in {"-h", "--help", "help"}:
        usage()
        return 0
    command = args[0]
    if command == "plan":
        plan()
        return 0
    if command == "sync":
        sync(refresh="--refresh" in args[1:])
        return 0
    if command == "fetch":
        manifest = load_manifest()
        if not manifest:
            die("no library manifest; run theme-wallpaper-library sync first")
        theme = None if len(args) < 2 or args[1] == "--all" else args[1]
        hydrate(manifest, theme=theme, force="--force" in args[1:])
        return 0
    if command == "status":
        status()
        return 0
    if command == "audit":
        return audit()
    die(f"unknown command: {command}")


if __name__ == "__main__":
    raise SystemExit(main())
