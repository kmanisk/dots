#!/usr/bin/env bash
# ==============================================================================
# rofi-speaker-dsp — Minimal ASUS Speaker DSP Preset Selector
# Clean, minimal selector for DAX3 presets matching desktop launcher style
# ==============================================================================
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

SPK_BIN="$HOME/.local/bin/spk"
STATE_FILE="$HOME/.config/asus-speakers/state.conf"
ALSA_SINK="alsa_output.pci-0000_00_1f.3.analog-stereo"

if [[ ! -x "$SPK_BIN" ]]; then
    echo "Error: spk utility not found or not executable at $SPK_BIN" >&2
    exit 1
fi

# Determine current active voicing to pre-select
ACTIVE_VOICING="tuned"
if [[ -f "$STATE_FILE" ]]; then
    ACTIVE_VOICING=$(grep "^ACTIVE_VOICING=" "$STATE_FILE" 2>/dev/null | cut -d'=' -f2 || echo "tuned")
fi

options=(
    "Tuned (Focused & Natural)"
    "Tuned (Old / Wide)"
    "Custom 2 (Dolby Access)"
    "Dynamic (DAX3 Default)"
    "Music (DAX3 Audiophile)"
    "Balanced (Linux)"
    "Experimental (Harmonic Bass)"
)

selected_label="Tuned (Focused & Natural)"
selected_index=0

case "$ACTIVE_VOICING" in
    tuned)        selected_label="Tuned (Focused & Natural)";   selected_index=0 ;;
    tuned-old)    selected_label="Tuned (Old / Wide)";          selected_index=1 ;;
    custom)       selected_label="Custom 2 (Dolby Access)";     selected_index=2 ;;
    dynamic)      selected_label="Dynamic (DAX3 Default)";      selected_index=3 ;;
    music)        selected_label="Music (DAX3 Audiophile)";      selected_index=4 ;;
    balanced)     selected_label="Balanced (Linux)";            selected_index=5 ;;
    experimental) selected_label="Experimental (Harmonic Bass)";selected_index=6 ;;
esac

# Launch minimal selector (fuzzel on Wayland/Sway, clean rofi on X11)
if command -v fuzzel >/dev/null 2>&1 && [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    chosen=$(printf '%s\n' "${options[@]}" | fuzzel --dmenu --prompt "❯ " --width 32 --lines "${#options[@]}" --select "$selected_label")
else
    chosen=$(printf '%s\n' "${options[@]}" | rofi -dmenu -i -p "❯" -selected-row "$selected_index" -theme-str '
        window { width: 380px; padding: 12px; border: 2px; border-radius: 0px; }
        mainbox { children: [ inputbar, listview ]; spacing: 8px; }
        inputbar { padding: 8px 12px; border-radius: 0px; children: [ prompt, entry ]; }
        listview { lines: 4; columns: 1; spacing: 4px; border: 0px; scrollbar: false; }
        element { padding: 8px 12px; border-radius: 0px; }
    ')
fi

[[ -z "$chosen" ]] && exit 0

# Apply preset and seamless stream attachment (zero need to cycle output device)
apply_preset() {
    local voicing="$1"

    # 1. Ensure DSP is enabled
    if [[ -f "$STATE_FILE" ]] && grep -q "^ENABLED=false" "$STATE_FILE" 2>/dev/null; then
        "$SPK_BIN" on >/dev/null 2>&1 || true
    fi

    # 2. Switch the active profile via spk
    "$SPK_BIN" "$voicing"

    # 3. Ensure default sink is set to internal speakers
    pactl set-default-sink "$ALSA_SINK" 2>/dev/null || true
    pw-metadata -n default 0 default.audio.sink "{\"name\":\"$ALSA_SINK\"}" 2>/dev/null || true
    pw-metadata -n default 0 default.configured.audio.sink "{\"name\":\"$ALSA_SINK\"}" 2>/dev/null || true

    # 4. Seamlessly re-link active playback streams into newly restarted DSP node
    python3 -c "
import subprocess
try:
    pactl_inputs = subprocess.check_output(['pactl', 'list', 'sink-inputs'], text=True)
    current_id = None
    node_name = ''
    app_name = ''
    is_virtual = False
    for line in pactl_inputs.split('\n') + ['']:
        line_s = line.strip()
        if line_s.startswith('Sink Input #'):
            current_id = line_s.split('#')[1].strip()
            node_name = ''
            app_name = ''
            is_virtual = False
        elif 'node.name =' in line_s:
            node_name = line_s.split('=')[1].strip(' \"')
        elif 'application.name =' in line_s:
            app_name = line_s.split('=')[1].strip(' \"')
        elif 'node.virtual = \"true\"' in line_s:
            is_virtual = True
        elif not line_s and current_id:
            is_internal = is_virtual or node_name.startswith(('effect_output.', 'playback.')) or any(x in node_name for x in ['ghelper', 'dusky', 'rnnoise', 'peace_gaming'])
            if not is_internal and 'cs2' not in app_name:
                subprocess.run(['pactl', 'move-sink-input', current_id, '$ALSA_SINK'], stderr=subprocess.DEVNULL)
            current_id = None
except Exception:
    pass
" 2>/dev/null || true
}

case "$chosen" in
    *"Tuned (Focused"*)
        apply_preset "tuned"
        ;;
    *"Tuned (Old"*)
        apply_preset "tuned-old"
        ;;
    *"Custom 2"*)
        apply_preset "custom"
        ;;
    *"Dynamic"*)
        apply_preset "dynamic"
        ;;
    *"Music"*)
        apply_preset "music"
        ;;
    *"Balanced"*)
        apply_preset "balanced"
        ;;
    *"Experimental"*)
        apply_preset "experimental"
        ;;
esac
