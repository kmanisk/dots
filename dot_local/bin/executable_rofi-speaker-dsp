#!/usr/bin/env bash
# ==============================================================================
# rofi-speaker-dsp — Minimal ASUS Speaker DSP Preset Selector
# Clean, minimal selector for DAX3 presets matching desktop launcher style
# ==============================================================================
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

SPK_BIN="$HOME/.local/bin/spk"
STATE_FILE="$HOME/.config/asus-speakers/state.conf"
ALSA_SINK="alsa_output.pci-0000_00_1f.3.analog-stereo"

if [[ ! -x "$SPK_BIN" ]]; then
    echo "Error: spk utility not found or not executable at $SPK_BIN" >&2
    exit 1
fi

# Determine current active voicing to pre-select
ACTIVE_VOICING="dynamic"
if [[ -f "$STATE_FILE" ]]; then
    ACTIVE_VOICING=$(grep "^ACTIVE_VOICING=" "$STATE_FILE" 2>/dev/null | cut -d'=' -f2 || echo "dynamic")
fi

options=(
    "Custom 2 (Dolby Access)"
    "Dynamic (DAX3 Default)"
    "Music (DAX3 Audiophile)"
    "Balanced (Linux)"
)

selected_label="Custom 2 (Dolby Access)"
selected_index=0

case "$ACTIVE_VOICING" in
    custom)   selected_label="Custom 2 (Dolby Access)"; selected_index=0 ;;
    dynamic)  selected_label="Dynamic (DAX3 Default)";  selected_index=1 ;;
    music)    selected_label="Music (DAX3 Audiophile)";  selected_index=2 ;;
    balanced) selected_label="Balanced (Linux)";        selected_index=3 ;;
esac

# Launch minimal selector (fuzzel on Wayland/Sway, clean rofi on X11)
if command -v fuzzel >/dev/null 2>&1 && [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    chosen=$(printf '%s\n' "${options[@]}" | fuzzel --dmenu --prompt "❯ " --width 32 --lines "${#options[@]}" --select "$selected_label")
else
    chosen=$(printf '%s\n' "${options[@]}" | rofi -dmenu -i -p "❯" -selected-row "$selected_index" -theme-str '
        window { width: 380px; padding: 12px; border: 2px; border-radius: 0px; }
        mainbox { children: [ inputbar, listview ]; spacing: 8px; }
        inputbar { padding: 8px 12px; border-radius: 0px; children: [ prompt, entry ]; }
        listview { lines: 4; columns: 1; spacing: 4px; border: 0px; scrollbar: false; }
        element { padding: 8px 12px; border-radius: 0px; }
    ')
fi

[[ -z "$chosen" ]] && exit 0

# Apply preset and seamless stream attachment (zero need to cycle output device)
apply_preset() {
    local voicing="$1"

    # 1. Ensure DSP is enabled
    if [[ -f "$STATE_FILE" ]] && grep -q "^ENABLED=false" "$STATE_FILE" 2>/dev/null; then
        "$SPK_BIN" on >/dev/null 2>&1 || true
    fi

    # 2. Switch the active profile via spk
    "$SPK_BIN" "$voicing"

    # 3. If default sink was on Gaming Audio (raw bypass), return to internal speakers
    local def_sink
    def_sink=$(pactl get-default-sink 2>/dev/null || echo "")
    if [[ "$def_sink" == "sink.peace_gaming" ]]; then
        pactl set-default-sink "$ALSA_SINK" 2>/dev/null || true
        pw-metadata -n default 0 default.audio.sink "{\"name\":\"$ALSA_SINK\"}" 2>/dev/null || true
        pw-metadata -n default 0 default.configured.audio.sink "{\"name\":\"$ALSA_SINK\"}" 2>/dev/null || true
    fi

    # 4. Seamlessly re-link active playback streams into newly restarted DSP node
    for input_id in $(pactl list short sink-inputs 2>/dev/null | awk '{print $1}'); do
        pactl move-sink-input "$input_id" "$ALSA_SINK" 2>/dev/null || true
    done
}

case "$chosen" in
    *"Custom 2"*)
        apply_preset "custom"
        ;;
    *"Dynamic"*)
        apply_preset "dynamic"
        ;;
    *"Music"*)
        apply_preset "music"
        ;;
    *"Balanced"*)
        apply_preset "balanced"
        ;;
esac
