#!/usr/bin/env bash
# ==============================================================================
# Modern Rofi Power Menu with Automatic i3 Session Preservation
# ==============================================================================
export PATH="$HOME/.local/bin:$PATH"

# Best-effort session save for the active compositor (never blocks the action).
save_session() {
    if [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then
        ~/.local/bin/sway-session-save --all --quiet 2>/dev/null || :
    else
        ~/.local/bin/i3-session-save --all 2>/dev/null || :
    fi
}

# Options with icons
shutdown='⏻   Shutdown'
reboot='   Restart'
lock='󰌾   Lock Screen'
suspend='󰤄   Suspend'
logout='󰍃   Logout'

# Prompt via Rofi
chosen=$(printf "%s\n%s\n%s\n%s\n%s" "$shutdown" "$reboot" "$lock" "$suspend" "$logout" | rofi \
    -dmenu \
    -i \
    -sort \
    -sorting-method "fzf" \
    -matching "fuzzy" \
    -p "Power Menu" \
    -theme ~/.config/rofi/powermenu.rasi \
    -selected-row 0)

case "$chosen" in
    *"Shutdown"*)
        save_session
        systemctl poweroff
        ;;
    *"Restart"*)
        save_session
        systemctl reboot
        ;;
    *"Lock"*)
        sleep 0.1 && swaylock -f -c 000000
        ;;
    *"Suspend"*)
        systemctl suspend
        ;;
    *"Logout"*)
        save_session
        i3-msg exit
        ;;
esac
