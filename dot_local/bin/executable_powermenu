#!/usr/bin/env bash
# ==============================================================================
# Icon-Only Rofi Power Menu with Automatic i3 Session Preservation
# ==============================================================================
export PATH="$HOME/.local/bin:$PATH"

# Best-effort session save for the active compositor (never blocks the action).
save_session() {
    if [ -n "${SWAYSOCK:-}" ] || [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then
        ~/.local/bin/sway-session-save --all --quiet 2>/dev/null || :
    else
        ~/.local/bin/i3-session-save --all 2>/dev/null || :
    fi
}

# Icon-only entries (Material design glyphs; matched exactly in the case below)
shutdown='󰐥'
reboot='󰜉'
lock='󰌾'
suspend='󰤄'
logout='󰍃'

# Prompt via Rofi
chosen=$(printf "%s\n%s\n%s\n%s\n%s" "$shutdown" "$reboot" "$lock" "$suspend" "$logout" | rofi \
    -dmenu \
    -i \
    -sort \
    -sorting-method "fzf" \
    -matching "fuzzy" \
    -theme ~/.config/rofi/powermenu.rasi \
    -selected-row 0)

case "$chosen" in
    "$shutdown")
        save_session
        systemctl poweroff
        ;;
    "$reboot")
        save_session
        systemctl reboot
        ;;
    "$lock")
        sleep 0.1 && swaylock -f -c 000000
        ;;
    "$suspend")
        systemctl suspend
        ;;
    "$logout")
        save_session
        if [ -n "${SWAYSOCK:-}" ] || [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then
            swaymsg exit
        else
            i3-msg exit
        fi
        ;;
esac
