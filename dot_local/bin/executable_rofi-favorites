#!/usr/bin/env bash
# ==============================================================================
# rofi-favorites: Instant single-click favorite URLs & bookmarks launcher
# ==============================================================================
export PATH="$HOME/.local/bin:$PATH"

LIST_FILE="$HOME/.config/rofi/favorites.list"
THEME="$HOME/.config/rofi/websearch-floating.rasi"

for arg in "$@"; do
    case "$arg" in
        --bar|-b)
            THEME="$HOME/.config/rofi/tsoding.rasi"
            ;;
        --floating|-f)
            THEME="$HOME/.config/rofi/websearch-floating.rasi"
            ;;
    esac
done

if [ ! -f "$LIST_FILE" ]; then
    echo "Favorites file not found: $LIST_FILE" >&2
    exit 1
fi

# Display names (column 1 before '|')
ENTRIES=$(awk -F'|' '{gsub(/^[ \t]+|[ \t]+$/, "", $1); print $1}' "$LIST_FILE")

# Prompt user via Rofi (single primary mouse click opens immediately)
SELECTED=$(echo "$ENTRIES" | rofi -dmenu -i \
    -sort \
    -sorting-method "fzf" \
    -matching "fuzzy" \
    -p "⭐ Favorites" \
    -me-select-entry '' \
    -me-accept-entry 'MousePrimary' \
    -theme "$THEME")

[ -z "$SELECTED" ] && exit 0

# Lookup URL for selected item
URL=$(awk -F'|' -v sel="$SELECTED" '{
    name = $1;
    gsub(/^[ \t]+|[ \t]+$/, "", name);
    if (name == sel) {
        url = $2;
        gsub(/^[ \t]+|[ \t]+$/, "", url);
        print url;
        exit;
    }
}' "$LIST_FILE")

# Fallback: if user typed a direct URL or custom query
if [ -z "$URL" ]; then
    CLEAN_INPUT="$(echo "$SELECTED" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    if [[ "$CLEAN_INPUT" =~ ^https?:// ]] || [[ "$CLEAN_INPUT" =~ ^www\. ]] || [[ "$CLEAN_INPUT" =~ \.(com|org|io|net|edu|dev|gov|app)/? ]]; then
        [[ ! "$CLEAN_INPUT" =~ ^https?:// ]] && CLEAN_INPUT="https://$CLEAN_INPUT"
        URL="$CLEAN_INPUT"
    else
        # Search query on Google
        ENCODED=$(echo -n "$CLEAN_INPUT" | jq -sRr @uri)
        URL="https://www.google.com/search?q=${ENCODED}"
    fi
fi

# Launch in browser and focus workspace 2
xdg-open "$URL" >/dev/null 2>&1 &
if [ -n "$SWAYSOCK" ]; then
    swaymsg "workspace number 2" >/dev/null 2>&1 || true
else
    i3-msg "workspace number 2" >/dev/null 2>&1 || true
fi
