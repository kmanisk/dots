#!/usr/bin/env bash
# eldenring-fog-gui: Launch Elden Ring Fog Gate Randomizer GUI under Proton
set -e

unset SteamAppId
unset SteamGameId

export STEAM_COMPAT_CLIENT_INSTALL_PATH="$HOME/.local/share/Steam"
export STEAM_COMPAT_DATA_PATH="$HOME/.local/share/Steam/steamapps/compatdata/2703476723"

FOG_DIR="/mnt/Games/NonSteamGames/ELDEN RING/fog"
if [ ! -d "$FOG_DIR" ]; then
    echo "Error: Fog Gate Randomizer directory not found at $FOG_DIR" >&2
    exit 1
fi

if [ -f "$HOME/.local/share/Steam/compatibilitytools.d/proton-cachyos-slr/proton" ]; then
    PROTON_BIN="$HOME/.local/share/Steam/compatibilitytools.d/proton-cachyos-slr/proton"
elif [ -f "$HOME/.local/share/Steam/compatibilitytools.d/GE-Proton11-7-x86_64/proton" ]; then
    PROTON_BIN="$HOME/.local/share/Steam/compatibilitytools.d/GE-Proton11-7-x86_64/proton"
else
    PROTON_BIN="$HOME/.local/share/Steam/steamapps/common/Proton - Experimental/proton"
fi

notify-send -i input-gaming "Fog Gate Randomizer" "Launching Fog Gate Randomizer GUI..." 2>/dev/null || true

USER_SETTINGS="$STEAM_COMPAT_DATA_PATH/user_settings.py"
USER_SETTINGS_BAK="$STEAM_COMPAT_DATA_PATH/user_settings.py.gui-bak"
if [ -f "$USER_SETTINGS" ]; then
    cp "$USER_SETTINGS" "$USER_SETTINGS_BAK"
    printf 'user_settings = {\n}\n' > "$USER_SETTINGS"
fi
restore_user_settings() {
    if [ -f "$USER_SETTINGS_BAK" ]; then
        mv "$USER_SETTINGS_BAK" "$USER_SETTINGS"
    fi
}
trap restore_user_settings EXIT INT TERM

cd "$FOG_DIR"
"$PROTON_BIN" run "$FOG_DIR/FogMod.exe" "$@" &
PID=$!

(
    for i in {1..60}; do
        if [ -n "$SWAYSOCK" ] || [ -n "$WAYLAND_DISPLAY" ]; then
            if swaymsg '[title="(?i).*fog.*"] move position center, floating enable, focus' >/dev/null 2>&1; then
                break
            fi
        fi
        sleep 0.25
    done
) &

wait "$PID" || true

ME2_DIR="/mnt/Games/NonSteamGames/ELDEN RING/ModEngine2/ModEngine-2.1.0.0-win64"
if [ -f "$FOG_DIR/config_eldenringfogrando.toml" ] && [ -d "$ME2_DIR" ]; then
    ln -sf "$FOG_DIR/config_eldenringfogrando.toml" "$ME2_DIR/config_eldenringfogrando.toml"
fi
