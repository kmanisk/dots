#!/usr/bin/env bash
# uall — unattended full-system updater (single binary of truth on PATH).
# Works from fish/zsh/bash; no shell alias needed (avoid stale function cache).
# Phases — auto-accepts every prompt:
#   1. sudo pacman -Syu --noconfirm   (official repos; snap-pac pre/post
#      snapshots fire inside the transaction)
#   2. paru -Syu --noconfirm --noedit (AUR, skip PKGBUILD review)
#   3. npm globals                    (graceful skip if none)
#   4. fish plugins (fisher)          (graceful skip if none)
# Failure of the repo/AUR phase aborts (safety over silence); aux phases
# never abort. Intervenes nothing else: extra CLI args are ignored.
set -euo pipefail

echo "==> [1/4] Official repos (pacman -Syu; snap-pac snapshots inside)"
sudo pacman -Syu --noconfirm
echo "==> [2/4] AUR (paru -Syu, auto-accepted, no PKGBUILD review)"
paru -Syu --noconfirm --noedit
echo "==> [3/4] npm globals"
npm update -g 2>/dev/null || echo "    (npm globals skipped)"
echo "==> [4/4] fish plugins"
fisher update 2>&1 | grep -E "Updating|Installed|Removed" | tail -n 4 || echo "    (fisher skipped)"
echo "uall complete."
