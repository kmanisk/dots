#!/usr/bin/env bash
set -e

export STEAM_COMPAT_CLIENT_INSTALL_PATH="$HOME/.local/share/Steam"
export STEAM_COMPAT_DATA_PATH="$HOME/.local/share/Steam/steamapps/compatdata/2703476723"

# Offload directly to RTX 5050 Mobile
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only

# Blackwell (RTX 50-series) VKD3D memory alignment & stability fixes
export VKD3D_CONFIG="no_upload_hvv,force_host_cached"
export PROTON_ENABLE_NVAPI=0

# Focus Workspace 4 automatically (i3 or Sway IPC)
if [ -n "$SWAYSOCK" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    swaymsg "workspace 4" >/dev/null 2>&1 || true
else
    i3-msg "workspace 4" >/dev/null 2>&1 || true
fi

# Auto power profile: Performance while playing (fixes 20 FPS input drops
# caused by powersave ramp latency), Balanced again on exit. AC only —
# on battery the system stays on Balanced to protect runtime.
on_ac_power() {
    for ps in /sys/class/power_supply/A*/online /sys/class/power_supply/ADP*/online; do
        [[ -f "$ps" && $(cat "$ps" 2>/dev/null) == "1" ]] && return 0
    done
    return 1
}
set_governor() {
    echo "$1" | sudo -n tee /sys/devices/system/cpu/cpufreq/policy*/scaling_governor >/dev/null 2>&1 || true
}
# Thermal guard: Elden Ring is CPU-light (30-40% load) but pins 4.4GHz+ on
# Performance, pushing 95C through shared heatpipes. Capping P-cores at
# 3.8GHz costs no FPS at a 60fps target and drops ~10-15C.
MAXFREQ_CAP=3800000
ORIG_MAXFREQ=""
cap_maxfreq() {
    ORIG_MAXFREQ=$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 2>/dev/null)
    echo "$MAXFREQ_CAP" | sudo -n tee /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq >/dev/null 2>&1 || true
}
restore_maxfreq() {
    [[ -n "$ORIG_MAXFREQ" ]] && echo "$ORIG_MAXFREQ" | sudo -n tee /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq >/dev/null 2>&1 || true
}
restore_power() {
    restore_maxfreq
    asusctl profile set Balanced >/dev/null 2>&1 || true
    set_governor powersave
}
if on_ac_power; then
    asusctl profile set Performance >/dev/null 2>&1 || true
    set_governor performance
    cap_maxfreq
    trap restore_power EXIT INT TERM
fi

GAME_DIR="/mnt/Games/NonSteamGames/ELDEN RING/Game"
GAME_EXE="$GAME_DIR/eldenring.exe"
PROTON_BIN="$HOME/.local/share/Steam/steamapps/common/Proton - Experimental/proton"

cd "$GAME_DIR"

# LSFG-VK isolation:
# gamescope is a Vulkan micro-compositor. If lsfg-vk is loaded on gamescope itself,
# it corrupts Wayland sync fences (dri_create_fence_fd) and crashes Sway.
# Always shield gamescope with DISABLE_LSFGVK=1, and inject LSFG only into the game process.
if [[ "${ENABLE_LSFG:-1}" == "1" && "${DISABLE_LSFGVK:-0}" != "1" ]]; then
    GAME_ENV=(env -u DISABLE_LSFGVK LSFGVK_PROFILE="${LSFGVK_PROFILE:-Elden Ring}")
else
    GAME_ENV=(env DISABLE_LSFGVK=1)
fi

if [ -n "$SWAYSOCK" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    # Sway fractional scale (1.2x) exposes only 1599x999 to XWayland.
    # Gamescope nests a native 1920x1200 session so the game renders
    # full-res fullscreen; compositor upscales. Mangohud env from the
    # caller passes through gamescope to the game process.
    DISABLE_LSFGVK=1 gamescope -W 1920 -H 1200 -w 1920 -h 1200 -f -r 165 -- "${GAME_ENV[@]}" "$PROTON_BIN" run "$GAME_EXE" "$@"
else
    "${GAME_ENV[@]}" "$PROTON_BIN" run "$GAME_EXE" "$@"
fi
STATUS=$?
# TRAP on EXIT restores Balanced/powersave (no exec above, on purpose)
exit "$STATUS"

