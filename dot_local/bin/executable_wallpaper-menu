#!/usr/bin/env bash
# Current-theme wallpaper menu. Unbound; keyboard wallpaper controls live in Sway.
export PATH="$HOME/.local/bin:$PATH"

options="Next\nPrevious\nRandom\nRefresh cache"
chosen=$(echo -e "$options" | rofi -dmenu -i     -p "Theme wallpaper"     -theme "$HOME/.config/rofi/system-floating.rasi")

case "$chosen" in
    "Next")          theme-wallpaper next ;;
    "Previous")      theme-wallpaper prev ;;
    "Random")        theme-wallpaper random ;;
    "Refresh cache") theme-wallpaper refresh ;;
esac
