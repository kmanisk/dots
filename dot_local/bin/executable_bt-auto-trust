#!/usr/bin/env python3
# ==============================================================================
# Bluetooth Auto-Trust & Instant Audio Routing Daemon
# 1. Automatically marks all paired devices as 'Trusted' in BlueZ so they never
#    trigger authorization prompts or 60s timeouts.
# 2. Instantly routes audio to Bluetooth headphones/speakers on connect.
# ==============================================================================

import os
import sys
import time
import subprocess
import gi

gi.require_version('Gio', '2.0')
gi.require_version('GLib', '2.0')
from gi.repository import Gio, GLib

bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)

def notify(title, msg, icon="audio-headphones"):
    subprocess.Popen([
        "notify-send",
        "-h", "string:x-canonical-private-synchronous:bt-audio",
        "-t", "2500",
        "-i", icon,
        title,
        msg
    ])

DUSKY_SOCK = os.path.expanduser("~/.config/dusky/settings/dusky_studio/dusky_audio.sock")
DUSKY_CONF = os.path.expanduser("~/.config/dusky/settings/dusky_studio/config.json")

def notify_dusky_sink(sink_name):
    """Notify Dusky Audio Studio DSP to re-route its output to the new sink."""
    if os.path.exists(DUSKY_SOCK):
        try:
            import socket
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(0.6)
                s.connect(DUSKY_SOCK)
                s.sendall(f"CMD SINK_TGT {sink_name}\n".encode("utf-8"))
                s.recv(64)
        except Exception:
            pass

    if os.path.exists(DUSKY_CONF):
        try:
            import json
            with open(DUSKY_CONF, "r", encoding="utf-8") as f:
                dconf = json.load(f)
            if dconf.get("pre_sink") != sink_name:
                dconf["pre_sink"] = sink_name
                with open(DUSKY_CONF, "w", encoding="utf-8") as f:
                    json.dump(dconf, f, indent=2)
        except Exception:
            pass

def switch_audio_to_bluetooth(mac_clean, device_name):
    # Poll PipeWire/WirePlumber with retries (up to 5s) to allow node creation
    card_name = f"bluez_card.{mac_clean}"
    target_sink = None

    for attempt in range(15):
        time.sleep(0.3)
        try:
            # If after a few tries sink hasn't appeared, ensure card profile is active
            if attempt == 3:
                subprocess.run(["pactl", "set-card-profile", card_name, "a2dp-sink"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            sinks_out = subprocess.check_output(["pactl", "list", "sinks", "short"]).decode()
            for line in sinks_out.strip().split("\n"):
                if not line:
                    continue
                parts = line.split("\t")
                if len(parts) >= 2:
                    sink_name = parts[1]
                    if "bluez_output" in sink_name and mac_clean.lower() in sink_name.lower():
                        target_sink = sink_name
                        break
            if target_sink:
                break
        except Exception:
            pass

    if not target_sink:
        print(f"[-] Could not find sink for {mac_clean} after 5s", file=sys.stderr)
        return

    try:
        # 1. Set PulseAudio default sink
        subprocess.run(["pactl", "set-default-sink", target_sink], check=True)

        # 2. Update WirePlumber native default
        try:
            wp_out = subprocess.check_output(["wpctl", "status"]).decode()
            for line in wp_out.split("\n"):
                if target_sink in line or device_name in line:
                    m = re.search(r'(\d+)\.\s+.*bluez', line) or re.search(r'(\d+)\.\s+' + re.escape(device_name), line)
                    if m:
                        wp_id = m.group(1)
                        subprocess.run(["wpctl", "set-default", wp_id], check=False, stdout=subprocess.DEVNULL)
                        break
        except Exception:
            pass

        # 3. Notify Dusky Audio Studio DSP to route processed audio to Bluetooth
        notify_dusky_sink(target_sink)

        # 4. Move active regular streams to the Bluetooth sink
        inputs_out = subprocess.check_output(["pactl", "list", "sink-inputs", "short"]).decode()
        for input_line in inputs_out.strip().split("\n"):
            if input_line:
                input_id = input_line.split("\t")[0]
                subprocess.run(["pactl", "move-sink-input", input_id, target_sink], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        notify("Bluetooth Audio Connected", f"Audio switched to {device_name}", "audio-headphones")
        print(f"[+] Audio successfully routed to {device_name} ({target_sink})")
    except Exception as e:
        print(f"Error routing audio: {e}", file=sys.stderr)

def trust_device(object_path, dev_name):
    try:
        dev = Gio.DBusProxy.new_sync(
            bus,
            Gio.DBusProxyFlags.NONE,
            None,
            'org.bluez',
            object_path,
            'org.bluez.Device1',
            None
        )
        trusted = dev.get_cached_property('Trusted')
        if trusted is not None and not trusted.get_boolean():
            dev.set_cached_property('Trusted', GLib.Variant('b', True))
            # Also invoke bluetoothctl trust as a reliable fallback
            mac = object_path.split("dev_")[-1].replace("_", ":")
            subprocess.run(["bluetoothctl", "trust", mac], check=False, stdout=subprocess.DEVNULL)
            print(f"[+] Automatically trusted device: {dev_name} ({object_path})")
    except Exception as e:
        print(f"[-] Failed to trust device {object_path}: {e}", file=sys.stderr)

def auto_connect_trusted_audio():
    """On boot, connect all paired+trusted Bluetooth audio devices that are in range."""
    try:
        om = Gio.DBusProxy.new_sync(
            bus,
            Gio.DBusProxyFlags.NONE,
            None,
            'org.bluez',
            '/',
            'org.freedesktop.DBus.ObjectManager',
            None
        )
        objects = om.GetManagedObjects()
        for path, ifaces in objects.items():
            if 'org.bluez.Device1' in ifaces:
                props = ifaces['org.bluez.Device1']
                paired   = props.get('Paired', False)
                trusted  = props.get('Trusted', False)
                connected = props.get('Connected', False)
                uuids    = props.get('UUIDs', [])
                name     = props.get('Name', 'Unknown')
                is_audio = any("110b" in u.lower() or "110a" in u.lower() for u in uuids)
                if paired and trusted and not connected and is_audio:
                    mac = path.split("dev_")[-1].replace("_", ":")
                    print(f"[+] Boot auto-connect: {name} ({mac})")
                    subprocess.Popen(["bluetoothctl", "connect", mac],
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        print(f"Error in auto_connect_trusted_audio: {e}", file=sys.stderr)
    return False  # GLib.timeout_add: do not repeat

def check_all_devices():
    try:
        om = Gio.DBusProxy.new_sync(
            bus,
            Gio.DBusProxyFlags.NONE,
            None,
            'org.bluez',
            '/',
            'org.freedesktop.DBus.ObjectManager',
            None
        )
        objects = om.GetManagedObjects()
        for path, ifaces in objects.items():
            if 'org.bluez.Device1' in ifaces:
                props = ifaces['org.bluez.Device1']
                name = props.get('Name', 'Unknown Device')
                paired = props.get('Paired', False)
                trusted = props.get('Trusted', False)
                connected = props.get('Connected', False)
                uuids = props.get('UUIDs', [])

                if paired and not trusted:
                    trust_device(path, name)

                # If device is already connected on startup (e.g. after restart/crash), ensure audio is routed
                is_audio = any("110b" in str(u).lower() or "110a" in str(u).lower() or "111e" in str(u).lower() for u in uuids)
                if connected and is_audio:
                    mac_clean = path.split("dev_")[-1]
                    GLib.timeout_add(200, lambda m=mac_clean, n=name: (switch_audio_to_bluetooth(m, n), False)[1])
    except Exception as e:
        print(f"Error checking devices: {e}", file=sys.stderr)


def on_signal(connection, sender_name, object_path, interface_name, signal_name, parameters, user_data):
    if interface_name == 'org.freedesktop.DBus.Properties' and signal_name == 'PropertiesChanged':
        iface, changed, _ = parameters.unpack()
        if iface == 'org.bluez.Device1':
            dev_proxy = Gio.DBusProxy.new_sync(
                bus,
                Gio.DBusProxyFlags.NONE,
                None,
                'org.bluez',
                object_path,
                'org.bluez.Device1',
                None
            )
            name_prop = dev_proxy.get_cached_property('Name')
            dev_name = name_prop.get_string() if name_prop else "Bluetooth Device"
            
            # If device was paired, ensure it is trusted immediately
            if 'Paired' in changed and changed['Paired']:
                trust_device(object_path, dev_name)

            # If device connected
            if 'Connected' in changed and changed['Connected']:
                trust_device(object_path, dev_name)
                # Check if it has Audio Sink UUID
                uuids_prop = dev_proxy.get_cached_property('UUIDs')
                is_audio = False
                if uuids_prop:
                    for u in uuids_prop.unpack():
                        if "110b" in u.lower() or "110a" in u.lower() or "111e" in u.lower():
                            is_audio = True
                            break
                if is_audio:
                    mac_clean = object_path.split("dev_")[-1]
                    # Route audio in separate worker / thread or quick timeout
                    GLib.timeout_add(100, lambda: (switch_audio_to_bluetooth(mac_clean, dev_name), False)[1])

            elif 'Connected' in changed and not changed['Connected']:
                # Disconnected
                uuids_prop = dev_proxy.get_cached_property('UUIDs')
                is_audio = False
                if uuids_prop:
                    for u in uuids_prop.unpack():
                        if "110b" in u.lower() or "110a" in u.lower() or "111e" in u.lower():
                            is_audio = True
                            break
                if is_audio:
                    notify("Bluetooth Audio Disconnected", f"{dev_name} disconnected, audio on speakers", "audio-speakers")

    elif interface_name == 'org.freedesktop.DBus.ObjectManager' and signal_name == 'InterfacesAdded':
        obj_path, ifaces = parameters.unpack()
        if 'org.bluez.Device1' in ifaces:
            props = ifaces['org.bluez.Device1']
            name = props.get('Name', 'Bluetooth Device')
            paired = props.get('Paired', False)
            if paired:
                trust_device(obj_path, name)

def main():
    check_all_devices()
    # After 5s, attempt to reconnect any trusted audio devices not yet connected
    # (handles boot scenario where BlueZ starts before headset radio wakes up)
    GLib.timeout_add(5000, auto_connect_trusted_audio)
    bus.signal_subscribe(
        'org.bluez',
        None,
        None,
        None,
        None,
        Gio.DBusSignalFlags.NONE,
        on_signal,
        None
    )
    loop = GLib.MainLoop()
    try:
        loop.run()
    except KeyboardInterrupt:
        pass

if __name__ == '__main__':
    main()
