#!/usr/bin/env bash
# rofi-games — game launcher menu (Alt+g). All entries use Proton, never vanilla Wine.
export PATH="$HOME/.local/bin:$PATH"

options="✨ ELDEN RING + FG (2x)\n🗡️ ELDEN RING\n🧪 ELDEN RING (Gamescope test)\n🎮 Steam library\n⚙️ Configure LSFG (GUI)\n🛑 Kill game"
chosen=$(echo -e "$options" | rofi -dmenu -i \
    -sort \
    -sorting-method "fzf" \
    -matching "fuzzy" \
    -p "Games" \
    -theme "$HOME/.config/rofi/games.rasi")

case "$chosen" in
    *"Steam"*)          env STEAM_DGPU=1 steam-workspace ;;
    *"+ FG"*)           env ENABLE_LSFG=1 LSFGVK_PROFILE='Elden Ring' mangohud eldenring-run ;;
    *"Gamescope test"*) env ENABLE_LSFG=0 DISABLE_LSFGVK=1 mangohud eldenring-run ;;
    *"ELDEN RING"*)     env ENABLE_LSFG=0 DISABLE_LSFGVK=1 mangohud eldenring-run ;;
    *"Configure LSFG"*) ( ~/.local/bin/lsfg-vk-ui >/dev/null 2>&1 & ) ;;
    *"Kill"*)           killgame ;;
esac
