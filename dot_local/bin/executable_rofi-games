#!/usr/bin/env bash
# rofi-games / game launcher menu (Alt+g) powered by fuzzel.
export PATH="$HOME/.local/bin:$PATH"

options="ELDEN RING + LSFG (120 FPS)\nGrand Theft Auto IV + LSFG (165 FPS)\nER Randomizer Config (GUI)\nDARK SOULS III + LSFG\nDS3 Randomizer Config (GUI)\nSteam library\nConfigure LSFG (GUI)\nKill game"
REG="$HOME/.config/rofi/epic-games.list"
if [ -f "$REG" ]; then
    while IFS='|' read -r title _ _; do
        [ -n "$title" ] && options="$options\n$title"
    done < "$REG"
fi

chosen=$(echo -e "$options" | fuzzel --dmenu --prompt "❯ " --width 38 --lines 10)

[ -z "$chosen" ] && exit 0

# Epic registry hit? Dispatch generically — no per-game edits needed.
if [ -f "$REG" ]; then
    GOT="$(awk -F'|' -v sel="$chosen" '$1==sel{print $2"\t"$3; exit}' "$REG")"
    if [ -n "$GOT" ]; then
        AID="$(echo "$GOT" | cut -f1)"; PFX="$(echo "$GOT" | cut -f2)"
        if [ -n "$PFX" ]; then epic-launch "$AID" "$PFX"; else epic-launch "$AID"; fi
        exit 0
    fi
fi

case "$chosen" in
    *"ELDEN RING + LSFG"*) ( nohup eldenring-lsfg >/tmp/eldenring-lsfg.log 2>&1 & ) ;;
    *"Grand Theft Auto IV"*) ( nohup env STEAM_DGPU=1 steam steam://rungameid/12210 >/dev/null 2>&1 & ) ;;
    *"ER Randomizer"*)  ( nohup eldenring-randomizer-gui >/dev/null 2>&1 & ) ;;
    *"DARK SOULS III + LSFG"*) ( nohup mangohud darksouls3-run >/dev/null 2>&1 & ) ;;
    *"DS3 Randomizer"*) ( nohup ds3-randomizer-gui >/dev/null 2>&1 & ) ;;
    *"Steam"*)          ( nohup env STEAM_DGPU=1 steam-workspace >/dev/null 2>&1 & ) ;;
    *"Configure LSFG"*) ( nohup ~/.local/bin/lsfg-vk-ui >/dev/null 2>&1 & ) ;;
    *"Kill"*)           killgame ;;
esac
