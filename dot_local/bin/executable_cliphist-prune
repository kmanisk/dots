#!/usr/bin/env bash
# ==============================================================================
# cliphist-prune: Prune clipboard database and purge pinned files older than TTL
# Default Retention: 7 days for unpinned clipboard DB, 30 days for orphaned pins
# ==============================================================================
PIN_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/clipboard_pins"

# Prune unpinned history bounded to 200 items max
if cliphist list 2>/dev/null | grep -q .; then
    # Keep only the newest 200 clips
    cliphist list 2>/dev/null | tail -n +201 | while read -r line; do
        cliphist delete <<< "$line" 2>/dev/null
    done
fi

# Remove any temporary or untagged pin scratch files older than 30 days
if [ -d "$PIN_DIR" ]; then
    find "$PIN_DIR" -type f -mtime +30 -delete 2>/dev/null
fi
