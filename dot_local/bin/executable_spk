#!/usr/bin/env bash
# ==============================================================================
# spk — ASUS TUF F16 Speaker DSP Control Utility
# Upstream DAX3-derived PipeWire DSP profile switcher & state manager
# ==============================================================================
set -euo pipefail

CONF_BASE="$HOME/.config/pipewire/asus-tuf-dax"
RUNTIME_CONF_DIR="$HOME/.config/pipewire/pipewire.conf.d"
STATE_DIR="$HOME/.config/asus-speakers"
STATE_FILE="$STATE_DIR/state.conf"

mkdir -p "$STATE_DIR"
if [[ ! -f "$STATE_FILE" ]]; then
    echo "ACTIVE_VOICING=tuned" > "$STATE_FILE"
    echo "ENABLED=true" >> "$STATE_FILE"
fi

get_active_voicing() {
    grep "^ACTIVE_VOICING=" "$STATE_FILE" 2>/dev/null | cut -d'=' -f2 || echo "tuned"
}

is_user_enabled() {
    local val
    val=$(grep "^ENABLED=" "$STATE_FILE" 2>/dev/null | cut -d'=' -f2 || echo "true")
    [[ "$val" == "true" ]]
}

check_hardware() {
    local dmi_prod alc_match
    dmi_prod=$(cat /sys/class/dmi/id/product_name 2>/dev/null || echo "")
    alc_match=$(grep -i "10431084" /proc/asound/card*/codec#* 2>/dev/null || echo "")
    if [[ ! "$dmi_prod" =~ FX608 ]] && [[ -z "$alc_match" ]]; then
        echo -e "\033[1;33m[!] Warning: Non-ASUS TUF ALC256 hardware detected ($dmi_prod).\033[0m" >&2
    fi
}

get_node_id() {
    pw-dump Node 2>/dev/null | jq -r '.[] | select(.info.props["node.name"] == "effect_input.Dolby_Speaker") | .id' 2>/dev/null | head -n 1
}

ALSA_SINK="alsa_output.pci-0000_00_1f.3.analog-stereo"

get_active_physical_target() {
    local def_sink
    def_sink=$(pactl get-default-sink 2>/dev/null || echo "")

    if [[ "$def_sink" =~ ^bluez_output ]]; then
        echo "bluetooth:$def_sink"
        return
    fi

    if [[ "$def_sink" == "$ALSA_SINK" ]]; then
        local active_port
        active_port=$(pactl list sinks 2>/dev/null | awk -v s="$ALSA_SINK" '$0 ~ "Name: " s {f=1} f && /Active Port:/ {print $3; exit}' || echo "analog-output-speaker")
        if [[ "$active_port" == "analog-output-headphones" ]]; then
            echo "headphones:$ALSA_SINK"
        else
            echo "speaker:$ALSA_SINK"
        fi
        return
    fi

    local meta_sink
    meta_sink=$(pw-metadata -n default 0 default.audio.sink 2>/dev/null | grep -o '"name": "[^"]*"' | cut -d'"' -f4 || echo "")
    if [[ "$meta_sink" =~ ^bluez_output ]]; then
        echo "bluetooth:$meta_sink"
        return
    fi

    local bt_sink
    bt_sink=$(pactl list short sinks 2>/dev/null | awk '{print $2}' | grep '^bluez_output' | head -n 1 || echo "")
    if [[ -n "$bt_sink" ]]; then
        if pw-link -l 2>/dev/null | grep -q "$bt_sink"; then
            echo "bluetooth:$bt_sink"
            return
        fi
    fi

    local alsa_port
    alsa_port=$(pactl list sinks 2>/dev/null | awk -v s="$ALSA_SINK" '$0 ~ "Name: " s {f=1} f && /Active Port:/ {print $3; exit}' || echo "analog-output-speaker")
    if [[ "$alsa_port" == "analog-output-headphones" ]]; then
        echo "headphones:$ALSA_SINK"
    else
        echo "speaker:$ALSA_SINK"
    fi
}

apply_voicing() {
    local voicing="$1"
    local title=""
    case "$voicing" in
        custom|c)
            voicing="custom"
            title="Custom 2 (Dolby Access)"
            ;;
        tuned|t)
            voicing="tuned"
            title="Tuned (Focused & Natural)"
            ;;
        tuned-old|tuned_old|old-tuned|old_tuned|to)
            voicing="tuned-old"
            title="Tuned (Old / Wide)"
            ;;
        dynamic|dyn)
            voicing="dynamic"
            title="Dynamic (DAX3 Default)"
            ;;
        music|mu)
            voicing="music"
            title="Music (DAX3 Audiophile)"
            ;;
        balanced|b)
            voicing="balanced"
            title="Balanced (Linux)"
            ;;
        experimental|exp|e)
            voicing="experimental"
            title="Experimental (Harmonic Bass & Tuned)"
            ;;
        *)
            echo "Error: Unknown profile '$voicing'." >&2
            echo "Available Profiles: tuned (t), tuned-old (to), custom (c), dynamic (dyn), music (mu), balanced (b), experimental (exp)" >&2
            exit 1
            ;;
    esac

    local src_conf="$CONF_BASE/$voicing/Dolby_Speaker.conf"
    local src_irs="$CONF_BASE/$voicing/Dolby_Speaker.irs"

    if [[ ! -f "$src_conf" ]] || [[ ! -f "$src_irs" ]]; then
        echo "Error: Profile assets missing in $CONF_BASE/$voicing/" >&2
        exit 1
    fi

    # Capture active physical target BEFORE restarting service
    local active_info
    active_info=$(get_active_physical_target)
    local active_type="${active_info%%:*}"
    local active_sink="${active_info#*:}"

    # Deploy active runner profile (symlink-only).
    # runner.conf embeds the profile IR path directly, so this symlink is the
    # single live artifact; ACTIVE_VOICING in $STATE_FILE records the selection.
    ln -sf "$CONF_BASE/$voicing/runner.conf" "$CONF_BASE/active-runner.conf"

    # Update state
    sed -i '/^ACTIVE_VOICING=/d' "$STATE_FILE"
    echo "ACTIVE_VOICING=$voicing" >> "$STATE_FILE"

    # Instantly restart standalone speaker DSP runner (does NOT touch PipeWire, PulseAudio, or Bluetooth)
    systemctl --user restart asus-speaker-dsp.service 2>/dev/null || systemctl --user start asus-speaker-dsp.service 2>/dev/null || true

    # Wait for node to register and ensure output links
    local nid=""
    for _ in {1..20}; do
        nid=$(get_node_id)
        if [[ -n "$nid" ]] && pw-link -o 2>/dev/null | grep -q "effect_output.Dolby_Speaker:output_FL"; then
            break
        fi
        sleep 0.05
    done

    # Ensure output is connected to ALSA hardware
    pw-link effect_output.Dolby_Speaker:output_FL alsa_output.pci-0000_00_1f.3.analog-stereo:playback_FL 2>/dev/null || true
    pw-link effect_output.Dolby_Speaker:output_FR alsa_output.pci-0000_00_1f.3.analog-stereo:playback_FR 2>/dev/null || true

    # Pin DSP filter input volumes at 100% unmute so filter headrooms never clip or attenuate
    if [[ -n "$nid" ]]; then
        wpctl set-volume "$nid" 1.0 2>/dev/null || true
        wpctl set-mute "$nid" 0 2>/dev/null || true
    fi
    local hp_id
    hp_id=$(pw-dump Node 2>/dev/null | jq -r '.[] | select(.info.props["node.name"] == "effect_input.Dolby_Headphones") | .id' 2>/dev/null | head -n 1 || true)
    if [[ -n "$hp_id" && "$hp_id" != "null" ]]; then
        wpctl set-volume "$hp_id" 1.0 2>/dev/null || true
        wpctl set-mute "$hp_id" 0 2>/dev/null || true
    fi
    local peace_id
    peace_id=$(pw-dump Node 2>/dev/null | jq -r '.[] | select(.info.props["node.name"] == "sink.peace_gaming") | .id' 2>/dev/null | head -n 1 || true)
    if [[ -n "$peace_id" && "$peace_id" != "null" ]]; then
        wpctl set-volume "$peace_id" 1.0 2>/dev/null || true
        wpctl set-mute "$peace_id" 0 2>/dev/null || true
    fi

    # Set user enabled preference in metadata
    if [[ -n "$nid" ]]; then
        if is_user_enabled; then
            pw-metadata -n filters "$nid" filter.smart.user_disabled false 2>/dev/null || true
        else
            pw-metadata -n filters "$nid" filter.smart.user_disabled true 2>/dev/null || true
        fi
    fi

    # Dynamically preserve active target routing (Never hijack Bluetooth or Wired Headphones!)
    case "$active_type" in
        bluetooth)
            pactl set-default-sink "$active_sink" 2>/dev/null || true
            pw-metadata -n default 0 default.audio.sink "{\"name\":\"$active_sink\"}" 2>/dev/null || true
            pw-metadata -n default 0 default.configured.audio.sink "{\"name\":\"$active_sink\"}" 2>/dev/null || true

            # Strictly disable Dolby_Speaker FIR on Bluetooth
            [[ -n "$nid" ]] && pw-metadata -n filters "$nid" filter.smart.disabled true 2>/dev/null || true
            # Enable Dolby_Headphones targeting Bluetooth
            [[ -n "$hp_id" && "$hp_id" != "null" ]] && pw-metadata -n filters "$hp_id" filter.smart.disabled false 2>/dev/null || true

            # Keep application streams on Bluetooth (skip competitive games & internal nodes)
            python3 -c '
import subprocess, sys
target_sink = sys.argv[1]
try:
    pactl_inputs = subprocess.check_output(["pactl", "list", "sink-inputs"], text=True)
    current_id = None
    node_name, media_name, app_name, bin_name = "", "", "", ""
    is_virtual = False
    for line in pactl_inputs.split("\n") + [""]:
        line_s = line.strip()
        if line_s.startswith("Sink Input #"):
            current_id = line_s.split("#")[1].strip()
            node_name, media_name, app_name, bin_name = "", "", "", ""
            is_virtual = False
        elif "node.name =" in line_s:
            node_name = line_s.split("=")[1].strip(" \"")
        elif "media.name =" in line_s:
            media_name = line_s.split("=")[1].strip(" \"")
        elif "application.name =" in line_s:
            app_name = line_s.split("=")[1].strip(" \"")
        elif "application.process.binary =" in line_s:
            bin_name = line_s.split("=")[1].strip(" \"")
        elif "node.virtual = \"true\"" in line_s:
            is_virtual = True
        elif not line_s and current_id:
            is_internal = is_virtual or node_name.startswith(("effect_output.", "playback.")) or any(x in node_name for x in ["ghelper", "dusky", "rnnoise", "peace_gaming"])
            combo_name = (app_name + " " + bin_name + " " + media_name + " " + node_name).lower()
            is_comp_game = any(g in combo_name for g in ["cs2", "counter-strike", "tslgame", "pubg", "r5apex", "apex legends", "discovery.exe", "the finals", "huntgame"])
            if not is_internal and not is_comp_game:
                subprocess.run(["pactl", "move-sink-input", current_id, target_sink], stderr=subprocess.DEVNULL)
            current_id = None
except Exception:
    pass
' "$active_sink" 2>/dev/null || true
            ;;

        headphones)
            pactl set-sink-port "$ALSA_SINK" "analog-output-headphones" 2>/dev/null || true
            pactl set-default-sink "$ALSA_SINK" 2>/dev/null || true
            pw-metadata -n default 0 default.audio.sink "{\"name\":\"$ALSA_SINK\"}" 2>/dev/null || true
            pw-metadata -n default 0 default.configured.audio.sink "{\"name\":\"$ALSA_SINK\"}" 2>/dev/null || true

            # Strictly disable Dolby_Speaker FIR on Wired Headphones
            [[ -n "$nid" ]] && pw-metadata -n filters "$nid" filter.smart.disabled true 2>/dev/null || true
            # Enable Dolby_Headphones targeting ALSA
            [[ -n "$hp_id" && "$hp_id" != "null" ]] && pw-metadata -n filters "$hp_id" filter.smart.disabled false 2>/dev/null || true
            ;;

        speaker|*)
            pactl set-sink-port "$ALSA_SINK" "analog-output-speaker" 2>/dev/null || true
            pactl set-default-sink "$ALSA_SINK" 2>/dev/null || true
            pw-metadata -n default 0 default.audio.sink "{\"name\":\"$ALSA_SINK\"}" 2>/dev/null || true
            pw-metadata -n default 0 default.configured.audio.sink "{\"name\":\"$ALSA_SINK\"}" 2>/dev/null || true

            if is_user_enabled; then
                [[ -n "$nid" ]] && pw-metadata -n filters "$nid" filter.smart.disabled false 2>/dev/null || true
            else
                [[ -n "$nid" ]] && pw-metadata -n filters "$nid" filter.smart.disabled true 2>/dev/null || true
            fi
            # Disable Dolby_Headphones on Internal Speakers
            [[ -n "$hp_id" && "$hp_id" != "null" ]] && pw-metadata -n filters "$hp_id" filter.smart.disabled true 2>/dev/null || true

            # Move application streams to speaker (skip competitive games & internal nodes)
            python3 -c '
import subprocess, sys
target_sink = sys.argv[1]
try:
    pactl_inputs = subprocess.check_output(["pactl", "list", "sink-inputs"], text=True)
    current_id = None
    node_name, media_name, app_name, bin_name = "", "", "", ""
    is_virtual = False
    for line in pactl_inputs.split("\n") + [""]:
        line_s = line.strip()
        if line_s.startswith("Sink Input #"):
            current_id = line_s.split("#")[1].strip()
            node_name, media_name, app_name, bin_name = "", "", "", ""
            is_virtual = False
        elif "node.name =" in line_s:
            node_name = line_s.split("=")[1].strip(" \"")
        elif "media.name =" in line_s:
            media_name = line_s.split("=")[1].strip(" \"")
        elif "application.name =" in line_s:
            app_name = line_s.split("=")[1].strip(" \"")
        elif "application.process.binary =" in line_s:
            bin_name = line_s.split("=")[1].strip(" \"")
        elif "node.virtual = \"true\"" in line_s:
            is_virtual = True
        elif not line_s and current_id:
            is_internal = is_virtual or node_name.startswith(("effect_output.", "playback.")) or any(x in node_name for x in ["ghelper", "dusky", "rnnoise", "peace_gaming"])
            combo_name = (app_name + " " + bin_name + " " + media_name + " " + node_name).lower()
            is_comp_game = any(g in combo_name for g in ["cs2", "counter-strike", "tslgame", "pubg", "r5apex", "apex legends", "discovery.exe", "the finals", "huntgame"])
            if not is_internal and not is_comp_game:
                subprocess.run(["pactl", "move-sink-input", current_id, target_sink], stderr=subprocess.DEVNULL)
            current_id = None
except Exception:
    pass
' "$ALSA_SINK" 2>/dev/null || true
            ;;
    esac

    # Ensure playback.peace_gaming links to active physical target
    if pw-link -l 2>/dev/null | grep -q "playback.peace_gaming"; then
        local peace_target="$active_sink"
        [[ -z "$peace_target" ]] && peace_target="$ALSA_SINK"
        local fl_port fr_port
        fl_port=$(pw-link -i 2>/dev/null | grep -E "^${peace_target}:(playback_FL|playback_1)" | head -n 1 || true)
        fr_port=$(pw-link -i 2>/dev/null | grep -E "^${peace_target}:(playback_FR|playback_2)" | head -n 1 || true)
        if [[ -n "$fl_port" && -n "$fr_port" ]]; then
            pw-link "playback.peace_gaming:output_FL" "$fl_port" 2>/dev/null || true
            pw-link "playback.peace_gaming:output_FR" "$fr_port" 2>/dev/null || true
            for p in $(pw-link -l 2>/dev/null | grep -A 2 "playback.peace_gaming:output_FL" | grep "|->" | awk '{print $2}'); do
                [[ -n "$p" && "$p" != "$fl_port" ]] && pw-link -d "playback.peace_gaming:output_FL" "$p" 2>/dev/null || true
            done
            for p in $(pw-link -l 2>/dev/null | grep -A 2 "playback.peace_gaming:output_FR" | grep "|->" | awk '{print $2}'); do
                [[ -n "$p" && "$p" != "$fr_port" ]] && pw-link -d "playback.peace_gaming:output_FR" "$p" 2>/dev/null || true
            done
        fi
    fi

    echo -e "\033[1;32m[spk]\033[0m Switched to \033[1m$title\033[0m profile (transparent on internal speakers)."
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -t 2000 -i audio-speakers "ASUS TUF Speaker DSP" "Profile: $title" 2>/dev/null &
    fi
}

dsp_off() {
    local nid
    nid=$(get_node_id)
    if [[ -n "$nid" ]]; then
        pw-metadata -n filters "$nid" filter.smart.user_disabled true 2>/dev/null || true
        pw-metadata -n filters "$nid" filter.smart.disabled true 2>/dev/null || true
    fi
    sed -i '/^ENABLED=/d' "$STATE_FILE"
    echo "ENABLED=false" >> "$STATE_FILE"

    echo -e "\033[1;33m[spk]\033[0m Speaker DSP \033[1;31mDisabled\033[0m (bypassed to flat internal speakers)."
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -t 2000 -i audio-volume-muted "ASUS TUF Speaker DSP" "Disabled (Bypassed)" 2>/dev/null &
    fi
}

dsp_on() {
    local nid
    nid=$(get_node_id)
    if [[ -n "$nid" ]]; then
        pw-metadata -n filters "$nid" filter.smart.user_disabled false 2>/dev/null || true
        local active_info active_type
        active_info=$(get_active_physical_target)
        active_type="${active_info%%:*}"
        if [[ "$active_type" == "speaker" ]]; then
            pw-metadata -n filters "$nid" filter.smart.disabled false 2>/dev/null || true
        fi
    fi
    sed -i '/^ENABLED=/d' "$STATE_FILE"
    echo "ENABLED=true" >> "$STATE_FILE"

    echo -e "\033[1;32m[spk]\033[0m Speaker DSP \033[1;32mEnabled\033[0m (transparent upstream DAX3 active)."
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -t 2000 -i audio-speakers "ASUS TUF Speaker DSP" "Enabled" 2>/dev/null &
    fi
}

dsp_status() {
    check_hardware
    local active_v enabled_str
    active_v=$(get_active_voicing)
    if is_user_enabled; then
        enabled_str="\033[1;32mEnabled (Active on internal speakers)\033[0m"
    else
        enabled_str="\033[1;31mDisabled (Bypassed)\033[0m"
    fi

    local nid
    nid=$(get_node_id)
    local meta_disabled="unknown"
    local meta_user_disabled="unknown"
    if [[ -n "$nid" ]]; then
        meta_disabled=$(pw-metadata -n filters 2>/dev/null | grep -E "id:$nid key:'filter\.smart\.disabled'" | sed -n "s/.*value:'\([^']*\)'.*/\1/p" || echo "false")
        meta_user_disabled=$(pw-metadata -n filters 2>/dev/null | grep -E "id:$nid key:'filter\.smart\.user_disabled'" | sed -n "s/.*value:'\([^']*\)'.*/\1/p" || echo "false")
    fi

    local current_sink
    current_sink=$(pactl get-default-sink 2>/dev/null || echo "unknown")
    local dmi_prod
    dmi_prod=$(cat /sys/class/dmi/id/product_name 2>/dev/null || echo "Unknown")

    echo "========================================================"
    echo "       ASUS TUF F16 Upstream DAX3 Speaker DSP           "
    echo "========================================================"
    echo -e " Hardware:        $dmi_prod (ALC256 / 1043:1084)"
    echo -e " State:           $enabled_str"
    echo -e " Active Profile:  \033[1m$active_v\033[0m"
    echo -e " Smart Node ID:   ${nid:-not found}"
    echo -e " Filter Bypass:   filter.smart.disabled=${meta_disabled:-false}"
    echo -e " User Disabled:   filter.smart.user_disabled=${meta_user_disabled:-false}"
    echo -e " Physical Sink:   $current_sink"
    echo -e " Gaming Audio:    sink.peace_gaming (Protected & Isolated)"
    echo "--------------------------------------------------------"
    echo " Active streams through DSP:"
    pw-link -l 2>/dev/null | grep -E "ASUS TUF Speaker DSP|effect_input\.Dolby" || echo "  (None active)"
    echo "========================================================"
}

show_help() {
    local active_v
    active_v=$(get_active_voicing)
    echo "Usage: spk [command]"
    echo ""
    echo "Core Speaker Profiles:"
    echo "  tuned, t       Switch to Tuned mode (Refined slev 1.30, full DAX3 loudness)"
    echo "  tuned-old, to  Switch to Tuned (Old) mode (Wide slev 1.82, full DAX3 loudness)"
    echo "  custom, c      Switch to Custom 2 mode (Dolby Access user preset, +11.6dB presence)"
    echo "  dynamic, dyn   Switch to Dynamic mode (Windows DAX3 default, Leveler + Spatial)"
    echo "  music, mu      Switch to Music mode (DAX3 Audiophile, uncompressed dynamics)"
    echo "  balanced, b    Switch to Balanced voicing (reference DAX3 baseline)"
    echo "  experimental, exp Switch to Experimental mode (Harmonic Bass & Tuned)"
    echo ""
    echo "Controls:"
    echo "  status         Display detailed DSP telemetry, routing & filter state"
    echo "  off            Bypass DSP immediately (zero interruption, flat sound)"
    echo "  on             Re-enable DSP on internal speakers"
    echo "  help, -h       Show this message"
    echo ""
    echo "Current Profile: $active_v"
}

# Subcommand dispatch
case "${1:-}" in
    custom|c)
        apply_voicing "custom"
        ;;
    tuned|t)
        apply_voicing "tuned"
        ;;
    tuned-old|tuned_old|old-tuned|old_tuned|to)
        apply_voicing "tuned-old"
        ;;
    dynamic|dyn)
        apply_voicing "dynamic"
        ;;
    music|mu)
        apply_voicing "music"
        ;;
    balanced|b)
        apply_voicing "balanced"
        ;;
    experimental|exp|e)
        apply_voicing "experimental"
        ;;
    off)
        dsp_off
        ;;
    on)
        dsp_on
        ;;
    status)
        dsp_status
        ;;
    help|-h|--help)
        show_help
        ;;
    "")
        show_help
        echo ""
        dsp_status
        ;;
    *)
        echo "Error: Unknown command '$1'"
        show_help
        exit 1
        ;;
esac
