#!/usr/bin/env bash
# eldenring-lsfg: Elden Ring Launcher with ModEngine2, EldenModLoader, CameraFix,
# optional LSFG-VK 4x frame generation, and RTX 5050 Mobile dGPU offload.
# MangoHud is diagnostic opt-in only (ELDENRING_MANGOHUD=1); default injection
# is disabled because it currently freezes Elden Ring's startup presentation.
set -e

# Steam AppID for Elden Ring
export SteamAppId="1245620"
export SteamGameId="1245620"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="$HOME/.local/share/Steam"
export STEAM_COMPAT_DATA_PATH="$HOME/.local/share/Steam/steamapps/compatdata/2703476723"

# --- GPU mode-aware graphics environment (AGENTS.md Rule 2) ---
if [ -z "$GPU_MODE" ]; then
    if [ -r "${XDG_RUNTIME_DIR:-/run/user/$UID}/gpu_mode" ]; then
        read -r GPU_MODE < "${XDG_RUNTIME_DIR:-/run/user/$UID}/gpu_mode"
    else
        GPU_MODE="$(supergfxctl -g 2>/dev/null || true)"
    fi
fi

case "$GPU_MODE" in
    Hybrid)
        export __NV_PRIME_RENDER_OFFLOAD=1
        export __GLX_VENDOR_LIBRARY_NAME=nvidia
        export __VK_LAYER_NV_optimus=NVIDIA_only
        export LIBVA_DRIVER_NAME=iHD
        ;;
    AsusMuxDgpu)
        unset __NV_PRIME_RENDER_OFFLOAD
        unset __GLX_VENDOR_LIBRARY_NAME
        export __VK_LAYER_NV_optimus=NVIDIA_only
        export LIBVA_DRIVER_NAME=nvidia
        ;;
    *)
        export __NV_PRIME_RENDER_OFFLOAD=1
        export __GLX_VENDOR_LIBRARY_NAME=nvidia
        export __VK_LAYER_NV_optimus=NVIDIA_only
        ;;
esac

# Audio: follow the system default output (whatever Alt+Shift+o selected).
# Do NOT force sink.peace_gaming here — forced routing bypasses the default
# device and goes silent when the gaming chain is idle-suspended.
unset PIPEWIRE_NODE
unset PULSE_SINK

# Blackwell (RTX 50-series) VKD3D memory alignment & stability fixes
export VKD3D_CONFIG="no_upload_hvv,force_host_cached"
export PROTON_ENABLE_NVAPI=0
export PROTON_USE_XALIA=0
export PROTON_NO_XALIA=1
export WINEDLLOVERRIDES="dinput8=b"

# Keep outer MangoHud unset so Proton's Python/runtime wrappers never load it.
# The inner script writes an empty user_settings.py by default; set
# ELDENRING_MANGOHUD=1 only for explicit diagnostics.
unset MANGOHUD
unset MANGOHUD_CONFIG

# 2026-11-06 A/B: the same randomizer/mod stack freezes at a fully black
# surface with LSFG 4x enabled but renders changing frames when disabled.
# Default to the verified playable path. 4x is explicit opt-in while its
# present hook remains unstable; do not change the shared lsfg-vk config.
if [ "${ENABLE_LSFG:-0}" = "1" ] && [ "${DISABLE_LSFGVK:-0}" != "1" ]; then
    export LSFGVK_PROFILE="Elden Ring"
    unset DISABLE_LSFGVK
    LSFG_STATUS="LSFG 4x (experimental)"
else
    export DISABLE_LSFGVK=1
    unset LSFGVK_PROFILE
    LSFG_STATUS="LSFG off (stable)"
fi

# This is a non-Steam game installation. Do not start or wait for the native
# Steam client here. SteamAppId/SteamGameId and the compatibility paths above
# are Proton/ModEngine compatibility metadata only; they do not imply that the
# Steam desktop client should be launched.

# Single-instance guard: a repeat Alt+g pick (or key-repeat double-fire) while the
# game is up must not spawn a second copy and race the prefix lock.
if pgrep -f "^Z:.*eldenring\.exe" >/dev/null 2>&1; then
    notify-send -i input-gaming "ELDEN RING" "Already running — switching to Workspace 4..." 2>/dev/null || true
    if [ -n "$SWAYSOCK" ] || [ -n "$WAYLAND_DISPLAY" ]; then
        swaymsg "workspace number 4" >/dev/null 2>&1 || true
    else
        i3-msg "workspace 4" >/dev/null 2>&1 || true
    fi
    exit 0
fi

# Auto power profile: Set Performance mode while playing, restore Balanced on exit
asusctl profile set Performance >/dev/null 2>&1 || true
trap 'asusctl profile set Balanced >/dev/null 2>&1 || true' EXIT INT TERM
trap '' HUP

# Focus Workspace 4 automatically (Sway or i3 IPC)
notify-send -i input-gaming "ELDEN RING" "Launching Elden Ring ($LSFG_STATUS; randomizer + QoL mods)..." 2>/dev/null || true
if [ -n "$SWAYSOCK" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    swaymsg "workspace number 4" >/dev/null 2>&1 || true
else
    i3-msg "workspace 4" >/dev/null 2>&1 || true
fi

GAME_DIR="/mnt/Games/NonSteamGames/ELDEN RING/Game"
GAME_EXE="$GAME_DIR/eldenring.exe"
ME2_DIR="/mnt/Games/NonSteamGames/ELDEN RING/ModEngine2/ModEngine-2.1.0.0-win64"

# Select Proton runner
if [ -f "$HOME/.local/share/Steam/compatibilitytools.d/proton-cachyos-slr/proton" ]; then
    PROTON_BIN="$HOME/.local/share/Steam/compatibilitytools.d/proton-cachyos-slr/proton"
elif [ -f "$HOME/.local/share/Steam/compatibilitytools.d/GE-Proton11-7-x86_64/proton" ]; then
    PROTON_BIN="$HOME/.local/share/Steam/compatibilitytools.d/GE-Proton11-7-x86_64/proton"
else
    PROTON_BIN="$HOME/.local/share/Steam/steamapps/common/Proton - Experimental/proton"
fi

INNER_BIN="$HOME/.local/bin/eldenring-launch-inner"

# Stale-prefix cleanup: if a previous session was SIGKILLed, its wineserver can
# linger with no game behind it. A fresh proton then attaches to the dead
# server and exits early (notification, no game). Reap it first. The guard
# above already returned when a real game is running, so this only fires when
# the prefix is truly abandoned.
if ! pgrep -f "^Z:.*eldenring\.exe" >/dev/null 2>&1; then
    for _ws in "$HOME/.local/share/Steam/compatibilitytools.d/proton-cachyos-slr/files/bin/wineserver" \
               "$HOME/.local/share/Steam/compatibilitytools.d/GE-Proton11-7-x86_64/files/bin/wineserver"; do
        if [ -x "$_ws" ]; then
            WINEPREFIX="$STEAM_COMPAT_DATA_PATH/pfx" "$_ws" -k >/dev/null 2>&1 || true
        fi
    done
fi

# NOTE (2026-10-16): Do NOT pin with taskset -c 0-11. Verified by A/B testing:
# taskset 0-11 -> eldenring.exe exits early at Vulkan device creation (EXIT 0, no window);
# taskset 0-15 / no pinning -> survives to LSFG init and renders.
# CachyOS BORE/EEVDF + Intel HFI already prefers P-cores; pinning only starves
# Proton/wineserver helper threads. Run unpinned.
exec "$INNER_BIN" "$@"

STATUS=$?
exit "$STATUS"
