#!/usr/bin/env bash
# ==============================================================================
# dolby-audio: Lightweight profile switcher for ASUS TUF Dolby Atmos filter-chain
# Pure PipeWire native graph switching — zero CPU overhead
# ==============================================================================

DOLBY_SINK="sink.dolby_atmos"
RAW_SINK="alsa_output.pci-0000_00_1f.3.analog-stereo"

is_dolby_active() {
    pamixer --get-default-sink 2>/dev/null | grep -q "$DOLBY_SINK"
}

set_dolby() {
    pactl set-default-sink "$DOLBY_SINK"
    dunstify -a "Dolby Atmos" -u low -i audio-speakers \
        -h string:x-dunst-stack-tag:dolby \
        "Dolby Atmos: Enabled" "ASUS TUF Acoustic Correction & Limiter Active"
}

set_raw() {
    pactl set-default-sink "$RAW_SINK"
    dunstify -a "Dolby Atmos" -u low -i audio-card \
        -h string:x-dunst-stack-tag:dolby \
        "Dolby Atmos: Bypass" "Raw Hardware DAC Mode (Flat / Headphones)"
}

toggle() {
    if is_dolby_active; then
        set_raw
    else
        set_dolby
    fi
}

status() {
    if is_dolby_active; then
        echo "Dolby Atmos"
    else
        echo "Raw DAC"
    fi
}

menu() {
    CURRENT=$(status)
    CHOICE=$(printf "󰓃 Dolby Atmos (Speaker Optimized)\n󰋋 Raw Hardware DAC (Flat / Headphones)\n󰍬 Dusky Voice Studio (GUI)\n󰍮 Voice Enhancer: Crisp & Clean\n󰍮 Voice Enhancer: Broadcast Warmth\n󰍮 Voice Reset (Natural Clean)" | rofi -dmenu -i \
        -sort \
        -sorting-method "fzf" \
        -matching "fuzzy" \
        -p "Audio Hub [Speaker: $CURRENT]" \
        -theme "$HOME/.config/rofi/system-floating.rasi")
    case "$CHOICE" in
        *Dolby*)        set_dolby ;;
        *Raw*)          set_raw ;;
        *Studio*)       dusky-audio-studio --gui >/dev/null 2>&1 & ;;
        *Crisp*)        dusky-audio-studio --enhancer "Crisp & Clean" ;;
        *Broadcast*)    dusky-audio-studio --enhancer "Broadcast Warmth" ;;
        *Natural*)      dusky-audio-studio --reset-voice && dusky-audio-studio --enhancer "Flat (0 dB)" ;;
    esac
}

case "${1:-toggle}" in
    on|enable)      set_dolby ;;
    off|disable)    set_raw ;;
    toggle)         toggle ;;
    status)         status ;;
    rofi|menu)      menu ;;
    *)
        echo "Usage: $(basename "$0") {on|off|toggle|status|rofi}"
        exit 1
        ;;
esac
