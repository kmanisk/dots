#!/usr/bin/env bash
# ==============================================================================
# toggle-btop: Single-instance launcher / focuser / toggler for btop in Alacritty
# ==============================================================================
export DISPLAY="${DISPLAY:-:0}"
export PATH="$HOME/.local/bin:$PATH"

# Check if btop window already exists in tree (Sway or i3)
IPC_CMD="i3-msg"
[ -n "$SWAYSOCK" ] && IPC_CMD="swaymsg"

if $IPC_CMD -t get_tree 2>/dev/null | grep -E -q '"(class|app_id)":"btop"'; then
    # If focused, hide or close it; if not focused, focus it
    FOCUSED_ID=$($IPC_CMD -t get_tree 2>/dev/null | jq -r '.. | objects | select(.focused? == true) | (.app_id // .window_properties.class // empty)')
    if [ "$FOCUSED_ID" = "btop" ]; then
        $IPC_CMD '[app_id="(?i)^btop$"] kill, [class="(?i)^btop$"] kill' >/dev/null 2>&1
    else
        $IPC_CMD '[app_id="(?i)^btop$"] focus, [class="(?i)^btop$"] focus' >/dev/null 2>&1
    fi
else
    # Not running: spawn single instance in floating Kitty (or fallback to Alacritty)
    if command -v kitty >/dev/null 2>&1; then
        exec kitty --class btop -e btop
    else
        exec alacritty --class btop -e btop
    fi
fi
