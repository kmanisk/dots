#!/usr/bin/env python3
"""
foot-font: Manage and synchronize Foot terminal font configuration across
~/.config/foot/foot.ini, chezmoi source, and Sway $term overrides.
"""

import argparse
import difflib
import os
import re
import subprocess
import sys
from pathlib import Path

FOOT_CONFIG = Path.home() / ".config/foot/foot.ini"
CHEZMOI_FOOT = Path.home() / ".local/share/chezmoi/dot_config/foot/foot.ini"

SWAY_VARS = Path.home() / ".config/sway/config.d/00-variables.conf"
CHEZMOI_SWAY_VARS = Path.home() / ".local/share/chezmoi/dot_config/sway/config.d/00-variables.conf"


def get_installed_families() -> set[str]:
    """Retrieve all font families registered in fontconfig."""
    try:
        res = subprocess.run(
            ["fc-list", ":", "family"],
            capture_output=True,
            text=True,
            check=True
        )
    except Exception as e:
        sys.stderr.write(f"Warning: Failed to query fc-list: {e}\n")
        return set()

    families = set()
    for line in res.stdout.splitlines():
        for fam in line.split(","):
            cleaned = fam.strip()
            if cleaned:
                families.add(cleaned)
    return families


def parse_font_spec(spec: str):
    """Parse fontconfig string into family, size, style, and extra options."""
    parts = spec.split(":")
    family = parts[0].strip()
    size = None
    style = None
    extra = []
    for p in parts[1:]:
        p = p.strip()
        if p.startswith("size="):
            try:
                size = float(p.split("=", 1)[1])
            except ValueError:
                extra.append(p)
        elif p.startswith("style="):
            style = p.split("=", 1)[1]
        elif p:
            extra.append(p)
    return family, size, style, extra


def build_font_spec(family: str, size: float | None, style: str | None, extra: list[str]) -> str:
    """Rebuild fontconfig string from components."""
    parts = [family]
    if size is not None:
        size_str = f"{size:.1f}" if size % 1 != 0 else f"{int(size)}"
        parts.append(f"size={size_str}")
    if style:
        parts.append(f"style={style}")
    for item in extra:
        parts.append(item)
    return ":".join(parts)


def read_current_font() -> str:
    """Read current font specification from foot.ini."""
    if FOOT_CONFIG.exists():
        content = FOOT_CONFIG.read_text(encoding="utf-8")
        match = re.search(r'(?m)^font=(.+)$', content)
        if match:
            return match.group(1).strip()
    return "monospace:size=10"


def is_running_in_foot() -> bool:
    """Check if the current process tree is running inside a foot terminal."""
    pid = os.getpid()
    while pid > 1:
        try:
            with open(f"/proc/{pid}/comm", "r", encoding="utf-8") as f:
                comm = f.read().strip()
            if comm == "foot":
                return True
            with open(f"/proc/{pid}/stat", "r", encoding="utf-8") as f:
                parts = f.read().split()
                pid = int(parts[3])
        except Exception:
            break
    return False


def validate_family(family: str, families: set[str], force: bool = False) -> bool:
    """Validate font family existence in fontconfig."""
    if not families or force:
        return True
    if family in families:
        return True

    # Case-insensitive check
    lower_map = {f.lower(): f for f in families}
    if family.lower() in lower_map:
        return True

    # Search for close suggestions using difflib and prefix matches
    close = difflib.get_close_matches(family, list(families), n=5, cutoff=0.3)
    if not close:
        # Fallback to token matching
        tokens = [t.lower() for t in re.split(r'[\s\-]+', family) if len(t) > 2 and t.lower() not in {"nerd", "font", "mono"}]
        matching = set()
        for fam in families:
            for t in tokens:
                if t in fam.lower():
                    matching.add(fam)
        close = sorted(matching)[:5]

    sys.stderr.write(f"Error: Font family '{family}' not found in fontconfig database.\n")
    if close:
        sys.stderr.write("Did you mean:\n")
        for s in close:
            sys.stderr.write(f"  - {s}\n")

    sys.stderr.write("Use --force to apply this font name regardless.\n")
    return False


def update_foot_config(path: Path, new_spec: str):
    """Update font= in a foot.ini file."""
    if not path.exists():
        return
    content = path.read_text(encoding="utf-8")
    if re.search(r'(?m)^font=.*$', content):
        new_content = re.sub(r'(?m)^font=.*$', f"font={new_spec}", content)
    else:
        # Append under [main]
        if "[main]" in content:
            new_content = content.replace("[main]\n", f"[main]\nfont={new_spec}\n", 1)
        else:
            new_content = content + f"\n[main]\nfont={new_spec}\n"
    path.write_text(new_content, encoding="utf-8")


def update_sway_variables(path: Path, new_spec: str):
    """Update footclient -o font=... in Sway variables configuration."""
    if not path.exists():
        return
    content = path.read_text(encoding="utf-8")
    font_arg = f'-o font="{new_spec}"'

    # Check if -o font= is already present in set $term
    pattern = r'(?m)^(set\s+\$term\s+footclient(?:\s+-[o\w\-]+(?:\s*(?:=\S+|="[^"]*"))?)*\s+)-o\s+font="[^"]*"'
    if re.search(pattern, content):
        new_content = re.sub(pattern, rf'\1{font_arg}', content)
    else:
        # Insert after footclient
        new_content = re.sub(
            r'(?m)^(set\s+\$term\s+footclient\s+)',
            rf'\1{font_arg} ',
            content
        )
    path.write_text(new_content, encoding="utf-8")


def list_nerd_fonts():
    """List popular Monospace and Nerd Fonts installed on system."""
    families = get_installed_families()
    nerd_mono = sorted({f for f in families if "nerd font" in f.lower() or "mono" in f.lower()})
    print("Installed Monospace & Nerd Fonts:")
    for f in nerd_mono:
        print(f"  {f}")


def main():
    parser = argparse.ArgumentParser(
        description="Configure Foot terminal font across foot.ini, chezmoi, and Sway overrides.",
        epilog="Examples:\n"
               "  foot-font                     # Show current configuration\n"
               "  foot-font 20                  # Set font size to 20\n"
               "  foot-font +1                  # Increase font size by 1\n"
               "  foot-font -0.5                # Decrease font size by 0.5\n"
               "  foot-font 'VictorMono Nerd Font'  # Change family to VictorMono\n"
               "  foot-font 'Iosevka Nerd Font Mono:size=19:style=Bold'\n"
               "  foot-font --restart           # Restart foot-server daemon\n",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )

    parser.add_argument("spec", nargs="?", help="Font family, size (e.g. 19 or +1), or font string")
    parser.add_argument("size", nargs="?", type=float, help="Explicit size if first arg is family")
    parser.add_argument("style", nargs="?", help="Explicit style (e.g. Bold, Regular)")
    parser.add_argument("-s", "--size", dest="opt_size", type=float, help="Set font size")
    parser.add_argument("-f", "--family", dest="opt_family", help="Set font family")
    parser.add_argument("--style", dest="opt_style", help="Set font style")
    parser.add_argument("-r", "--restart", action="store_true", help="Restart foot-server.service")
    parser.add_argument("--force", action="store_true", help="Bypass font validation or active foot check")
    parser.add_argument("-l", "--list", action="store_true", help="List installed monospace/nerd fonts")

    args = parser.parse_args()

    if args.list:
        list_nerd_fonts()
        return

    current_spec = read_current_font()
    curr_family, curr_size, curr_style, curr_extra = parse_font_spec(current_spec)

    # Check if a modification was requested
    has_change = bool(args.spec or args.opt_size is not None or args.opt_family or args.opt_style or args.size is not None or args.style)

    # If no arguments and no restart requested, display current font
    if not has_change and not args.restart:
        print(f"Current Foot Font: {current_spec}")
        print(f"  Family : {curr_family}")
        print(f"  Size   : {curr_size}")
        print(f"  Style  : {curr_style or 'default'}")
        if curr_extra:
            print(f"  Extra  : {', '.join(curr_extra)}")
        return

    # If only restart requested without font changes
    if not has_change and args.restart:
        restart_script = Path.home() / ".local/bin/restart-terminals"
        if restart_script.exists():
            subprocess.run([str(restart_script)], check=False)
        else:
            subprocess.run(["systemctl", "--user", "restart", "foot-server.service"], check=False)
        return

    new_family = curr_family
    new_size = curr_size if curr_size is not None else 18.5
    new_style = curr_style
    new_extra = curr_extra

    # Parse positional spec
    if args.spec:
        spec = args.spec.strip()
        # Relative size (+1, -0.5)
        if re.match(r'^[+-][0-9]+(?:\.[0-9]+)?$', spec):
            delta = float(spec)
            new_size = round(new_size + delta, 1)
        # Absolute numeric size (18, 18.5)
        elif re.match(r'^[0-9]+(?:\.[0-9]+)?$', spec):
            new_size = float(spec)
        # Full fontconfig spec (Family:size=... or Family:style=...)
        elif ":" in spec:
            sf, ss, st, se = parse_font_spec(spec)
            new_family = sf
            if ss is not None:
                new_size = ss
            if st is not None:
                new_style = st
            if se:
                new_extra = se
        # Just family name
        else:
            new_family = spec

    # Secondary positional size / style
    if args.size is not None:
        new_size = args.size
    if args.style is not None:
        new_style = args.style

    # Explicit options override positionals
    if args.opt_family:
        new_family = args.opt_family
    if args.opt_size is not None:
        new_size = args.opt_size
    if args.opt_style:
        new_style = args.opt_style

    # Size bounds clamp
    if new_size < 6.0:
        new_size = 6.0
    elif new_size > 72.0:
        new_size = 72.0

    # Validate family with fontconfig
    families = get_installed_families()
    if not validate_family(new_family, families, force=args.force):
        sys.exit(1)

    new_spec = build_font_spec(new_family, new_size, new_style, new_extra)

    # 1. Update foot.ini and chezmoi copy
    update_foot_config(FOOT_CONFIG, new_spec)
    update_foot_config(CHEZMOI_FOOT, new_spec)

    # Verify foot config
    res_foot = subprocess.run(["foot", "--check-config", "-c", str(FOOT_CONFIG)], capture_output=True, text=True)
    if res_foot.returncode != 0:
        sys.stderr.write(f"Configuration error in {FOOT_CONFIG}:\n{res_foot.stderr}\nReverting changes.\n")
        update_foot_config(FOOT_CONFIG, current_spec)
        update_foot_config(CHEZMOI_FOOT, current_spec)
        sys.exit(1)

    # 2. Update Sway variables and chezmoi copy
    update_sway_variables(SWAY_VARS, new_spec)
    update_sway_variables(CHEZMOI_SWAY_VARS, new_spec)

    # Verify sway config
    res_sway = subprocess.run(["sway", "-C"], capture_output=True, text=True)
    if res_sway.returncode != 0:
        sys.stderr.write(f"Sway configuration check failed:\n{res_sway.stderr}\n")
    else:
        # Reload sway live if running
        try:
            subprocess.run(["swaymsg", "reload"], capture_output=True, check=True)
        except Exception:
            pass

    print(f"Updated Foot Font to: {new_spec}")
    print("Applied to: foot.ini, chezmoi source, and Sway $term override (swaymsg reload)")

    # 3. Handle foot-server restart if requested
    if args.restart:
        restart_script = Path.home() / ".local/bin/restart-terminals"
        if restart_script.exists():
            subprocess.run([str(restart_script)], check=False)
        else:
            subprocess.run(["systemctl", "--user", "restart", "foot-server.service"], check=False)


if __name__ == "__main__":
    main()
