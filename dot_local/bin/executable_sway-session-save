#!/usr/bin/env python3
"""sway-session-save: on-demand Sway session save. No daemon, stdlib only.

Usage: sway-session-save [--all] [--quiet]
  --all    save every active workspace (except gaming ws4, scratchpad)
  bare     save only the focused workspace
  --quiet  suppress desktop notification (status still goes to stdout/journal)

Writes ~/.config/sway/session/session.json atomically, rotating the
previous valid snapshot to session.json.prev. A failed, empty, or
unusable snapshot NEVER replaces a valid session file.

Exit codes: 0 saved (or nothing new to save), 1 aborted to protect
the existing session (no Sway, bad tree, empty snapshot, write error).
"""
import json
import os
import subprocess
import sys
from pathlib import Path

SAVE_DIR = Path.home() / ".config" / "sway" / "session"
SESSION = SAVE_DIR / "session.json"
PREV = SAVE_DIR / "session.json.prev"
STEAM_KILLED = SAVE_DIR / "steam_was_killed"
NL_STATE = Path.home() / ".config" / "nightlight_state"
BAR_STATE = Path.home() / ".config" / "polybar" / "bar_state"
TOGGLE_NL = Path.home() / ".local" / "bin" / "toggle-nightlight"
SKIP_WS = {"4", "__i3_scratch"}
FORMAT_VERSION = 2


def log(msg):
    print(f"[session] {msg}", flush=True)


def runtime_dir():
    d = os.environ.get("XDG_RUNTIME_DIR")
    if d:
        return Path(d)
    return Path(f"/run/user/{os.getuid()}")


def discover_socket():
    """Find a live Sway IPC socket without hardcoding UID/PID paths."""
    tried = []
    for cand in (os.environ.get("SWAYSOCK"), os.environ.get("I3SOCK")):
        if cand:
            tried.append(cand)
    try:
        tried.extend(sorted(str(p) for p in runtime_dir().glob("sway-ipc.*.sock")))
    except OSError:
        pass
    for sock in tried:
        if not sock:
            continue
        try:
            subprocess.check_output(
                ["swaymsg", "-s", sock, "-t", "get_version"],
                stderr=subprocess.DEVNULL, timeout=5)
            return sock
        except Exception:
            continue
    return None


def msg(sock, *args):
    try:
        out = subprocess.check_output(
            ["swaymsg", "-s", sock, "-t", *args],
            stderr=subprocess.DEVNULL, timeout=10)
        return json.loads(out)
    except Exception:
        return None


def walk(node, cur_ws, out):
    if node.get("type") == "workspace":
        cur_ws = str(node.get("num") or node.get("name"))
        out.setdefault(cur_ws, [])
    # NOTE: on Sway, `window` is the X11 window ID and is None for
    # Wayland-native views. A live view always has a `pid`, so pid (or
    # window) is the correct presence test. True placeholders have neither.
    if (node.get("window") or node.get("pid")) and cur_ws and cur_ws not in SKIP_WS:
        props = node.get("window_properties", {}) or {}
        out[cur_ws].append({
            "pid": node.get("pid"),
            "app_id": (node.get("app_id") or "").lower(),
            "class": str(props.get("class", "") or "").lower(),
            "instance": str(props.get("instance", "") or "").lower(),
        })
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        walk(child, cur_ws, out)


def cmdline_of(pid):
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        return [p.decode(errors="replace") for p in raw if p]
    except Exception:
        return []


def cwd_of(pid):
    try:
        p = Path(f"/proc/{pid}/cwd")
        return str(p.resolve()) if p.exists() else str(Path.home())
    except Exception:
        return str(Path.home())


def child_pids(pid):
    """Return direct child PIDs of *pid* from /proc."""
    try:
        return [
            int(p.name)
            for p in Path("/proc").iterdir()
            if p.name.isdigit()
            and (p / "status").exists()
            and any(
                line.startswith("PPid:") and line.split()[1] == str(pid)
                for line in (p / "status").read_text(errors="replace").splitlines()
            )
        ]
    except Exception:
        return []


def has_agy_child(pid):
    """Return True if *pid* has agy running anywhere in its process subtree."""
    if not pid:
        return False
    queue = list(child_pids(pid))
    seen_pids = {pid}
    while queue:
        cpid = queue.pop()
        if cpid in seen_pids:
            continue
        seen_pids.add(cpid)
        try:
            comm = Path(f"/proc/{cpid}/comm").read_text(errors="replace").strip()
            if comm in ("agy",):
                return True
        except Exception:
            pass
        queue.extend(child_pids(cpid))
    return False


def normalize(cmd, pid=None):
    if not cmd:
        return []
    s = " ".join(cmd).lower()
    if "scratch-term" in s or "scratch-notes" in s:
        return []
    if "steam" in s:
        return ["steam"]
    if "brave" in s:
        return ["brave-origin"]
    if "zed" in s:
        return ["zed"]
    if "alacritty" in s:
        # If agy is running inside this terminal, restore it with agy.
        if has_agy_child(pid):
            return ["alacritty", "-e", "agy"]
        return ["alacritty"]
    base = Path(cmd[0]).name
    kept = [base] + [a for a in cmd[1:]
                     if "/tmp/" not in a and "socket" not in a.lower()]
    return kept


def fallback_launch(win):
    for key, launch in (("brave", ["brave-origin"]),
                        ("firefox", ["firefox"]),
                        ("librewolf", ["librewolf"]),
                        ("zed", ["zed"]),
                        ("alacritty", ["alacritty"]),
                        ("ghostty", ["ghostty"]),
                        ("thunar", ["thunar"]),
                        ("steam", ["steam"])):
        if key in win["app_id"] or key in win["class"] or key in win["instance"]:
            return launch
    return []


def proc_running(name):
    try:
        subprocess.check_output(["pgrep", "-x", name],
                                stderr=subprocess.DEVNULL, timeout=5)
        return True
    except Exception:
        return False


def capture_system_state(sock):
    """Best-effort snapshot of desktop state from LIVE authoritative
    sources (never stale config alone). Returns {} on total failure;
    never raises, never aborts the workspace save."""
    state = {}
    try:
        # Night light: what the user sees == wlsunset actually running.
        # The state file is the toggle's persistent preference; the
        # process is the ground truth (a crash leaves file stale).
        nl_on = proc_running("wlsunset")
        state["night_light"] = {"enabled": nl_on}
    except Exception:
        pass
    try:
        # Bottom bar: live swaybar mode first, state file as fallback.
        bar_on = None
        cfg = msg(sock, "get_bar_config", "bar-0")
        if isinstance(cfg, dict) and cfg.get("mode"):
            bar_on = cfg["mode"] == "dock"
        if bar_on is None:
            try:
                bar_on = BAR_STATE.read_text().strip().lower() in (
                    "true", "1", "shown", "on")
            except OSError:
                bar_on = None
        if bar_on is not None:
            state["bottom_bar"] = {"enabled": bar_on}
    except Exception:
        pass
    return state


def notify(summary, body):
    try:
        subprocess.call(["notify-send", "-i", "document-save", summary, body],
                        timeout=5)
    except Exception:
        pass


def main():
    quiet = "--quiet" in sys.argv
    sock = discover_socket()
    if not sock:
        log("no running Sway session, keeping previous session")
        return 1
    tree = msg(sock, "get_tree")
    if not isinstance(tree, dict) or "nodes" not in tree:
        log("invalid: swaymsg tree unusable, keeping previous session")
        return 1

    ws_map = {}
    walk(tree, None, ws_map)

    # Steam lifecycle (ports i3 steam_was_killed): record whether Steam is
    # alive at save time so restore won't resurrect a deliberately killed
    # Steam. Updated on --all saves with a valid tree only.
    if "--all" in sys.argv:
        SAVE_DIR.mkdir(parents=True, exist_ok=True)
        steam_alive = any("steam" in (w["app_id"] + w["class"] + w["instance"])
                          for wins in ws_map.values() for w in wins)
        if steam_alive:
            STEAM_KILLED.unlink(missing_ok=True)
        else:
            STEAM_KILLED.touch()
    if "--all" in sys.argv:
        targets = {w: v for w, v in ws_map.items() if v}
    else:
        workspaces = msg(sock, "get_workspaces") or []
        focused = next((str(w.get("num") or w.get("name"))
                        for w in workspaces if w.get("focused")), None)
        targets = {focused: ws_map.get(focused, [])} if focused else {}

    snapshot = {"version": FORMAT_VERSION, "workspaces": {}}
    sys_state = capture_system_state(sock)
    if sys_state:
        snapshot["system_state"] = sys_state

    # Apps that can legitimately have multiple windows open at once.
    MULTI_INSTANCE = {"alacritty", "ghostty"}

    for ws, wins in targets.items():
        entries = []
        # seen maps cmd_tuple -> count, so multi-instance apps can repeat.
        seen: dict = {}
        for w in wins:
            pid = w["pid"]
            cmd = normalize(cmdline_of(pid), pid=pid) if pid else []
            if not cmd:
                cmd = fallback_launch(w)
            if not cmd:
                continue
            key = tuple(cmd)
            base = Path(cmd[0]).name.lower()
            if base not in MULTI_INSTANCE and key in seen:
                # Single-instance app already recorded — skip duplicate.
                continue
            seen[key] = seen.get(key, 0) + 1
            entries.append({
                "command": cmd,
                "working_directory": cwd_of(pid) if pid else str(Path.home()),
                "app_id": w["app_id"], "class": w["class"],
            })
        if entries:
            snapshot["workspaces"][ws] = entries

    if not snapshot["workspaces"]:
        log("skipped: snapshot empty, keeping previous session")
        return 1

    try:
        SAVE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = SAVE_DIR / "session.json.tmp"
        with open(tmp, "w") as f:
            json.dump(snapshot, f, indent=2)
            f.flush()
            os.fsync(f.fileno())
        if SESSION.exists():
            os.replace(SESSION, PREV)
        os.replace(tmp, SESSION)
    except OSError as e:
        log(f"invalid: write failed ({e}), keeping previous session")
        return 1

    # One-time migration: drop legacy per-workspace files after a good save.
    for f in SAVE_DIR.glob("workspace_*.json"):
        try:
            f.unlink()
        except OSError:
            pass

    names = ", ".join(sorted(snapshot["workspaces"]))
    log(f"saved workspaces: {names}")
    for key, label, on_word, off_word in (
            ("night_light", "night-light", "on", "off"),
            ("bottom_bar", "bottom-bar", "shown", "hidden")):
        sub = sys_state.get(key, {}) if isinstance(sys_state, dict) else {}
        if isinstance(sub, dict) and isinstance(sub.get("enabled"), bool):
            log(f"{label}: {on_word if sub['enabled'] else off_word}")
    if not quiet:
        notify("Sway Session", f"Saved workspaces: {names}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
