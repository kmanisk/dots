#!/usr/bin/env python3
import json
import os
import subprocess
import sys

def get_user_env():
    env = os.environ.copy()
    uid = os.geteuid() if os.geteuid() != 0 else 1000
    env["XDG_RUNTIME_DIR"] = f"/run/user/{uid}"
    env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path=/run/user/{uid}/bus"
    return env

def run_user_cmd(cmd, timeout=10):
    try:
        if os.geteuid() == 0:
            import pwd
            target_user = os.environ.get("SUDO_USER") or pwd.getpwuid(1000).pw_name
            uid = pwd.getpwnam(target_user).pw_uid
            full_cmd = ["runuser", "-u", target_user, "--", "env", f"XDG_RUNTIME_DIR=/run/user/{uid}", f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus"] + cmd
        else:
            full_cmd = cmd
            
        res = subprocess.run(
            full_cmd,
            capture_output=True,
            text=True,
            timeout=timeout,
            env=get_user_env()
        )
        if res.returncode != 0 and not res.stdout.strip():
            err = res.stderr.strip() or f"Exit code {res.returncode}"
            return f"Error ({res.returncode}): {err}"
        return res.stdout.strip() if res.stdout.strip() else "(ok)"
    except subprocess.TimeoutExpired:
        return "Error: Command timed out"
    except Exception as e:
        return f"Error: {str(e)}"

def read_message():
    line = sys.stdin.readline()
    if not line:
        return None
    return json.loads(line)

def write_message(msg):
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()

TOOLS = [
    {
        "name": "desktop_notify",
        "description": "Send a desktop notification via notify-send (Dunst on X11).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "title": {"type": "string", "description": "Notification title"},
                "body": {"type": "string", "default": "", "description": "Notification message body"},
                "urgency": {"type": "string", "enum": ["low", "normal", "critical"], "default": "normal"},
                "app_name": {"type": "string", "default": "Antigravity", "description": "App name tag"},
                "icon": {"type": "string", "description": "Icon name or file path"}
            },
            "required": ["title"]
        }
    },
    {
        "name": "audio_get_status",
        "description": "Query PipeWire / WirePlumber audio status, showing active sinks (headphones/speakers), sources (mics), and audio streams.",
        "inputSchema": {
            "type": "object",
            "properties": {}
        }
    },
    {
        "name": "audio_set_default_sink",
        "description": "Switch default PipeWire audio output sink (e.g. switch between soundcore Q20i headset and Built-in laptop speakers).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "sink_id": {"type": "string", "description": "Sink ID number (e.g. 80, 61) from audio_get_status"}
            },
            "required": ["sink_id"]
        }
    },
    {
        "name": "audio_set_volume",
        "description": "Set or adjust audio volume on default sink or target device (e.g. 0.85 for 85%, or +5%, -5%).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "volume": {"type": "string", "description": "Volume level (e.g. 0.80, +5%, -5%)"},
                "target": {"type": "string", "default": "@DEFAULT_AUDIO_SINK@", "description": "Target ID or @DEFAULT_AUDIO_SINK@"}
            },
            "required": ["volume"]
        }
    },
    {
        "name": "audio_toggle_mute",
        "description": "Toggle mute on default audio sink or microphone source.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "target": {"type": "string", "default": "@DEFAULT_AUDIO_SINK@", "description": "Target sink/source ID or @DEFAULT_AUDIO_SINK@ / @DEFAULT_AUDIO_SOURCE@"}
            }
        }
    },
    {
        "name": "mpris_list_players",
        "description": "List currently active MPRIS media players (Spotify, Brave, MPV, Amberol, etc.).",
        "inputSchema": {
            "type": "object",
            "properties": {}
        }
    },
    {
        "name": "mpris_playback_control",
        "description": "Control playback on active media players (play, pause, play-pause, next, previous).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "action": {"type": "string", "enum": ["play", "pause", "play-pause", "next", "previous", "stop"], "description": "Playback action"},
                "player": {"type": "string", "description": "Optional player name (e.g. spotify, brave)"}
            },
            "required": ["action"]
        }
    },
    {
        "name": "mpris_get_metadata",
        "description": "Get title, artist, album, and status for currently playing media track.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "player": {"type": "string", "description": "Optional specific player name"}
            }
        }
    }
]

def main():
    while True:
        req = read_message()
        if req is None:
            break
        req_id = req.get("id")
        method = req.get("method")
        
        if method == "initialize":
            write_message({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {
                        "tools": {}
                    },
                    "serverInfo": {
                        "name": "desktop-mcp",
                        "version": "1.0.0"
                    }
                }
            })
        elif method == "notifications/initialized":
            pass
        elif method == "tools/list":
            write_message({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "tools": TOOLS
                }
            })
        elif method == "tools/call":
            params = req.get("params", {})
            name = params.get("name")
            args = params.get("arguments", {})
            
            content = ""
            if name == "desktop_notify":
                cmd = ["notify-send", "-a", args.get("app_name", "Antigravity"), "-u", args.get("urgency", "normal")]
                if args.get("icon"):
                    cmd.extend(["-i", args["icon"]])
                cmd.append(args["title"])
                if args.get("body"):
                    cmd.append(args["body"])
                content = run_user_cmd(cmd)
            elif name == "audio_get_status":
                content = run_user_cmd(["wpctl", "status"])
            elif name == "audio_set_default_sink":
                sink_id = str(args["sink_id"])
                content = run_user_cmd(["wpctl", "set-default", sink_id])
            elif name == "audio_set_volume":
                vol = str(args["volume"])
                target = args.get("target", "@DEFAULT_AUDIO_SINK@")
                content = run_user_cmd(["wpctl", "set-volume", target, vol])
            elif name == "audio_toggle_mute":
                target = args.get("target", "@DEFAULT_AUDIO_SINK@")
                content = run_user_cmd(["wpctl", "set-mute", target, "toggle"])
            elif name == "mpris_list_players":
                content = run_user_cmd(["playerctl", "-l"])
            elif name == "mpris_playback_control":
                action = args["action"]
                cmd = ["playerctl"]
                if args.get("player"):
                    cmd.extend(["-p", args["player"]])
                cmd.append(action)
                content = run_user_cmd(cmd)
            elif name == "mpris_get_metadata":
                cmd = ["playerctl"]
                if args.get("player"):
                    cmd.extend(["-p", args["player"]])
                cmd.extend(["metadata", "--format", "{{playerName}}: {{artist}} - {{title}} ({{album}}) [{{status}}]"])
                content = run_user_cmd(cmd)
            else:
                content = f"Unknown tool: {name}"

            write_message({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [
                        {"type": "text", "text": content}
                    ]
                }
            })
        else:
            if req_id is not None:
                write_message({
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "error": {
                        "code": -32601,
                        "message": f"Method {method} not found"
                    }
                })

if __name__ == "__main__":
    main()
