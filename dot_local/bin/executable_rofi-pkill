#!/usr/bin/env python3
"""rofi-pkill: Minimal App & Process Killer for Sway/Wayland via Fuzzel.

Features:
- Native Wayland Fuzzel interface with theme-synchronized styling and Papirus icons.
- Clean, minimal single-line presentation: application name and optional window title.
- Zero clutter: removes CPU%, RAM%, process counts, and static section dividers.
- Active windowed applications prioritized at the top, followed by user background workloads.
- Subprocesses and helpers folded into parent applications (Brave, Steam, QEMU/Windows, etc.).
- Strictly shields critical system services (Dusky mic DSP, WirePlumber, PipeWire,
  xremap, xscroll, sway components, bluetooth reconnect, polkit, agents, and MCP servers).
- Supports graceful SIGTERM on Enter (code 0) and force SIGKILL on Shift+Delete (code 10).
"""
import glob
import json
import os
import re
import signal
import subprocess
import sys

# Strict regex matching protected process comm names (case-insensitive)
PROTECTED_COMM = re.compile(
    r"^("
    # Core system, init, bus & session daemons
    r"systemd.*|sd-pam|\(sd-pam\)|dbus.*|seatd|udevd?|"
    # Compositor, window manager & bar
    r"sway(bg|idle|lock|bar|msg|nag|nc.*)?|waybar|mako|dunst|foot|Xwayland|"
    # Key remapping & input daemons
    r"xremap.*|xscroll.*|"
    # Audio stack & headless mic suppression
    r"pipewire.*|wireplumber|dusky.*|rnnoise.*|"
    # Bluetooth daemons & reconnect helpers
    r"bluetooth.*|wpa_supplicant|iwd|NetworkManager|bt-keyboard-rec.*|bt-auto.*|"
    # Clipboard & screen color
    r"wl-paste|cliphist.*|clipnotify|wl-gammarelay.*|wl-copy|"
    # Security, auth, portals & virtual filesystem
    r"polkit.*|gnome-keyring.*|at-spi.*|xdg-.*|dconf.*|gvfs.*|tumbler.*|"
    # Power & hardware switching
    r"power-profiles.*|supergfx.*|ananicy.*|gamemode.*|rtkit.*|"
    # Package management & system integrity
    r"pacman|makepkg|paru|yay|snapper.*|btrfs.*|"
    # Interactive shells & tool runners
    r"fish|bash|zsh|sh|dash|ps|grep|rofi|fuzzel|awk|sed|sleep|cat|chezmoi|"
    r"timeout|flock|ionice|nice|xargs|chpst|"
    # Containers & namespace supervisors
    r"conmon|catatonit|tini|"
    # AI Coding Agents, IDE tooling & MCP servers
    r"agy|opencode|gemini|antigravity|"
    r"node-MainThread|node-mainthread"
    r")$",
    re.IGNORECASE,
)

# Argument patterns that identify protected system daemons, agents, and MCP servers
PROTECTED_ARGS = [
    re.compile(p, re.IGNORECASE) for p in [
        r"\bdusky",
        r"\bcliphist",
        r"\bxremap\b",
        r"\bxscroll\b",
        r"\bpipewire\b",
        r"\bwireplumber\b",
        r"\bmcp\b",
        r"mcp-server",
        r"@modelcontextprotocol",
        r"@praeses/steam-mcp",
        r"\bagy\b",
        r"\bopencode\b",
        r"\bantigravity\b",
        r"polkit",
        r"xdg-desktop-portal",
        r"sway-idle-guard",
        r"swaybar-status",
        r"game-workspace-daemon",
        r"bt-auto-trust",
        r"bt-keyboard-reconnect",
        r"wl-gammarelay",
        r"gnome-keyring",
        r"color-scheme-mcp",
        r"snapper-mcp",
        r"arch-ops-server",
        r"lutris-mcp",
        r"bash-mcp",
    ]
]

# Systemd unit keywords that must never be exposed or killed
PROTECTED_UNITS = [
    "dusky-audio-dsp",
    "cliphist",
    "xremap",
    "xscroll",
    "pipewire",
    "wireplumber",
    "wl-gammarelay",
    "bt-auto-trust",
    "bt-keyboard-reconnect",
    "dconf",
    "gvfs-daemon",
    "gnome-keyring",
    "gamemoded",
]

# Alias map: folds child helpers, runners, and renderers into the parent app group
ALIASES = [
    (re.compile(r"^steamwebhelper|^steam$|pressure-vessel|bwrap|steam-runtime|reaper|srt-.*|pv-.*", re.I), "steam"),
    (re.compile(r"^brave.*|^chrome.*zygote|^chrome_crashpad", re.I), "brave"),
    (re.compile(r"^firefox.*|Isolated Web Co", re.I), "firefox"),
    (re.compile(r"^foot(client)?$", re.I), "footclient"),
    (re.compile(r"^cs2(\.sh)?$", re.I), "cs2"),
    (re.compile(r"^kitten$", re.I), "kitty"),
    (re.compile(r"^vesktop$", re.I), "vesktop"),
    (re.compile(r"^zed$", re.I), "zed"),
    (re.compile(r"^alacritty$", re.I), "alacritty"),
    (re.compile(r"^thunar$", re.I), "thunar"),
    (re.compile(r"gamescope.*|gamescopereaper", re.I), "gamescope"),
    (re.compile(r"MangoHud|mangohud", re.I), "mangohud"),
    (re.compile(r"wineserver|wine.*preloader|.*\.exe$", re.I), "steam"),
    (re.compile(r"^codex.*", re.I), "codex"),
    (re.compile(r"qemu.*|pasta.*|passt.*|virgl_render.*|swtpm|smbd.*|wsddn|websocketd|nginx", re.I), "windows"),
]

# Well-known display labels and icon fallback chains
KNOWN_APPS = {
    "brave": ("Brave", "brave-origin,brave-browser,brave"),
    "brave-origin": ("Brave", "brave-origin,brave-browser,brave"),
    "foot": ("Foot", "foot,utilities-terminal"),
    "footclient": ("Foot", "foot,utilities-terminal"),
    "scratch-term": ("Scratch Terminal", "foot,utilities-terminal"),
    "scratch-files": ("Thunar", "org.xfce.thunar,system-file-manager"),
    "thunar": ("Thunar", "org.xfce.thunar,system-file-manager"),
    "freerdp": ("FreeRDP", "org.remmina.Remmina,network-server"),
    "com.freerdp.client.sdl3": ("FreeRDP", "org.remmina.Remmina,network-server"),
    "windows": ("Windows VM", "qemu,computer,virtualbox"),
    "qemu-system-x86_64": ("Windows VM", "qemu,computer,virtualbox"),
    "codex": ("Codex", "code,com.visualstudio.code,text-editor"),
    "btop": ("btop", "utilities-system-monitor,system-run"),
    "rill": ("Rill", "download,application-x-executable"),
    "npm": ("npm", "application-x-executable,system-run"),
    "steam": ("Steam", "steam"),
    "vesktop": ("Vesktop", "vesktop,discord"),
    "kitty": ("kitty", "kitty,utilities-terminal"),
    "alacritty": ("Alacritty", "alacritty,utilities-terminal"),
    "zed": ("Zed", "zed,text-editor"),
    "craft-anything": ("Craft Anything", "ai.storyteller.craft-anything"),
    "ai.storyteller.craft-anything": ("Craft Anything", "ai.storyteller.craft-anything"),
}


def build_desktop_index():
    """Index installed .desktop files for application display names and icons."""
    idx = {}
    patterns = [
        "/usr/share/applications/*.desktop",
        os.path.expanduser("~/.local/share/applications/*.desktop"),
    ]
    for pattern in patterns:
        for path in glob.glob(pattern):
            try:
                with open(path, errors="ignore") as f:
                    name, icon = "", ""
                    for line in f:
                        if line.startswith("Name=") and not name:
                            name = line[5:].strip()
                        elif line.startswith("Icon=") and not icon:
                            icon = line[5:].strip()
                        elif line.startswith("[") and line.strip() != "[Desktop Entry]":
                            break
                    base = os.path.splitext(os.path.basename(path))[0].lower()
                    if name:
                        idx[base] = (name, icon)
            except Exception:
                pass
    return idx


def resolve_meta(key, desktop_idx):
    """Resolve (display_name, icon_chain) for a given process or app key."""
    k = key.lower()
    if k in KNOWN_APPS:
        return KNOWN_APPS[k]
    if k in desktop_idx:
        name, icon = desktop_idx[k]
        return (name, f"{icon},{k},application-x-executable")
    simple = k.split(".")[-1]
    if simple in KNOWN_APPS:
        return KNOWN_APPS[simple]
    if simple in desktop_idx:
        name, icon = desktop_idx[simple]
        return (name, f"{icon},{simple},application-x-executable")
    return (key, f"{k},application-x-executable,system-run")


def clean_title(title, app_label, key):
    """Return a clean window title, stripped of browser brands and redundant prefixes."""
    t = (title or "").strip()
    t = re.sub(
        r"([\s\-|–—]+(YouTube|Brave Origin|Brave|Firefox|Google Chrome|Chromium))+$",
        "",
        t,
        flags=re.I,
    )
    t = t.strip()
    if not t or t.lower() in (
        app_label.lower(),
        key.lower(),
        "scratch-term",
        "scratch-files",
        "footclient",
        "terminal",
    ):
        return ""
    if t.lower().startswith(app_label.lower() + ":"):
        t = t[len(app_label) + 1:].strip()
    elif t.lower().startswith(app_label.lower() + " -"):
        t = t[len(app_label) + 2:].strip()
    return t[:64]


def ensure_env():
    """Ensure SWAYSOCK, WAYLAND_DISPLAY, and DISPLAY are populated even when spawned from xremap."""
    needed = [k for k in ("SWAYSOCK", "WAYLAND_DISPLAY", "DISPLAY") if not os.environ.get(k)]
    if needed:
        try:
            out = subprocess.check_output(
                ["systemctl", "--user", "show-environment"],
                stderr=subprocess.DEVNULL, timeout=2
            ).decode(errors="replace")
            for line in out.splitlines():
                if "=" in line:
                    k, v = line.split("=", 1)
                    if k in needed and v:
                        os.environ[k] = v
        except Exception:
            pass
    uid = os.getuid()
    if not os.environ.get("SWAYSOCK"):
        socks = glob.glob(f"/run/user/{uid}/sway-ipc.*.sock") + glob.glob("/tmp/sway-ipc.*.sock")
        if socks:
            os.environ["SWAYSOCK"] = sorted(socks, key=os.path.getmtime)[-1]
    if not os.environ.get("WAYLAND_DISPLAY"):
        os.environ["WAYLAND_DISPLAY"] = "wayland-1"
    if not os.environ.get("DISPLAY"):
        os.environ["DISPLAY"] = ":0"


def sway_tree():
    ensure_env()
    for cmd in ("swaymsg", "i3-msg"):
        try:
            out = subprocess.check_output(
                [cmd, "-t", "get_tree"], stderr=subprocess.DEVNULL, timeout=4
            )
            return json.loads(out)
        except Exception:
            continue
    return {}


def ps_table():
    try:
        out = subprocess.check_output(
            ["ps", "-u", str(os.getuid()), "-o", "pid=,%cpu=,%mem=,comm=,args="],
            stderr=subprocess.DEVNULL, timeout=4
        ).decode(errors="replace")
    except Exception:
        return {}
    table = {}
    for line in out.splitlines():
        parts = line.split(None, 4)
        if len(parts) == 5:
            try:
                table[int(parts[0])] = (float(parts[1]), float(parts[2]), parts[3], parts[4])
            except ValueError:
                pass
    return table


def is_protected(pid, comm, args):
    if pid == os.getpid() or comm in ("rofi-pkill", "rofi", "fuzzel") or "rofi-pkill" in args:
        return True
    if PROTECTED_COMM.match(comm):
        return True
    for pat in PROTECTED_ARGS:
        if pat.search(args):
            return True
    try:
        with open(f"/proc/{pid}/cgroup", errors="ignore") as f:
            cg = f.read()
            if any(u in cg for u in PROTECTED_UNITS):
                return True
    except Exception:
        pass
    return False


def collect():
    tree = sway_tree()
    pst = ps_table()

    fg_groups = {}
    bg_groups = {}
    fg_pids = set()

    def walk(node):
        if isinstance(node, dict):
            props = node.get("window_properties") or {}
            app = node.get("app_id") or props.get("class") or props.get("instance") or ""
            pid = node.get("pid")
            if app and (pid or node.get("window")):
                raw = str(app).lower()
                name = "brave" if "brave" in raw else re.sub(r"[-_.]?(bin|x86_64|appimage)$", "", raw)
                g = fg_groups.setdefault(name, {"pids": {}, "wins": 0, "titles": []})
                g["wins"] += 1
                t = str(props.get("title") or node.get("name") or "")
                if t and t not in g["titles"] and len(g["titles"]) < 2:
                    g["titles"].append(t[:140])
                if pid and pid in pst:
                    g["pids"][pid] = pst[pid][:2]
                    fg_pids.add(pid)
            for c in node.get("nodes", []) + node.get("floating_nodes", []):
                walk(c)

    walk(tree)

    # Fold related child/helper processes into foreground apps
    for pid, (cpu, mem, comm, args) in pst.items():
        if pid in fg_pids:
            continue
        blob = f"{comm} {args}".lower()
        for rx, target in ALIASES:
            if rx.search(comm) or rx.search(blob):
                if target in fg_groups:
                    fg_groups[target]["pids"][pid] = (cpu, mem)
                    fg_pids.add(pid)
                    break

    # Non-windowed user processes (Background Services & Workloads)
    for pid, (cpu, mem, comm, args) in pst.items():
        if pid in fg_pids:
            continue
        if is_protected(pid, comm, args):
            continue
        blob = f"{comm} {args}".lower()
        matched_target = None
        for rx, target in ALIASES:
            if rx.search(comm) or rx.search(blob):
                matched_target = target
                break
        name = matched_target if matched_target else comm.lower()
        if matched_target and matched_target in fg_groups:
            fg_groups[matched_target]["pids"][pid] = (cpu, mem)
            fg_pids.add(pid)
            continue
        g = bg_groups.setdefault(name, {"pids": {}, "wins": 0, "titles": []})
        g["pids"][pid] = (cpu, mem)
        if args and not g["titles"]:
            g["titles"].append(args[:48])

    return fg_groups, bg_groups


def build_rows(fg, bg, desktop_idx):
    """Format clean entries for Fuzzel dmenu: (display_label, icon_string, group_name, group_data)."""
    items = []

    # 1. Foreground windowed apps (sorted by memory usage)
    for name, g in sorted(fg.items(), key=lambda kv: sum(m for _, m in kv[1]["pids"].values()), reverse=True):
        app_label, icons = resolve_meta(name, desktop_idx)
        title = clean_title(g["titles"][0] if g["titles"] else "", app_label, name)
        if g["wins"] > 1 and title:
            disp = f"{app_label} ({g['wins']}) — {title}"
        elif g["wins"] > 1:
            disp = f"{app_label} ({g['wins']} windows)"
        elif title:
            disp = f"{app_label} — {title}"
        else:
            disp = app_label
        items.append((disp, icons, name, g))

    # 2. Background user processes (avoiding duplicate names with foreground apps)
    for name, g in sorted(bg.items(), key=lambda kv: sum(m for _, m in kv[1]["pids"].values()), reverse=True):
        if name in fg:
            continue
        app_label, icons = resolve_meta(name, desktop_idx)
        items.append((app_label, icons, name, g))

    return items


def notify(title, body):
    try:
        subprocess.call(
            [
                "notify-send", "-a", "Process Killer", "-u", "low",
                "-i", "process-stop",
                "-h", "string:x-canonical-private-synchronous:pkill",
                title, body,
            ],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5
        )
    except Exception:
        pass


def kill_group(label, name, group_data, force):
    if not group_data:
        return
    sig = signal.SIGKILL if force else signal.SIGTERM
    done, protected = 0, 0
    pids = list(group_data.get("pids", {}).keys())
    for pid in sorted(pids):
        try:
            comm = ""
            try:
                with open(f"/proc/{pid}/comm") as f:
                    comm = f.read().strip()
            except OSError:
                pass
            if PROTECTED_COMM.match(comm):
                protected += 1
                continue
            os.kill(pid, sig)
            done += 1
        except (ProcessLookupError, PermissionError):
            continue
    what = "Force Killed (SIGKILL -9)" if force else "Terminated (SIGTERM)"
    display_target = label.split(" — ")[0] if " — " in label else label
    notify(
        "Process Killer",
        f"{what} → {done} procs of {display_target}"
        + (f" ({protected} protected skipped)" if protected else ""),
    )


def main():
    ensure_env()
    desktop_idx = build_desktop_index()
    fg, bg = collect()
    items = build_rows(fg, bg, desktop_idx)

    if os.environ.get("ROFI_PKILL_TEST") == "1":
        for idx, (disp, icons, name, g) in enumerate(items):
            print(f"[{idx:02d}] {disp:36} | icon={icons} | procs={len(g['pids'])}")
        return 0

    if not items:
        notify("Process Killer", "No killable processes found")
        return 0

    menu_lines = [f"{disp}\x00icon\x1f{icons}" for disp, icons, _, _ in items]
    menu_text = "\n".join(menu_lines) + "\n"

    try:
        p = subprocess.run(
            [
                "fuzzel",
                "--dmenu",
                "--index",
                "--lines=10",
                "--minimal-lines",
                "--no-run-if-empty",
                "--no-exit-on-keyboard-focus-loss",
                "--override=main.image-size-ratio=0",
                "--override=key-bindings.expunge=none",
                "--override=key-bindings.custom-1=Shift+Delete",
            ],
            input=menu_text.encode("utf-8"),
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=300,
        )
    except Exception:
        return 0

    # 0 = normal Enter (SIGTERM), 10 = custom-1 / Shift+Delete (SIGKILL)
    if p.returncode not in (0, 10) or not p.stdout.strip():
        return 0

    try:
        idx = int(p.stdout.decode(errors="replace").strip())
        disp, icons, name, group_data = items[idx]
    except (ValueError, IndexError):
        return 0

    kill_group(disp, name, group_data, force=(p.returncode == 10))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
