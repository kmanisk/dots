#!/usr/bin/env python3
"""rofi-pkill: app-level process killer for Sway.

Groups processes by APPLICATION (not raw comm), so Steam + steamwebhelper +
game helpers show as one entry. Window-backed apps resolve via Sway IPC
(app_id/class); windowless stragglers attach through an alias map.

Enter: graceful SIGTERM to the whole group.  Alt+d / Shift+Del: SIGKILL.
Protected system processes are never listed.
"""
import json
import os
import re
import signal
import subprocess
import sys

THEME = os.path.expanduser("~/.config/rofi/clipboard-floating.rasi")

# Never list or kill these (regex, matched against comm).
PROTECTED = re.compile(
    r"^(systemd|sd-pam|dbus-broker.*|dbus-daemon|pipewire.*|wireplumber"
    r"|sway(bg|idle|lock|bar|msg|nag)?|Xwayland|xremap|mako|waybar|foot"
    r"|bash|fish|zsh|sh|dash|ps|grep|rofi|agy|opencode|node-mainthread"
    r"|python3(\.\d+)?|uwsm|seatd|polkit.*|at-spi.*|xdg-.*|dconf.*"
    r"|gvfs.*|tumbler.*)$"
)

# Windowless helpers fold into their parent app (regex on comm/args).
ALIASES = [
    (re.compile(r"^steamwebhelper"), "steam"),
    (re.compile(r"^steam$"), "steam"),
    (re.compile(r"pressure-vessel|bwrap|steam-runtime|reaper"), "steam"),
    (re.compile(r"^brave$|^brave-origin$|chrome.*zygote"), "brave"),
    (re.compile(r"^firefox$|Isolated Web Co"), "firefox"),
    (re.compile(r"^chrome_crashpad"), "browser"),
    (re.compile(r"wineserver|wine.*preloader|.*\.exe$"), "wine-game"),
    (re.compile(r"gamescope.*|gamescopereaper"), "gamescope"),
    (re.compile(r"MangoHud|mangohud"), "mangohud"),
]


def sway_tree():
    for cmd in ("swaymsg", "i3-msg"):
        try:
            out = subprocess.check_output(
                [cmd, "-t", "get_tree"], stderr=subprocess.DEVNULL, timeout=5)
            return json.loads(out)
        except Exception:
            continue
    return {}


def ps_table():
    try:
        out = subprocess.check_output(
            ["ps", "-u", str(os.getuid()), "-o", "pid=,%cpu=,%mem=,comm=,args="],
            stderr=subprocess.DEVNULL, timeout=5).decode(errors="replace")
    except Exception:
        return {}
    table = {}
    for line in out.splitlines():
        parts = line.split(None, 4)
        if len(parts) == 5:
            try:
                pid = int(parts[0])
                table[pid] = (float(parts[1]), float(parts[2]),
                              parts[3], parts[4])
            except ValueError:
                continue
    return table


def collect():
    """Returns {group: {'pids': {pid: (cpu,mem)}, 'wins': int, 'titles': []}}."""
    tree, pst = sway_tree(), ps_table()
    groups = {}

    def grp(name):
        return groups.setdefault(
            name, {"pids": {}, "wins": 0, "titles": []})

    def walk(node, cur_ws=None):
        if isinstance(node, dict):
            if node.get("type") == "workspace":
                cur_ws = node.get("name")
            props = node.get("window_properties") or {}
            app = (node.get("app_id")
                   or props.get("class")
                   or props.get("instance") or "")
            pid = node.get("pid")
            if app and (pid or node.get("window")):
                g = grp(display_name(str(app)))
                g["wins"] += 1
                title = str(props.get("title") or node.get("name") or "")
                if title and len(g["titles"]) < 2:
                    g["titles"].append(title[:48])
                if pid and pid in pst:
                    g["pids"][pid] = pst[pid][:2]
            for c in node.get("nodes", []) + node.get("floating_nodes", []):
                walk(c, cur_ws)
    walk(tree)

    for pid, (cpu, mem, comm, args) in pst.items():
        if PROTECTED.match(comm):
            continue
        blob = f"{comm} {args}".lower()
        target = next(
            (n for rx, n in ALIASES
             if rx.search(comm.lower()) or rx.search(blob)), None)
        if target is None:
            if any(pid in g["pids"] for g in groups.values()):
                continue  # already counted via its window
            target = display_name(comm)
        g = grp(target)
        if pid not in g["pids"]:
            g["pids"][pid] = (cpu, mem)
    return groups


def display_name(raw):
    s = re.sub(r"[-_.]?(bin|x86_64|appimage)$", "", raw.strip().lower())
    return {"brave-origin": "brave"}.get(s, s) or raw


def theme_colors():
    """Pull live theme colors so markup matches the active theme-set theme."""
    defaults = {"foreground": "#d3c6aa", "foreground-alt": "#7c6f64",
                "accent": "#7fbbb3", "accent-bright": "#dbbc7f"}
    try:
        with open(os.path.expanduser("~/.local/state/theme/rofi.rasi")) as f:
            content = f.read()
    except OSError:
        return defaults
    raw = dict(re.findall(r"([a-zA-Z0-9_-]+)\s*:\s*([^;]+);", content))

    def resolve(v, depth=0):
        v = v.strip().strip('"')
        if v.startswith("@") and depth < 5:
            return resolve(raw.get(v[1:], v), depth + 1)
        return v

    out = {}
    for key, fallback in defaults.items():
        val = resolve(raw.get(key, fallback))
        out[key] = val if re.fullmatch(r"#[0-9a-fA-F]{6}", val) else fallback
    return out


def rows(groups):
    import html
    out = []  # list of (name, markup-text)
    agg = []
    for name, g in groups.items():
        if not g["pids"]:
            continue
        cpu = sum(c for c, _ in g["pids"].values())
        mem = sum(m for _, m in g["pids"].values())
        agg.append((mem, cpu, name, g))
    for mem, cpu, name, g in sorted(agg, reverse=True):
        n = len(g["pids"])
        det = f"{n} procs" + (f", {g['wins']} wins" if g["wins"] else "")
        titles = (" — " + " / ".join(g["titles"])) if g["titles"] else ""
        rest = html.escape(f"({det}) │ CPU {cpu:4.1f}% │ RAM {mem:4.1f}%{titles}")
        if g["wins"]:
            # Foreground app: bold bright name, full-bright details.
            # (Bold only, no fixed color: a hardcoded color would turn
            # invisible against the accent fill of the selected row.)
            text = f"<b>{html.escape(name)}</b>\t{rest}"
        else:
            # Background service/daemon: whole row dimmed via alpha.
            # (Never hardcode foreground color: it overrides selected text-color
            # and turns invisible against the accent fill of the selected row.)
            text = f"<span alpha=\"65%\">{html.escape(name)}\t{rest}</span>"
        out.append((name, text))
    return out


def notify(title, body):
    try:
        subprocess.call(["notify-send", "-a", "Process Killer", "-u", "low",
                         "-i", "process-stop",
                         "-h", "string:x-canonical-private-synchronous:pkill",
                         title, body],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL, timeout=5)
    except Exception:
        pass


def kill_group(name, groups, force):
    g = groups.get(name)
    if not g:
        return
    sig = signal.SIGKILL if force else signal.SIGTERM
    done, protected = 0, 0
    for pid in list(g["pids"]):
        try:
            if PROTECTED.match(proc_comm(pid)):
                protected += 1
                continue
            os.kill(pid, sig)
            done += 1
        except (ProcessLookupError, PermissionError):
            continue
    what = "SIGKILL (-9)" if force else "SIGTERM"
    notify("Force Killed" if force else "Terminated",
           f"{what} → {done} procs of {name}"
           + (f" ({protected} protected skipped)" if protected else ""))


def proc_comm(pid):
    try:
        with open(f"/proc/{pid}/comm") as f:
            return f.read().strip()
    except OSError:
        return ""


def main():
    if os.environ.get("ROFI_PKILL_TEST") == "1":
        print("\n".join(t for _, t in rows(collect())[:15]))
        return 0
    while True:
        groups = collect()
        entries = rows(groups)
        if not entries:
            notify("Process Killer", "No killable processes")
            return 0
        try:
            p = subprocess.run(
                ["rofi", "-dmenu", "-i", "-markup-rows", "-format", "i",
                 "-sort", "-sorting-method", "fzf", "-matching", "fuzzy",
                 "-p", "Kill App",
                 "-kb-delete-entry", "", "-kb-custom-1", "Alt+d,Shift+Delete",
                 "-theme", THEME],
                input="\n".join(t for _, t in entries).encode(), stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL, timeout=300)
        except Exception:
            return 0
        if p.returncode not in (0, 10) or not p.stdout.strip():
            return 0
        try:
            name = entries[int(p.stdout.decode(errors="replace").strip())][0]
        except (ValueError, IndexError):
            return 0
        if not name:
            return 0
        kill_group(name, groups, force=(p.returncode == 10))
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
