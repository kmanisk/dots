#!/bin/sh
# scratch-toggle <term|notes|spotify>
# Toggle a scratchpad dropdown by name. If its window doesn't exist
# (closed/crashed), spawn it first -- the i3 for_window rule auto-hides it
# into the scratchpad, then it is shown. Keys never go silently dead.
#
# First-press race fix: after spawning, wait until the window is actually
# HIDDEN in the scratchpad before issuing `show`. Showing a still-visible
# fresh window would re-hide it (launch, blink, gone).
#
# Spawn commands live here (not in the i3 bindsym line) because i3's command
# parser treats commas as command separators, which breaks
# `alacritty --class Alacritty,<instance>` when passed through a binding.
set -u

mode="${1:?usage: scratch-toggle <term|notes|spotify>}"

case "$mode" in
    # CANONICAL SCRATCHPAD GEOMETRY (single source of truth).
    # These MUST match the for_window rules in sway config:
    #   term 1700x1050 | notes 1700x1050 | spotify 1700x1050.
    # Order on show is always: resize set W H, then move position center.
    term)
        instance="scratch-term"
        spawn="kitty --class scratch-term 2>>/tmp/scratch-term-err.log"
        geom="1700 1050"
        ;;
    notes)
        instance="scratch-notes"
        spawn="kitty -o font_size=20.5 --class scratch-notes -e nvim $HOME/notes.md 2>>/tmp/scratch-notes-err.log"
        geom="1700 1050"
        ;;
    spotify)
        instance="spotify"
        spawn="spotify"
        geom="1700 1050"
        ;;
    *)
        echo "unknown mode: $mode" >&2
        exit 1
        ;;
esac

IPC_CMD="i3-msg"
if [ -n "${SWAYSOCK:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
    IPC_CMD="swaymsg"
fi

# Game guard: bindings that collide with gameplay (e.g. Control+space =
# crouch-jump in FPS games) set SCRATCH_GAME_GUARD=1. When set, the toggle
# is a silent no-op while a game window is focused. Deterministic and
# compositor-independent (does not rely on shortcuts_inhibitor timing).
# Game patterns mirror the fullscreen/game for_window rules in sway config.
if [ -n "${SCRATCH_GAME_GUARD:-}" ]; then
    if $IPC_CMD -t get_tree 2>/dev/null | python3 -c '
import json, sys
pats = ("steam_app_", "cs2", "gamescope", "eldenring", "steam_proton",
        "farcry3", "gtaiv")
try:
    tree = json.load(sys.stdin)
except Exception:
    sys.exit(1)
stack, focused = [tree], None
while stack:
    n = stack.pop()
    if isinstance(n, dict):
        if n.get("focused"):
            focused = n
        stack.extend(n.get("nodes", []) + n.get("floating_nodes", []))
if not isinstance(focused, dict):
    sys.exit(1)
wp = focused.get("window_properties") or {}
hay = " ".join((focused.get("app_id") or "", wp.get("class") or "",
                wp.get("instance") or "")).lower()
if any(p in hay for p in pats) or focused.get("fullscreen_mode"):
    sys.exit(0)
sys.exit(1)
'; then
        exit 0
    fi
fi

# Reports where the window is: missing | visible | hidden (scratchpad).
win_state() {
    $IPC_CMD -t get_tree 2>/dev/null | python3 -c '
import json, sys
inst = sys.argv[1]
try:
    tree = json.load(sys.stdin)
except Exception:
    print("missing")
    sys.exit(0)
result = ["missing"]

def walk(n, in_scratch):
    if result[0] == "hidden":
        return
    name = n.get("name") or ""
    if name in ("__i3", "__i3_scratch") or (n.get("type") == "workspace" and name == "__i3_scratch"):
        in_scratch = True
    wp = n.get("window_properties") or {}
    app_id = n.get("app_id") or ""
    cls = wp.get("class") or n.get("class") or ""
    cur_inst = wp.get("instance") or ""
    
    if cur_inst == inst or app_id == inst or cls.lower() == inst.lower():
        is_hidden = in_scratch or (n.get("scratchpad_state") not in (None, "none") and not n.get("visible", False))
        result[0] = "hidden" if is_hidden else "visible"
        return
    for c in n.get("nodes", []) + n.get("floating_nodes", []):
        walk(c, in_scratch)

walk(tree, False)
print(result[0])
' "$instance"
}

show_it() {
    if [ "$IPC_CMD" = "swaymsg" ]; then
        swaymsg "[app_id=\"$instance\"] scratchpad show" >/dev/null 2>&1 || \
        swaymsg "[class=\"(?i)$instance\"] scratchpad show" >/dev/null 2>&1 || \
        swaymsg "[instance=\"$instance\"] scratchpad show" >/dev/null 2>&1
        # Enforce border pixel 2 and geometry on show
        # shellcheck disable=SC2086
        swaymsg "[app_id=\"$instance\"] border pixel 2, resize set $geom, move position center" >/dev/null 2>&1 || \
        swaymsg "[class=\"(?i)$instance\"] border pixel 2, resize set $geom, move position center" >/dev/null 2>&1
    else
        i3-msg "[instance=\"$instance\"] scratchpad show" >/dev/null 2>&1 || \
        i3-msg "[class=\"(?i)$instance\"] scratchpad show" >/dev/null 2>&1
    fi
}

# Fast-path: if window process is already running, toggle instantly (<3ms)
if pgrep -f "$instance" >/dev/null 2>&1; then
    echo "$(date '+%T') toggle $mode state_before=$(win_state)" >> /tmp/scratch-toggle.log 2>&1
    show_it
    echo "$(date '+%T') toggle $mode state_after=$(win_state)" >> /tmp/scratch-toggle.log 2>&1
    tail -n 30 /tmp/scratch-toggle.log > /tmp/scratch-toggle.log.tmp 2>/dev/null && mv /tmp/scratch-toggle.log.tmp /tmp/scratch-toggle.log 2>/dev/null
    exit 0
fi

# Fallback path: process missing or crashed. Spawn and poll fast (50ms intervals)
setsid sh -c "$spawn" </dev/null >/dev/null 2>&1 &
state="missing"
for _ in $(seq 1 20); do
    state="$(win_state)"
    [ "$state" = "hidden" ] && break
    sleep 0.05
done
[ "$state" = "hidden" ] && show_it
