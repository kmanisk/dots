#!/usr/bin/env python3
"""
omarchy-import: CLI entry point for importing Omarchy community themes into Schema 1.
Usage:
  omarchy-import <github-url> [--apply] [--dry-run] [--info]
  omarchy-import --update <github-url>
  omarchy-import --remove <theme-name>
  omarchy-import --status
  omarchy-import --catalog [--dry-run] [--limit N]
"""
import os
import sys

sys.path.insert(0, os.path.expanduser("~/.local/lib"))
from theme_engine.importer import (
    import_git_theme,
    remove_imported_theme,
    import_catalog,
    fetch_official_catalog,
    _local_import_records,
)
from theme_engine.schema import normalize_theme


def print_usage():
    print("""Usage:
  omarchy-import <github-url> [--apply] [--dry-run] [--info]
  omarchy-import --update <github-url>
  omarchy-import --remove <theme-name>
  omarchy-import --status
  omarchy-import --catalog [--dry-run] [--limit N]

Examples:
  omarchy-import https://github.com/OldJobobo/omarchy-city-783-theme
  omarchy-import https://github.com/OldJobobo/omarchy-city-783-theme --apply
  omarchy-import https://github.com/OldJobobo/omarchy-city-783-theme --dry-run
  omarchy-import https://github.com/OldJobobo/omarchy-city-783-theme --info
  omarchy-import --update https://github.com/OldJobobo/omarchy-city-783-theme
  omarchy-import --remove city-783
  omarchy-import --catalog
""")


def main():
    args = sys.argv[1:]
    if not args:
        print_usage()
        sys.exit(1)

    if "-h" in args or "--help" in args:
        print_usage()
        sys.exit(0)

    # 1. Status Check
    if args[0] in ("--status", "status"):
        themes, url = fetch_official_catalog()
        records = _local_import_records()
        catalog_repos = {
            str(t.get("repo") or "").rstrip("/").lower()
            for t in themes
            if t.get("repo")
        }
        local_repos = {
            str(repo).rstrip("/").lower()
            for _, _, repo in records
            if repo
        }
        print("\nOmarchy Theme Catalog Status:")
        print(f"  source                = {url}")
        print(f"  catalog entries       = {len(themes)}")
        print(f"  locally imported      = {len(records)}")
        print(f"  missing               = {len(catalog_repos - local_repos)}")
        print(f"  no longer listed      = {len(local_repos - catalog_repos)}")
        sys.exit(0)

    # 2. Catalog Import
    if args[0] in ("--catalog", "--all"):
        dry_run = "--dry-run" in args
        limit = None
        if "--limit" in args:
            idx = args.index("--limit")
            if idx + 1 < len(args):
                limit = int(args[idx + 1])
        ok = import_catalog(dry_run=dry_run, limit=limit)
        sys.exit(0 if ok else 1)

    # 3. Remove Theme
    if args[0] in ("--remove", "--delete", "-rm") and len(args) > 1:
        theme_name = args[1]
        ok = remove_imported_theme(theme_name)
        sys.exit(0 if ok else 1)

    # 4. Update Git Theme
    if args[0] in ("--update", "-u") and len(args) > 1:
        url = args[1]
        ok = import_git_theme(url, force_update=True)
        sys.exit(0 if ok else 1)

    # 5. Git Repository Import / Dry-run / Info / Apply
    dry_run = "--dry-run" in args
    info_only = "--info" in args or "-i" in args
    apply_flag = "--apply" in args or "-a" in args

    urls = [a for a in args if not a.startswith("-")]
    if not urls:
        print("Error: Missing repository URL", file=sys.stderr)
        print_usage()
        sys.exit(1)

    url = urls[0]

    ok = import_git_theme(
        url,
        dry_run=dry_run,
        info_only=info_only,
        force_update=False,
        apply_theme_flag=apply_flag,
    )
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
