#!/usr/bin/env bash
# ==============================================================================
# Adjust Brightness: Hardware Backlight (0% - 100%) + Below-Zero Software Dimming
# Allows dimming below 0% for dark room usage without screen flashing or lag.
# Software dimming uses wl-gammarelay-rs (Wayland wlr-gamma-control via D-Bus).
# Works uniformly in both Hybrid (intel_backlight) and AsusMuxDgpu (nvidia_wmi_ec_backlight).
# ==============================================================================
export PATH="$HOME/.gemini/antigravity-cli/bin:$HOME/.local/bin:/usr/bin:$PATH"

ARG="${1:-+5%}"
DIRECTION="up"
STEP=5

if [[ "$ARG" =~ -|down ]]; then
    DIRECTION="down"
fi

NUM=$(echo "$ARG" | grep -o -E '[0-9]+' | head -n 1)
if [[ -n "$NUM" && "$NUM" -gt 0 ]]; then
    STEP="$NUM"
fi

# Ensure wl-gammarelay daemon is running for software dimming
if ! systemctl --user is-active --quiet wl-gammarelay.service 2>/dev/null; then
    systemctl --user start wl-gammarelay.service 2>/dev/null || true
fi

# Read current hardware brightness (0 - 100)
HW_PERCENT=$(brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d '%')
[[ -z "$HW_PERCENT" ]] && HW_PERCENT=0

# Read current software brightness (0.15 - 1.0)
SW_BRIGHTNESS=$(busctl --user get-property rs.wl-gammarelay / rs.wl.gammarelay Brightness 2>/dev/null | awk '{print $2}')
if [[ -z "$SW_BRIGHTNESS" ]]; then
    SW_BRIGHTNESS="1"
fi

# Convert software brightness to integer percentage (15 to 100)
SW_PCT=$(python3 -c "import sys; print(int(round(float('$SW_BRIGHTNESS') * 100)))" 2>/dev/null || echo 100)

OSD_LABEL=""
OSD_VAL=0
ICON="display-brightness"

if [[ "$DIRECTION" == "down" ]]; then
    if (( HW_PERCENT > 0 )); then
        # 1. Hardware Backlight Dimming (100% down to 0%)
        # Ensure software brightness is maxed (1.0) while hardware backlight is above 0%
        if (( SW_PCT < 100 )); then
            busctl --user set-property rs.wl-gammarelay / rs.wl.gammarelay Brightness d 1.0 2>/dev/null || true
            SW_PCT=100
        fi

        brightnessctl set "${STEP}%-" >/dev/null 2>&1
        HW_PERCENT=$(brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d '%')
        [[ -z "$HW_PERCENT" ]] && HW_PERCENT=0

        OSD_LABEL="Brightness: ${HW_PERCENT}%"
        OSD_VAL="$HW_PERCENT"
        if (( HW_PERCENT <= 15 )); then
            ICON="display-brightness-low"
        else
            ICON="display-brightness"
        fi
    else
        # 2. Below-Zero Software Dimming (Hardware backlight is at 0%)
        NEW_SW=$(( SW_PCT - STEP ))
        # Minimum safe software floor: 15% (avoids complete blackout)
        if (( NEW_SW < 15 )); then
            NEW_SW=15
        fi

        FLOAT_VAL=$(awk -v val="$NEW_SW" 'BEGIN { printf "%.2f", val / 100 }')
        busctl --user set-property rs.wl-gammarelay / rs.wl.gammarelay Brightness d "$FLOAT_VAL" 2>/dev/null || true

        SUB_PERCENT=$(( 100 - NEW_SW ))
        OSD_LABEL="Brightness: -${SUB_PERCENT}%"
        OSD_VAL="$NEW_SW"
        ICON="weather-clear-night"
    fi
else
    # DIRECTION == "up"
    if (( SW_PCT < 100 )); then
        # 1. Recovering from Below-Zero Software Dimming up to 0% (SW 1.0)
        NEW_SW=$(( SW_PCT + STEP ))
        if (( NEW_SW >= 100 )); then
            NEW_SW=100
            busctl --user set-property rs.wl-gammarelay / rs.wl.gammarelay Brightness d 1.0 2>/dev/null || true
            OSD_LABEL="Brightness: 0%"
            OSD_VAL=0
            ICON="display-brightness-low"
        else
            FLOAT_VAL=$(awk -v val="$NEW_SW" 'BEGIN { printf "%.2f", val / 100 }')
            busctl --user set-property rs.wl-gammarelay / rs.wl.gammarelay Brightness d "$FLOAT_VAL" 2>/dev/null || true
            SUB_PERCENT=$(( 100 - NEW_SW ))
            OSD_LABEL="Brightness: -${SUB_PERCENT}%"
            OSD_VAL="$NEW_SW"
            ICON="weather-clear-night"
        fi
    else
        # 2. Hardware Backlight Increasing (0% up to 100% full panel nits)
        # Ensure software brightness is strictly 1.0 (no dimming/gamma bottleneck)
        busctl --user set-property rs.wl-gammarelay / rs.wl.gammarelay Brightness d 1.0 2>/dev/null || true

        brightnessctl set "+${STEP}%" >/dev/null 2>&1
        HW_PERCENT=$(brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d '%')
        [[ -z "$HW_PERCENT" ]] && HW_PERCENT=100

        OSD_LABEL="Brightness: ${HW_PERCENT}%"
        OSD_VAL="$HW_PERCENT"
        ICON="display-brightness"
    fi
fi

# Suppress OSD notification completely on Workspace 4 (Gaming workspace) to prevent FPS drops
CURRENT_WS=""
if [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null 2>&1; then
    CURRENT_WS=$(swaymsg -t get_workspaces --raw 2>/dev/null | jq -r '.[] | select(.focused).name' 2>/dev/null || echo "")
elif [ -n "${I3SOCK:-}" ] && command -v i3-msg >/dev/null 2>&1; then
    CURRENT_WS=$(i3-msg -t get_workspaces 2>/dev/null | jq -r '.[] | select(.focused).name' 2>/dev/null || echo "")
fi

if [ "$CURRENT_WS" = "4" ]; then
    exit 0
fi

# Fast dismiss: 800ms regular, 500ms in fullscreen
TIMEOUT=800
if command -v swaymsg >/dev/null 2>&1 && [ -n "${SWAYSOCK:-}" ]; then
    IS_FS=$(swaymsg -t get_tree 2>/dev/null | jq -r '.. | select(.focused? == true) | .fullscreen_mode' 2>/dev/null || echo 0)
    [ "$IS_FS" = "1" ] && TIMEOUT=500
elif command -v i3-msg >/dev/null 2>&1 && [ -n "${I3SOCK:-}" ]; then
    IS_FS=$(i3-msg -t get_tree 2>/dev/null | jq -r '.. | select(.focused? == true) | .fullscreen_mode' 2>/dev/null || echo 0)
    [ "$IS_FS" = "1" ] && TIMEOUT=500
fi

# Send synchronized OSD notification (Mako / Dunst)
notify-send -a "Brightness" -t "$TIMEOUT" -u low -i "$ICON" \
    -h string:x-canonical-private-synchronous:brightness \
    -h string:x-dunst-stack-tag:brightness \
    -h int:value:"$OSD_VAL" \
    "$OSD_LABEL" 2>/dev/null || \
dunstify -a "Brightness" -t "$TIMEOUT" -u low -i "$ICON" \
    -h string:x-dunst-stack-tag:brightness \
    -h int:value:"$OSD_VAL" \
    "$OSD_LABEL" 2>/dev/null
