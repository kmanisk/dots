#!/usr/bin/env bash
# ==============================================================================
# mic — Minimal Native Audio Studio & Voice Preset Manager Wrapper
# Delegates to high-performance native Rust `micstudio` binary.
# Zero always-running background daemons or polling loops.
# ==============================================================================
set -euo pipefail

case "${1:-}" in
    ""|"tui")
        exec micstudio
        ;;
    clean)
        exec micstudio clean
        ;;
    fx)
        exec micstudio voice "Deep Voice"
        ;;
    voice)
        shift
        exec micstudio voice "$@"
        ;;
    list)
        exec micstudio list
        ;;
    status)
        exec micstudio status
        ;;
    doctor)
        exec micstudio doctor
        ;;
    preset)
        shift
        exec micstudio preset "$@"
        ;;
    noise)
        shift
        exec micstudio noise "$@"
        ;;
    gate)
        # Backward compatibility: if single number passed (e.g. `mic gate 70`), map to aggressiveness
        if [[ $# -eq 2 && "$2" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
            exec micstudio gate aggressiveness "$2"
        else
            shift
            exec micstudio gate "$@"
        fi
        ;;
    gain)
        shift
        exec micstudio gain "$@"
        ;;
    speaker|spk|dolby)
        shift
        exec micstudio speaker "$@"
        ;;
    audio)
        shift
        exec audio "$@"
        ;;
    hear|sidetone|monitor)
        shift
        exec micstudio hear "$@"
        ;;
    *)
        exec micstudio "$@"
        ;;
esac
