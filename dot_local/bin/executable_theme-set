#!/usr/bin/env python3
"""
theme-set: Minimal, robust Base46 system theme compiler.
Staged atomic file replacement, live IPC/RPC/signals where supported,
zero resident processes / daemons / watchers.
Optimized for low-latency verified reloads; missing wallpaper bytes hydrate in detached one-shot jobs.
"""
import os
import sys
import glob
import json
import re
import subprocess
import math
import colorsys
import signal
import fcntl
import filecmp
from contextlib import contextmanager

sys.path.insert(0, os.path.expanduser("~/.local/lib"))
from theme_engine.wallpaper_policy import resolve_omarchy_wallpaper_source, wallpaper_path_allowed


STATE_DIR = os.path.expanduser("~/.local/state/theme")
CACHE_DIR = os.path.expanduser("~/.cache/theme/themes")
TEMPLATES_DIR = os.path.expanduser("~/.config/theme/templates")
HOOKS_DIR = os.path.expanduser("~/.config/theme/hooks.d")
QT5_COLOR_FILE = os.path.expanduser("~/.config/qt5ct/colors/nvchad.conf")
QT6_COLOR_FILE = os.path.expanduser("~/.config/qt6ct/colors/nvchad.conf")
LOCK_FILE = os.path.join(STATE_DIR, ".lock")
WALLPAPER_ROOT_DIR = os.path.expanduser("~/.local/share/theme/wallpapers")
WALLPAPER_CACHE_DIR = os.path.join(WALLPAPER_ROOT_DIR, "upstream")
WALLPAPER_STATE_DIR = os.path.join(STATE_DIR, "wallpaper")
CURRENT_WALLPAPER_FILE = os.path.expanduser("~/.config/current_wallpaper")
WALLPAPER_EXTENSIONS = {".png", ".jpg", ".jpeg", ".webp"}
REPOSITORY_DISCOVERY_VERSION = 3
UPSTREAM_APPS_VERSION = 3
UPSTREAM_APPS_DIR = os.path.expanduser("~/.local/share/theme/upstream-apps")

os.makedirs(STATE_DIR, exist_ok=True)

@contextmanager
def theme_mutation_lock():
    """Serialize theme mutations so rapid switches cannot share staging state."""
    with open(LOCK_FILE, "a+", encoding="utf-8") as lock_file:
        os.chmod(LOCK_FILE, 0o600)
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)

def run_ipc(cmd, label, timeout=1.0):
    """Run a short-lived reload command synchronously so switches stay ordered."""
    try:
        result = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
            check=False,
        )
        if result.returncode != 0:
            detail = result.stderr.strip() or result.stdout.strip() or f"exit status {result.returncode}"
            print(f"[WARN] {label}: {detail}", file=sys.stderr)
            return False
        return True
    except Exception as exc:
        print(f"[WARN] {label} failed: {exc}", file=sys.stderr)
        return False

def upstream_apps_overlay_path(theme_name):
    return os.path.join(UPSTREAM_APPS_DIR, f"{theme_name}.json")


def load_upstream_apps_overlay(theme_name, theme_data):
    """Load a validated runtime overlay for legacy Omarchy imports."""
    source = theme_data.get("source") or {}
    repository = str(source.get("repository") or "").rstrip("/")
    ref = str(source.get("commit") or source.get("branch") or "main")
    if str(source.get("provider") or "").lower() != "omarchy" or not repository:
        return None
    try:
        with open(upstream_apps_overlay_path(theme_name), "r", encoding="utf-8") as handle:
            overlay = json.load(handle)
    except (OSError, json.JSONDecodeError, TypeError):
        return None
    if overlay.get("version") != UPSTREAM_APPS_VERSION:
        return None
    if str(overlay.get("repository") or "").rstrip("/") != repository:
        return None
    if str(overlay.get("ref") or "") != ref:
        return None
    return overlay


def merge_upstream_apps_overlay(theme_name, theme_data):
    """Merge parsed app profiles without mutating the canonical cache object."""
    overlay = load_upstream_apps_overlay(theme_name, theme_data)
    if not overlay or not isinstance(overlay.get("apps"), dict):
        return theme_data
    merged = dict(theme_data)
    apps = dict(theme_data.get("apps") or {})
    apps.update(overlay.get("apps") or {})
    merged["apps"] = apps
    merged["upstream_apps_overlay"] = {
        "version": overlay.get("version"),
        "files": overlay.get("files") or {},
    }
    return merged


def upstream_apps_need_hydration(theme_name, theme_data):
    source = theme_data.get("source") or {}
    if os.environ.get("THEME_UPSTREAM_REAPPLY") == "1":
        return False
    if str(source.get("provider") or "").lower() != "omarchy" or not source.get("repository"):
        return False
    assets = theme_data.get("assets") or {}
    if assets.get("upstream_apps_version") == UPSTREAM_APPS_VERSION:
        return False
    return load_upstream_apps_overlay(theme_name, theme_data) is None


def spawn_reload(cmd, label):
    """Fire a reload-current-config command without extending theme latency.

    These commands carry no theme values; if they finish after a newer switch,
    they reload the newest already-promoted config and therefore cannot restore
    stale colors.
    """
    try:
        subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
        return True
    except Exception as exc:
        print(f"[WARN] {label} launch failed: {exc}", file=sys.stderr)
        return False


def spawn_upstream_apps_hydration(theme_name):
    helper = os.path.expanduser("~/.local/bin/theme-upstream-apps")
    if not os.path.isfile(helper) or not os.access(helper, os.X_OK):
        return False
    try:
        subprocess.Popen(
            [helper, "hydrate", theme_name],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
        return True
    except Exception as exc:
        print(f"[WARN] upstream app hydration launch failed for {theme_name}: {exc}", file=sys.stderr)
        return False


def spawn_wallpaper_hydration(theme_name):
    """Hydrate a missing resolved wallpaper repository without blocking theme apply."""
    helper = os.path.expanduser("~/.local/bin/theme-wallpaper")
    if not os.path.isfile(helper) or not os.access(helper, os.X_OK):
        return False
    try:
        subprocess.Popen(
            [helper, "hydrate", theme_name],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
        return True
    except Exception as exc:
        print(f"[WARN] wallpaper hydration launch failed for {theme_name}: {exc}", file=sys.stderr)
        return False


def reload_nvim_socket(sock, name, theme_type, timeout=1.5):
    """Apply a Base46 theme to one live NvChad socket and surface Lua failures."""
    lua_code = (
        'luaeval("(function() '
        'vim.g.system_theme_sync = true; '
        'local ok, err = xpcall(function() '
        f"require(\'nvconfig\').base46.theme = \'{name}\'; "
        f"require(\'nvconfig\').base46.transparency = {str(theme_type != 'light').lower()}; "
        f"package.loaded[\'themes.{name}\'] = nil; "
        f"package.loaded[\'base46.themes.{name}\'] = nil; "
        "require('base46').load_all_highlights(); "
        "end, debug.traceback); "
        "vim.g.system_theme_sync = false; "
        "return ok and 'OK' or ('ERR:' .. tostring(err)) "
        'end)()")'
    )
    try:
        result = subprocess.run(
            ["nvim", "--server", sock, "--remote-expr", lua_code],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
            check=False,
        )
    except Exception as exc:
        print(f"[WARN] Neovim RPC {os.path.basename(sock)} failed: {exc}", file=sys.stderr)
        return False

    output = result.stdout.strip()
    if result.returncode == 0 and output == "OK":
        return True

    detail = output or result.stderr.strip() or f"exit status {result.returncode}"
    print(f"[WARN] Neovim RPC {os.path.basename(sock)}: {detail}", file=sys.stderr)
    return False


def refresh_nvim_disk_cache(name, theme_type, timeout=2.5):
    """Compile Base46 cache through normal NvChad startup when no live socket can."""
    # `nvim --headless -l -` skips normal init loading, so nvconfig/base46 are not
    # available there. Use a normal headless startup and turn Lua failure into
    # `cquit 1` because Neovim otherwise exits 0 even after a command-line error.
    lua_cmd = (
        "lua local ok,err=xpcall(function() "
        f"require('nvconfig').base46.theme='{name}'; "
        f"require('nvconfig').base46.transparency={str(theme_type != 'light').lower()}; "
        f"package.loaded['themes.{name}']=nil; "
        f"package.loaded['base46.themes.{name}']=nil; "
        "require('base46').load_all_highlights() "
        "end,debug.traceback); "
        "if not ok then io.stderr:write(tostring(err)..'\\n'); vim.cmd('cquit 1') end"
    )
    try:
        result = subprocess.run(
            ["nvim", "--headless", "-c", lua_cmd, "-c", "qa!"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
            check=False,
        )
    except Exception as exc:
        print(f"[WARN] Neovim Base46 cache refresh failed: {exc}", file=sys.stderr)
        return False

    if result.returncode == 0:
        return True
    detail = result.stderr.strip() or result.stdout.strip() or f"exit status {result.returncode}"
    print(f"[WARN] Neovim Base46 cache refresh: {detail}", file=sys.stderr)
    return False


def write_atomic(filepath, content):
    """Safely write content to filepath atomically via os.replace."""
    dirname = os.path.dirname(filepath)
    os.makedirs(dirname, exist_ok=True)
    temp_name = f"{filepath}.tmp.{os.getpid()}"
    try:
        with open(temp_name, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_name, filepath)
    finally:
        try:
            os.unlink(temp_name)
        except FileNotFoundError:
            pass


def create_rollback_backup(source, destination):
    """Keep old target bytes for rollback without importing/copying file metadata."""
    try:
        os.link(source, destination)
        return
    except OSError:
        pass
    with open(source, "rb") as src, open(destination, "wb") as dst:
        while True:
            chunk = src.read(65536)
            if not chunk:
                break
            dst.write(chunk)


def write_stage(filepath, content):
    """Write private .next/ content without fsync; live targets are promoted transactionally later."""
    os.makedirs(os.path.dirname(filepath), exist_ok=True)
    with open(filepath, "w", encoding="utf-8") as handle:
        handle.write(content)


def write_atomic_if_changed(filepath, content):
    """Atomically replace a text file only when its bytes actually change."""
    try:
        with open(filepath, "r", encoding="utf-8") as handle:
            if handle.read() == content:
                return False
    except OSError:
        pass
    write_atomic(filepath, content)
    return True


def preserve_scale_managed_chrome(filename, rendered, current_path):
    """Keep ui-sync-owned geometry while replacing theme-owned colors.

    theme-set owns palette/content; ui-sync owns scale-derived dimensions. Reading
    those few live values into the staged render prevents a rewrite/rescale loop
    on same-theme reapply while preserving correct sizes across theme changes.
    """
    try:
        with open(current_path, "r", encoding="utf-8") as handle:
            current = handle.read()
    except OSError:
        return rendered

    if filename == "mako.conf":
        for key in ("font", "padding", "margin", "width", "border-size", "border-radius"):
            match = re.search(rf"(?m)^{re.escape(key)}=.*$", current)
            if match:
                rendered = re.sub(
                    rf"(?m)^{re.escape(key)}=.*$",
                    match.group(0),
                    rendered,
                    count=1,
                )
        return rendered

    if filename == "swaybar.conf":
        match = re.search(r"(?m)^[ \t]*font[ \t]+pango:.*$", current)
        if match:
            rendered = re.sub(
                r"(?m)^[ \t]*font[ \t]+pango:.*$",
                match.group(0),
                rendered,
                count=1,
            )
        return rendered

    if filename == "gtk.css":
        values = re.findall(r"font-size:[ \t]*[0-9.]+pt", current)
        if values:
            iterator = iter(values)
            rendered = re.sub(
                r"font-size:[ \t]*[0-9.]+pt",
                lambda match: next(iterator, match.group(0)),
                rendered,
            )
        return rendered

    return rendered


def _upstream_wallpaper_images(name, source_theme=None):
    directory = os.path.join(WALLPAPER_CACHE_DIR, name)
    if not os.path.isdir(directory):
        return []
    manifest_path = os.path.join(directory, "manifest.json")
    files = []
    try:
        with open(manifest_path, "r", encoding="utf-8") as handle:
            manifest = json.load(handle)
        for item in manifest.get("files") or []:
            filename = item.get("file") if isinstance(item, dict) else None
            source_path = item.get("source") if isinstance(item, dict) else None
            if source_theme is not None and source_path and not wallpaper_path_allowed(source_theme, str(source_path)):
                continue
            candidate = os.path.join(directory, str(filename or ""))
            if filename and os.path.isfile(candidate) and os.path.splitext(candidate)[1].lower() in WALLPAPER_EXTENSIONS:
                files.append(candidate)
    except (OSError, json.JSONDecodeError, TypeError):
        files = []
    if files:
        return files
    return sorted(
        os.path.join(directory, entry)
        for entry in os.listdir(directory)
        if os.path.splitext(entry)[1].lower() in WALLPAPER_EXTENSIONS
        and os.path.isfile(os.path.join(directory, entry))
    )


def cached_theme_wallpaper(name, theme_data=None):
    """Return a local wallpaper without substituting another theme's artwork."""
    state_path = os.path.join(WALLPAPER_STATE_DIR, name)
    try:
        selected = open(state_path, "r", encoding="utf-8").read().strip()
    except OSError:
        selected = ""

    source = resolve_omarchy_wallpaper_source(name, theme_data or {}) if theme_data is not None else None
    images = _upstream_wallpaper_images(source[0], source[1]) if source else []

    if not images:
        return None
    if selected:
        for candidate in images:
            if os.path.basename(candidate) == selected:
                return candidate
    return images[0]


def wallpaper_cache_needs_hydration(name, theme_data):
    """Return True when a resolved repository cache needs lazy discovery/repair."""
    source = resolve_omarchy_wallpaper_source(name, theme_data or {})
    if not source:
        return False
    source_name, source_theme = source
    source_meta = source_theme.get("source") or {}
    expected_repository = str(source_meta.get("repository") or "").rstrip("/")
    expected_ref = str(source_meta.get("commit") or source_meta.get("branch") or "main")
    path = os.path.join(WALLPAPER_CACHE_DIR, source_name, "manifest.json")
    try:
        with open(path, "r", encoding="utf-8") as handle:
            manifest = json.load(handle)
    except (OSError, json.JSONDecodeError, TypeError):
        return True

    if manifest.get("discovery_version") != REPOSITORY_DISCOVERY_VERSION:
        return True
    if str(manifest.get("repository") or "").rstrip("/") != expected_repository:
        return True
    if str(manifest.get("ref") or "") != expected_ref:
        return True

    files = manifest.get("files") or []
    if not files:
        return True
    directory = os.path.join(WALLPAPER_CACHE_DIR, source_name)
    for item in files:
        filename = item.get("file") if isinstance(item, dict) else None
        if not filename or not os.path.isfile(os.path.join(directory, str(filename))):
            return True
    return False


def get_available_themes():
    files = glob.glob(os.path.join(CACHE_DIR, "*.json"))
    names = [os.path.splitext(os.path.basename(f))[0] for f in files]
    return sorted(names)

def scan_running_processes(names):
    """Perform a single fast /proc scan for all target process names."""
    found = {name: [] for name in names}
    try:
        for pid_dir in os.listdir("/proc"):
            if pid_dir.isdigit():
                try:
                    with open(f"/proc/{pid_dir}/comm", "r") as f:
                        comm = f.read().strip()
                        if comm in found:
                            found[comm].append(int(pid_dir))
                except Exception:
                    pass
    except Exception:
        pass
    return found

def foot_terminal_ptys(foot_pids):
    """Find the slave PTYs of existing Foot windows, including server clients.

    In Foot server mode, footclient is an IPC client with no terminal child.
    The long-lived `foot --server` spawns each session as a direct child (Fish,
    shell `-e`, or other command) which owns the slave PTY on fd 0/1/2.
    Inspect only those direct child standard FDs; scanning every FD or every
    /dev/pts would risk injecting OSC into unrelated terminals/sessions.
    """
    pts = set()
    for pid in foot_pids:
        try:
            with open(f"/proc/{pid}/task/{pid}/children", "r", encoding="utf-8") as handle:
                child_pids = (int(child) for child in handle.read().split())
                for child_pid in child_pids:
                    for fd in (1, 0, 2):
                        try:
                            target = os.readlink(f"/proc/{child_pid}/fd/{fd}")
                        except OSError:
                            continue
                        if target.startswith("/dev/pts/") and target[9:].isdigit():
                            pts.add(target)
                            break
        except (OSError, ValueError):
            continue
    return pts


def broadcast_foot_palette(colors, foot_pids):
    """Send the active Foot palette to windows without resetting screen cells.

    Use one OSC write per PTY, including Foot server-hosted sessions. This
    updates terminal-default and indexed colors; application-painted RGB cells
    cannot be recolored until that TUI chooses to redraw them.
    Returns (updated, discovered) for optional, non-mutating verification.
    """
    foot_pts = foot_terminal_ptys(foot_pids)
    if not foot_pts:
        return 0, 0
    osc_seq = (
        f"\x1b]10;{colors['foot_fg']}\x1b\\"
        f"\x1b]11;{colors['foot_bg']}\x1b\\"
        f"\x1b]12;{colors['foot_cursor']}\x1b\\"
        f"\x1b]17;{colors['foot_selection_bg']}\x1b\\"
        f"\x1b]19;{colors['foot_selection_fg']}\x1b\\"
        + "".join(
            f"\x1b]4;{index};{colors[f'foot_color{index}']}\x1b\\"
            for index in range(16)
        )
    ).encode("utf-8")
    updated = 0
    for pts in sorted(foot_pts):
        try:
            # Avoid clearing or forcing redraw of in-progress fullscreen TUIs.
            with open(pts, "wb", buffering=0) as f:
                if f.write(osc_seq) == len(osc_seq):
                    updated += 1
        except OSError as exc:
            print(f"[WARN] Foot OSC update for {pts}: {exc}", file=sys.stderr)
    if os.environ.get("THEME_FOOT_TRACE") == "1":
        print(f"[Foot] updated {updated}/{len(foot_pts)} live PTYs", file=sys.stderr)
    return updated, len(foot_pts)


def get_current_theme():
    name_file = os.path.join(STATE_DIR, "name")
    if os.path.exists(name_file):
        try:
            with open(name_file, "r") as f:
                return f.read().strip()
        except Exception:
            pass
    return "gruvchad"

def get_current_theme_type():
    type_file = os.path.join(STATE_DIR, "type")
    if os.path.exists(type_file):
        try:
            with open(type_file, "r") as f:
                return f.read().strip()
        except Exception:
            pass
    return "dark"

def generate_qt_palette(r):
    QT = [
        "fg", "one_bg", "one_bg3", "one_bg2", "darker_black", "black2", "fg", "white", "fg",
        "darker_black", "black", "darker_black", "accent", "black", "blue", "purple",
        "black2", "black", "one_bg", "fg", "grey"
    ]
    def qt_colors(dis):
        cols = []
        for i, k in enumerate(QT):
            key = "grey" if (dis and i in (0, 6, 8)) else k
            hex_val = r.get(key, "#ffffff")
            if hex_val.startswith("#"):
                hex_val = hex_val[1:]
            cols.append(f"#ff{hex_val}")
        return ", ".join(cols)

    active = qt_colors(False)
    disabled = qt_colors(True)
    return f"[ColorScheme]\nactive_colors={active}\ndisabled_colors={disabled}\ninactive_colors={active}\n"

HEX_RE = re.compile(r"^#?[0-9a-fA-F]{6}$")

def clean_hex(h, default="#ffffff"):
    if not h or not isinstance(h, str):
        return default
    h = h.strip()
    if not h.startswith("#"):
        h = "#" + h
    if HEX_RE.match(h):
        return h.lower()
    return default

def hex_to_rgb(h):
    h = clean_hex(h).lstrip("#")
    if len(h) != 6:
        return 255, 255, 255
    try:
        return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    except ValueError:
        return 255, 255, 255

def rgb_to_hex(r, g, b):
    return f"#{int(round(max(0, min(255, r)))):02x}{int(round(max(0, min(255, g)))):02x}{int(round(max(0, min(255, b)))):02x}"

def blend_colors(c1, c2, alpha):
    r1, g1, b1 = hex_to_rgb(c1)
    r2, g2, b2 = hex_to_rgb(c2)
    return rgb_to_hex(r1 + (r2 - r1) * alpha, g1 + (g2 - g1) * alpha, b1 + (b2 - b1) * alpha)

def srgb_channel_to_linear(c):
    c_norm = c / 255.0
    return c_norm / 12.92 if c_norm <= 0.04045 else math.pow((c_norm + 0.055) / 1.055, 2.4)

def relative_luminance(h):
    r, g, b = hex_to_rgb(h)
    return 0.2126 * srgb_channel_to_linear(r) + 0.7152 * srgb_channel_to_linear(g) + 0.0722 * srgb_channel_to_linear(b)

def contrast_ratio(h1, h2):
    l1 = relative_luminance(h1)
    l2 = relative_luminance(h2)
    return (max(l1, l2) + 0.05) / (min(l1, l2) + 0.05)

def ensure_contrast(fg_hex, bg_hex, min_ratio=4.5, is_dark=True):
    fg_hex = clean_hex(fg_hex)
    bg_hex = clean_hex(bg_hex)
    ratio = contrast_ratio(fg_hex, bg_hex)
    if ratio >= min_ratio:
        return fg_hex
    r, g, b = hex_to_rgb(fg_hex)
    h, l, s = colorsys.rgb_to_hls(r / 255.0, g / 255.0, b / 255.0)
    current_l = l
    best_hex = fg_hex
    for _ in range(40):
        current_l = min(1.0, current_l + 0.02) if is_dark else max(0.0, current_l - 0.02)
        nr, ng, nb = colorsys.hls_to_rgb(h, current_l, s)
        cand = '#{:02x}{:02x}{:02x}'.format(int(round(nr * 255)), int(round(ng * 255)), int(round(nb * 255)))
        if contrast_ratio(cand, bg_hex) >= min_ratio:
            return cand
        best_hex = cand
    return best_hex

def normalize_palette(theme_data, name):
    b16 = dict(theme_data.get("base_16", {}))
    b30 = dict(theme_data.get("base_30", {}))
    if "derived" in theme_data and isinstance(theme_data["derived"], dict):
        if not b30 and "base_30" in theme_data["derived"]:
            b30 = dict(theme_data["derived"]["base_30"])
    if "palette" in theme_data and isinstance(theme_data["palette"], dict):
        if not b16 and "base_16" in theme_data["palette"]:
            b16 = dict(theme_data["palette"]["base_16"])

    theme_type = theme_data.get("type", "dark")
    is_dark = (theme_type == "dark")

    # Semantic roles from base16
    base00 = b16.get("BASE00", "#1e2122")
    base01 = b16.get("BASE01", "#282b2c")
    base02 = b16.get("BASE02", "#393c3d")
    base03 = b16.get("BASE03", "#484b4c")
    base04 = b16.get("BASE04", "#575a5b")
    base05 = b16.get("BASE05", "#c7b89d")
    base06 = b16.get("BASE06", "#c3b499")
    base07 = b16.get("BASE07", "#c7b89d")
    base08 = b16.get("BASE08", "#ec6b64")
    base09 = b16.get("BASE09", "#e78a4e")
    base0A = b16.get("BASE0A", "#d6b676")
    base0B = b16.get("BASE0B", "#89b482")
    base0C = b16.get("BASE0C", "#82b3a8")
    base0D = b16.get("BASE0D", "#6d8dad")
    base0E = b16.get("BASE0E", "#9385b4")
    base0F = b16.get("BASE0F", "#d65d0e")

    # Signature UI accent selection:
    # 1. folder_bg (brand UI color explicitly chosen by theme designer)
    # 2. explicit custom accent if provider is custom
    # 3. blue / nord_blue
    # 4. BASE0D / BASE0A
    provider = theme_data.get("source", {}).get("provider", "")
    if provider == "custom" and theme_data.get("accent"):
        accent = theme_data["accent"]
    else:
        accent = (
            b30.get("folder_bg")
            or theme_data.get("accent")
            or theme_data.get("palette", {}).get("accent")
            or b30.get("blue")
            or b30.get("nord_blue")
            or base0D
            or base0A
        )
    accent = clean_hex(accent)

    # Extract authentic named colors: prefer b30 (designer's canonical palette),
    # falling back to base16 slots
    true_red    = b30.get("red") or base08
    true_orange = b30.get("orange") or base09
    true_yellow = b30.get("yellow") or b30.get("sun") or base0A
    true_green  = b30.get("green") or base0B
    true_cyan   = b30.get("cyan") or base0C
    true_blue   = b30.get("blue") or b30.get("nord_blue") or base0D
    true_purple = b30.get("purple") or b30.get("dark_purple") or base0E
    true_pink   = b30.get("pink") or b30.get("baby_pink") or true_purple
    true_teal   = b30.get("teal") or true_cyan

    # Background, surface, selection, muted
    bg    = b30.get("black") or base00
    bg2   = b30.get("one_bg") or base01
    sel   = b30.get("one_bg2") or base02
    muted = b30.get("grey_fg") or b30.get("grey") or base03
    raw_fg = b30.get("white") or base05

    # Surface & selection polarity guard:
    if is_dark:
        if relative_luminance(sel) > 0.22 or contrast_ratio(sel, bg) > 3.0:
            sel = blend_colors(bg, accent, 0.14)
        if relative_luminance(bg2) > 0.22:
            bg2 = blend_colors(bg, accent, 0.08)
    else:
        if relative_luminance(sel) < 0.40:
            sel = blend_colors(bg, "#000000", 0.10)
        if relative_luminance(bg2) < 0.40:
            bg2 = blend_colors(bg, "#000000", 0.04)

    # Smart contrast adjustment: WCAG AA is 4.5:1 for body text.
    # Syntax/UI colors use the 3.0:1 non-text floor. Keep the authored hue and
    # change lightness only when a base_30 alias would otherwise undo the
    # Schema 1 contrast correction (for example white syntax on a white theme).
    smart_fg = ensure_contrast(raw_fg, bg, min_ratio=4.5, is_dark=is_dark)
    bright_fg = ensure_contrast(b30.get("white", smart_fg), bg, min_ratio=7.0, is_dark=is_dark)
    muted = ensure_contrast(muted, bg, min_ratio=3.0, is_dark=is_dark)
    true_red = ensure_contrast(true_red, bg, min_ratio=3.0, is_dark=is_dark)
    true_orange = ensure_contrast(true_orange, bg, min_ratio=3.0, is_dark=is_dark)
    true_yellow = ensure_contrast(true_yellow, bg, min_ratio=3.0, is_dark=is_dark)
    true_green = ensure_contrast(true_green, bg, min_ratio=3.0, is_dark=is_dark)
    true_cyan = ensure_contrast(true_cyan, bg, min_ratio=3.0, is_dark=is_dark)
    true_blue = ensure_contrast(true_blue, bg, min_ratio=3.0, is_dark=is_dark)
    true_purple = ensure_contrast(true_purple, bg, min_ratio=3.0, is_dark=is_dark)
    true_pink = ensure_contrast(true_pink, bg, min_ratio=3.0, is_dark=is_dark)
    true_teal = ensure_contrast(true_teal, bg, min_ratio=3.0, is_dark=is_dark)

    # Pick the highest-contrast foreground for accent-backed selections.
    # This is more robust than a luminance threshold for saturated mid-tones.
    accent_fg = max(
        (bg, "#121212", "#ffffff"),
        key=lambda candidate: contrast_ratio(candidate, accent),
    )

    r = {
        "name": name,
        "display_name": theme_data.get("display_name", name),
        "type": theme_type,
        "bg": bg,
        "bg2": bg2,
        "sel": sel,
        "muted": muted,
        "fg": smart_fg,
        "bright_fg": bright_fg,
        "red": true_red,
        "orange": true_orange,
        "yellow": true_yellow,
        "green": true_green,
        "cyan": true_cyan,
        "blue": true_blue,
        "purple": true_purple,
        "pink": true_pink,
        "teal": true_teal,
        "accent": accent,
        "accent_fg": accent_fg,
        "selected_fg": accent_fg,
    }

    # Harmonize base_16 keys in lower and upper
    r["base00"] = bg
    r["base01"] = bg2
    r["base02"] = sel
    r["base03"] = muted
    r["base04"] = ensure_contrast(
        b30.get("grey_fg2") or b16.get("BASE04", muted),
        bg,
        min_ratio=3.0,
        is_dark=is_dark,
    )
    r["base05"] = smart_fg
    r["base06"] = ensure_contrast(
        b16.get("BASE06", smart_fg),
        bg,
        min_ratio=4.5,
        is_dark=is_dark,
    )
    r["base07"] = bright_fg
    r["base08"] = true_red
    r["base09"] = true_orange
    r["base0a"] = true_yellow
    r["base0b"] = true_green
    r["base0c"] = true_cyan
    r["base0d"] = true_blue
    r["base0e"] = true_purple
    r["base0f"] = true_pink

    for k in [f"base0{x}" for x in "0123456789abcdef"]:
        r[k.upper()] = r[k]

    # Add all base_30 keys without allowing authored aliases to undo the
    # normalized contrast floor. Hue/saturation stay authored; only lightness
    # moves when one of these chromatic aliases is otherwise unreadable.
    surface_keys = {"black2", "one_bg", "one_bg2", "one_bg3", "line", "lightbg", "pmenu_bg", "statusline_bg", "darker_black"}
    chromatic_keys = {
        "red", "orange", "yellow", "sun", "green", "vibrant_green",
        "cyan", "teal", "blue", "nord_blue", "purple",
        "dark_purple", "pink", "baby_pink",
    }
    for k, v in b30.items():
        if k == "white":
            r[k] = ensure_contrast(v, bg, min_ratio=4.5, is_dark=is_dark)
        elif k in chromatic_keys:
            r[k] = ensure_contrast(v, bg, min_ratio=3.0, is_dark=is_dark)
        elif k in surface_keys:
            l_v = relative_luminance(v)
            if is_dark and l_v > 0.25:
                r[k] = sel if k in ("one_bg2", "lightbg") else (bg2 if k in ("one_bg", "darker_black") else blend_colors(bg, accent, 0.10))
            elif not is_dark and l_v < 0.35:
                r[k] = sel if k in ("one_bg2", "lightbg") else (bg2 if k in ("one_bg", "darker_black") else blend_colors(bg, "#000000", 0.08))
            else:
                r[k] = v
        else:
            r[k] = v

    if "white" not in r:
        r["white"] = smart_fg

    # Add semantic tokens. Window borders get dedicated visibility-safe roles:
    # focused >= 3:1 against the window background; inactive >= 1.7:1 while
    # retaining the same theme hue instead of falling back to generic grey.
    semantic = theme_data.get("derived", {}).get("semantic", {}) or theme_data.get("semantic", {})
    for k, v in semantic.items():
        r[f"semantic_{k}"] = v
    border_seed = semantic.get("border") or accent
    border_focus = ensure_contrast(border_seed, bg, min_ratio=3.0, is_dark=is_dark)
    border_muted = ensure_contrast(blend_colors(bg, accent, 0.32), bg, min_ratio=1.7, is_dark=is_dark)
    r["border_focus"] = border_focus
    r["border_muted"] = border_muted

    # Sway tabbed chrome: Base16 BASE01 can be an expressive *accent* rather
    # than a quiet UI surface (Rebecca is saturated purple, Gold Rush gold).
    # Never use raw bg2/blue/accent as a tab's broad background or text. Keep
    # the theme's BASE00 hue and add only restrained neutral lightness, while
    # retaining its authored accent as the narrow focused-border indicator.
    neutral = "#ffffff" if is_dark else "#000000"
    tab_active_bg = blend_colors(bg, neutral, 0.12 if is_dark else 0.08)
    tab_inactive_bg = blend_colors(bg, neutral, 0.025 if is_dark else 0.015)
    r["tab_active_bg"] = tab_active_bg
    r["tab_inactive_bg"] = tab_inactive_bg
    # BASE05 is the palette's intended body text. Some imported BASE07/
    # base_30.white values are vivid syntax hues (e.g. Moonlight neon pink),
    # unsuitable for an entire tab title; do not inherit them as tab text.
    r["tab_active_fg"] = ensure_contrast(base05, tab_active_bg, min_ratio=4.5, is_dark=is_dark)
    # Inactive titles should be a subdued form of the same body text rather
    # than an unrelated imported grey_fg hue (some 'muted' aliases are gold,
    # magenta, or other syntax accents). Keep readable contrast on the dim tab.
    tab_inactive_seed = blend_colors(base05, bg, 0.28)
    r["tab_inactive_fg"] = ensure_contrast(tab_inactive_seed, tab_inactive_bg, min_ratio=4.5, is_dark=is_dark)
    r["tab_urgent_fg"] = ensure_contrast(true_red, tab_inactive_bg, min_ratio=4.5, is_dark=is_dark)

    r["semantic_background"] = bg
    r["semantic_foreground"] = smart_fg
    r["semantic_border"] = border_focus
    r["semantic_accent"] = accent
    r["semantic_error"] = true_red
    r["semantic_warning"] = true_yellow
    r["semantic_success"] = true_green
    r["semantic_info"] = true_cyan
    r["semantic_link"] = true_blue

    # Graph & meter color contrast enforcement (WCAG AA non-text standard is 3.0:1 against bg)
    safe_green  = ensure_contrast(true_green, bg, min_ratio=3.0, is_dark=is_dark)
    safe_yellow = ensure_contrast(true_yellow, bg, min_ratio=3.0, is_dark=is_dark)
    safe_orange = ensure_contrast(true_orange, bg, min_ratio=3.0, is_dark=is_dark)
    safe_red    = ensure_contrast(true_red, bg, min_ratio=3.0, is_dark=is_dark)
    safe_cyan   = ensure_contrast(true_cyan, bg, min_ratio=3.0, is_dark=is_dark)
    safe_blue   = ensure_contrast(true_blue, bg, min_ratio=3.0, is_dark=is_dark)
    safe_purple = ensure_contrast(true_purple, bg, min_ratio=3.0, is_dark=is_dark)
    safe_teal   = ensure_contrast(true_teal, bg, min_ratio=3.0, is_dark=is_dark)
    safe_pink   = ensure_contrast(true_pink, bg, min_ratio=3.0, is_dark=is_dark)

    # Meter background (battery meter, percentage bar empty backgrounds):
    meter_bg = b30.get("one_bg2") or b30.get("one_bg") or sel
    div_line = b30.get("one_bg2") or b30.get("line") or sel
    if is_dark:
        if relative_luminance(meter_bg) > 0.25:
            meter_bg = sel
        if relative_luminance(div_line) > 0.25:
            div_line = blend_colors(bg, accent, 0.15)
    else:
        if relative_luminance(meter_bg) < 0.35:
            meter_bg = sel
        if relative_luminance(div_line) < 0.35:
            div_line = blend_colors(bg, "#000000", 0.10)
    r["meter_bg"] = meter_bg
    r["div_line"] = div_line


    # Per-app upstream profiles: exact author intent wins for that application
    # when the Omarchy repository shipped a dedicated theme file. Only parsed
    # colors are consumed; fonts, geometry, keybindings and commands stay local.
    apps = theme_data.get("apps") if isinstance(theme_data.get("apps"), dict) else {}

    alacritty_profile = apps.get("alacritty") if isinstance(apps.get("alacritty"), dict) else {}
    alacritty_colors = alacritty_profile.get("colors") if isinstance(alacritty_profile.get("colors"), dict) else {}
    r["alacritty_bg"] = alacritty_colors.get("background") or bg
    r["alacritty_fg"] = alacritty_colors.get("foreground") or smart_fg
    r["alacritty_cursor"] = alacritty_colors.get("cursor") or accent
    r["alacritty_cursor_text"] = alacritty_colors.get("cursor_text") or r["alacritty_bg"]
    r["alacritty_selection_bg"] = alacritty_colors.get("selection_background") or alacritty_colors.get("selection") or sel
    r["alacritty_selection_fg"] = alacritty_colors.get("selection_foreground") or bright_fg
    alacritty_fallbacks = [
        bg, true_red, true_green, true_yellow, true_blue, true_purple, true_cyan, smart_fg,
        muted, true_red, true_green, true_yellow, true_blue, true_purple, true_cyan, bright_fg,
    ]
    for index, fallback in enumerate(alacritty_fallbacks):
        value = alacritty_colors.get(f"color{index}") or fallback
        r[f"alacritty_color{index}"] = clean_hex(value)

    kitty_profile = apps.get("kitty") if isinstance(apps.get("kitty"), dict) else {}
    kitty_colors = kitty_profile.get("colors") if isinstance(kitty_profile.get("colors"), dict) else {}
    kitty_theme = kitty_colors.get("theme") if isinstance(kitty_colors.get("theme"), dict) else {}
    def kitty_value(key, fallback):
        value = kitty_theme.get(key) or kitty_colors.get(key) or fallback
        return clean_hex(value) if isinstance(value, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", clean_hex(value)) else fallback
    r["kitty_background"] = kitty_value("background", bg)
    r["kitty_foreground"] = kitty_value("foreground", smart_fg)
    r["kitty_cursor"] = kitty_value("cursor", accent)
    r["kitty_cursor_text"] = kitty_value("cursor_text_color", bg)
    r["kitty_selection_bg"] = kitty_value("selection_background", sel)
    r["kitty_selection_fg"] = kitty_value("selection_foreground", bright_fg)
    r["kitty_url"] = kitty_value("url_color", true_cyan)
    r["kitty_active_border"] = kitty_value("active_border_color", accent)
    r["kitty_inactive_border"] = kitty_value("inactive_border_color", border_muted)
    r["kitty_bell_border"] = kitty_value("bell_border_color", true_red)
    r["kitty_active_tab_fg"] = kitty_value("active_tab_foreground", bg)
    r["kitty_active_tab_bg"] = kitty_value("active_tab_background", accent)
    r["kitty_inactive_tab_fg"] = kitty_value("inactive_tab_foreground", smart_fg)
    r["kitty_inactive_tab_bg"] = kitty_value("inactive_tab_background", bg2)
    r["kitty_tab_bar_bg"] = kitty_value("tab_bar_background", bg)
    r["kitty_mark1_fg"] = kitty_value("mark1_foreground", bg)
    r["kitty_mark1_bg"] = kitty_value("mark1_background", true_blue)
    r["kitty_mark2_fg"] = kitty_value("mark2_foreground", bg)
    r["kitty_mark2_bg"] = kitty_value("mark2_background", true_yellow)
    r["kitty_mark3_fg"] = kitty_value("mark3_foreground", bg)
    r["kitty_mark3_bg"] = kitty_value("mark3_background", true_cyan)
    for index, fallback in enumerate(alacritty_fallbacks):
        r[f"kitty_color{index}"] = kitty_value(f"color{index}", fallback)

    # Foot is this workstation's primary terminal. Omarchy repositories often
    # ship Alacritty and/or Kitty palettes instead of a Foot theme, so translate
    # those authored terminal colors into Foot without importing terminal
    # behavior. Alacritty is the primary source when both exist; Kitty fills
    # fields Alacritty does not define, then the normalized palette is fallback.
    def authored_hex(value):
        if not isinstance(value, str):
            return None
        cleaned = clean_hex(value)
        return cleaned if re.fullmatch(r"#[0-9a-fA-F]{6}", cleaned) else None

    def foot_pick(alacritty_key, kitty_key, fallback):
        return (
            authored_hex(alacritty_colors.get(alacritty_key))
            or authored_hex(kitty_theme.get(kitty_key))
            or authored_hex(kitty_colors.get(kitty_key))
            or fallback
        )

    if alacritty_colors:
        r["foot_profile_source"] = "alacritty"
    elif kitty_theme or kitty_colors:
        r["foot_profile_source"] = "kitty"
    else:
        r["foot_profile_source"] = "generated"

    r["foot_bg"] = foot_pick("background", "background", bg)
    r["foot_fg"] = foot_pick("foreground", "foreground", smart_fg)
    r["foot_cursor"] = foot_pick("cursor", "cursor", accent)
    r["foot_cursor_text"] = foot_pick("cursor_text", "cursor_text_color", r["foot_bg"])
    r["foot_selection_bg"] = (
        authored_hex(alacritty_colors.get("selection_background"))
        or authored_hex(alacritty_colors.get("selection"))
        or authored_hex(kitty_theme.get("selection_background"))
        or authored_hex(kitty_colors.get("selection_background"))
        or authored_hex(kitty_colors.get("selection"))
        or sel
    )
    r["foot_selection_fg"] = (
        authored_hex(alacritty_colors.get("selection_foreground"))
        or authored_hex(kitty_theme.get("selection_foreground"))
        or authored_hex(kitty_colors.get("selection_foreground"))
        or bright_fg
    )
    # Alacritty has no URL color role; use Kitty's authored URL color when the
    # repository provides one, otherwise retain the normalized theme accent.
    r["foot_url"] = (
        authored_hex(kitty_theme.get("url_color"))
        or authored_hex(kitty_colors.get("url_color"))
        or accent
    )
    for index, fallback in enumerate(alacritty_fallbacks):
        r[f"foot_color{index}"] = (
            authored_hex(alacritty_colors.get(f"color{index}"))
            or authored_hex(kitty_theme.get(f"color{index}"))
            or authored_hex(kitty_colors.get(f"color{index}"))
            or fallback
        )

    # Distinct box outline colors:
    r["btop_cpu_box"]  = accent
    r["btop_mem_box"]  = safe_cyan
    r["btop_net_box"]  = safe_purple
    r["btop_proc_box"] = safe_blue

    # Distinct graph tokens:
    r["btop_cpu_start"] = safe_blue
    r["btop_cpu_mid"]   = safe_yellow
    r["btop_cpu_end"]   = safe_red

    r["btop_temp_start"] = safe_teal
    r["btop_temp_mid"]   = safe_orange
    r["btop_temp_end"]   = safe_red

    r["btop_used_start"] = safe_green
    r["btop_used_mid"]   = safe_yellow
    r["btop_used_end"]   = safe_red

    r["btop_free_start"] = safe_blue
    r["btop_free_mid"]   = safe_teal
    r["btop_free_end"]   = safe_green

    r["btop_cached_start"] = safe_purple
    r["btop_cached_mid"]   = safe_pink
    r["btop_cached_end"]   = safe_cyan

    r["btop_avail_start"] = safe_cyan
    r["btop_avail_mid"]   = safe_teal
    r["btop_avail_end"]   = safe_green

    # Download graph: cool incoming tones (blue -> cyan -> teal)
    r["btop_download_start"] = safe_blue
    r["btop_download_mid"]   = safe_cyan
    r["btop_download_end"]   = safe_teal

    # Upload graph: warm outgoing tones (pink -> purple -> orange)
    r["btop_upload_start"] = safe_pink
    r["btop_upload_mid"]   = safe_purple
    r["btop_upload_end"]   = safe_orange

    # Process box usage gradient
    r["btop_process_start"] = safe_blue
    r["btop_process_mid"]   = safe_yellow
    r["btop_process_end"]   = safe_red

    btop_profile = apps.get("btop") if isinstance(apps.get("btop"), dict) else {}
    btop_colors = btop_profile.get("colors") if isinstance(btop_profile.get("colors"), dict) else {}
    authored_btop = btop_colors.get("theme") if isinstance(btop_colors.get("theme"), dict) else {}
    btop_token_map = {
        "main_fg": "btop_main_fg", "title": "btop_title", "hi_fg": "btop_hi_fg",
        "selected_bg": "btop_selected_bg", "selected_fg": "btop_selected_fg",
        "inactive_fg": "btop_inactive_fg", "graph_text": "btop_graph_text",
        "meter_bg": "meter_bg", "proc_misc": "btop_proc_misc",
        "cpu_box": "btop_cpu_box", "mem_box": "btop_mem_box", "net_box": "btop_net_box",
        "proc_box": "btop_proc_box", "div_line": "div_line",
        "temp_start": "btop_temp_start", "temp_mid": "btop_temp_mid", "temp_end": "btop_temp_end",
        "cpu_start": "btop_cpu_start", "cpu_mid": "btop_cpu_mid", "cpu_end": "btop_cpu_end",
        "free_start": "btop_free_start", "free_mid": "btop_free_mid", "free_end": "btop_free_end",
        "cached_start": "btop_cached_start", "cached_mid": "btop_cached_mid", "cached_end": "btop_cached_end",
        "available_start": "btop_avail_start", "available_mid": "btop_avail_mid", "available_end": "btop_avail_end",
        "used_start": "btop_used_start", "used_mid": "btop_used_mid", "used_end": "btop_used_end",
        "download_start": "btop_download_start", "download_mid": "btop_download_mid", "download_end": "btop_download_end",
        "upload_start": "btop_upload_start", "upload_mid": "btop_upload_mid", "upload_end": "btop_upload_end",
        "process_start": "btop_process_start", "process_mid": "btop_process_mid", "process_end": "btop_process_end",
    }
    btop_defaults = {
        "btop_main_fg": smart_fg, "btop_title": smart_fg, "btop_hi_fg": accent,
        "btop_selected_bg": sel, "btop_selected_fg": bright_fg, "btop_inactive_fg": muted,
        "btop_graph_text": muted, "btop_proc_misc": accent,
    }
    for token, fallback in btop_defaults.items():
        r[token] = fallback
    for source_key, token in btop_token_map.items():
        value = authored_btop.get(source_key)
        if isinstance(value, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", clean_hex(value)):
            r[token] = clean_hex(value)

    # Preserve the local btop canvas invariant regardless of upstream main_bg:
    # terminal default background avoids the cached stale-background artifact.
    r["btop_main_bg"] = ""

    # Add Cava visualizer tokens. Preserve an authored upstream Cava theme when
    # available; otherwise keep the existing single-accent fallback.
    accent = r.get("accent", "#58a6ff")
    cava = apps.get("cava") if isinstance(apps.get("cava"), dict) else (theme_data.get("cava", {}) or {})
    cava_bg = cava.get("background") or "default"
    cava_fg = cava.get("foreground") or ((cava.get("colors") or [accent])[0]) or accent
    gradient = 1 if int(cava.get("gradient") or 0) else 0
    colors = [clean_hex(str(value)) for value in (cava.get("colors") or []) if re.fullmatch(r"#[0-9a-fA-F]{6}", clean_hex(str(value)))]
    count = min(len(colors), max(0, int(cava.get("gradient_count") or len(colors)))) if gradient else 0
    lines = []
    if gradient:
        for index, color in enumerate(colors[:count], 1):
            lines.append(f"gradient_color_{index} = '{color}'")
    r["cava_bg"] = cava_bg if cava_bg == "default" else clean_hex(cava_bg)
    r["cava_fg"] = clean_hex(cava_fg)
    r["cava_gradient"] = str(gradient)
    r["cava_gradient_count"] = str(count)
    r["cava_gradient_count_line"] = f"gradient_count = {count}" if gradient else ""
    r["cava_gradient_lines"] = "\n".join(lines)


    mako_profile = apps.get("mako") if isinstance(apps.get("mako"), dict) else {}
    r["mako_bg"] = mako_profile.get("background_color") or bg
    r["mako_fg"] = mako_profile.get("text_color") or smart_fg
    r["mako_border"] = mako_profile.get("border_color") or accent

    # Add _x no-hash variants
    keys_snapshot = list(r.keys())
    for k in keys_snapshot:
        v = str(r[k])
        if v.startswith("#") and len(v) == 7:
            r[f"{k}_x"] = v[1:]

    return r, theme_type

def validate_normalized_palette(r):
    """Return semantic preflight failures for one normalized theme palette."""
    failures = []
    required_hex = [
        "bg", "bg2", "sel", "muted", "fg", "bright_fg", "accent",
        "red", "orange", "yellow", "green", "cyan", "blue",
        "purple", "pink", "teal", "border_focus", "border_muted",
    ]
    for key in required_hex:
        value = r.get(key)
        if not isinstance(value, str) or not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
            failures.append(f"{key}: invalid color {value!r}")

    bg = r.get("bg", "#000000")
    floors = {
        "fg": 4.5,
        "white": 4.5,
        "base04": 3.0,
        "base06": 4.5,
        "muted": 3.0,
        "red": 3.0,
        "orange": 3.0,
        "yellow": 3.0,
        "sun": 3.0,
        "green": 3.0,
        "vibrant_green": 3.0,
        "cyan": 3.0,
        "teal": 3.0,
        "blue": 3.0,
        "nord_blue": 3.0,
        "purple": 3.0,
        "dark_purple": 3.0,
        "pink": 3.0,
        "baby_pink": 3.0,
        "border_focus": 3.0,
        "border_muted": 1.7,
    }
    for key, floor in floors.items():
        if key in r and contrast_ratio(r[key], bg) + 1e-9 < floor:
            failures.append(
                f"{key}: contrast {contrast_ratio(r[key], bg):.3f}:1 < {floor:.1f}:1"
            )

    accent_fg = r.get("accent_fg")
    accent = r.get("accent")
    if accent_fg and accent and contrast_ratio(accent_fg, accent) < 3.0:
        failures.append(
            f"accent_fg: contrast {contrast_ratio(accent_fg, accent):.3f}:1 < 3.0:1"
        )
    return failures


def resolve_theme_data(name):
    path = os.path.join(CACHE_DIR, f"{name}.json")
    resolved_name = name
    if not os.path.exists(path):
        candidate = os.path.join(CACHE_DIR, f"omarchy-{name}.json")
        if not os.path.exists(candidate):
            raise FileNotFoundError(f"Theme '{name}' not found in cache. Run 'theme-sync' first.")
        path = candidate
        resolved_name = f"omarchy-{name}"
    with open(path, "r", encoding="utf-8") as handle:
        data = json.load(handle)
    return resolved_name, merge_upstream_apps_overlay(resolved_name, data)


def check_theme(name, quiet=False):
    """Compile/validate a theme in memory without changing live state."""
    try:
        resolved_name, theme_data = resolve_theme_data(name)
        r, _theme_type = normalize_palette(theme_data, resolved_name)
    except Exception as exc:
        if not quiet:
            print(f"FAIL {name}: {exc}", file=sys.stderr)
        return False

    failures = validate_normalized_palette(r)
    pattern = re.compile(r"\{\{([a-zA-Z0-9_]+)\}\}")
    for template_path in glob.glob(os.path.join(TEMPLATES_DIR, "*")):
        if os.path.isdir(template_path):
            continue
        try:
            with open(template_path, "r", encoding="utf-8") as handle:
                source = handle.read()
            rendered = pattern.sub(lambda m: str(r.get(m.group(1), m.group(0))), source)
        except Exception as exc:
            failures.append(f"{os.path.basename(template_path)}: {exc}")
            continue
        unresolved = sorted(set(pattern.findall(rendered)))
        if unresolved:
            failures.append(
                f"{os.path.basename(template_path)}: unresolved tokens {', '.join(unresolved)}"
            )
        if not rendered.strip():
            failures.append(f"{os.path.basename(template_path)}: rendered output is empty")

    if failures:
        if not quiet:
            for failure in failures:
                print(f"FAIL {resolved_name}: {failure}", file=sys.stderr)
        return False
    if not quiet:
        print(f"PASS {resolved_name}")
    return True


def update_cava_config(cava_config_path, rendered_color_section):
    """Preserves all sections and non-color settings, replacing only [color]."""
    if not os.path.exists(cava_config_path):
        return
    try:
        with open(cava_config_path, "r", encoding="utf-8") as f:
            content = f.read()

        # Matches [color] up to the next [section] or EOF
        pattern = re.compile(r"^\[color\].*?(?=(?:^\[[a-zA-Z0-9_-]+\]|\Z))", re.MULTILINE | re.DOTALL)
        if pattern.search(content):
            new_content = pattern.sub(rendered_color_section.strip() + "\n\n", content)
        else:
            new_content = content.rstrip() + "\n\n" + rendered_color_section.strip() + "\n"

        write_atomic(cava_config_path, new_content)
    except Exception as e:
        print(f"[WARN] Error updating Cava config: {e}", file=sys.stderr)

def hex_to_rgb1000(h):
    """Convert a hex color to neo's 0-1000 RGB triple."""
    r, g, b = hex_to_rgb(h)
    return (
        int(round(r * 1000 / 255)),
        int(round(g * 1000 / 255)),
        int(round(b * 1000 / 255)),
    )

def generate_neo_colors(r):
    """Truecolor palette for cmatrix-neo, derived from the active theme."""
    bg = r.get("black") or r["bg"]
    rain = r.get("green") or r["accent"]
    head = r.get("bright_fg") or r["fg"]
    shades = [
        blend_colors(bg, rain, 0.30),
        blend_colors(bg, rain, 0.50),
        blend_colors(bg, rain, 0.70),
        rain,
        blend_colors(rain, head, 0.50),
        head,
    ]
    lines = [
        "neo_color_version 1",
        f"# Auto-generated by theme-set from {r['name']}",
        "0,%d,%d,%d" % hex_to_rgb1000(bg),
    ]
    for shade in shades:
        lines.append("0,%d,%d,%d" % hex_to_rgb1000(shade))
    return "\n".join(lines) + "\n"

def apply_theme(name, no_nvim=False):
    try:
        name, theme_data = resolve_theme_data(name)
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1

    r, theme_type = normalize_palette(theme_data, name)
    palette_failures = validate_normalized_palette(r)
    if palette_failures:
        for failure in palette_failures:
            print(f"Validation failed: {failure}", file=sys.stderr)
        return 1
    current_type = get_current_theme_type()

    # -------------------------------------------------------------
    # PHASE 2: STAGED COMPILATION IN .next/
    # -------------------------------------------------------------
    next_dir = os.path.join(STATE_DIR, ".next")
    os.makedirs(next_dir, exist_ok=True)

    staged_files = {}

    # 1. Render all templates
    tmpl_files = glob.glob(os.path.join(TEMPLATES_DIR, "*"))
    pattern = re.compile(r"\{\{([a-zA-Z0-9_]+)\}\}")
    for tf in tmpl_files:
        if os.path.isdir(tf):
            continue
        fname = os.path.basename(tf)
        try:
            with open(tf, "r", encoding="utf-8") as f:
                template_text = f.read()
            rendered = pattern.sub(lambda m: str(r.get(m.group(1), m.group(0))), template_text)
            rendered = preserve_scale_managed_chrome(
                fname,
                rendered,
                os.path.join(STATE_DIR, fname),
            )
            unresolved = sorted(set(pattern.findall(rendered)))
            if unresolved:
                print(
                    f"Validation failed: {fname} has unresolved tokens: {', '.join(unresolved)}",
                    file=sys.stderr,
                )
                return 1
            staged_path = os.path.join(next_dir, fname)
            write_stage(staged_path, rendered)
            staged_files[staged_path] = os.path.join(STATE_DIR, fname)

            if fname == "zed-theme.json":
                zed_dest = os.path.expanduser("~/.config/zed/themes/nvchad-system.json")
                os.makedirs(os.path.dirname(zed_dest), exist_ok=True)
                staged_zed = os.path.join(next_dir, "nvchad-system.json")
                write_stage(staged_zed, rendered)
                staged_files[staged_zed] = zed_dest

            if fname == "cava.conf":
                cava_theme_dest = os.path.expanduser("~/.config/cava/themes/current")
                os.makedirs(os.path.dirname(cava_theme_dest), exist_ok=True)
                staged_cava = os.path.join(next_dir, "current.cava")
                write_stage(staged_cava, rendered)
                staged_files[staged_cava] = cava_theme_dest

            if fname == "kitty-colors.conf":
                kitty_dest = os.path.expanduser("~/.config/kitty/kitty-colors.conf")
                os.makedirs(os.path.dirname(kitty_dest), exist_ok=True)
                staged_kitty = os.path.join(next_dir, "kitty-colors.conf")
                write_stage(staged_kitty, rendered)
                staged_files[staged_kitty] = kitty_dest

            if fname == "foot-colors.ini":
                foot_dest = os.path.expanduser("~/.config/foot/foot-colors.ini")
                os.makedirs(os.path.dirname(foot_dest), exist_ok=True)
                staged_foot = os.path.join(next_dir, "foot-colors.ini")
                write_stage(staged_foot, rendered)
                staged_files[staged_foot] = foot_dest
        except Exception as e:
            print(f"Error compiling template {fname}: {e}", file=sys.stderr)
            return 1

    # 2. Stage Qt palettes
    qt_content = generate_qt_palette(r)
    staged_qt5 = os.path.join(next_dir, "qt5ct.conf")
    staged_qt6 = os.path.join(next_dir, "qt6ct.conf")
    write_stage(staged_qt5, qt_content)
    write_stage(staged_qt6, qt_content)
    staged_files[staged_qt5] = QT5_COLOR_FILE
    staged_files[staged_qt6] = QT6_COLOR_FILE

    # 3. Stage cmatrix-neo truecolor palette
    staged_neo = os.path.join(next_dir, "neo-colors")
    neo_dest = os.path.expanduser("~/.config/neo/colors")
    os.makedirs(os.path.dirname(neo_dest), exist_ok=True)
    write_stage(staged_neo, generate_neo_colors(r))
    staged_files[staged_neo] = neo_dest

    # 4. Stage state markers
    staged_name = os.path.join(next_dir, "name")
    staged_type = os.path.join(next_dir, "type")
    write_stage(staged_name, name + "\n")
    write_stage(staged_type, theme_type + "\n")

    # -------------------------------------------------------------
    # VALIDATION
    # -------------------------------------------------------------
    for staged_p in staged_files.keys():
        if not os.path.exists(staged_p) or os.path.getsize(staged_p) == 0:
            print(f"Validation failed: generated output {staged_p} is empty or missing", file=sys.stderr)
            return 1

    # -------------------------------------------------------------
    # CHANGE-AWARE TRANSACTIONAL PROMOTION
    # -------------------------------------------------------------
    # Avoid unnecessary inode churn and native file-watcher reloads when a
    # generated target is byte-identical. Before touching a changed target,
    # keep a private rollback copy in .next so a rare promotion failure cannot
    # leave a half-applied theme on disk.
    state_name = os.path.join(STATE_DIR, "name")
    state_type = os.path.join(STATE_DIR, "type")
    promotion_items = list(staged_files.items()) + [
        (staged_name, state_name),
        (staged_type, state_type),
    ]
    promotion_plan = []
    changed_targets = set()
    for index, (staged_p, target_p) in enumerate(promotion_items):
        if os.path.isfile(target_p) and filecmp.cmp(staged_p, target_p, shallow=False):
            os.remove(staged_p)
            continue
        backup = None
        if os.path.isfile(target_p):
            backup = os.path.join(next_dir, f".rollback-{index}")
            create_rollback_backup(target_p, backup)
        promotion_plan.append((staged_p, target_p, backup))

    promoted = []
    try:
        for staged_p, target_p, backup in promotion_plan:
            os.replace(staged_p, target_p)
            promoted.append((target_p, backup))
            changed_targets.add(target_p)
    except Exception as exc:
        print(f"Error promoting theme outputs: {exc}; rolling back", file=sys.stderr)
        for target_p, backup in reversed(promoted):
            try:
                if backup and os.path.exists(backup):
                    os.replace(backup, target_p)
                elif os.path.exists(target_p):
                    os.remove(target_p)
            except Exception as rollback_exc:
                print(f"[WARN] rollback failed for {target_p}: {rollback_exc}", file=sys.stderr)
        return 1
    finally:
        for _staged_p, _target_p, backup in promotion_plan:
            if backup and os.path.exists(backup):
                try:
                    os.remove(backup)
                except OSError:
                    pass

    # Clean up .next directory safely
    try:
        for f in os.listdir(next_dir):
            os.remove(os.path.join(next_dir, f))
    except Exception:
        pass

    # Update active Cava configuration file preserving all non-color user settings
    cava_cfg_path = os.path.expanduser("~/.config/cava/config")
    if os.path.exists(cava_cfg_path):
        rendered_cava_theme = os.path.join(STATE_DIR, "cava.conf")
        if os.path.exists(rendered_cava_theme):
            try:
                with open(rendered_cava_theme, "r", encoding="utf-8") as cf:
                    cava_color_block = cf.read()
                update_cava_config(cava_cfg_path, cava_color_block)
            except Exception as e:
                print(f"[WARN] Error updating Cava config: {e}", file=sys.stderr)

    # -------------------------------------------------------------
    # RUNTIME IPC / SIGNALS (Best-Effort, isolated)
    # -------------------------------------------------------------

    # Process discovery is needed only when generated app configs changed. A
    # same-theme no-op skips the /proc walk entirely. Neovim socket discovery
    # remains independent below so a stale editor cache can still self-repair.
    procs = (
        scan_running_processes({"sway", "btop", "dunst", "mako", "yazi", "cava", "kitty", "legendary-tui", "foot", "footclient", "thunar"})
        if changed_targets else
        {name: [] for name in {"sway", "btop", "dunst", "mako", "yazi", "cava", "kitty", "legendary-tui", "foot", "footclient", "thunar"}}
    )

    # Foot terminal: update palette before app-specific TUI redraws.
    # This reduces the dark/light mismatch during Neovim RPC refresh.
    # SIGUSR1/SIGUSR2 do NOT reload foot-colors.ini; they switch to the
    # [colors-dark]/[colors-light] palette cached by the long-lived Foot server.
    # Sending those signals after a theme change can therefore restore a stale
    # palette. New clients load the current generated palette via the footclient
    # wrapper; existing clients are updated directly through their PTYs here.
    # Only a `foot` process owns a terminal child; `footclient` does not.
    foot_pids = procs.get("foot", [])
    foot_theme_target = os.path.expanduser("~/.config/foot/foot-colors.ini")
    if foot_pids and foot_theme_target in changed_targets:
        broadcast_foot_palette(r, foot_pids)

    # Neovim RPC (system -> all live NvChad instances via their sockets).
    # A successful live reload also compiles Base46's disk cache, so avoid a
    # redundant headless compile. If no live socket succeeds, compile once
    # headlessly. Mark the cache current only after a verified compile.
    cache_theme_file = os.path.expanduser("~/.local/share/nvim/base46/current_theme")
    try:
        cache_theme_current = open(cache_theme_file, "r", encoding="utf-8").read().strip()
    except OSError:
        cache_theme_current = ""
    nvim_needs_refresh = bool(changed_targets) or cache_theme_current != name
    if not no_nvim and nvim_needs_refresh:
        runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        nvim_sockets = []
        for sock in glob.glob(os.path.join(runtime_dir, "nvim.*")):
            base = os.path.basename(sock)
            parts = base.split(".")
            if len(parts) >= 2 and parts[1].isdigit() and not os.path.exists(f"/proc/{parts[1]}"):
                continue
            nvim_sockets.append(sock)

        # With no live Neovim there is nothing visible to refresh. Leave the
        # Base46 marker stale intentionally; init.lua already recompiles on the
        # next Neovim startup when system theme != cached theme. This removes a
        # 50-120 ms headless editor startup from every ordinary theme switch.
        if nvim_sockets:
            live_success = False
            failed_sockets = []
            for sock in nvim_sockets:
                if reload_nvim_socket(sock, name, theme_type):
                    live_success = True
                else:
                    failed_sockets.append(sock)

            cache_ready = live_success or refresh_nvim_disk_cache(name, theme_type)

            # A successful socket has already produced a valid shared disk cache.
            # Retry any lagging socket once now that the cache is known-good.
            if cache_ready and failed_sockets:
                for sock in failed_sockets:
                    reload_nvim_socket(sock, name, theme_type, timeout=2.0)

            if cache_ready:
                try:
                    os.makedirs(os.path.dirname(cache_theme_file), exist_ok=True)
                    write_atomic(cache_theme_file, f"{name}\n")
                except Exception as exc:
                    print(f"[WARN] Neovim cache marker update failed: {exc}", file=sys.stderr)
            else:
                print(
                    "[WARN] Neovim theme cache was not refreshed; leaving its marker stale so startup will retry",
                    file=sys.stderr,
                )

    # Sway IPC: live client borders and swaybar colors (single batched command)
    sway_theme_target = os.path.join(STATE_DIR, "sway.conf")
    if procs["sway"] and sway_theme_target in changed_targets:
        sway_cmd = (
            f"client.focused {r['border_focus']} {r['tab_active_bg']} {r['tab_active_fg']} {r['border_focus']} {r['border_focus']}; "
            f"client.focused_inactive {r['border_muted']} {r['tab_inactive_bg']} {r['tab_inactive_fg']} {r['border_muted']} {r['border_muted']}; "
            f"client.unfocused {r['border_muted']} {r['tab_inactive_bg']} {r['tab_inactive_fg']} {r['border_muted']} {r['border_muted']}; "
            f"client.urgent {r['red']} {r['tab_inactive_bg']} {r['tab_urgent_fg']} {r['red']} {r['red']}; "
            f"bar bar-0 colors background {r['bg']}; "
            f"bar bar-0 colors statusline {r['fg']}; "
            f"bar bar-0 colors separator {r['muted']}; "
            f"bar bar-0 colors focused_workspace {r['border_focus']} {r['tab_active_bg']} {r['tab_active_fg']}; "
            f"bar bar-0 colors active_workspace {r['border_muted']} {r['tab_active_bg']} {r['tab_active_fg']}; "
            f"bar bar-0 colors inactive_workspace {r['tab_inactive_bg']} {r['bg']} {r['tab_inactive_fg']}; "
            f"bar bar-0 colors urgent_workspace {r['red']} {r['tab_inactive_bg']} {r['tab_urgent_fg']}"
        )
        # Cursor is strictly decoupled and managed independently via toggle-cursor-theme (Gruvbox only)

        run_ipc(["swaymsg", sway_cmd], "Sway theme IPC", timeout=0.75)

        # Persist client border colors so a fresh sway start keeps the theme
        # (picked up by the config.d glob include); regenerated on every theme-set.
        try:
            colors_conf = os.path.expanduser("~/.config/sway/config.d/80-theme-colors.conf")
            colors_content = (
                "# GENERATED by theme-set — do not edit manually.\n"
                "# Visibility-safe borders derived from the theme accent/background.\n"
                f"client.focused {r['border_focus']} {r['tab_active_bg']} {r['tab_active_fg']} {r['border_focus']} {r['border_focus']}\n"
                f"client.focused_inactive {r['border_muted']} {r['tab_inactive_bg']} {r['tab_inactive_fg']} {r['border_muted']} {r['border_muted']}\n"
                f"client.unfocused {r['border_muted']} {r['tab_inactive_bg']} {r['tab_inactive_fg']} {r['border_muted']} {r['border_muted']}\n"
                f"client.urgent {r['red']} {r['tab_inactive_bg']} {r['tab_urgent_fg']} {r['red']} {r['red']}\n"
            )
            write_atomic_if_changed(colors_conf, colors_content)
        except Exception as exc:
            print(f"[WARN] Sway theme state write failed: {exc}", file=sys.stderr)

    # Zed editor: touch settings.json to trigger instant inotify reload of active theme
    zed_settings = os.path.expanduser("~/.config/zed/settings.json")
    zed_theme_target = os.path.expanduser("~/.config/zed/themes/nvchad-system.json")
    if zed_theme_target in changed_targets and os.path.exists(zed_settings):
        try:
            os.utime(zed_settings, None)
        except Exception:
            pass

    # Alacritty watches its generated theme target. Touch only when that target
    # changed, avoiding a redundant reload on same-theme reapply.
    alacritty_cfg = os.path.expanduser("~/.config/alacritty/alacritty.toml")
    alacritty_theme_target = os.path.join(STATE_DIR, "alacritty.toml")
    if alacritty_theme_target in changed_targets and os.path.exists(alacritty_cfg):
        try:
            os.utime(alacritty_cfg, None)
        except Exception:
            pass

    # Kitty terminal: SIGUSR1 reloads configuration and color themes on the fly
    if os.path.join(STATE_DIR, "kitty-colors.conf") in changed_targets:
        for pid in procs["kitty"]:
            try:
                os.kill(pid, signal.SIGUSR1)
            except Exception:
                pass

    # btop: direct SIGUSR2 signal for instantaneous in-memory theme & config reload
    if os.path.join(STATE_DIR, "btop.theme") in changed_targets:
        for pid in procs["btop"]:
            try:
                os.kill(pid, signal.SIGUSR2)
            except Exception:
                pass

    # legendary-tui: direct SIGUSR2 signal for instantaneous in-memory theme reload
    if changed_targets:
        for pid in procs.get("legendary-tui", []):
            try:
                os.kill(pid, signal.SIGUSR2)
            except Exception:
                pass

    # Short-lived reload commands are synchronous so a newer theme can never
    # be overtaken by an older asynchronous IPC request.
    if procs["dunst"] and os.path.join(STATE_DIR, "dunst.conf") in changed_targets:
        spawn_reload(["dunstctl", "reload"], "Dunst reload")

    if procs["mako"] and os.path.join(STATE_DIR, "mako.conf") in changed_targets:
        spawn_reload(["makoctl", "reload"], "Mako reload")

    if procs["yazi"] and os.path.join(STATE_DIR, "yazi.toml") in changed_targets:
        spawn_reload(["ya", "emit-to", "0", "app:theme"], "Yazi theme DDS")

    # GTK cache work is only needed when GTK colors or polarity actually changed.
    # Same-theme no-op reapplies must not spawn D-Bus writes or a Thunar process.
    gtk_theme_target = os.path.join(STATE_DIR, "gtk.css")
    gtk_colors_changed = gtk_theme_target in changed_targets
    if theme_type != current_type:
        pref = "prefer-dark" if theme_type == "dark" else "prefer-light"
        run_ipc(
            ["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", pref],
            "GTK color-scheme update",
            timeout=0.75,
        )
    if gtk_colors_changed:
        gtk_theme = "adw-gtk3-dark" if theme_type == "dark" else "adw-gtk3"
        alt_theme = "adw-gtk3" if theme_type == "dark" else "adw-gtk3-dark"
        # Momentarily toggle gtk-theme so GTK3/GTK4 runtime engines flush style
        # caches and re-parse the generated CSS. This stays ordered for real
        # changes, but disappears entirely from no-op applications.
        run_ipc(
            ["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", alt_theme],
            "GTK theme toggle step 1",
            timeout=0.5,
        )
        run_ipc(
            ["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", gtk_theme],
            "GTK theme toggle step 2",
            timeout=0.5,
        )
        # Do not spawn Thunar just to ask it to quit. Refresh only an existing
        # daemon/window so its next view sees the new CSS/icon cache.
        if procs.get("thunar"):
            run_ipc(["thunar", "--quit"], "Thunar daemon refresh", timeout=0.5)


    # Cava: reload colors only via SIGUSR2 (instantaneous, 0 audio drop)
    if os.path.join(STATE_DIR, "cava.conf") in changed_targets:
        for pid in procs.get("cava", []):
            try:
                os.kill(pid, signal.SIGUSR2)
            except Exception:
                pass

    # Legacy Omarchy imports may predate structured upstream app profiles.
    # Hydrate those small text profiles off the critical path; when the active
    # theme still matches, the helper re-enters this same serialized apply path.
    if upstream_apps_need_hydration(name, theme_data):
        spawn_upstream_apps_hydration(name)

    # 8. Wallpaper application is ordered with the rest of the switch so rapid
    # theme changes cannot leave the previous wallpaper behind. Theme switching
    # normally uses local state. A palette may use only its own authoritative
    # Omarchy repository, an exact/alias donor, or an artistic/technical semantic
    # Omarchy donor. Solid color remains the final fallback; generic images are forbidden.
    wallpaper = theme_data.get("assets", {}).get("wallpaper") or theme_data.get("wallpaper")
    if not wallpaper:
        wallpaper = cached_theme_wallpaper(name, theme_data)

    # Missing or legacy repository caches must never stall the palette
    # transaction. Queue one detached hydration/discovery job even when an old
    # cached wallpaper is already usable; it self-heals retired five-item
    # manifests in the background. The worker downloads outside the theme lock
    # and applies only if this theme is still active.
    wallpaper_source = resolve_omarchy_wallpaper_source(name, theme_data)
    if wallpaper_source and wallpaper_cache_needs_hydration(name, theme_data):
        spawn_wallpaper_hydration(name)

    if wallpaper:
        wp_path = os.path.expanduser(wallpaper)
        desired_wallpaper = os.path.realpath(wp_path)
        try:
            current_wallpaper = open(CURRENT_WALLPAPER_FILE, "r", encoding="utf-8").read().strip()
            current_wallpaper = os.path.realpath(current_wallpaper) if current_wallpaper else ""
        except OSError:
            current_wallpaper = ""
        if os.path.isfile(wp_path) and current_wallpaper != desired_wallpaper and run_ipc(
            ["swaymsg", f"output * bg '{wp_path}' fill"],
            "Sway wallpaper update",
            timeout=0.75,
        ):
            # Keep session restore and per-theme selection state synchronized
            # with the actually applied image (including after a library remap).
            write_atomic_if_changed(CURRENT_WALLPAPER_FILE, desired_wallpaper + "\n")
            os.makedirs(WALLPAPER_STATE_DIR, exist_ok=True)
            write_atomic_if_changed(
                os.path.join(WALLPAPER_STATE_DIR, name),
                os.path.basename(wp_path) + "\n",
            )
    else:
        # Never leak the previous theme's unrelated wallpaper while a missing
        # repository hydrates (or when no donor exists). Use the theme background
        # immediately; a queued worker may replace it later only if this theme is still active.
        solid = r.get("bg", "#000000")
        if run_ipc(
            ["swaymsg", f"output * bg '{solid}' solid_color"],
            "Sway theme background fallback",
            timeout=0.75,
        ):
            try:
                os.unlink(CURRENT_WALLPAPER_FILE)
            except FileNotFoundError:
                pass

    # 9. Hooks are failure-isolated but ordered. They are intentionally short
    # lived and cached; waiting prevents an older hook from winning a later switch.
    if changed_targets and os.path.exists(HOOKS_DIR):
        for h in sorted(os.listdir(HOOKS_DIR)):
            hp = os.path.join(HOOKS_DIR, h)
            if not (os.path.isfile(hp) and os.access(hp, os.X_OK)):
                continue
            if h == "20-thunar-folder-color.py":
                # Recoloring thousands of icon SVGs is maintenance, not a visible
                # theme-switch dependency. The hook has its own lock + active-theme
                # guard, so it can converge safely after the core switch returns.
                spawn_reload([hp, name, theme_type], "Thunar folder icon refresh")
                continue
            if hp.endswith(".py"):
                # Other small Python hooks execute in-process to avoid another interpreter.
                try:
                    import importlib.util
                    spec = importlib.util.spec_from_file_location(
                        f"theme_hook_{os.getpid()}_{h.replace('.', '_').replace('-', '_')}", hp
                    )
                    module = importlib.util.module_from_spec(spec)
                    spec.loader.exec_module(module)
                    hook_main = getattr(module, "main", None)
                    if callable(hook_main):
                        rc = hook_main()
                        if rc not in (None, 0):
                            print(f"[WARN] theme hook {h}: exit status {rc}", file=sys.stderr)
                except Exception as exc:
                    print(f"[WARN] theme hook {h} failed: {exc}", file=sys.stderr)
            else:
                run_ipc([hp, name, theme_type], f"theme hook {h}", timeout=1.5)

    return 0

def main():
    args = sys.argv[1:]
    if not args:
        print("Usage: theme-set <name> [--no-nvim] | --check <name> | --check-all | --list | --current | --info <name> | --next | --prev")
        return 1

    no_nvim = "--no-nvim" in args
    filtered_args = [a for a in args if a != "--no-nvim"]

    if not filtered_args:
        print("Usage: theme-set <name> [--no-nvim] | --check <name> | --check-all | --list | --current | --info <name> | --next | --prev")
        return 1

    cmd = filtered_args[0]
    all_themes = None
    if cmd in {"--check-all", "--list", "--next", "--prev"}:
        all_themes = get_available_themes()

    if cmd in {"-h", "--help", "help"}:
        print("Usage: theme-set <name> [--no-nvim] | --check <name> | --check-all | --list | --current | --info <name> | --next | --prev")
        return 0

    if cmd == "--check" and len(filtered_args) > 1:
        return 0 if check_theme(filtered_args[1]) else 1

    if cmd == "--check-all":
        all_themes = all_themes or []
        failures = [name for name in all_themes if not check_theme(name, quiet=True)]
        if failures:
            for name in failures:
                check_theme(name, quiet=False)
            print(f"FAIL {len(failures)}/{len(all_themes)} themes", file=sys.stderr)
            return 1
        print(f"PASS {len(all_themes)} themes")
        return 0

    if cmd in ("--info", "-i") and len(filtered_args) > 1:
        target_name = filtered_args[1]
        tf = os.path.join(CACHE_DIR, f"{target_name}.json")
        if not os.path.isfile(tf):
            cand = os.path.join(CACHE_DIR, f"omarchy-{target_name}.json")
            if os.path.isfile(cand):
                tf = cand
                target_name = f"omarchy-{target_name}"
            else:
                print(f"Error: Theme '{target_name}' not found in cache", file=sys.stderr)
                return 1
        with open(tf, "r", encoding="utf-8") as f:
            data = json.load(f)
        data = merge_upstream_apps_overlay(target_name, data)
        src = data.get("source", {})
        caps = data.get("capabilities", {})
        cr = data.get("derived", {}).get("contrast", {})
        print(f"Name:         {data.get('display_name', target_name)} ({target_name})")
        print(f"Type:         {data.get('type', 'dark')}")
        print(f"Accent:       {data.get('accent', 'N/A')}")
        print(f"Provider:     {src.get('provider', 'N/A')}")
        if src.get('repository'):
            print(f"Repository:   {src.get('repository')}")
        if src.get('author'):
            print(f"Author:       {src.get('author')}")
        if src.get('license'):
            print(f"License:      {src.get('license')}")
        if src.get('commit'):
            print(f"Commit:       {src.get('commit')}")
        cap_list = [k for k, v in caps.items() if v]
        print(f"Capabilities: {', '.join(cap_list) if cap_list else 'palette'}")

        assets = data.get("assets") or {}
        apps = data.get("apps") or {}
        embedded = assets.get("upstream_apps_version") == UPSTREAM_APPS_VERSION
        overlay_meta = data.get("upstream_apps_overlay") if isinstance(data.get("upstream_apps_overlay"), dict) else None
        profile_apps = []
        source_files = {}
        for app, profile in apps.items():
            if not isinstance(profile, dict):
                continue
            source_file = profile.get("source_file")
            if source_file:
                profile_apps.append(app)
                source_files[app] = source_file
        if embedded:
            profile_mode = "embedded"
            source_files.update(assets.get("upstream_app_files") or {})
        elif overlay_meta:
            profile_mode = "lazy-cache"
            source_files.update(overlay_meta.get("files") or {})
        else:
            profile_mode = "generated-fallback"
        if profile_apps:
            profile_apps = sorted(set(profile_apps))
            print(f"Upstream profiles: {profile_mode} ({', '.join(profile_apps)})")
            exact_runtime_supported = {"alacritty", "kitty", "btop", "cava", "mako"}
            runtime_exact = sorted(app for app in profile_apps if app in exact_runtime_supported)
            recorded_only = sorted(app for app in profile_apps if app not in exact_runtime_supported)
            if runtime_exact:
                print(f"Runtime exact:  {', '.join(runtime_exact)}")
            if recorded_only:
                print(f"Recorded only:  {', '.join(recorded_only)}")
            if isinstance(apps.get("alacritty"), dict):
                print("Foot port:      alacritty -> foot (Kitty fills missing roles)")
            elif isinstance(apps.get("kitty"), dict):
                print("Foot port:      kitty -> foot")
            else:
                print("Foot port:      generated palette fallback")
            file_summary = ", ".join(f"{app}={source_files[app]}" for app in sorted(source_files) if app in profile_apps)
            if file_summary:
                print(f"App sources:    {file_summary}")
        else:
            print(f"Upstream profiles: {profile_mode}")

        cava = apps.get("cava") if isinstance(apps.get("cava"), dict) else {}
        if cava.get("source") == "cava_theme":
            cava_label = f"authored ({cava.get('gradient_count', len(cava.get('colors') or []))} colors)"
        else:
            accent = data.get("accent", "N/A")
            cava_label = f"generated accent {accent}" if caps.get("cava") else "no"
        print(f"Cava:         {cava_label}")

        if cr:
            ratio = cr.get('ratio', 'N/A')
            aa = "Pass" if cr.get('wcag_aa') else "Fail"
            print(f"Contrast:     {ratio}:1 (WCAG AA: {aa})")
        return 0

    if cmd == "--list":
        for t in (all_themes or []):
            print(t)
        return 0

    if cmd == "--current":
        print(get_current_theme())
        return 0

    if cmd in ("--next", "--prev"):
        with theme_mutation_lock():
            # Resolve relative navigation while holding the same lock as the
            # mutation; two rapid --next calls therefore advance twice rather
            # than both selecting the same stale current theme.
            curr = get_current_theme()
            all_themes = all_themes or []
            if not all_themes:
                return 1
            idx = all_themes.index(curr) if curr in all_themes else 0
            new_idx = (idx + 1) % len(all_themes) if cmd == "--next" else (idx - 1) % len(all_themes)
            target = all_themes[new_idx]
            ret = apply_theme(target, no_nvim=no_nvim)
        if ret == 0:
            print(f"Switched theme to {target}")
        return ret

    with theme_mutation_lock():
        ret = apply_theme(cmd, no_nvim=no_nvim)
    if ret == 0:
        print(f"Applied theme: {cmd}")
    return ret

if __name__ == "__main__":
    sys.exit(main())
