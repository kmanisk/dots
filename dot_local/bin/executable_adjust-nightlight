#!/usr/bin/env bash
# ==============================================================================
# Adjust Night Light Color Temperature Up/Down (Flicker-Free)
# Range: 2000K (Warm Amber) - 6500K (Daylight Neutral)
# Unified with wl-gammarelay-rs
# ==============================================================================
export PATH="$HOME/.local/bin:$PATH"

DELTA="${1:-100}"
STATE_FILE="$HOME/.config/nightlight_state"
TEMP_FILE="$HOME/.config/nightlight_temp"

CURRENT_TEMP=4200
if [[ -f "$TEMP_FILE" ]]; then
    CURRENT_TEMP=$(cat "$TEMP_FILE" 2>/dev/null)
fi

NEW_TEMP=$(( CURRENT_TEMP + DELTA ))

# Clamp between 2000K and 6500K
if (( NEW_TEMP > 6500 )); then
    NEW_TEMP=6500
fi
if (( NEW_TEMP < 2000 )); then
    NEW_TEMP=2000
fi

echo "$NEW_TEMP" > "$TEMP_FILE"

# Calculate percentage (2000K = 0%, 6500K = 100%)
PERCENT=$(( (NEW_TEMP - 2000) * 100 / 4500 ))

if [ -n "$WAYLAND_DISPLAY" ] || [ -n "$SWAYSOCK" ]; then
    if ! systemctl --user is-active --quiet wl-gammarelay.service 2>/dev/null; then
        systemctl --user start wl-gammarelay.service 2>/dev/null || true
    fi
    busctl --user set-property rs.wl-gammarelay / rs.wl.gammarelay Temperature q "$NEW_TEMP" 2>/dev/null || true
else
    redshift -r -P -m randr -O "$NEW_TEMP" >/dev/null 2>&1
fi

if (( NEW_TEMP >= 6500 )); then
    echo "off" > "$STATE_FILE"
    MSG="Night Light: 6500K (Daylight)"
else
    echo "on" > "$STATE_FILE"
    MSG="Night Light: ${NEW_TEMP}K"
fi

# Fast dismiss: 800ms regular, 500ms in fullscreen
TIMEOUT=800
if command -v swaymsg >/dev/null 2>&1 && [ -n "${SWAYSOCK:-}" ]; then
    IS_FS=$(swaymsg -t get_tree 2>/dev/null | jq -r '.. | select(.focused? == true) | .fullscreen_mode' 2>/dev/null || echo 0)
    [ "$IS_FS" = "1" ] && TIMEOUT=500
elif command -v i3-msg >/dev/null 2>&1 && [ -n "${I3SOCK:-}" ]; then
    IS_FS=$(i3-msg -t get_tree 2>/dev/null | jq -r '.. | select(.focused? == true) | .fullscreen_mode' 2>/dev/null || echo 0)
    [ "$IS_FS" = "1" ] && TIMEOUT=500
fi

# Send synchronized OSD notification (supported by Mako and Dunst)
notify-send -a "Night Light" -t "$TIMEOUT" -u low -i preferences-desktop-display \
    -h string:x-canonical-private-synchronous:nightlight \
    -h string:x-dunst-stack-tag:nightlight \
    -h int:value:"$PERCENT" \
    "$MSG" 2>/dev/null || \
dunstify -a "Night Light" -t "$TIMEOUT" -u low -i preferences-desktop-display \
    -h string:x-dunst-stack-tag:nightlight \
    -h int:value:"$PERCENT" \
    "$MSG" 2>/dev/null
