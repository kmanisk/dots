#!/usr/bin/env bash
# darksouls3-run: Dark Souls III Launcher with MangoHud, LSFG-VK (2x frame gen),
# RTX 5050 Mobile dGPU offload, and automatic power & workspace orchestration.
set -e

# Steam AppID for Dark Souls III
export SteamAppId="374320"
export SteamGameId="374320"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="$HOME/.local/share/Steam"
export STEAM_COMPAT_DATA_PATH="$HOME/.local/share/Steam/steamapps/compatdata/374320"
mkdir -p "$STEAM_COMPAT_DATA_PATH"

# --- GPU mode-aware graphics environment (AGENTS.md Rule 2) ---
if [ -z "$GPU_MODE" ]; then
    if [ -r "${XDG_RUNTIME_DIR:-/run/user/$UID}/gpu_mode" ]; then
        read -r GPU_MODE < "${XDG_RUNTIME_DIR:-/run/user/$UID}/gpu_mode"
    else
        GPU_MODE="$(supergfxctl -g 2>/dev/null || true)"
    fi
fi

case "$GPU_MODE" in
    Hybrid)
        export __NV_PRIME_RENDER_OFFLOAD=1
        export __GLX_VENDOR_LIBRARY_NAME=nvidia
        export __VK_LAYER_NV_optimus=NVIDIA_only
        export LIBVA_DRIVER_NAME=iHD
        ;;
    AsusMuxDgpu)
        unset __NV_PRIME_RENDER_OFFLOAD
        unset __GLX_VENDOR_LIBRARY_NAME
        export __VK_LAYER_NV_optimus=NVIDIA_only
        export LIBVA_DRIVER_NAME=nvidia
        ;;
    *)
        export __NV_PRIME_RENDER_OFFLOAD=1
        export __GLX_VENDOR_LIBRARY_NAME=nvidia
        export __VK_LAYER_NV_optimus=NVIDIA_only
        ;;
esac

# DirectX 11 / DXVK optimizations for NVIDIA Blackwell
export DXVK_ASYNC=1
export DXVK_STATE_CACHE=1
export PROTON_ENABLE_NVAPI=0

# Load in-game mods: Souls3Mod FPS unlock (d3dcompiler_43 proxy) + ReShade (dxgi proxy + d3dcompiler_47)
export WINEDLLOVERRIDES="d3d11=n,b;dinput8=n,b;d3dcompiler_43=n,b;d3dcompiler_47=n;dxgi=n,b"

# MangoHud overlay: same minimal HUD as Elden Ring/global (starts hidden, Alt+3 toggles)
export MANGOHUD=1
export MANGOHUD_CONFIGFILE="/mnt/Games/NonSteamGames/Dark Souls III/MangoHud.conf"

# LSFG-VK 2.0: Enable profile unless explicit DISABLE_LSFGVK is set
if [ "${ENABLE_LSFG:-1}" = "1" ] && [ "${DISABLE_LSFGVK:-0}" != "1" ]; then
    export LSFGVK_PROFILE="Dark Souls III"
    unset DISABLE_LSFGVK
else
    export DISABLE_LSFGVK=1
    unset LSFGVK_PROFILE
fi

# Focus Workspace 4 automatically (Sway or i3 IPC)
notify-send -i input-gaming "Dark Souls III" "Launching Dark Souls III... (Workspace 4)" 2>/dev/null || true
if [ -n "$SWAYSOCK" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    swaymsg "workspace number 4" >/dev/null 2>&1 || true
else
    i3-msg "workspace 4" >/dev/null 2>&1 || true
fi

GAME_DIR="/mnt/Games/NonSteamGames/Dark Souls III"
GAME_EXE="$GAME_DIR/DarkSoulsIII.exe"

# If me3 mod framework is installed and randomizer profile exists, launch via me3 to inject map & enemy assets
if command -v me3 >/dev/null 2>&1 && [ -f "$HOME/.config/me3/profiles/darksouls3-default.me3" ] && [ -d "$GAME_DIR/randomizer" ]; then
    RUN_TARGET=(me3 launch -g darksouls3 -p darksouls3-default --skip-steam-init)
else
    # Fallback to direct Proton launch
    if [ -f "$HOME/.local/share/Steam/compatibilitytools.d/proton-cachyos-slr/proton" ]; then
        PROTON_BIN="$HOME/.local/share/Steam/compatibilitytools.d/proton-cachyos-slr/proton"
    elif [ -f "$HOME/.local/share/Steam/compatibilitytools.d/GE-Proton11-7-x86_64/proton" ]; then
        PROTON_BIN="$HOME/.local/share/Steam/compatibilitytools.d/GE-Proton11-7-x86_64/proton"
    else
        PROTON_BIN="$HOME/.local/share/Steam/steamapps/common/Proton - Experimental/proton"
    fi
    RUN_TARGET=("$PROTON_BIN" run "$GAME_EXE" "$@")
fi

cd "$GAME_DIR"

if [ -n "$SWAYSOCK" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    gamescope --mangoapp -W 1920 -H 1200 -w 1920 -h 1200 -f -r 165 -- "${RUN_TARGET[@]}"
else
    "${RUN_TARGET[@]}"
fi

STATUS=$?
exit "$STATUS"
