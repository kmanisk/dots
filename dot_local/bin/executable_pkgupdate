#!/usr/bin/env python3
"""pkgupdate - update packages that were installed by hand with pacman -U.

pacman -Syu only knows about repositories. Every package that arrived as a
.pkg.tar.zst (ArtCraft releases, vendor builds, one-off downloads) is invisible
to it. This finds those packages from /var/log/pacman.log, resolves each one's
upstream GitHub release, verifies the published SHA-256 and installs the newer
Arch package with pacman -U.

Packages built by an AUR helper (paru/yay/makepkg caches) are ignored: those
are handled by `paru -Sua`, not from upstream release assets.

Usage:
  pkgup                       check and install updates
  pkgup --check               only report, install nothing
  pkgup --list                show what was detected and how it maps upstream
  pkgup --dry-run             download and verify, then stop before pacman
  pkgup --force <pkg...>      reinstall even when already current
  pkgup <pkg...>              limit to named packages

Exit codes: 0 = nothing to do or all updates applied, 10 = update pending
(--check), 1 = a package failed.
"""

from __future__ import annotations

import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import hashlib

ARCH = "x86_64"
LOG = "/var/log/pacman.log"
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "pkgupdate")
TTL = 6 * 3600

# AUR helper and build caches: those packages are updated with paru -Sua.
BUILD_CACHE = ("/.cache/paru/", "/.cache/yay/", "/.cache/makepkg/", "/var/cache/pacman/pkg/")

# ArtCraft packages advertise getartcraft.com, not GitHub, so map them here.
ARTCRAFT = {}
for _name in (
    "photocraft vectorcraft filmcraft lightcraft pdfcraft effectcraft designcraft "
    "wordcraft figcraft soundcraft deckcraft cadcraft gridcraft"
).split():
    ARTCRAFT[_name] = f"storytold/{_name}"
    ARTCRAFT[f"ai.storyteller.{_name}"] = f"storytold/{_name}"

CHECKSUM_NAMES = ("sha256sums.txt", "sha256sums", "sha256sum.txt", "checksums.txt", "sha256.txt")


def out(msg: str = "") -> None:
    print(msg, flush=True)


def warn(msg: str) -> None:
    print(msg, file=sys.stderr, flush=True)


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


# ---------------------------------------------------------------- discovery
def installed_version(name: str) -> str | None:
    p = run(["pacman", "-Q", name])
    if p.returncode != 0:
        return None
    m = re.match(r"\S+\s+(\S+?)-[0-9]+$", p.stdout.strip())
    return m.group(1) if m else p.stdout.strip().split()[1]


def package_url(name: str) -> str:
    p = run(["pacman", "-Qi", name])
    for line in p.stdout.splitlines():
        if line.startswith("URL"):
            return line.split(":", 1)[1].strip()
    return ""


def scan_log() -> dict[str, dict]:
    """Map package name -> {version, file} for manual pacman -U installs."""
    try:
        lines = open(LOG, errors="replace").read().splitlines()
    except OSError as exc:
        warn(f"pkgupdate: cannot read {LOG}: {exc}")
        return {}

    blocks, current = [], None
    for line in lines:
        if "[PACMAN] Running '" in line:
            if current:
                blocks.append(current)
            current = {"cmd": line, "touched": []}
            continue
        if current is None:
            continue
        m = re.search(r"\[ALPM\] (?:installed|upgraded|downgraded|reinstalled) ([^ ]+) \(([^)]+)\)", line)
        if m:
            current["touched"].append((m.group(1), m.group(2)))
    if current:
        blocks.append(current)

    found: dict[str, dict] = {}
    for block in blocks:
        m = re.search(r"pacman -U ([^']*)'", block["cmd"])
        if not m:
            continue
        try:
            args = shlex.split(m.group(1))
        except ValueError:
            continue
        files = [a for a in args if not a.startswith("-")]
        manual = [f for f in files if not any(c in f for c in BUILD_CACHE)]
        if not manual:
            continue
        for name, version in block["touched"]:
            match = [f for f in manual if os.path.basename(f).startswith(name + "-")]
            if match or len(manual) == 1:
                source = match[0] if match else manual[0]
                found[name] = {"version": version, "file": source}
    return found


def foreign_set() -> set[str]:
    return {
        line.split()[0]
        for line in run(["pacman", "-Qm"]).stdout.splitlines()
        if line.strip()
    }


def candidates() -> dict[str, dict]:
    found = scan_log()
    foreign = foreign_set()
    live = {}
    for name, info in found.items():
        if name not in foreign:
            continue  # now provided by a repo, so pacman -Syu owns it
        version = installed_version(name)
        if version is None:
            continue
        live[name] = {"version": version, "file": info["file"]}
    return live


def github_repo(name: str) -> str | None:
    if name in ARTCRAFT:
        return ARTCRAFT[name]
    url = package_url(name)
    m = re.match(r"https?://(?:www\.)?github\.com/([^/\s]+)/([^/#?\s]+)", url)
    if not m:
        return None
    return f"{m.group(1)}/{m.group(2).removesuffix('.git')}"


# ------------------------------------------------------------------- github
def latest_release(repo: str) -> dict | None:
    os.makedirs(CACHE, exist_ok=True)
    path = os.path.join(CACHE, repo.replace("/", "_") + ".json")
    if os.path.exists(path) and time.time() - os.path.getmtime(path) < TTL:
        try:
            return json.load(open(path))
        except Exception:
            pass
    req = urllib.request.Request(
        f"https://api.github.com/repos/{repo}/releases/latest",
        headers={"User-Agent": "pkgupdate", "Accept": "application/vnd.github+json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = json.load(resp)
    except urllib.error.HTTPError as exc:
        if exc.code == 404:
            return {"tag_name": "", "assets": [], "_no_releases": True}
        return None
    except (urllib.error.URLError, TimeoutError, ValueError):
        return None
    with open(path, "w") as f:
        json.dump(data, f)
    return data


def pick_asset(release: dict, pkgname: str) -> dict | None:
    assets = [a for a in release.get("assets", []) if a.get("name", "").endswith(".pkg.tar.zst")]
    if not assets:
        return None
    native = [a for a in assets if ARCH in a["name"] or "-any." in a["name"]] or assets
    stem = re.sub(r"-(bin|git|appimage)$", "", pkgname).replace("-", "").lower()

    def score(asset: dict) -> tuple:
        name = asset["name"].replace("-", "").lower()
        return (0 if stem and stem in name else 1, len(asset["name"]))

    return sorted(native, key=score)[0]


def checksum_for(release: dict, asset_name: str) -> str | None:
    sums = None
    for a in release.get("assets", []):
        n = a["name"].lower()
        if n in CHECKSUM_NAMES or n.startswith("sha256sums") or n == asset_name.lower() + ".sha256":
            sums = a
            break
    if sums is None:
        return None
    try:
        with urllib.request.urlopen(sums["browser_download_url"], timeout=30) as resp:
            text = resp.read().decode("utf-8", "replace")
    except (urllib.error.URLError, TimeoutError):
        return None
    if sums["name"].lower() == asset_name.lower() + ".sha256":
        token = text.split()[0]
        return token if re.fullmatch(r"[0-9a-fA-F]{64}", token) else None
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[1].lstrip("*") == asset_name:
            if re.fullmatch(r"[0-9a-fA-F]{64}", parts[0]):
                return parts[0].lower()
    return None


def vercmp(a: str, b: str) -> int | None:
    p = run(["vercmp", a, b])
    if p.returncode != 0:
        return None
    try:
        return int(p.stdout.strip())
    except ValueError:
        return None


# ------------------------------------------------------------------ install
def download(url: str, dest: str) -> bool:
    req = urllib.request.Request(url, headers={"User-Agent": "pkgupdate"})
    try:
        with urllib.request.urlopen(req, timeout=600) as resp, open(dest, "wb") as f:
            while True:
                chunk = resp.read(1 << 20)
                if not chunk:
                    break
                f.write(chunk)
        return True
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        warn(f"  download failed: {exc}")
        return False


def sha256(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def update_one(name: str, info: dict, *, check: bool, dry: bool, force: bool) -> str:
    """Return one of: current, updated, available, skipped, failed."""
    installed = info["version"]
    repo = github_repo(name)
    if repo is None:
        out(f"{name} {installed}: no GitHub release feed (update manually)")
        return "skipped"

    release = latest_release(repo)
    if release is None:
        out(f"{name} {installed}: release lookup failed")
        return "skipped"
    if release.get("_no_releases"):
        out(f"{name} {installed}: {repo} publishes no GitHub releases")
        return "skipped"

    tag = str(release.get("tag_name", "")).lstrip("v")
    cmp = vercmp(tag, installed)
    if cmp is None:
        out(f"{name} {installed}: cannot compare with tag '{tag}'")
        return "skipped"

    if cmp <= 0 and not force:
        out(f"{name} {installed}: up to date")
        return "current"

    asset = pick_asset(release, name)
    if asset is None:
        out(f"{name} {installed}: release {tag} has no Arch .pkg.tar.zst")
        return "skipped"

    target = tag if cmp > 0 else installed
    expect = checksum_for(release, asset["name"])
    if expect is None:
        out(f"{name} {installed}: {target} available but no published SHA-256, skipping")
        out(f"  {asset['browser_download_url']}")
        return "skipped"

    if check:
        out(f"{name} {installed}: update available -> {target}")
        return "available"

    out(f"{name} {installed}: downloading {target} ({asset['name']})")
    with tempfile.TemporaryDirectory(prefix="pkgupdate.") as tmp:
        path = os.path.join(tmp, asset["name"])
        if not download(asset["browser_download_url"], path):
            return "failed"
        actual = sha256(path)
        if actual != expect:
            warn(f"  checksum mismatch for {asset['name']}, refusing to install")
            return "failed"
        out(f"  sha256 verified")
        if dry:
            out(f"  dry run: would install {asset['name']}")
            return "available"
        p = run(["sudo", "pacman", "-U", "--noconfirm", path])
        if p.returncode != 0:
            warn(p.stderr.strip() or p.stdout.strip())
            return "failed"

    new = installed_version(name)
    out(f"{name}: installed {new}")
    return "updated"


def main(argv: list[str]) -> int:
    check = "--check" in argv or "-n" in argv
    dry = "--dry-run" in argv
    force = "--force" in argv
    listing = "--list" in argv or "-l" in argv

    names = [a for a in argv if not a.startswith("-")]
    found = candidates()

    if names:
        foreign = foreign_set()
        for n in names:
            if n in found:
                continue
            version = installed_version(n)
            if version and n in foreign:
                found[n] = {"version": version, "file": ""}
                warn(f"pkgupdate: {n} not in pacman.log, using installed version {version}")
            else:
                warn(f"pkgupdate: {n} was not installed with pacman -U (or the log has rolled)")
        found = {n: found[n] for n in names if n in found}
        if not found:
            return 1

    if not found:
        out("No manually installed pacman -U packages found.")
        return 0

    if listing:
        out(f"{'PACKAGE':28} {'INSTALLED':16} UPSTREAM")
        for name, info in sorted(found.items()):
            out(f"{name:28} {info['version']:16} {github_repo(name) or '-'}")
        return 0

    results = []
    for name, info in sorted(found.items()):
        try:
            results.append(update_one(name, info, check=check, dry=dry, force=force))
        except KeyboardInterrupt:
            raise
        except Exception as exc:  # never leave the user mid-transaction
            warn(f"  unexpected error: {exc}")
            results.append("failed")

    if "failed" in results:
        return 1
    if check and "available" in results:
        return 10
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
