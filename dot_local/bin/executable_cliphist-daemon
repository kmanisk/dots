#!/usr/bin/env bash
# ==============================================================================
# cliphist-daemon: clipboard watcher (Wayland-native + XWayland fallback)
# Single store: cliphist default DB (shared with fuzzel-clipboard/rofi-clipboard)
# Managed by: cliphist.service (user unit, enabled)
# ==============================================================================
export PATH="$HOME/.local/bin:$PATH"
export DISPLAY="${DISPLAY:-:0}"

# --- Wayland watcher loop: catches native app copies (Brave, Firefox, Zed, Alacritty) ---
(
while true; do
    if [ -z "$WAYLAND_DISPLAY" ]; then
        WAYLAND_DISPLAY=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^WAYLAND_DISPLAY=//p')
    fi
    if [ -z "$WAYLAND_DISPLAY" ]; then
        latest_sock=$(ls -t "${XDG_RUNTIME_DIR:-/run/user/$UID}"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -n 1)
        if [ -n "$latest_sock" ]; then
            WAYLAND_DISPLAY=$(basename "$latest_sock")
        fi
    fi

    if [ -n "$WAYLAND_DISPLAY" ] && [ -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/$WAYLAND_DISPLAY" ]; then
        export WAYLAND_DISPLAY
        wl-paste --watch cliphist store 2>/dev/null
    fi
    sleep 2
done
) &
WL_PID=$!

# --- X11 watcher: catches XWayland app copies ---
(
while clipnotify 2>/dev/null || sleep 5; do
    clip=$(xsel -b -o 2>/dev/null)
    [ -n "$clip" ] && printf '%s' "$clip" | cliphist store 2>/dev/null
done
) &
X11_PID=$!

# --- Hourly prune (500 items + 30-day pins) ---
(
while sleep 3600; do
    "$HOME/.local/bin/cliphist-prune" 2>/dev/null
done
) &

wait $WL_PID $X11_PID
