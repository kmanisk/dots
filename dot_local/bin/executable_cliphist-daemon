#!/usr/bin/env bash
# ==============================================================================
# cliphist-daemon: Wayland clipboard watcher feeding cliphist (cliphist.service)
# Single watcher on the Wayland clipboard: XWayland mirrors X11 selections into
# it, so no separate X11 (clipnotify/xsel) watcher is needed.
# Items are size-filtered by cliphist-store-capped; retention and dedupe live
# in ~/.config/cliphist/config.
# ==============================================================================
export PATH="$HOME/.local/bin:$PATH"

resolve_wayland_display() {
    if [ -n "$WAYLAND_DISPLAY" ] && [ -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/$WAYLAND_DISPLAY" ]; then
        return 0
    fi
    local wl
    wl=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^WAYLAND_DISPLAY=//p')
    [ -n "$wl" ] || return 1
    export WAYLAND_DISPLAY="$wl"
}

while true; do
    if resolve_wayland_display \
        && [ -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/$WAYLAND_DISPLAY" ]; then
        wl-paste --watch "$HOME/.local/bin/cliphist-store-capped" 2>/dev/null
    fi
    sleep 2
done
