#!/usr/bin/env bash
# ==============================================================================
# rofi-clipboard: Interactive Floating Clipboard & Pinned Notes Selector
# Supports:
#   Enter       -> Copy to Clipboard & Exit
#   Alt+p       -> Pin selected entry (stays open / loops)
#   Alt+x       -> Unpin entry (stays open / loops)
#   Alt+d       -> Delete entry (stays open / loops)
#   Escape      -> Exit
export PATH="$HOME/.local/bin:$PATH"

PIN_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/clipboard_pins"
mkdir -p "$PIN_DIR"
THEME="$HOME/.config/rofi/clipboard-floating.rasi"

PIN_PREFIX="📌 [PIN] "

notify() {
    notify-send -a "Clipboard" -u low -i edit-paste "$1" "$2" 2>/dev/null
}

# Assemble display list: Pinned items first, then cliphist history
display_items() {
    if [ -d "$PIN_DIR" ]; then
        for f in "$PIN_DIR"/*; do
            [ -f "$f" ] || continue
            first_line=$(head -n 1 "$f" | tr -d '\r\n')
            [ -z "$first_line" ] && first_line="<empty>"
            echo "${PIN_PREFIX}${first_line}"
        done
    fi
    cliphist list 2>/dev/null
}

# Main interactive loop: pinning, unpinning, or deleting keeps the menu open
while true; do
    chosen=$(display_items | rofi -dmenu \
        -p "Clipboard" \
        -mesg "Enter: Copy &amp; Close  │  Alt+p: Pin  │  Alt+x: Unpin  │  Alt+d: Delete" \
        -kb-delete-entry "" \
        -kb-custom-1 "Alt+d,Shift+Delete" \
        -kb-custom-2 "Alt+p" \
        -kb-custom-3 "Alt+x" \
        -theme "$THEME" \
        "$@")
    exit_code=$?

    # Esc or window close / canceled
    [ -z "$chosen" ] && exit 0
    [ "$exit_code" -eq 1 ] && exit 0

    is_pinned=0
    if [[ "$chosen" == "${PIN_PREFIX}"* ]]; then
        is_pinned=1
    fi

    # --- ACTION: ALT+D (Delete) -> Loops ---
    if [ "$exit_code" -eq 10 ]; then
        if [ "$is_pinned" -eq 1 ]; then
            pin_text="${chosen#"${PIN_PREFIX}"}"
            for f in "$PIN_DIR"/*; do
                [ -f "$f" ] || continue
                line=$(head -n 1 "$f" | tr -d '\r\n')
                if [ "$line" = "$pin_text" ]; then
                    rm -f "$f"
                    notify "Deleted Pin" "$pin_text"
                    break
                fi
            done
        else
            cliphist delete <<< "$chosen" 2>/dev/null
            notify "Deleted Entry" "Clipboard entry removed"
        fi
        continue
    fi

    # --- ACTION: ALT+P (Pin) -> Loops ---
    if [ "$exit_code" -eq 11 ]; then
        if [ "$is_pinned" -eq 1 ]; then
            notify "Already Pinned" "This item is already pinned"
        else
            raw_text=$(cliphist decode <<< "$chosen" 2>/dev/null)
            if [ -n "$raw_text" ]; then
                hash_id=$(printf '%s' "$raw_text" | md5sum | cut -d' ' -f1)
                printf '%s' "$raw_text" > "$PIN_DIR/$hash_id"
                notify "Pinned Note" "$(head -n 1 "$PIN_DIR/$hash_id")"
            fi
        fi
        continue
    fi

    # --- ACTION: ALT+X (Unpin) -> Loops ---
    if [ "$exit_code" -eq 12 ]; then
        if [ "$is_pinned" -eq 1 ]; then
            pin_text="${chosen#"${PIN_PREFIX}"}"
            for f in "$PIN_DIR"/*; do
                [ -f "$f" ] || continue
                line=$(head -n 1 "$f" | tr -d '\r\n')
                if [ "$line" = "$pin_text" ]; then
                    rm -f "$f"
                    notify "Unpinned" "$pin_text"
                    break
                fi
            done
        else
            notify "Not Pinned" "Item is in standard history, not pinned"
        fi
        continue
    fi

    # --- ACTION: ENTER (Copy & Close) ---
    if [ "$exit_code" -eq 0 ]; then
        if [ "$is_pinned" -eq 1 ]; then
            pin_text="${chosen#"${PIN_PREFIX}"}"
            for f in "$PIN_DIR"/*; do
                [ -f "$f" ] || continue
                line=$(head -n 1 "$f" | tr -d '\r\n')
                if [ "$line" = "$pin_text" ]; then
                    wl-copy < "$f"
                    notify "Copied Pin" "$pin_text"
                    break
                fi
            done
        else
            raw_text=$(cliphist decode <<< "$chosen" 2>/dev/null)
            if [ -n "$raw_text" ]; then
                printf '%s' "$raw_text" | wl-copy
                notify "Copied to Clipboard" "$(head -n 1 <<< "$raw_text")"
            fi
        fi
        exit 0
    fi

    # Fallback exit for other codes
    exit 0
done
