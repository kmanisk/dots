#!/usr/bin/env python3
"""
smart-layout-toggle:
Seamlessly toggles between Tiling (splith) and Tabbed mode (horizontal left-and-right tabs).
- When in Tiling mode: converts to Tabbed. If 1 window, it becomes a single tab.
  If 2+ windows, consolidates them all as horizontal side-by-side tabs.
- When in Tabbed mode: converts to Tiling (splith side-by-side).
- Tab navigation is handled cleanly via Alt+Shift+j (next tab) and Alt+Shift+k (prev tab).
- Instant, hot-reloaded in place without switching workspaces or reopening windows.
- Prevents redundant nested split/tab containers and eliminates orphaned wrapper geometry.
"""
import json
import os
import subprocess
import sys

IPC_CMD = "swaymsg" if os.environ.get("SWAYSOCK") else "i3-msg"


def i3_msg(*cmds):
    cmd = "; ".join(cmds)
    res = subprocess.run([IPC_CMD, cmd], capture_output=True, text=True)
    return res.stdout


def get_tree():
    res = subprocess.run([IPC_CMD, "-t", "get_tree"], capture_output=True, text=True)
    return json.loads(res.stdout)


def find_focused(node):
    if node.get("focused"):
        return node
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        res = find_focused(child)
        if res:
            return res
    return None


def contains_id(node, target_id):
    if node.get("id") == target_id:
        return True
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        if contains_id(child, target_id):
            return True
    return False


def find_workspace_node(node, focused_id):
    if node.get("type") == "workspace":
        if contains_id(node, focused_id):
            return node
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        res = find_workspace_node(child, focused_id)
        if res:
            return res
    return None


def find_parent_container(root, target_id):
    for child in root.get("nodes", []) + root.get("floating_nodes", []):
        if child.get("id") == target_id:
            return root
        res = find_parent_container(child, target_id)
        if res:
            return res
    return None


def get_ancestor_containers(ws, target_id):
    """Return all container nodes between ws (exclusive) and target (inclusive)."""
    ancestors = []

    def walk(curr):
        for child in curr.get("nodes", []) + curr.get("floating_nodes", []):
            if child.get("id") == target_id:
                ancestors.append(child)
                return True
            if walk(child):
                ancestors.append(child)
                return True
        return False

    walk(ws)
    return ancestors


def get_tiled_leaves(node):
    leaves = []
    # Only consider non-floating windows.
    # Sway-native Wayland views have window=None + app_id set;
    # X11/XWayland views have window set. Count both.
    if node.get("type") == "con" and (node.get("window") is not None or node.get("app_id")):
        floating = node.get("floating", "")
        if not floating or floating in ("auto_off", "user_off"):
            return [node]
    for child in node.get("nodes", []):
        leaves.extend(get_tiled_leaves(child))
    return leaves


def is_workspace_tabbed(ws, leaves):
    if not leaves:
        return ws.get("layout") in ("tabbed", "stacked")
    if len(leaves) == 1:
        p = find_parent_container(ws, leaves[0]["id"])
        return (p and p.get("layout") in ("tabbed", "stacked")) or (ws.get("layout") in ("tabbed", "stacked"))

    parents = [find_parent_container(ws, leaf["id"]) for leaf in leaves]
    parent_ids = {p["id"] for p in parents if p}
    if len(parent_ids) == 1:
        common_p = parents[0]
        return common_p.get("layout") in ("tabbed", "stacked")
    return False


def flatten_single_window(ws, leaf, focused_id):
    """If a single window is wrapped in nested single-child containers, flatten to a clean container."""
    ws_name = ws.get("name")
    if not ws_name:
        return
    leaf_id = leaf["id"]
    p = find_parent_container(ws, leaf_id)
    if not p:
        return
    p2 = find_parent_container(ws, p["id"])
    if p2 and p2.get("type") != "workspace":
        cmds = [
            f'[con_id="{leaf_id}"] move to workspace __flatten_tmp',
            f'[con_id="{leaf_id}"] move to workspace {ws_name}',
            f'[con_id="{leaf_id}"] layout tabbed',
            f'[con_id="{leaf_id}"] focus',
        ]
        i3_msg(*cmds)


def main():
    tree = get_tree()
    focused = find_focused(tree)
    if not focused:
        sys.exit(0)

    focused_id = focused["id"]
    ws = find_workspace_node(tree, focused_id)
    if not ws:
        sys.exit(0)

    leaves = get_tiled_leaves(ws)
    n = len(leaves)

    if n == 0:
        sys.exit(0)

    already_tabbed = is_workspace_tabbed(ws, leaves)

    if already_tabbed:
        # Check if currently stacked (top-down) from earlier -> convert to tabbed (horizontal)
        p = find_parent_container(ws, leaves[0]["id"]) if n >= 1 else None
        cur_layout = p.get("layout") if p else ws.get("layout")
        if cur_layout == "stacked":
            i3_msg(f'[con_id="{focused_id}"] focus, layout tabbed')
            sys.exit(0)

        # ======================================================================
        # CURRENTLY TABBED -> Switch to TILING (splith)
        # ======================================================================
        i3_msg(f'[con_id="{focused_id}"] focus, layout splith')
    else:
        # ======================================================================
        # CURRENTLY TILING -> Switch to TABBED (horizontal side-by-side tabs)
        # ======================================================================
        if n == 1:
            p = find_parent_container(ws, leaves[0]["id"])
            p2 = find_parent_container(ws, p["id"]) if p else None
            if p2 and p2.get("type") != "workspace":
                flatten_single_window(ws, leaves[0], focused_id)
            else:
                i3_msg(f'[con_id="{focused_id}"] focus, layout tabbed')
        else:
            parents = [find_parent_container(ws, leaf["id"]) for leaf in leaves]
            parent_ids = {p["id"] for p in parents if p}
            if len(parent_ids) == 1:
                # All leaves already share a common parent. Setting focused leaf to layout tabbed
                # seamlessly makes the common parent tabbed without creating any nested containers.
                cmds = [f'[con_id="{focused_id}"] focus, layout tabbed']
                ancestors = get_ancestor_containers(ws, parents[0]["id"])
                for anc in ancestors:
                    if anc["id"] != parents[0]["id"] and anc.get("layout") in ("tabbed", "stacked"):
                        cmds.append(f'[con_id="{anc["id"]}"] layout splith')
                i3_msg(*cmds)
            else:
                # Scattered across different containers. Consolidate into root leaf's container.
                root_leaf = leaves[0]
                cmds = []
                for other in leaves[1:]:
                    cmds.append(f'[con_id="{other["id"]}"] move to con_id {root_leaf["id"]}')
                cmds.append(f'[con_id="{root_leaf["id"]}"] focus, layout tabbed')
                cmds.append(f'[con_id="{focused_id}"] focus')
                i3_msg(*cmds)


if __name__ == "__main__":
    main()
