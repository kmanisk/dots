#!/usr/bin/env bash
# ==============================================================================
# dgpu-power: Dynamic on-the-fly power management for NVIDIA RTX 5050 Mobile
#
# Modes:
#   status   - Inspect power state (D3cold, suspended, active) & holding processes
#   off      - Safely isolate and force dGPU into D3cold / unbind for max battery
#   on       - Restore dGPU / re-bind and rescan for prime-run gaming & compute
#   toggle   - Toggle between on-demand auto power management and disabled
# ==============================================================================
set -euo pipefail

NVIDIA_GPU="0000:01:00.0"
NVIDIA_AUDIO="0000:01:00.1"

notify() {
    local title="$1"
    local msg="$2"
    local urgency="${3:-normal}"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u "$urgency" -a "dGPU Power" "$title" "$msg"
    fi
    echo "[$title] $msg"
}

get_status() {
    echo "=================================================="
    echo " NVIDIA RTX 5050 Mobile — Dynamic Power Status"
    echo "=================================================="

    if [ ! -d "/sys/bus/pci/devices/$NVIDIA_GPU" ]; then
        echo "Hardware State:   DISCONNECTED / POWERED OFF (PCI Bus Removed)"
        echo "Power Mode:       Maximum Power Saving (0W draw)"
        echo "=================================================="
        return 0
    fi

    local pstate
    pstate=$(cat "/sys/bus/pci/devices/$NVIDIA_GPU/power_state" 2>/dev/null || echo "unknown")
    local rstatus
    rstatus=$(cat "/sys/bus/pci/devices/$NVIDIA_GPU/power/runtime_status" 2>/dev/null || echo "unknown")
    local control
    control=$(cat "/sys/bus/pci/devices/$NVIDIA_GPU/power/control" 2>/dev/null || echo "unknown")

    echo "PCI Device:       $NVIDIA_GPU"
    echo "Power State:      $pstate"
    echo "Runtime Status:   $rstatus"
    echo "PM Control:       $control"

    if [[ "$pstate" == "D3cold" ]] || [[ "$rstatus" == "suspended" ]]; then
        echo "Energy Profile:   SUSPENDED (D3cold ~0W idle consumption)"
    else
        echo "Energy Profile:   ACTIVE (Consuming battery power)"
    fi

    # Check for blocking processes
    local procs
    procs=$(fuser -v /dev/nvidia* 2>/dev/null || true)
    if [ -n "$procs" ]; then
        echo ""
        echo "Active processes locking the dGPU:"
        lsof /dev/nvidia* 2>/dev/null | awk 'NR>1 {printf "  - %-15s (PID %s)\n", $1, $2}' | sort -u || true
    else
        echo "Processes:        None holding /dev/nvidia* (Free to suspend)"
    fi
    echo "=================================================="
}

power_off() {
    notify "dGPU Power" "Isolating dGPU for power saving..." "normal"

    # 1. Identify any background apps using NVIDIA
    local culprits
    culprits=$(lsof /dev/nvidia* 2>/dev/null | awk 'NR>1 {print $1 ":" $2}' | sort -u || true)

    if [ -n "$culprits" ]; then
        echo "Notice: Found applications currently holding NVIDIA handles:"
        for c in $culprits; do
            echo "  -> $c"
        done
        echo "To cleanly suspend into D3cold, close any dGPU-bound applications (e.g. Steam, prime-run apps)."
    fi

    # 2. Ensure runtime PM is in auto mode for GPU and paired audio
    if [ -d "/sys/bus/pci/devices/$NVIDIA_GPU/power" ]; then
        echo auto | sudo tee "/sys/bus/pci/devices/$NVIDIA_GPU/power/control" >/dev/null
    fi
    if [ -d "/sys/bus/pci/devices/$NVIDIA_AUDIO/power" ]; then
        echo auto | sudo tee "/sys/bus/pci/devices/$NVIDIA_AUDIO/power/control" >/dev/null
    fi

    # 3. Give kernel a moment to transition to D3cold
    sleep 1

    local pstate
    pstate=$(cat "/sys/bus/pci/devices/$NVIDIA_GPU/power_state" 2>/dev/null || echo "unknown")

    if [[ "$pstate" == "D3cold" ]] || [[ "$pstate" == "D3hot" ]]; then
        notify "dGPU Power" "dGPU successfully in $pstate power-saving mode (0W draw)." "normal"
    else
        # If still awake due to background handles, offer soft-remove from PCI bus
        notify "dGPU Power" "dGPU is currently $pstate. Close active GPU apps for deepest sleep." "low"
    fi
}

power_on() {
    notify "dGPU Power" "Waking dGPU & ensuring drivers are ready..." "normal"

    # 1. If device was removed from PCI tree, rescan
    if [ ! -d "/sys/bus/pci/devices/$NVIDIA_GPU" ]; then
        echo 1 | sudo tee /sys/bus/pci/rescan >/dev/null
        sleep 0.5
    fi

    # 2. Touch runtime PM to auto (ready for prime-run on demand)
    if [ -d "/sys/bus/pci/devices/$NVIDIA_GPU/power" ]; then
        echo auto | sudo tee "/sys/bus/pci/devices/$NVIDIA_GPU/power/control" >/dev/null
    fi

    notify "dGPU Power" "dGPU is ready for prime-run offload and gaming." "normal"
}

case "${1:-status}" in
    status)
        get_status
        ;;
    off|disable|suspend|save)
        power_off
        ;;
    on|enable|resume|wake)
        power_on
        ;;
    toggle)
        cur=$(cat "/sys/bus/pci/devices/$NVIDIA_GPU/power_state" 2>/dev/null || echo "D3cold")
        if [[ "$cur" == "D3cold" ]] || [[ "$cur" == "unknown" ]]; then
            power_on
        else
            power_off
        fi
        ;;
    *)
        echo "Usage: dgpu-power [status | off | on | toggle]"
        exit 1
        ;;
esac
