#!/usr/bin/env python3
"""
bt-keyboard-reconnect — Dedicated, ultra-lightweight BLE keyboard auto-connect daemon.
Targeting exclusively:
  - Katana S K2 (CC:04:2E:90:66:02)

Features:
  - Event-driven via system D-Bus (GLib mainloop)
  - Completely dormant (0% CPU) when keyboard is connected
  - Immediate asynchronous connection when keyboard disconnects or wakes up
  - Auto-restarts xremap.service on reconnect so custom layers attach instantly
  - Immediate reconnection on system resume and Bluetooth adapter power-on
  - Zero interference with audio devices or bt-refuse-toggle
"""

import os
import sys
import subprocess
import time
import dbus
import dbus.mainloop.glib
from gi.repository import GLib

KEYBOARD_ADDR = "CC:04:2E:90:66:02"
KEYBOARD_PATH = "/org/bluez/hci0/dev_CC_04_2E_90_66_02"
RETRY_INTERVAL_SEC = 3
LOG_FILE = os.path.expanduser("~/.local/state/bt-keyboard-reconnect.log")

class KeyboardAutoConnector:
    def __init__(self, verbose=True):
        self.verbose = verbose
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        self.bus = dbus.SystemBus()
        self.retry_timer_id = None
        self.connecting = False

        # Listen for Device property changes (Connected, etc.)
        self.bus.add_signal_receiver(
            self.on_properties_changed,
            dbus_interface="org.freedesktop.DBus.Properties",
            signal_name="PropertiesChanged",
            path_keyword="path"
        )

        # Listen for system resume from sleep
        try:
            self.bus.add_signal_receiver(
                self.on_prepare_for_sleep,
                bus_name="org.freedesktop.login1",
                dbus_interface="org.freedesktop.login1.Manager",
                signal_name="PrepareForSleep"
            )
        except Exception as e:
            self.log(f"Warning: Could not hook PrepareForSleep: {e}")

    def log(self, msg):
        timestamp = time.strftime("%Y-%m-%d %H:%M:%S")
        formatted = f"[{timestamp}] [bt-keyboard-reconnect] {msg}"
        if self.verbose:
            print(formatted, flush=True)
        try:
            with open(LOG_FILE, "a") as f:
                f.write(formatted + "\n")
        except Exception:
            pass

    def is_connected(self):
        try:
            dev_obj = self.bus.get_object("org.bluez", KEYBOARD_PATH)
            props = dbus.Interface(dev_obj, "org.freedesktop.DBus.Properties")
            return bool(props.Get("org.bluez.Device1", "Connected"))
        except Exception as e:
            self.log(f"Could not read Connected property: {e}")
            return False

    def restart_xremap(self):
        try:
            subprocess.Popen(
                ["systemctl", "--user", "restart", "xremap.service"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
            self.log("xremap restarted to attach to reconnected keyboard.")
        except Exception as e:
            self.log(f"Failed to restart xremap: {e}")

    def stop_retry_timer(self):
        if self.retry_timer_id is not None:
            GLib.source_remove(self.retry_timer_id)
            self.retry_timer_id = None

    def schedule_retry(self, delay=RETRY_INTERVAL_SEC):
        if self.retry_timer_id is None:
            self.retry_timer_id = GLib.timeout_add_seconds(delay, self.on_retry_timer)

    def on_retry_timer(self):
        self.retry_timer_id = None
        self.connect()
        return False

    def connect(self):
        if self.connecting:
            return
        if self.is_connected():
            self.stop_retry_timer()
            return

        self.connecting = True
        self.log("Attempting asynchronous connection to Katana S K2...")

        try:
            dev_obj = self.bus.get_object("org.bluez", KEYBOARD_PATH)
            dev_iface = dbus.Interface(dev_obj, "org.bluez.Device1")

            def on_success():
                self.connecting = False
                self.log("Connection successfully established! Entering dormant state.")
                self.stop_retry_timer()
                GLib.timeout_add_seconds(1, self.restart_xremap)

            def on_error(err):
                self.connecting = False
                err_msg = str(err)
                if "AlreadyConnected" in err_msg:
                    self.log("Keyboard is already connected.")
                    self.stop_retry_timer()
                elif "InProgress" in err_msg:
                    self.log("Connection already in progress.")
                    self.schedule_retry(5)
                else:
                    self.log(f"Connect attempt ended ({err_msg}). Re-arming scan in {RETRY_INTERVAL_SEC}s...")
                    self.schedule_retry(RETRY_INTERVAL_SEC)

            dev_iface.Connect(
                reply_handler=on_success,
                error_handler=on_error,
                timeout=25
            )
        except Exception as e:
            self.connecting = False
            self.log(f"Connect call exception: {e}")
            self.schedule_retry(RETRY_INTERVAL_SEC)

    def on_properties_changed(self, interface, changed, invalidated, path):
        if interface == "org.bluez.Device1" and path == KEYBOARD_PATH:
            if "Connected" in changed:
                connected = bool(changed["Connected"])
                self.log(f"Katana S K2 Connected property changed -> {connected}")
                if connected:
                    self.connecting = False
                    self.stop_retry_timer()
                    GLib.timeout_add_seconds(1, self.restart_xremap)
                else:
                    self.log("Katana S K2 disconnected. Initiating auto-reconnect...")
                    GLib.timeout_add_seconds(1, self.connect)

        elif interface == "org.bluez.Adapter1":
            if "Powered" in changed and bool(changed["Powered"]):
                self.log("Bluetooth adapter powered ON. Triggering connect...")
                GLib.timeout_add_seconds(1, self.connect)

    def on_prepare_for_sleep(self, going_to_sleep):
        if not going_to_sleep:
            self.log("System resumed from sleep. Triggering connect in 1s...")
            GLib.timeout_add_seconds(1, self.connect)

def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    connector = KeyboardAutoConnector()

    if not connector.is_connected():
        connector.log("Keyboard not connected at startup. Beginning connect loop.")
        connector.connect()
    else:
        connector.log("Keyboard already connected at startup. Staying dormant.")

    loop = GLib.MainLoop()
    try:
        loop.run()
    except (KeyboardInterrupt, SystemExit):
        connector.stop_retry_timer()

if __name__ == "__main__":
    main()
