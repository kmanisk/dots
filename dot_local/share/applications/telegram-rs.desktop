[Desktop Entry]
Type=Application
Name=Telegram RS
Comment=Feather-light Telegram client in Rust
Exec=/home/onyx/.local/bin/telegram-rs-open %u
Icon=telegram-rs
Terminal=false
Categories=Network;Chat;InstantMessaging;
