[Desktop Entry]
Type=Application
Name=Waydroid
GenericName=Android Container
Comment=Start Waydroid session and open the full Android UI.
Exec=waydroid-launcher
TryExec=waydroid-launcher
Icon=waydroid
Categories=X-WayDroid-App;Utility;
Actions=restart;stop;
X-Purism-FormFactor=Workstation;Mobile;

[Desktop Action restart]
Name=Restart Waydroid
Exec=waydroid-restart
Icon=waydroid

[Desktop Action stop]
Name=Stop Waydroid
Exec=waydroid-stop
Icon=waydroid
