/**
 * NvChad Base46 / Omarchy Theme Picker — strong frame (2026-10-18).
 * Rebuilt for visibility after feedback that the old chrome was too weak
 * (1px border, unboxed rows, 10pt muted hints, invisible text on some
 * themes). Now conforms to the system baseline in system.rasi: 860px wide,
 * 2px accent border, boxed search row and hint/HUD row with a 4px accent
 * leading edge, 12pt hint text in the chrome foreground.
 * Functionality unchanged: Enter Apply, Ctrl+D Delete, Ctrl+R Sync,
 * Ctrl+I Preview HUD, [ACTIVE] badge, spectrum swatches.
 */
@import "~/.config/rofi/system.rasi"

configuration {
    show-icons:     false;
    kb-custom-1:    "Control+d,Control+Shift+D";
    kb-custom-2:    "Control+r";
    kb-custom-3:    "Control+i";
    sort:           true;
    sorting-method: "fzf";
    matching:       "fuzzy";
}

window {
    background-color:    @background;
    text-color:          @foreground;
    border:              2px;
    border-color:        @border-focus;
    border-radius:       0px;
    width:               860px;
    location:            center;
    anchor:              center;
    padding:             16px 20px;
}

mainbox {
    background-color:    transparent;
    children:            [ inputbar, message, listview ];
    spacing:             10px;
}

/* Search row: primary slot fill + 4px accent leading edge */
inputbar {
    background-color:    @background-alt;
    text-color:          @foreground;
    border:              0px 0px 0px 4px;
    border-color:        @border-focus;
    border-radius:       0px;
    padding:             12px 16px;
    children:            [ prompt, entry ];
    spacing:             14px;
}

prompt {
    background-color:    transparent;
    text-color:          @accent-bright;
    font:                "VictorMono Nerd Font Mono Bold 17";
}

entry {
    background-color:    transparent;
    text-color:          @foreground;
    placeholder:         "Search themes...";
    placeholder-color:   @gruvbox-fg2;
    font:                "VictorMono Nerd Font Mono Bold 16";
}

/* Hint / HUD row: same boxed language, fill only */
message {
    background-color:    @background-alt;
    text-color:          @foreground;
    border:              0px;
    border-radius:       0px;
    padding:             10px 16px;
}

textbox {
    background-color:    transparent;
    text-color:          @foreground;
    font:                "VictorMono Nerd Font Mono Bold 13";
}

listview {
    background-color:    transparent;
    columns:             1;
    lines:               9;
    spacing:             4px;
    cycle:               true;
    dynamic:             true;
    layout:              vertical;
    scrollbar:           false;
    border:              0px;
    padding:             0px;
}

element {
    orientation:         horizontal;
    background-color:    transparent;
    text-color:          @foreground;
    padding:             10px 14px;
    border-radius:       0px;
    border:              0px;
    children:            [ element-text ];
}

element selected {
    background-color:    @accent;
    text-color:          @selected-foreground;
    border:              0px 0px 0px 4px;
    border-color:        @selected-foreground;
    border-radius:       0px;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    font:                "VictorMono Nerd Font Mono Bold 16";
    highlight:           bold;
    vertical-align:      0.5;
}
