/**
 * NvChad Base46 / Omarchy Theme Picker — minimal flat style (2026-10-18).
 * Visual language matches the compact launcher look: single thin border,
 * no boxed header/hint blocks, muted hint row, flat rows with accent fill.
 * Functionality unchanged: search (fzf fuzzy), Enter Apply, Ctrl+D Delete,
 * Ctrl+R Sync, Ctrl+I Preview HUD, [ACTIVE] badge, spectrum swatches.
 */
@import "~/.config/rofi/system.rasi"

configuration {
    show-icons:             false;
    kb-remove-char-forward: "Delete";
    kb-custom-1:            "Control+d,Control+Shift+D";
    kb-custom-2:            "Control+r";
    kb-custom-3:            "Control+i";
    sort:                   true;
    sorting-method:         "fzf";
    matching:               "fuzzy";
}

window {
    background-color:    @background;
    text-color:          @foreground;
    border:              1px;
    border-color:        @border-focus;
    border-radius:       0px;
    width:               720px;
    location:            center;
    anchor:              center;
    padding:             12px 14px;
}

mainbox {
    background-color:    transparent;
    children:            [ inputbar, message, listview ];
    spacing:             8px;
}

/* Flat search row: no box, accent label carries the hierarchy */
inputbar {
    background-color:    transparent;
    border:              0px;
    padding:             2px 6px 8px;
    children:            [ prompt, entry ];
    spacing:             12px;
}

prompt {
    background-color:    transparent;
    text-color:          @accent-bright;
    font:                "VictorMono Nerd Font Mono Bold 15";
}

entry {
    background-color:    transparent;
    text-color:          @foreground;
    placeholder:         "Search themes...";
    placeholder-color:   @foreground-alt;
    font:                "VictorMono Nerd Font Mono 14";
}

/* Hint row: quiet and muted, no border */
message {
    background-color:    transparent;
    border:              0px;
    padding:             0px 6px 2px;
}

textbox {
    background-color:    transparent;
    text-color:          @foreground-alt;
    font:                "VictorMono Nerd Font Mono 10";
}

listview {
    background-color:    transparent;
    columns:             1;
    lines:               8;
    spacing:             3px;
    cycle:               true;
    dynamic:             true;
    layout:              vertical;
    scrollbar:           false;
    border:              0px;
    padding:             0px;
}

element {
    orientation:         horizontal;
    background-color:    transparent;
    text-color:          @foreground;
    padding:             9px 10px;
    border-radius:       0px;
    border:              0px;
    children:            [ element-text ];
}

element selected {
    background-color:    @accent;
    text-color:          @selected-foreground;
    border:              0px;
    border-radius:       0px;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    font:                "VictorMono Nerd Font Mono 14";
    highlight:           bold;
    vertical-align:      0.5;
}
