/**
 * NvChad Base46 / Omarchy Theme Picker — system theme (sharp, VictorMono).
 * Geometry only: wide 860px showcase list with spectrum swatches + [ACTIVE] badge.
 * Selection follows the system rule: accent fill + dark text.
 */
@import "~/.config/rofi/system.rasi"

configuration {
    show-icons:             false;
    kb-remove-char-forward: "Delete";
    kb-custom-1:            "Control+d,Control+Shift+D";
    kb-custom-2:            "Control+r";
    kb-custom-3:            "Control+i";
    sort:                   true;
    sorting-method:         "fzf";
    matching:               "fuzzy";
}

window {
    background-color:    @background;
    text-color:          @foreground;
    border:              2px;
    border-color:        @accent;
    border-radius:       0px;
    width:               780px;
    location:            center;
    anchor:              center;
    padding:             18px;
}

mainbox {
    background-color:    transparent;
    children:            [ inputbar, message, listview ];
    spacing:             14px;
}

inputbar {
    background-color:    @background-alt;
    border:              2px;
    border-color:        @accent;
    border-radius:       0px;
    padding:             14px 18px;
    children:            [ prompt, entry ];
    spacing:             14px;
}

prompt {
    background-color:    transparent;
    text-color:          @accent;
    font:                "VictorMono Nerd Font Mono Bold 18";
}

entry {
    background-color:    transparent;
    text-color:          @foreground;
    placeholder:         "Search themes...";
    placeholder-color:   @foreground-alt;
    font:                "VictorMono Nerd Font Mono Bold 16";
}

message {
    background-color:    @background-alt;
    border:              1px;
    border-color:        @accent;
    border-radius:       0px;
    padding:             8px 14px;
}

textbox {
    background-color:    transparent;
    text-color:          @foreground;
    font:                "VictorMono Nerd Font Mono 13";
}

listview {
    background-color:    transparent;
    columns:             1;
    lines:               8;
    spacing:             6px;
    cycle:               true;
    dynamic:             true;
    layout:              vertical;
    scrollbar:           false;
    border:              0px;
    padding:             4px 0px;
}

element {
    orientation:         horizontal;
    background-color:    transparent;
    text-color:          @foreground;
    padding:             12px 18px;
    border-radius:       0px;
    border:              0px;
    children:            [ element-text ];
}

element selected {
    background-color:    @accent;
    text-color:          @selected-foreground;
    border:              0px;
    border-radius:       0px;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    font:                "VictorMono Nerd Font Mono Bold 16";
    highlight:           bold;
    vertical-align:      0.5;
}
