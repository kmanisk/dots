/**
 * NvChad Base46 / Omarchy Theme Picker — compact frame (2026-10-29).
 *
 * Reworked for scale, not just width: the old chrome ran 17/16/13/16pt with
 * 10-16px paddings, which made a 860x690 window for nine short rows. Type scale
 * is now 12 body / 12 bold prompt / 10 hint on a 4px spacing rhythm.
 *
 * Font is Iosevka Nerd Font Mono to match the system UI/mono font and the
 * network menu. The row layout pads theme names to 26 characters, so the
 * family must stay monospace or the [ACTIVE] badge and swatch column drift.
 *
 * Functionality unchanged: Enter Apply, Ctrl+D Delete, Ctrl+R Sync,
 * Ctrl+I Preview HUD, [ACTIVE] badge, spectrum swatches.
 */
@import "~/.config/rofi/system.rasi"

/* System-wide default here is Iosevka; element rules below refine the sizes. */
* {
    font:                "Iosevka Nerd Font Mono 12";
}

configuration {
    show-icons:     false;
    kb-custom-1:    "Control+d,Control+Shift+D";
    kb-custom-2:    "Control+r";
    kb-custom-3:    "Control+i";
    sort:           true;
    sorting-method: "fzf";
    matching:       "fuzzy";
}

window {
    background-color:    @background;
    text-color:          @foreground;
    border:              1px;
    border-color:        @border-focus;
    border-radius:       0px;
    width:               600px;
    location:            center;
    anchor:              center;
    padding:             10px 12px;
}

mainbox {
    background-color:    transparent;
    children:            [ inputbar, message, listview ];
    spacing:             6px;
}

/* Search row: primary slot fill + 4px accent leading edge */
inputbar {
    background-color:    @background-alt;
    text-color:          @foreground;
    border:              0px 0px 0px 4px;
    border-color:        @border-focus;
    border-radius:       0px;
    padding:             8px 10px;
    children:            [ prompt, entry ];
    spacing:             12px;
}

prompt {
    background-color:    transparent;
    text-color:          @accent-bright;
    font:                "Iosevka Nerd Font Mono Bold 12";
}

entry {
    background-color:    transparent;
    text-color:          @foreground;
    placeholder:         "Search themes...";
    placeholder-color:   @gruvbox-fg2;
    font:                "Iosevka Nerd Font Mono 12";
}

/* Hint / HUD row: same boxed language, fill only */
message {
    background-color:    @background-alt;
    text-color:          @foreground;
    border:              0px;
    border-radius:       0px;
    padding:             6px 10px;
}

textbox {
    background-color:    transparent;
    text-color:          @foreground;
    font:                "Iosevka Nerd Font Mono 10";
}

listview {
    background-color:    transparent;
    columns:             1;
    lines:               9;
    spacing:             2px;
    cycle:               true;
    dynamic:             true;
    layout:              vertical;
    scrollbar:           false;
    border:              0px;
    padding:             0px;
}

element {
    orientation:         horizontal;
    background-color:    transparent;
    text-color:          @foreground;
    padding:             5px 10px;
    border-radius:       0px;
    border:              0px;
    children:            [ element-text ];
}

element selected {
    background-color:    @accent;
    text-color:          @selected-foreground;
    border:              0px 0px 0px 4px;
    border-color:        @selected-foreground;
    border-radius:       0px;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    font:                "Iosevka Nerd Font Mono 12";
    highlight:           bold;
    vertical-align:      0.5;
}
