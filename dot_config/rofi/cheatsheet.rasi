/**
 * Large floating cheatsheet modal — system theme (sharp, VictorMono).
 * Geometry only: wide 1200px two-column keybinding matrix.
 */
@import "~/.config/rofi/system.rasi"

configuration {
    show-icons:     false;
    sort:           true;
    sorting-method: "fzf";
    matching:       "fuzzy";
}

window {
    background-color:    @background;
    text-color:          @foreground;
    border:              2px;
    border-color:        @accent;
    border-radius:       0px;
    width:               1200px;
    height:              860px;
    location:            center;
    anchor:              center;
    padding:             22px;
}

mainbox {
    background-color:    transparent;
    children:            [ inputbar, message, listview ];
    spacing:             16px;
}

inputbar {
    background-color:    @background-alt;
    border:              2px;
    border-color:        @accent;
    border-radius:       0px;
    padding:             14px 18px;
    children:            [ prompt, entry ];
    spacing:             14px;
}

prompt {
    background-color:    transparent;
    text-color:          @accent;
    font:                "VictorMono Nerd Font Mono Bold 18";
}

entry {
    background-color:    transparent;
    text-color:          @foreground;
    font:                "VictorMono Nerd Font Mono 15";
    placeholder:         "Filter shortcuts (e.g. workspace, split, zed, audio, rofi)...";
    placeholder-color:   @foreground-alt;
}

message {
    background-color:    transparent;
    padding:             4px 6px;
}

textbox {
    background-color:    transparent;
    text-color:          @accent;
    font:                "VictorMono Nerd Font Mono Italic 13";
}

listview {
    background-color:    transparent;
    columns:             1;
    lines:               18;
    spacing:             5px;
    cycle:               true;
    dynamic:             true;
    layout:              vertical;
    scrollbar:           false;
}

element {
    background-color:    transparent;
    text-color:          @foreground;
    border-radius:       0px;
    padding:             9px 14px;
    children:            [ element-text ];
}

element selected {
    background-color:    @accent;
    text-color:          #1d2021;
}

element-text {
    background-color:    inherit;
    text-color:          inherit;
    font:                "VictorMono Nerd Font Mono 15";
    highlight:           bold italic;
}
