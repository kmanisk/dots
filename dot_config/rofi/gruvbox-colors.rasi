/**
 * Backward-compat shim. The system theme now lives in system.rasi
 * (sharp corners, VictorMono, dynamic colors). This file only re-exports
 * it so older @import "~/.config/rofi/gruvbox-colors.rasi" lines keep working.
 * New files must @import "~/.config/rofi/system.rasi" directly.
 */
@import "~/.config/rofi/system.rasi"
