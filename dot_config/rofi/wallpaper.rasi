/**
 * Rofi wallpaper grid — system theme (sharp, VictorMono).
 * Geometry only: 4x2 thumbnail grid. Selection is a sharp accent outline
 * (fill would hide thumbnails); everything else follows the system theme.
 */
@import "~/.config/rofi/system.rasi"

configuration {
    show-icons:     true;
    sort:           true;
    sorting-method: "fzf";
    matching:       "fuzzy";
}

/* ---- Window ---- */
window {
    background-color: @background;
    text-color:       @foreground;
    width:            60%;
    height:           74%;
    border:           2px;
    border-color:     @accent;
    border-radius:    0px;
    location:         center;
    anchor:           center;
}

/* ---- Mainbox ---- */
mainbox {
    background-color: transparent;
    children:         [ "inputbar", "message", "listview" ];
    spacing:          16px;
    padding:          22px;
}

/* ---- Inputbar ---- */
inputbar {
    enabled:          true;
    padding:          14px 18px;
    border:           2px;
    border-color:     @accent;
    border-radius:    0px;
    background-color: @background-alt;
    children:         [ "prompt", "entry" ];
    spacing:          14px;
}

prompt {
    enabled:          true;
    padding:          0px 10px 0px 0px;
    background-color: transparent;
    text-color:       @accent;
    font:             "VictorMono Nerd Font Mono Bold 18";
}

entry {
    placeholder:       "Search Wallpapers...";
    placeholder-color: @foreground-alt;
    background-color:  transparent;
    text-color:        @foreground;
    font:              "VictorMono Nerd Font Mono Bold 15";
}

/* ---- Message / Keybind Header ---- */
message {
    enabled:          true;
    padding:          10px 14px;
    border-radius:    0px;
    background-color: transparent;
    text-color:       @accent;
}

textbox {
    background-color: transparent;
    text-color:       @accent;
    font:             @modal-font-italic;
}

/* ---- Listview ---- */
listview {
    background-color: transparent;
    columns:          4;
    lines:            2;
    fixed-columns:    true;
    fixed-height:     true;
    dynamic:          false;
    scrollbar:        true;
    spacing:          15px;
    padding:          10px;
    cycle:            false;
    layout:           vertical;
    reverse:          false;
}

scrollbar {
    handle-color: @border-col;
    handle-width: 6px;
    padding:      0;
}

/* ---- Elements ---- */
element {
    background-color: transparent;
    text-color:       @foreground;
    orientation:      vertical;
    padding:          10px;
    spacing:          5px;
    border-radius:    0px;
    cursor:           pointer;
}

element normal.normal {
    background-color: transparent;
    text-color:       inherit;
}

element selected.normal {
    background-color: @background-alt;
    text-color:       @accent-bright;
    border:           2px;
    border-color:     @accent;
    border-radius:    0px;
}

element-icon {
    size:             6em;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
    font:             "VictorMono Nerd Font Mono 12";
}
