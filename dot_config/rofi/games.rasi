/**
 * Game launcher picker — unified system theme.
 * Matches theme-picker-nvchad baseline: 860px width, 2px accent borders,
 * boxed inputbar, and VictorMono Bold typography.
 */
@import "~/.config/rofi/system.rasi"

configuration {
    show-icons: false;
}

window {
    background-color:    @background;
    text-color:          @foreground;
    border:              2px;
    border-color:        @accent;
    border-radius:       0px;
    width:               860px;
    location:            center;
    anchor:              center;
    padding:             22px;
}

mainbox {
    background-color:    transparent;
    children:            [ inputbar, message, listview ];
    spacing:             16px;
}

inputbar {
    background-color:    @background-alt;
    border:              2px;
    border-color:        @accent;
    border-radius:       0px;
    padding:             14px 18px;
    children:            [ prompt, entry ];
    spacing:             14px;
}

prompt {
    background-color:    transparent;
    text-color:          @accent;
    font:                "VictorMono Nerd Font Mono Bold 18";
}

entry {
    background-color:    transparent;
    text-color:          @foreground;
    placeholder:         "Pick a game...";
    placeholder-color:   @foreground-alt;
    font:                "VictorMono Nerd Font Mono Bold 15";
}

message {
    background-color:    transparent;
    padding:             2px 6px;
}

textbox {
    background-color:    transparent;
    text-color:          @accent;
    font:                "VictorMono Nerd Font Mono Italic 13";
}

listview {
    background-color:    transparent;
    columns:             1;
    lines:               8;
    spacing:             6px;
    cycle:               true;
    dynamic:             true;
    layout:              vertical;
    scrollbar:           false;
    border:              0px;
    padding:             4px 0px;
}

element {
    orientation:         horizontal;
    background-color:    transparent;
    text-color:          @foreground;
    padding:             12px 18px;
    border-radius:       0px;
    border:              0px;
    children:            [ element-text ];
}

element selected {
    background-color:    @accent;
    text-color:          #1d2021;
    border:              0px;
    border-radius:       0px;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    font:                "VictorMono Nerd Font Mono Bold 15";
    highlight:           bold;
    vertical-align:      0.5;
}
