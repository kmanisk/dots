/**
 * Power Menu — unified system theme (sharp, VictorMono).
 * Redesigned as a vertical list of 5 power actions with full text width,
 * matching theme-picker-nvchad baseline (860px width, 2px accent borders).
 * Eliminates all label truncation ("Lock Scre...") and matches system theme.
 */
@import "~/.config/rofi/system.rasi"

configuration {
    show-icons: false;
}

window {
    background-color:    @background;
    text-color:          @foreground;
    border:              2px;
    border-color:        @accent;
    border-radius:       0px;
    width:               860px;
    location:            center;
    anchor:              center;
    padding:             22px;
}

mainbox {
    background-color:    transparent;
    children:            [ inputbar, listview ];
    spacing:             16px;
}

inputbar {
    background-color:    @background-alt;
    border:              2px;
    border-color:        @accent;
    border-radius:       0px;
    padding:             14px 18px;
    children:            [ prompt, entry ];
    spacing:             14px;
}

prompt {
    background-color:    transparent;
    text-color:          @accent;
    font:                "VictorMono Nerd Font Mono Bold 18";
}

entry {
    background-color:    transparent;
    text-color:          @foreground;
    placeholder:         "Select power action...";
    placeholder-color:   @foreground-alt;
    font:                "VictorMono Nerd Font Mono Bold 15";
}

listview {
    background-color:    transparent;
    columns:             1;
    lines:               5;
    spacing:             6px;
    cycle:               true;
    dynamic:             true;
    layout:              vertical;
    scrollbar:           false;
    border:              0px;
    padding:             4px 0px;
}

element {
    orientation:         horizontal;
    background-color:    transparent;
    text-color:          @foreground;
    padding:             12px 18px;
    border-radius:       0px;
    border:              0px;
    children:            [ element-text ];
}

element selected {
    background-color:    @accent;
    text-color:          #1d2021;
    border:              0px;
    border-radius:       0px;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    font:                "VictorMono Nerd Font Mono Bold 15";
    highlight:           bold;
    vertical-align:      0.5;
}
