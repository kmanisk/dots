/**
 * Power Menu — big horizontal button bar (power-button-menu style).
 * Five equal tiles, left-to-right: Shutdown, Restart, Lock, Suspend, Logout.
 * Colors inherited from ~/.config/rofi/system.rasi (theme engine compiled),
 * so a future `theme-set` recolors this menu automatically.
 * Layout: 2026-10-18 rewrite from vertical list to horizontal tiles.
 */
@import "~/.config/rofi/system.rasi"

configuration {
    show-icons:     false;
    sort:           true;
    sorting-method: "fzf";
    matching:       "fuzzy";
}

window {
    background-color:    @background;
    text-color:          @foreground;
    border:              2px;
    border-color:        @accent;
    border-radius:       0px;
    width:               1120px;
    location:            center;
    anchor:              center;
    padding:             24px;
}

mainbox {
    background-color:    transparent;
    children:            [ listview ];
    spacing:             0px;
}

listview {
    background-color:    transparent;
    columns:             5;
    lines:               1;
    spacing:             10px;
    cycle:               true;
    dynamic:             true;
    scrollbar:           false;
    border:              0px;
}

/* One tile = one big button */
element {
    orientation:         vertical;
    background-color:    @background-alt;
    text-color:          @foreground;
    padding:             28px 6px;
    border:              2px;
    border-color:        @background-alt;
    border-radius:       0px;
    children:            [ element-text ];
}

element selected {
    background-color:    @accent;
    text-color:          #1d2021;
    border:              2px;
    border-color:        @accent;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    font:                "VictorMono Nerd Font Mono Bold 21";
    vertical-align:      0.55;
    horizontal-align:    0.5;
}
