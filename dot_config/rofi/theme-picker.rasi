/**
 * Theme selector with split system preview — system theme (sharp, VictorMono).
 * Geometry only: wide 1260px list + preview pane.
 */
@import "~/.config/rofi/system.rasi"

configuration {
    show-icons:     true;
    sort:           true;
    sorting-method: "fzf";
    matching:       "fuzzy";
}

window {
    background-color:    @background;
    text-color:          @foreground;
    border:              2px;
    border-color:        @border-focus;
    border-radius:       0px;
    width:               1260px;
    height:              640px;
    location:            center;
    anchor:              center;
    padding:             18px;
}

mainbox {
    background-color:    transparent;
    children:            [ inputbar, split-pane ];
    spacing:             14px;
}

inputbar {
    background-color:    @background-alt;
    border-radius:       0px;
    padding:             10px 16px;
    children:            [ prompt, entry ];
    spacing:             12px;
}

prompt {
    background-color:    transparent;
    text-color:          @accent-bright;
    font:                @modal-font-bold;
}

entry {
    background-color:    transparent;
    text-color:          @foreground;
    placeholder:         "Search themes (type 'omarchy' for omarchy.org themes)...";
    placeholder-color:   @foreground-alt;
    font:                @modal-font;
}

split-pane {
    orientation:         horizontal;
    spacing:             18px;
    background-color:    transparent;
    children:            [ listview, preview-container ];
    expand:              true;
}

listview {
    background-color:    transparent;
    columns:             1;
    lines:               12;
    spacing:             4px;
    cycle:               true;
    dynamic:             true;
    layout:              vertical;
    scrollbar:           false;
    width:               360px;
    fixed-height:        true;
}

element {
    background-color:    transparent;
    text-color:          @foreground;
    border-radius:       0px;
    padding:             8px 14px;
    children:            [ element-text ];
}

element selected {
    background-color:    @accent;
    text-color:          #1d2021;
}

element-text {
    background-color:    inherit;
    text-color:          inherit;
    font:                @modal-font;
}

preview-container {
    expand:              true;
    orientation:         vertical;
    background-color:    @background-alt;
    border:              1px;
    border-color:        @border-col;
    border-radius:       0px;
    padding:             8px;
    children:            [ preview-frame ];
}

preview-frame {
    expand:              true;
    background-color:    transparent;
    children:            [ icon-current-entry ];
}

icon-current-entry {
    expand:              true;
    size:                560px;
    horizontal-align:    0.5;
    vertical-align:      0.5;
    background-color:    transparent;
}
