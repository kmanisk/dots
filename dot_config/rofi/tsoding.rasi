/**
 * Compact bottom command bar for Rofi.
 *
 * Position invariant: full-width, anchored to the bottom edge of the output.
 * Look: hairline accent top rule, 2px accent tick beside the prompt, flat
 * accent chip for the selection. Sharp corners everywhere, per the system.rasi
 * invariant; colors stay dynamic through system.rasi.
 *
 * Sizing note: rofi is GTK, so GDK_DPI_SCALE=1.35 and the 1.2 compositor scale
 * both apply. Nominal 8pt below renders at roughly 17px line height, and all
 * thirteen bang hints fit on one row at 1920px. Do not raise these sizes
 * without re-checking that the hint strip still fits.
 */
@import "~/.config/rofi/system.rasi"

configuration {
    sort:           true;
    sorting-method: "fzf";
    matching:       "fuzzy";
    show-icons:     false;
}

* {
    background-color: @background;
    border-color:     @border-col;
    text-color:       @foreground;
    font:             "VictorMono Nerd Font Mono 10";
}

window {
    anchor:           south;
    location:         south;
    width:            100%;
    padding:          3px 10px;
    border:           1px 0px 0px 0px;
    border-color:     @accent;
    border-radius:    0px;
    children:         [ horibox ];
}

horibox {
    orientation: horizontal;
    spacing:     8px;
    children:    [ prompt, entry, listview ];
}

prompt {
    padding:          0px 8px;
    border:           0px 0px 0px 2px;
    border-color:     @accent-bright;
    text-color:       @accent-bright;
    font:             "VictorMono Nerd Font Mono Bold 11";
}

entry {
    expand:            false;
    font:              "VictorMono Nerd Font Mono 10";
    width:             8em;
    text-color:        @foreground;
    placeholder:       "type to search...";
    placeholder-color: @accent;
}

listview {
    layout:    horizontal;
    spacing:   3px;
    lines:     100;
    dynamic:   true;
    scrollbar: false;
    padding:   0px;
}

element {
    padding:          2px 5px;
    border:           0px;
    border-radius:    0px;
    text-color:       @foreground;
}

element selected {
    background-color: @accent;
    text-color:       #1d2021;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
}

element-icon {
    size:             0.9em;
    background-color: inherit;
}
