[general]

# --- RETRO CRT / SYNTHWAVE ---

framerate = 60
autosens = 1
sensitivity = 100

# Decibel scaling gives a more musical response.
scaling = decibel

# Fill the terminal automatically.
bars = 0

# Compact arcade-style bars.
bar_width = 2
bar_spacing = 1

# Keep the visualizer slightly below the terminal edge.
max_height = 94

# Frequency range.
lower_cutoff_freq = 45
higher_cutoff_freq = 16000

# Keep the visualizer active.
sleep_timer = 0

# Center the visualization when possible.
center_align = 1


[input]

# Native PipeWire capture.
method = pipewire
source = auto

# PipeWire settings.
sample_rate = 48000
sample_bits = 16

# Stereo spectrum.
channels = 2

# Keep the monitor node processing.
active = 1

# Allow PipeWire to handle channel conversion.
remix = 1

# Avoid desktop recording notifications.
virtual = 1


[output]

# ncurses is required for the truecolor theme/gradient.
method = ncurses

# Classic rising spectrum.
orientation = bottom

# Stereo = mirrored spectrum.
channels = stereo
mono_option = average
reverse = 0

# No frequency labels.
xaxis = none

# Better rendering in Alacritty.
synchronized_sync = 1



[color]
# Theme: bearded-arc (bearded-arc)
background = 'default'
foreground = '#69c3ff'

gradient = 0

[smoothing]

# Smooth enough to look polished without feeling delayed.
monstercat = 1
waves = 0
noise_reduction = 18
