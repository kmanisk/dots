# ==============================================================================
# Gaming / Passthrough Mode — Alt+Shift+F to toggle
# All Sway shortcuts muted. Only workspace switching (Win+u/i/o/p, Win+1..0) works.
# Both plain and --inhibited are bound to guarantee matching in all states.
# Press Alt+Shift+F again to return to normal desktop mode.
# ==============================================================================
mode "gaming" {
    # Plain bindings (active when window has no shortcut inhibitor)
    bindsym $mod+u    workspace number $ws1
    bindsym $mod+i    workspace number $ws2
    bindsym $mod+o    workspace number $ws3
    bindsym $mod+p    workspace number $ws4
    bindsym $mod+1    workspace number $ws1
    bindsym $mod+2    workspace number $ws2
    bindsym $mod+3    workspace number $ws3
    bindsym $mod+4    workspace number $ws4
    bindsym $mod+5    workspace number $ws5
    bindsym $mod+6    workspace number $ws6
    bindsym $mod+7    workspace number $ws7
    bindsym $mod+8    workspace number $ws8
    bindsym $mod+9    workspace number $ws9
    bindsym $mod+0    workspace number $ws10

    # Inhibited bindings (active if a game/client requests shortcut inhibitor)
    bindsym --inhibited $mod+u    workspace number $ws1
    bindsym --inhibited $mod+i    workspace number $ws2
    bindsym --inhibited $mod+o    workspace number $ws3
    bindsym --inhibited $mod+p    workspace number $ws4
    bindsym --inhibited $mod+1    workspace number $ws1
    bindsym --inhibited $mod+2    workspace number $ws2
    bindsym --inhibited $mod+3    workspace number $ws3
    bindsym --inhibited $mod+4    workspace number $ws4
    bindsym --inhibited $mod+5    workspace number $ws5
    bindsym --inhibited $mod+6    workspace number $ws6
    bindsym --inhibited $mod+7    workspace number $ws7
    bindsym --inhibited $mod+8    workspace number $ws8
    bindsym --inhibited $mod+9    workspace number $ws9
    bindsym --inhibited $mod+0    workspace number $ws10

    # Exit gaming mode back to normal desktop mode
    bindsym Mod1+Shift+f mode "default", exec notify-send -t 1500 -i input-gaming "Gaming Mode: OFF" "Desktop shortcuts restored"
    bindsym --inhibited Mod1+Shift+f mode "default", exec notify-send -t 1500 -i input-gaming "Gaming Mode: OFF" "Desktop shortcuts restored"
}
