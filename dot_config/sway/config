# ==============================================================================
# Sway Window Manager Configuration (Wayland) — ASUS TUF Gaming F16
# Modular Architecture:
#   ~/.config/sway/config.d/00-variables.conf     - Modifiers, Workspaces, Font
#   ~/.config/sway/config.d/10-display.conf       - Output, Cursor, Borders & Theme
#   ~/.config/sway/config.d/20-input.conf         - Keyboard, Touchpad, Gestures
#   ~/.config/sway/config.d/30-window-rules.conf  - Rules, Floating, Steam, Games
#   ~/.config/sway/config.d/40-keybindings.conf   - Window nav, Launchers, Marks
#   ~/.config/sway/config.d/50-gaming-mode.conf   - Gaming passthrough mode
#   ~/.config/sway/config.d/60-autostart.conf     - Daemons, Services, Scratchpads
#   ~/.config/sway/config.d/70-bar.conf           - Swaybar status & theme
# ==============================================================================

include ~/.config/sway/config.d/*.conf
