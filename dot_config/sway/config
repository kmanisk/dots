for_window [instance="(?i)^(launcher\.exe|socialclubhelper\.exe|playgtaiv\.exe)$"] move to workspace number $ws4, floating enable
for_window [title="(?i)^rockstar games.*$"] move to workspace number $ws4, floating enable
for_window [title="(?i).*(rockstar|social club).*$"] move to workspace number $ws4, floating enable
for_window [class="(?i)^(gtaiv\.exe|gtaiv)$"] move to workspace number $ws4
for_window [instance="(?i)^(gtaiv\.exe|gtaiv)$"] move to workspace number $ws4
for_window [title="(?i)^GTAIV$"] move to workspace number $ws4
for_window [title="(?i)^Grand Theft Auto IV$"] move to workspace number $ws4


# Scratchpad window rules (floating & centered, auto-hidden to scratchpad)
# Geometry MUST match the canonical per-mode size in scratch-toggle show_it()
# (term 1700x1050, notes 1700x1050, spotify 1700x1050). for_window sizes the
# first map; show_it() re-enforces resize+center on every show, so any
# mismatch here causes a visible size jump on first toggle.
for_window [app_id="scratch-term"] floating enable, resize set 1700 1050, move position center, move to scratchpad
for_window [instance="scratch-term"] floating enable, resize set 1700 1050, move position center, move to scratchpad
for_window [app_id="scratch-notes"] floating enable, resize set 1700 1050, move position center, move to scratchpad
for_window [instance="scratch-notes"] floating enable, resize set 1700 1050, move position center, move to scratchpad
for_window [class="(?i)spotify"] floating enable, resize set 1700 1050, move position center, move to scratchpad

# Layout: ws1/2/3 forced tabbed (user policy: tab strip always
# visible, including single-window "[T|...]" bars). `workspace layout`
# alone only applies at startup, so for_window rules re-assert tabbed
# on every new window to hold it across restarts and moves.
workspace 1 layout tabbed
workspace 2 layout tabbed
workspace 3 layout tabbed
for_window [workspace="^1$"] layout tabbed
for_window [workspace="^2$"] layout tabbed
for_window [workspace="^3$"] layout tabbed


# Web Browser Rules (Workspace 2)
assign [app_id="(?i)^(brave|brave-browser|brave-origin|firefox|librewolf|zen-alpha)$"] workspace number $ws2
assign [class="(?i)^(brave|brave-browser|brave-origin|firefox|librewolf|zen-alpha)$"] workspace number $ws2
for_window [app_id="(?i)^(brave|brave-browser|brave-origin|firefox|librewolf|zen-alpha)$"] move to workspace number $ws2, layout tabbed, floating disable
for_window [class="(?i)^(brave|brave-browser|brave-origin|firefox|librewolf|zen-alpha)$"] move to workspace number $ws2, layout tabbed, floating disable
# Browser popups, web app dialogs float instead of being swallowed into tabbed view
for_window [app_id="(?i)^(brave|brave-browser|brave-origin|firefox|librewolf|zen-alpha)$" window_role="pop-up"] floating enable, move position center
for_window [app_id="(?i)^(brave|brave-browser|brave-origin|firefox|librewolf|zen-alpha)$" window_role="bubble"] floating enable, move position center
for_window [app_id="(?i)^(brave|brave-browser|brave-origin|firefox|librewolf|zen-alpha)$" window_type="dialog"] floating enable, move position center
for_window [app_id="(?i)^brave-(?!origin$).+"] floating enable, move position center

# Steam & All Steam Dialogs (Workspace 3)
assign [class="(?i)^steam$"] workspace number $ws3
assign [app_id="(?i)^steam$"] workspace number $ws3
assign [instance="(?i)^steam.*$"] workspace number $ws3

for_window [class="(?i)^steam$"] move to workspace number $ws3
for_window [app_id="(?i)^steam$"] move to workspace number $ws3
for_window [instance="(?i)^steam.*$"] move to workspace number $ws3

# Main Steam window tiled
for_window [class="(?i)^steam$" title="^Steam$"] floating disable
for_window [instance="steamwebhelper" title="^Steam$"] floating disable

# Steam Settings, Properties, and Non-Steam Game open tiled or as tabs on ws3
for_window [class="(?i)^steam$" title="^Settings$"] move to workspace number $ws3, floating disable
for_window [class="(?i)^steam$" title=".*[Pp]roperties.*"] move to workspace number $ws3, floating disable
for_window [class="(?i)^steam$" title="^Add Non-Steam Game$"] move to workspace number $ws3, floating disable
for_window [instance="steamwebhelper" title="^Add Non-Steam Game$"] move to workspace number $ws3, floating disable

# Steam dialogs (Launch options, Self Updater, Guard, News, File Chooser, etc.) move to ws3 and float
for_window [class="(?i)^steam$" window_type="dialog"] move to workspace number $ws3, floating enable, move position center
for_window [class="(?i)^steam$" window_role="dialog"] move to workspace number $ws3, floating enable, move position center
for_window [class="(?i)^steam$" window_role="pop-up"] move to workspace number $ws3, floating enable, move position center
for_window [class="(?i)^steam$" title="(?i).*(launch option|launch options|choose an option|news|updater|guard|screenshot|cd key|install).*"] move to workspace number $ws3, floating enable, move position center

# Steam Friends list & Chat float on ws3
for_window [class="(?i)^steam$" title="^Friends List$"] move to workspace number $ws3, floating enable, resize set 360 700
for_window [instance="steamwebhelper" title="^Friends List$"] move to workspace number $ws3, floating enable, resize set 360 700
for_window [instance="steamwebhelper" title=".* - Chat$"] move to workspace number $ws3, floating enable

# Games go to ws4 only (native XWayland + gamescope-nested + native Wayland cs2)
# for_window [workspace="^4$"] move container to workspace number $ws1, workspace number $ws1

# Whitelist of game & launcher windows allowed on ws4 (re-assert ws4 after eviction rule)
for_window [class="^steam_app_.*$"] move to workspace number $ws4
for_window [app_id="^steam_app_.*$"] move to workspace number $ws4
for_window [class="(?i)^(cs2|gamescope|eldenring|steam_proton|farcry3|gtaiv|gtaiv\.exe|dyinglight.*)$"] move to workspace number $ws4
for_window [app_id="(?i)^(cs2|gamescope|dyinglight.*)$"] move to workspace number $ws4
for_window [class="(?i)^(launcher\.exe|socialclubhelper\.exe|playgtaiv\.exe)$"] move to workspace number $ws4, floating enable
for_window [instance="(?i)^(launcher\.exe|socialclubhelper\.exe|playgtaiv\.exe)$"] move to workspace number $ws4, floating enable
for_window [title="(?i)^GTAIV$"] move to workspace number $ws4
for_window [title="(?i)^Grand Theft Auto IV$"] move to workspace number $ws4
for_window [title="(?i).*(rockstar|social club).*$"] move to workspace number $ws4, floating enable

# Re-assert Steam windows on ws3 if affected by ws4 eviction
for_window [class="(?i)^steam$"] move to workspace number $ws3
for_window [instance="(?i)^steam.*$"] move to workspace number $ws3

# Autostart Services
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP=sway SWAYSOCK QT_QPA_PLATFORMTHEME XCURSOR_THEME XCURSOR_SIZE
exec systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK QT_QPA_PLATFORMTHEME XCURSOR_THEME XCURSOR_SIZE
exec_always --no-startup-id xrdb -merge "$HOME/.Xresources"
# Autotab DISABLED under forced-tabbed policy (would untab singles).
#exec_always --no-startup-id sh -c 'pkill -f "i3-autota[b]"; sleep 0.2; exec ~/.local/bin/i3-autotab'
exec alacritty --class scratch-term
exec alacritty -o font.size=20.5 --class scratch-notes -e nvim "$HOME/notes.md"
# One-shot session restore (bounded IPC wait, exits immediately, no daemon)
exec --no-startup-id ~/.local/bin/sway-session-restore --all --quiet --wait-ready
exec --no-startup-id ~/.local/bin/toggle-nightlight --auto --silent
# Polkit authentication agent (required for root GUI apps like GParted)
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
# Bluetooth tray (blueman-applet was missing on sway: GUI toggle did nothing)
exec --no-startup-id blueman-applet
# Game workspace backstop: moves late-class game windows (Rockstar/CEF) to ws4
exec_always --no-startup-id ~/.local/bin/game-workspace-daemon
exec_always --no-startup-id sh -c '[ -f "$HOME/.config/current_wallpaper" ] && swaymsg output "*" bg "$(cat "$HOME/.config/current_wallpaper")" fill'

# Idle Management (swayidle)
# sway-idle-guard pauses these timers while a fullscreen window is focused
exec_always --no-startup-id ~/.local/bin/sway-idle-guard
exec swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f -c 000000'

# Status Bar (Swaybar — 0 extra daemons, dynamic base46 theme)
include ~/.local/state/theme/swaybar.conf
exec_always --no-startup-id sh -c '[ "$(cat ~/.config/polybar/bar_state 2>/dev/null)" = "true" ] && swaymsg "bar bar-0 mode dock"'
