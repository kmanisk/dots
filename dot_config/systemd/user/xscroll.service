[Unit]
Description=Persistent UInput mouse wheel scroll emulator for xremap
Documentation=man:xremap(1)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/home/onyx/.local/bin/xscroll --daemon
Restart=always
RestartSec=1s

[Install]
WantedBy=graphical-session.target
