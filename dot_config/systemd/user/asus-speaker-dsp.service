[Unit]
Description=ASUS TUF Speaker DSP (DAX3 Filter Chain)
After=pipewire.service
BindsTo=pipewire.service
PartOf=pipewire.service

[Service]
Type=simple
CPUAffinity=0-11
Nice=-11
ExecStart=/usr/bin/pipewire -c %h/.config/pipewire/asus-tuf-dax/active-runner.conf
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target pipewire.service
