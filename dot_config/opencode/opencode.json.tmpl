{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "mcp": {
    "system-metrics": {
      "type": "local",
      "command": [
        "{{ .chezmoi.homeDir }}/.local/bin/sysmetrics-mcp"
      ],
      "enabled": true
    },
    "gpu-tuning": {
      "type": "local",
      "command": [
        "{{ .chezmoi.homeDir }}/.local/bin/gpu-tuning-mcp"
      ],
      "enabled": true
    },
    "systemd": {
      "type": "local",
      "command": [
        "{{ .chezmoi.homeDir }}/.local/bin/systemd-mcp"
      ],
      "enabled": true
    },
    "desktop": {
      "type": "local",
      "command": [
        "{{ .chezmoi.homeDir }}/.local/bin/desktop-mcp"
      ],
      "enabled": true
    },
    "chezmoi": {
      "type": "local",
      "command": [
        "{{ .chezmoi.homeDir }}/.local/bin/chezmoi-mcp"
      ],
      "enabled": true
    },
    "sway": {
      "type": "local",
      "command": [
        "{{ .chezmoi.homeDir }}/.local/bin/sway-mcp"
      ],
      "enabled": true
    },
    "input-stack": {
      "type": "local",
      "command": [
        "{{ .chezmoi.homeDir }}/.local/bin/input-stack-mcp"
      ],
      "enabled": true
    }
  }
}