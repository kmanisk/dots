include={{ .chezmoi.homeDir }}/.local/state/theme/fuzzel.ini
# Font, paddings and border width are scale-derived and live in the generated
# scale.conf that ui-sync writes. include= is only valid at top level, so this
# line has to stay above [main]. Sizes are omitted below on purpose: a value
# here would win over the included one.
include={{ .chezmoi.homeDir }}/.config/fuzzel/scale.conf

[main]
prompt="❯ "
icon-theme=Papirus-Dark
icons-enabled=yes
terminal=footclient
width=36
lines=10
tabs=4
# Keep Alt+Space compact while allowing Fuzzel's native selected-app preview
# when filtering down to a few matches. Row icons remain scale-derived.
image-size-ratio=0.58
layer=overlay

[border]
radius=0
