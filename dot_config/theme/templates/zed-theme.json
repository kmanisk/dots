{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "NvChad System",
  "author": "Antigravity",
  "themes": [
    {
      "name": "NvChad System",
      "appearance": "{{type}}",
      "style": {
        "accents": [
          "{{accent}}",
          "{{blue}}",
          "{{green}}",
          "{{yellow}}",
          "{{orange}}",
          "{{red}}",
          "{{purple}}",
          "{{cyan}}"
        ],
        "background": "{{black}}",
        "surface.background": "{{black}}",
        "elevated_surface.background": "{{one_bg}}",
        "border": "{{one_bg}}",
        "border.variant": "{{one_bg2}}",
        "border.focused": "{{accent}}",
        "border.selected": "{{accent}}",
        "border.transparent": "#00000000",
        "border.disabled": "{{grey}}",
        "element.background": "{{one_bg}}",
        "element.hover": "{{one_bg2}}",
        "element.active": "{{one_bg3}}",
        "element.selected": "{{one_bg2}}",
        "element.disabled": "{{black}}",
        "drop_target.background": "{{one_bg2}}",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{one_bg}}",
        "ghost_element.active": "{{one_bg2}}",
        "ghost_element.selected": "{{one_bg2}}",
        "ghost_element.disabled": "#00000000",
        "text": "{{white}}",
        "text.muted": "{{grey_fg}}",
        "text.placeholder": "{{grey}}",
        "text.disabled": "{{grey}}",
        "text.accent": "{{accent}}",
        "icon": "{{grey_fg}}",
        "icon.muted": "{{grey}}",
        "icon.disabled": "{{grey}}",
        "icon.placeholder": "{{grey}}",
        "icon.accent": "{{accent}}",
        "status_bar.background": "{{darker_black}}",
        "title_bar.background": "{{darker_black}}",
        "title_bar.inactive_background": "{{darker_black}}",
        "toolbar.background": "{{black}}",
        "tab_bar.background": "{{darker_black}}",
        "tab.inactive_background": "{{darker_black}}",
        "tab.active_background": "{{black}}",
        "search.match_background": "{{one_bg2}}",
        "search.active_match_background": "{{accent}}",
        "panel.background": "{{darker_black}}",
        "panel.focused_border": "{{accent}}",
        "scrollbar.thumb.background": "{{one_bg2}}",
        "scrollbar.thumb.hover_background": "{{one_bg3}}",
        "scrollbar.thumb.border": "{{one_bg2}}",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "{{one_bg}}",
        "editor.foreground": "{{white}}",
        "editor.background": "{{black}}",
        "editor.gutter.background": "{{black}}",
        "editor.subheader.background": "{{black}}",
        "editor.active_line.background": "{{one_bg}}",
        "editor.highlighted_line.background": "{{one_bg}}",
        "editor.line_number": "{{grey_fg}}",
        "editor.active_line_number": "{{white}}",
        "editor.hover_line_number": "{{white}}",
        "editor.invisible": "{{grey}}",
        "editor.wrap_guide": "{{one_bg}}",
        "editor.active_wrap_guide": "{{one_bg2}}",
        "editor.document_highlight.read_background": "{{one_bg}}",
        "editor.document_highlight.write_background": "{{one_bg2}}",
        "editor.document_highlight.bracket_background": "{{one_bg2}}",
        "editor.indent_guide": "{{one_bg}}",
        "editor.indent_guide_active": "{{one_bg2}}",
        "terminal.background": "{{black}}",
        "terminal.foreground": "{{white}}",
        "terminal.bright_foreground": "{{white}}",
        "terminal.dim_foreground": "{{grey_fg}}",
        "terminal.ansi.black": "{{black}}",
        "terminal.ansi.bright_black": "{{grey}}",
        "terminal.ansi.dim_black": "{{darker_black}}",
        "terminal.ansi.red": "{{red}}",
        "terminal.ansi.bright_red": "{{red}}",
        "terminal.ansi.dim_red": "{{red}}",
        "terminal.ansi.green": "{{green}}",
        "terminal.ansi.bright_green": "{{vibrant_green}}",
        "terminal.ansi.dim_green": "{{green}}",
        "terminal.ansi.yellow": "{{yellow}}",
        "terminal.ansi.bright_yellow": "{{sun}}",
        "terminal.ansi.dim_yellow": "{{yellow}}",
        "terminal.ansi.blue": "{{blue}}",
        "terminal.ansi.bright_blue": "{{nord_blue}}",
        "terminal.ansi.dim_blue": "{{blue}}",
        "terminal.ansi.magenta": "{{purple}}",
        "terminal.ansi.bright_magenta": "{{baby_pink}}",
        "terminal.ansi.dim_magenta": "{{dark_purple}}",
        "terminal.ansi.cyan": "{{cyan}}",
        "terminal.ansi.bright_cyan": "{{teal}}",
        "terminal.ansi.dim_cyan": "{{cyan}}",
        "terminal.ansi.white": "{{white}}",
        "terminal.ansi.bright_white": "{{white}}",
        "terminal.ansi.dim_white": "{{grey_fg}}",
        "link_text.hover": "{{accent}}",
        "version_control.added": "{{green}}",
        "version_control.modified": "{{yellow}}",
        "version_control.deleted": "{{red}}",
        "created": "{{green}}",
        "deleted": "{{red}}",
        "modified": "{{yellow}}",
        "warning": "{{yellow}}",
        "error": "{{red}}",
        "success": "{{green}}",
        "info": "{{blue}}",
        "hint": "{{accent}}",
        "players": [
          {
            "cursor": "{{white}}",
            "background": "{{white}}",
            "selection": "{{one_bg2}}"
          }
        ],
        "syntax": {
          "attribute": { "color": "{{yellow}}" },
          "boolean": { "color": "{{orange}}" },
          "comment": { "color": "{{grey_fg}}" },
          "comment.doc": { "color": "{{grey_fg}}" },
          "constant": { "color": "{{orange}}" },
          "constructor": { "color": "{{blue}}" },
          "function": { "color": "{{blue}}" },
          "function.method": { "color": "{{blue}}" },
          "keyword": { "color": "{{purple}}" },
          "number": { "color": "{{orange}}" },
          "operator": { "color": "{{cyan}}" },
          "property": { "color": "{{white}}" },
          "string": { "color": "{{green}}" },
          "string.escape": { "color": "{{teal}}" },
          "type": { "color": "{{yellow}}" },
          "variable": { "color": "{{white}}" },
          "variable.special": { "color": "{{red}}" }
        }
      }
    }
  ]
}
