#!/usr/bin/env bash
# Enforce cross-agent documentation synchronization for durable workstation changes.
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
cd "$repo"

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$staged" ] || exit 0

# Paths that represent durable workstation/configuration implementation rather than docs/history.
system_change_re='^(AGENTS\.md$|CLAUDE\.md$|\.chezmoidata\.toml$|\.chezmoiignore$|\.chezmoiexternal\.toml\.tmpl$|\.chezmoitemplates/|\.github/workflows/system-docs-check\.yml$|dot_|private_|encrypted_|packages/|systemd/|install\.sh$|run_(once|onchange|after|before)_|scripts/)'
if ! grep -Eq "$system_change_re" <<<"$staged"; then
    exit 0
fi

printf 'pre-commit: durable workstation/configuration change detected\n'

if [ "${SYSTEM_DOCS_EXEMPT:-0}" != "1" ]; then
    "$repo/scripts/check-system-docs.sh" --cached
else
    printf 'pre-commit: SYSTEM_DOCS_EXEMPT=1; local semantic-doc check bypassed by explicit user/manual override\n'
fi

# Never auto-stage unrelated manual edits already present in the canonical context file.
if ! git diff --quiet -- docs/system/SYSTEM_CONTEXT.md; then
    printf '%s\n' \
        'pre-commit: BLOCKED: docs/system/SYSTEM_CONTEXT.md has unstaged edits.' \
        'Stage/reconcile those edits first so the hook cannot accidentally publish unrelated context changes.' >&2
    exit 1
fi

# Sway has a safe read-only validator, so require it when Sway/UI-scale implementation changes.
sway_change_re='^(dot_config/sway/|dot_config/ui-metrics\.conf$|dot_local/bin/executable_(ui-scale|ui-sync|sway-check|sway-safe-reload)$)'
sync_args=()
if grep -Eq "$sway_change_re" <<<"$staged"; then
    printf 'pre-commit: Sway/UI source changed; running Sway validation\n'
    sync_args=(--validate-sway)
fi

"$repo/scripts/sync-system-context.sh" "${sync_args[@]}"
git add docs/system/SYSTEM_CONTEXT.md

printf 'pre-commit: verified live SYSTEM_CONTEXT snapshot synchronized and staged\n'
